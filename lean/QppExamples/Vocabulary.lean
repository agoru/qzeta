/-- the scale j (from 1) of the block at the offset o of a point of a program: its coordinate o + j - 1, and 0 at
j = 0 and beyond the point -/
def Pair.blk {k : ℕ} (X : Fin k → ℚ) (o : ℕ) : ℕ → ℚ
  | 0 => 0
  | j + 1 => if h : o + j < k then X ⟨o + j, h⟩ else 0

theorem Pair.blk_succ {k : ℕ} (X : Fin k → ℚ) (o j : ℕ) :
    Pair.blk X o (j + 1) = if h : o + j < k then X ⟨o + j, h⟩ else 0 := rfl

theorem Pair.blk_one {k : ℕ} (X : Fin k → ℚ) (o : ℕ) (h : o < k) : Pair.blk X o 1 = X ⟨o, h⟩ :=
  dite_eq_left h

