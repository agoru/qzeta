  | 0 => rfl
  | j + 1 => by
    rw [Pair.blk_succ]
    by_cases h : o + j < k
    · rw [dite_eq_left h, Pi.zero_apply]
    · rw [dite_eq_right h]

/-- the point that is f on the block at the offset o of size s (its scale j the coordinate o + j - 1), 0 elsewhere -/
def Pair.emb (k o s : ℕ) (f : ℕ → ℚ) : Fin k → ℚ :=
  fun i => if o ≤ i.val ∧ i.val < o + s then f (i.val - o + 1) else 0

theorem Pair.blk_emb_self {k o s : ℕ} (f : ℕ → ℚ) (hk : o + s ≤ k) {j : ℕ} (h1 : 1 ≤ j) (h2 : j ≤ s) :
    Pair.blk (Pair.emb k o s f) o j = f j := by
  cases j with
  | zero => exact absurd h1 (Nat.not_succ_le_zero 0)
  | succ j =>
    have hs : o + j < o + s := Nat.add_lt_add_left (Nat.lt_of_succ_le h2) o
    rw [Pair.blk_succ, dite_eq_left (Nat.lt_of_lt_of_le hs hk)]
    show (if o ≤ o + j ∧ o + j < o + s then f (o + j - o + 1) else 0) = f (j + 1)
    rw [ite_eq_left ⟨Nat.le_add_right o j, hs⟩, Nat.add_sub_cancel_left]

theorem Pair.blk_emb_before {k o s o' s' : ℕ} (f : ℕ → ℚ) (h : o' + s' ≤ o) {j : ℕ} (h2 : j ≤ s') :
    Pair.blk (Pair.emb k o s f) o' j = 0 := by
  cases j with
  | zero => rfl
  | succ j =>
    rw [Pair.blk_succ]
    by_cases hk : o' + j < k
    · rw [dite_eq_left hk]
      show (if o ≤ o' + j ∧ o' + j < o + s then f (o' + j - o + 1) else 0) = 0
      exact ite_eq_right (fun hc => absurd (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_of_succ_le h2) o') h)
        (Nat.not_lt.2 hc.1))
    · rw [dite_eq_right hk]

theorem Pair.blk_emb_after {k o s o' : ℕ} (f : ℕ → ℚ) (h : o + s ≤ o') (j : ℕ) :
    Pair.blk (Pair.emb k o s f) o' j = 0 := by
  cases j with
  | zero => rfl
  | succ j =>
    rw [Pair.blk_succ]
    by_cases hk : o' + j < k
    · rw [dite_eq_left hk]
      show (if o ≤ o' + j ∧ o' + j < o + s then f (o' + j - o + 1) else 0) = 0
      exact ite_eq_right (fun hc => absurd (Nat.le_trans h (Nat.le_add_right o' j)) (Nat.not_le.2 hc.2))
    · rw [dite_eq_right hk]

theorem Pair.emb_nonneg {k o s : ℕ} {f : ℕ → ℚ} (hf : ∀ j, 1 ≤ j → j ≤ s → 0 ≤ f j) (i : Fin k) :
    0 ≤ Pair.emb k o s f i := by
  show 0 ≤ (if o ≤ i.val ∧ i.val < o + s then f (i.val - o + 1) else 0)
  by_cases hc : o ≤ i.val ∧ i.val < o + s
  · rw [ite_eq_left hc]
    exact hf _ (Nat.succ_le_succ (Nat.zero_le _)) (Nat.succ_le_of_lt (Nat.sub_lt_left_of_lt_add hc.1 hc.2))
  · rw [ite_eq_right hc]

/-- a block of size one is its scale 1 -/
theorem Pair.blk_le_one {k : ℕ} {u : Fin k → ℚ} {o : ℕ} (h : Pair.blk u o 1 = 0) :
    ∀ j, 1 ≤ j → j ≤ 1 → Pair.blk u o j = 0 :=
  fun j h1 h2 => (Nat.le_antisymm h2 h1) ▸ h

/-- the coordinates from the end of the point on vanish (none) -/
theorem Pair.van_end {k : ℕ} (u : Fin k → ℚ) : ∀ i : Fin k, k ≤ i.val → u i = 0 :=
  fun i h => absurd i.isLt (Nat.not_lt.2 h)

/-- the coordinates from o on vanish when they vanish from o + s on and the block at o of size s vanishes -/
theorem Pair.van_step {k o s : ℕ} {u : Fin k → ℚ} (hv : ∀ i : Fin k, o + s ≤ i.val → u i = 0)
    (hb : ∀ j, 1 ≤ j → j ≤ s → Pair.blk u o j = 0) : ∀ i : Fin k, o ≤ i.val → u i = 0 := by
  intro i hi
  by_cases hs : i.val < o + s
  · have e := hb (i.val - o + 1) (Nat.succ_le_succ (Nat.zero_le _))
      (Nat.succ_le_of_lt (Nat.sub_lt_left_of_lt_add hi hs))
    rw [Pair.blk_succ, dite_eq_left ((Nat.add_sub_cancel' hi).trans_lt i.isLt)] at e
    have ei : (⟨o + (i.val - o), (Nat.add_sub_cancel' hi).trans_lt i.isLt⟩ : Fin k) = i :=
      Fin.ext (Nat.add_sub_cancel' hi)
    rw [ei] at e
    exact e
  · exact hv i (Nat.not_lt.1 hs)

/-- the point vanishes when it vanishes from s on and its first block, of size s, vanishes -/
theorem Pair.van_first {k s : ℕ} {u : Fin k → ℚ} (hv : ∀ i : Fin k, s ≤ i.val → u i = 0)
    (hb : ∀ j, 1 ≤ j → j ≤ s → Pair.blk u 0 j = 0) : u = 0 :=
  funext fun i => Pair.van_step (o := 0) (s := s) (fun i h => hv i ((Nat.zero_add s).symm ▸ h)) hb i (Nat.zero_le _)

theorem Pair.isProg_cast {k k' : ℕ} (e : k = k') (Φ : (ℕ → ℕ → ℚ) → Prop) (Ψ : (ℕ → ℕ → ℚ) → ℚ) (P : Pair) :
    Pair.IsProg {X : Fin k → ℚ | (∀ i, 0 ≤ X i) ∧ Φ (Pair.blk X)} (fun X => Ψ (Pair.blk X)) P ↔
      Pair.IsProg {X : Fin k' → ℚ | (∀ i, 0 ≤ X i) ∧ Φ (Pair.blk X)} (fun X => Ψ (Pair.blk X)) P := by
  subst e; exact Iff.rfl

