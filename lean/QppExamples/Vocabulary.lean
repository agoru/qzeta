  m : {x : Nat // 0 < x}
  d : ℕ

/-- word sep(K in Loss(n), K' in Loss(n')) : Loss(n + n'); define sep(K, K')(x, y) := K(x) + K'(y) (qpp/examples/vocabulary.qpp:330) -/
def sep {n n' : ℕ} (K : Loss n) (K' : Loss n') : Loss (n + n') :=
  fun z => (fun (x : Point n) (y : Point n') => K x + K' y) (fun j => z (Fin.castAdd n' j)) (fun j => z (Fin.natAdd n j))

theorem sep_def {n n' : ℕ} (K : Loss n) (K' : Loss n') (x : Point n) (y : Point n') : sep K K' (Fin.append x y) = K x + K' y := by
  simp only [sep, Fin.append_left, Fin.append_right]

/-- word shift(K in Loss(n)) : Loss(n); define shift(K)(w) := 2 * K(w) + 1 (qpp/examples/vocabulary.qpp:332) -/
def shift {n : ℕ} (K : Loss n) : Loss n := fun w => 2 * K w + 1

theorem shift_def {n : ℕ} (K : Loss n) (w : Point n) : shift K w = 2 * K w + 1 := rfl

/-- word twice(K in Loss(n), K' in Loss(n)) : Loss(n + n); define twice(K, K')(x, y) := K(x) * K'(y) (qpp/examples/vocabulary.qpp:335) -/
def twice {n : ℕ} (K : Loss n) (K' : Loss n) : Loss (n + n) :=
  fun z => (fun (x : Point n) (y : Point n) => K x * K' y) (fun j => z (Fin.castAdd n j)) (fun j => z (Fin.natAdd n j))

theorem twice_def {n : ℕ} (K : Loss n) (K' : Loss n) (x : Point n) (y : Point n) : twice K K' (Fin.append x y) = K x * K' y := by
  simp only [twice, Fin.append_left, Fin.append_right]

/-- word halve(n, N in NN) : Halves(n); define halve(n, N)(u)_(j) := u_(j) / 2^N (qpp/examples/vocabulary.qpp:343) -/
def halve (n : ℕ) (N : ℕ) : Halves n := fun u => fun j => (u j : NNRat) / 2 ^ N

theorem halve_def (n : ℕ) (N : ℕ) (u : Grid n) (j : Fin n) : halve n N u j = (u j : NNRat) / 2 ^ N := rfl

/-- word dyad(B in Grid(n), N in NN) : Dyads(n); define dyad(B, N)(u)_(j) := sum k in 1..B_(j), iverson(u_(j) * 2^k <= 2^N) (qpp/examples/vocabulary.qpp:345) -/
def dyad {n : ℕ} (B : Grid n) (N : ℕ) : Dyads n := fun u => fun j => (∑ k ∈ Finset.Icc 1 (B j), (if u j * 2 ^ k ≤ 2 ^ N then (1 : ℕ) else 0))

theorem dyad_def {n : ℕ} (B : Grid n) (N : ℕ) (u : Grid n) (j : Fin n) : dyad B N u j = (∑ k ∈ Finset.Icc 1 (B j), (if u j * 2 ^ k ≤ 2 ^ N then (1 : ℕ) else 0)) := rfl

/-- word value(K in Loss(n), N in NN) : Values(n); define value(K, N)(u) := K(halve(n, N)(u)) (qpp/examples/vocabulary.qpp:347) -/
def value {n : ℕ} (K : Loss n) (N : ℕ) : Values n := fun u => K (halve n N u)

theorem value_def {n : ℕ} (K : Loss n) (N : ℕ) (u : Grid n) : value K N u = K (halve n N u) := rfl

/-- context coef(K in Loss(n), B in Region(n), p in Pair) (qpp/examples/vocabulary.qpp:350) -/
abbrev Ctx_coef : Type := ∀ {n : ℕ}, Loss n → Region n → Pair → Prop

/-- context coefw(K in Loss(n), omega in Weight(n), B in Region(n), p in Pair) (qpp/examples/vocabulary.qpp:351) -/
abbrev Ctx_coefw : Type := ∀ {n : ℕ}, Loss n → Weight n → Region n → Pair → Prop

/-- define pos(x) := max(x, 0) (qpp/examples/vocabulary.qpp:15) -/
def pos (x : ℚ) : ℚ := max x (0 : ℚ)

theorem pos_def (x : ℚ) : pos x = max x (0 : ℚ) := rfl

/-- define half(x) := x / 2 (qpp/examples/vocabulary.qpp:19) -/
def half (x : ℚ) : ℚ := x / (2 : ℚ)

theorem half_def (x : ℚ) : half x = x / (2 : ℚ) := rfl

/-- define mean(x, y) := (x + y) / 2 (qpp/examples/vocabulary.qpp:20) -/
def mean (x y : ℚ) : ℚ := (x + y) / (2 : ℚ)

theorem mean_def (x y : ℚ) : mean x y = (x + y) / (2 : ℚ) := rfl

/-- define ordz(m) := m - 1 (qpp/examples/vocabulary.qpp:276) -/
def ordz (m : ℚ) : ℚ := m - (1 : ℚ)

theorem ordz_def (m : ℚ) : ordz m = m - (1 : ℚ) := rfl

/-- relation (q #zsite t) := q in QQ>0, q <= t, t <= 2 * q (qpp/examples/vocabulary.qpp:21) -/
structure zsite (q t : ℚ) : Prop where
  h1 : q > (0 : ℚ)
  h2 : q ≤ t
  h3 : t ≤ (2 : ℚ) * q

noncomputable instance zsite.decidable (q t : ℚ) : Decidable (zsite q t) :=
  Classical.propDecidable _

theorem zsite_iff (q t : ℚ) : zsite q t ↔ (q > (0 : ℚ)) ∧ (q ≤ t) ∧ (t ≤ (2 : ℚ) * q) :=
  ⟨fun h => ⟨h.h1, h.h2, h.h3⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩

/-- relation (m #zcount t) := m in NN>=1, t in QQ>=0, m <= t + 1 (qpp/examples/vocabulary.qpp:277) -/
structure zcount (m : ℕ) (t : ℚ) : Prop where
  h1 : m ≥ (1 : ℕ)
  h2 : t ≥ (0 : ℚ)
  h3 : (m : ℚ) ≤ t + (1 : ℚ)

noncomputable instance zcount.decidable (m : ℕ) (t : ℚ) : Decidable (zcount m t) :=
  Classical.propDecidable _

theorem zcount_iff (m : ℕ) (t : ℚ) : zcount m t ↔ (m ≥ (1 : ℕ)) ∧ (t ≥ (0 : ℚ)) ∧ ((m : ℚ) ≤ t + (1 : ℚ)) :=
  ⟨fun h => ⟨h.h1, h.h2, h.h3⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩

/-- relation (G #zfloor Q #zbox b) := n in NN, G in Values(n), Q in QQ>0, b in Grid(n), (forall u in Grid(n) : (forall i : u_(i) <= b_(i)) => Q <= G(u)) (qpp/examples/vocabulary.qpp:349) -/
structure zfloor_zbox {n : ℕ} (G : Values n) (Q : ℚ) (b : Grid n) : Prop where
  h1 : Q > (0 : ℚ)
  h2 : ∀ u : Grid n, (∀ (i : Fin n), u i ≤ b i) → (Q ≤ (G u : ℚ))

noncomputable instance zfloor_zbox.decidable {n : ℕ} (G : Values n) (Q : ℚ) (b : Grid n) : Decidable (zfloor_zbox G Q b) :=
  Classical.propDecidable _

theorem zfloor_zbox_iff {n : ℕ} (G : Values n) (Q : ℚ) (b : Grid n) : zfloor_zbox G Q b ↔ (Q > (0 : ℚ)) ∧ (∀ u : Grid n, (∀ (i : Fin n), u i ≤ b i) → (Q ≤ (G u : ℚ))) :=
  ⟨fun h => ⟨h.h1, h.h2⟩, fun h => ⟨h.1, h.2⟩⟩

/-- relation (K #asymp K' #on B) := n in NN, K, K' in Loss(n), B in Region(n), (exists c, C in QQ>0 : forall w in B : c * K'(w) <= K(w) <= C * K'(w)) (qpp/examples/vocabulary.qpp:352) -/
structure asymp_on {n : ℕ} (K K' : Loss n) (B : Region n) : Prop where
  h1 : ∃ c C : ℚ, (0 < c ∧ 0 < C) ∧ ∀ w ∈ B, (c * (K' w : ℚ) ≤ (K w : ℚ)) ∧ ((K w : ℚ) ≤ C * (K' w : ℚ))

noncomputable instance asymp_on.decidable {n : ℕ} (K K' : Loss n) (B : Region n) : Decidable (asymp_on K K' B) :=
  Classical.propDecidable _

theorem asymp_on_iff {n : ℕ} (K K' : Loss n) (B : Region n) : asymp_on K K' B ↔ (∃ c C : ℚ, (0 < c ∧ 0 < C) ∧ ∀ w ∈ B, (c * (K' w : ℚ) ≤ (K w : ℚ)) ∧ ((K w : ℚ) ≤ C * (K' w : ℚ))) :=
  ⟨fun h => h.h1, fun h => ⟨h⟩⟩

/-- relation (K #bdd B) := n in NN, K in Loss(n), B in Region(n), (exists c in QQ>0 : forall w in B : c <= K(w)) (qpp/examples/vocabulary.qpp:353) -/
structure bdd {n : ℕ} (K : Loss n) (B : Region n) : Prop where
  h1 : ∃ c : ℚ, (0 < c) ∧ ∀ w ∈ B, c ≤ (K w : ℚ)

noncomputable instance bdd.decidable {n : ℕ} (K : Loss n) (B : Region n) : Decidable (bdd K B) :=
  Classical.propDecidable _

theorem bdd_iff {n : ℕ} (K : Loss n) (B : Region n) : bdd K B ↔ (∃ c : ℚ, (0 < c) ∧ ∀ w ∈ B, c ≤ (K w : ℚ)) :=
  ⟨fun h => h.h1, fun h => ⟨h⟩⟩

/-- relation (K #below K' #on B) := n in NN, K, K' in Loss(n), B in Region(n), (exists C in QQ>0 : forall w in B : K(w) <= C * K'(w)) (qpp/examples/vocabulary.qpp:354) -/
structure below_on {n : ℕ} (K K' : Loss n) (B : Region n) : Prop where
  h1 : ∃ C : ℚ, (0 < C) ∧ ∀ w ∈ B, (K w : ℚ) ≤ C * (K' w : ℚ)

noncomputable instance below_on.decidable {n : ℕ} (K K' : Loss n) (B : Region n) : Decidable (below_on K K' B) :=
  Classical.propDecidable _

theorem below_on_iff {n : ℕ} (K K' : Loss n) (B : Region n) : below_on K K' B ↔ (∃ C : ℚ, (0 < C) ∧ ∀ w ∈ B, (K w : ℚ) ≤ C * (K' w : ℚ)) :=
  ⟨fun h => h.h1, fun h => ⟨h⟩⟩

/-- relation (f #zcap t) := k, n in NN, f in Rows(k, n), t in NN, (forall iota : forall i : f_(iota)_(i) <= t) (qpp/examples/vocabulary.qpp:357) -/
structure zcap {k n : ℕ} (f : Rows k n) (t : ℕ) : Prop where
  h1 : ∀ (iota : Fin k), ∀ (i : Fin n), f iota i ≤ t

noncomputable instance zcap.decidable {k n : ℕ} (f : Rows k n) (t : ℕ) : Decidable (zcap f t) :=
  Classical.propDecidable _

theorem zcap_iff {k n : ℕ} (f : Rows k n) (t : ℕ) : zcap f t ↔ (∀ (iota : Fin k), ∀ (i : Fin n), f iota i ≤ t) :=
  ⟨fun h => h.h1, fun h => ⟨h⟩⟩

/-- relation (f #zcaps g #zby t) := k, n, t in NN, f, g in Rows(k, n), (f #zcap t), (forall j : forall i : g_(j)_(i) <= f_(j)_(i)) (qpp/examples/vocabulary.qpp:358) -/
structure zcaps_zby {k n : ℕ} (f g : Rows k n) (t : ℕ) : Prop where
  h1 : zcap f t
  h2 : ∀ (j : Fin k), ∀ (i : Fin n), g j i ≤ f j i

noncomputable instance zcaps_zby.decidable {k n : ℕ} (f g : Rows k n) (t : ℕ) : Decidable (zcaps_zby f g t) :=
  Classical.propDecidable _

theorem zcaps_zby_iff {k n : ℕ} (f g : Rows k n) (t : ℕ) : zcaps_zby f g t ↔ (zcap f t) ∧ (∀ (j : Fin k), ∀ (i : Fin n), g j i ≤ f j i) :=
  ⟨fun h => ⟨h.h1, h.h2⟩, fun h => ⟨h.1, h.2⟩⟩

/-- relation (s #zfeasible Pr #zlevel L) := k, n, L in NN, Pr in Prog(k, n), s in Grid(n), (forall iota : (sum i, Pr.P_(iota)_(i) * s_(i)) + Pr.op_(iota) >= (sum i, Pr.N_(iota)_(i) * s_(i)) + Pr.om_(iota) + Pr.eps_(iota) * L) (qpp/examples/vocabulary.qpp:362) -/
structure zfeasible_zlevel {k n : ℕ} (s : Grid n) (Pr : Prog k n) (L : ℕ) : Prop where
  h1 : ∀ (iota : Fin k), (∑ i : Fin n, Pr.P iota i * s i) + Pr.op iota ≥ (∑ i : Fin n, Pr.N iota i * s i) + Pr.om iota + Pr.eps iota * L

noncomputable instance zfeasible_zlevel.decidable {k n : ℕ} (s : Grid n) (Pr : Prog k n) (L : ℕ) : Decidable (zfeasible_zlevel s Pr L) :=
  Classical.propDecidable _

theorem zfeasible_zlevel_iff {k n : ℕ} (s : Grid n) (Pr : Prog k n) (L : ℕ) : zfeasible_zlevel s Pr L ↔ (∀ (iota : Fin k), (∑ i : Fin n, Pr.P iota i * s i) + Pr.op iota ≥ (∑ i : Fin n, Pr.N iota i * s i) + Pr.om iota + Pr.eps iota * L) :=
  ⟨fun h => h.h1, fun h => ⟨h⟩⟩

/-- relation (l #zrows t) := k, n in NN, l in Forms(k, n), t in QQ>=0, (forall iota : forall i : l_(iota)_(i) <= t) (qpp/examples/vocabulary.qpp:1161) -/
structure zrows {k n : ℕ} (l : Forms k n) (t : ℚ) : Prop where
  h1 : t ≥ (0 : ℚ)
  h2 : ∀ (iota : Fin k), ∀ (i : Fin n), (l iota i : ℚ) ≤ t

noncomputable instance zrows.decidable {k n : ℕ} (l : Forms k n) (t : ℚ) : Decidable (zrows l t) :=
  Classical.propDecidable _

theorem zrows_iff {k n : ℕ} (l : Forms k n) (t : ℚ) : zrows l t ↔ (t ≥ (0 : ℚ)) ∧ (∀ (iota : Fin k), ∀ (i : Fin n), (l iota i : ℚ) ≤ t) :=
  ⟨fun h => ⟨h.h1, h.h2⟩, fun h => ⟨h.1, h.2⟩⟩

/-- relation (W #zweight q #zcorners l #zsides s) := k, n in NN, W, l in Forms(k, n), s in Sides(k, n), q in Grid(n), (forall iota : forall i : l_(iota)_(i)^q_(i) + q_(i) * W_(iota)_(i) = (l_(iota)_(i) + s_(iota)_(i))^q_(i)) (qpp/examples/vocabulary.qpp:1287) -/
structure zweight_zcorners_zsides {k n : ℕ} (W : Forms k n) (q : Grid n) (l : Forms k n) (s : Sides k n) : Prop where
  h1 : ∀ (iota : Fin k), ∀ (i : Fin n), (l iota i : ℚ) ^ q i + (q i : ℚ) * (W iota i : ℚ) = ((l iota i : ℚ) + (s iota i : ℚ)) ^ q i

noncomputable instance zweight_zcorners_zsides.decidable {k n : ℕ} (W : Forms k n) (q : Grid n) (l : Forms k n) (s : Sides k n) : Decidable (zweight_zcorners_zsides W q l s) :=
  Classical.propDecidable _

theorem zweight_zcorners_zsides_iff {k n : ℕ} (W : Forms k n) (q : Grid n) (l : Forms k n) (s : Sides k n) : zweight_zcorners_zsides W q l s ↔ (∀ (iota : Fin k), ∀ (i : Fin n), (l iota i : ℚ) ^ q i + (q i : ℚ) * (W iota i : ℚ) = ((l iota i : ℚ) + (s iota i : ℚ)) ^ q i) :=
  ⟨fun h => h.h1, fun h => ⟨h⟩⟩

/-- relation (c #zpos L) := c in QQ>=0, L in NN, (exists d in QQ>0 : exists M in NN>=1 : d <= c, L <= M) (qpp/examples/vocabulary.qpp:1510) -/
structure zpos (c : ℚ) (L : ℕ) : Prop where
  h1 : c ≥ (0 : ℚ)
  h2 : ∃ d : ℚ, (0 < d) ∧ ∃ M : ℕ, (1 ≤ M) ∧ (d ≤ c) ∧ (L ≤ M)

noncomputable instance zpos.decidable (c : ℚ) (L : ℕ) : Decidable (zpos c L) :=
  Classical.propDecidable _

theorem zpos_iff (c : ℚ) (L : ℕ) : zpos c L ↔ (c ≥ (0 : ℚ)) ∧ (∃ d : ℚ, (0 < d) ∧ ∃ M : ℕ, (1 ≤ M) ∧ (d ≤ c) ∧ (L ≤ M)) :=
  ⟨fun h => ⟨h.h1, h.h2⟩, fun h => ⟨h.1, h.2⟩⟩

/-- relation (K #zcapped L #zon B) := n, L in NN, K in Loss(n), B in Region(n), (forall w in B : 2^L * K(w) <= 1 => exists k in NN : K(w) <= k) (qpp/examples/vocabulary.qpp:1627) -/
structure zcapped_zon {n : ℕ} (K : Loss n) (L : ℕ) (B : Region n) : Prop where
