    { toFun := fun u t => (u : Fin k → ℚ) (r t)
      map_add' := fun u v => by funext t; rfl
      map_smul' := fun a u => by funext t; rfl }
  have hinj : Function.Injective φ := by
    intro u v huv
    have hd : T ((u : Fin k → ℚ) - v) := by
      rw [sub_eq_add_neg, ← neg_one_smul ℚ (v : Fin k → ℚ)]
      exact hadd _ _ u.2 (hsmul (-1) _ v.2)
    have h0' := hR _ hd (fun t => by
      rw [Pi.sub_apply, sub_eq_zero]
      exact congrFun huv t)
    exact Subtype.ext (sub_eq_zero.1 h0')
  calc Module.finrank ℚ (vectorSpan ℚ F) ≤ Module.finrank ℚ W := Submodule.finrank_mono hle
    _ ≤ Module.finrank ℚ (Fin d → ℚ) := LinearMap.finrank_le_finrank_of_injective hinj
    _ = d := Module.finrank_fin_fun ℚ

/-- the dimension of a face from below, by two of its points that differ at the scale of a block of size one -/
theorem Pair.one_le_faceDim {k : ℕ} {F : Set (Fin k → ℚ)} {P Q : Fin k → ℚ} (hP : P ∈ F) (hQ : Q ∈ F) (o : ℕ)
    (h : o < k) (hne : Pair.blk P o 1 ≠ Pair.blk Q o 1) : 1 ≤ Module.finrank ℚ (vectorSpan ℚ F) := by
  rw [Pair.blk_one P o h, Pair.blk_one Q o h] at hne
  refine Pair.le_faceDim ![P, Q] (Fin.forall_fin_two.2 ⟨hP, hQ⟩) ![⟨o, h⟩] ![![1 / (Q ⟨o, h⟩ - P ⟨o, h⟩)]]
    (Fin.forall_fin_one.2 (Fin.forall_fin_one.2 ?_))
  rw [Fin.sum_univ_one, ite_eq_left rfl]
  exact one_div_mul_cancel (sub_ne_zero.2 hne.symm)



/-- type Point(n) := (QQ>=0)^n (qpp/examples/vocabulary.qpp:320) -/
abbrev Point (n : ℕ) : Type := Fin n -> NNRat

/-- type Loss(n) := Point(n) -> QQ>=0 (qpp/examples/vocabulary.qpp:321) -/
abbrev Loss (n : ℕ) : Type := Point n -> NNRat

/-- type Weight(n) := (QQ>0)^n (qpp/examples/vocabulary.qpp:322) -/
abbrev Weight (n : ℕ) : Type := Fin n -> {x : Rat // 0 < x}

/-- type Region(n) := set(Point(n)) (qpp/examples/vocabulary.qpp:323) -/
abbrev Region (n : ℕ) : Type := Set (Point n)

/-- type Map(n) := Point(n) -> Point(n) (qpp/examples/vocabulary.qpp:324) -/
abbrev Map (n : ℕ) : Type := Point n -> Point n

/-- type Grid(n) := NN^n (qpp/examples/vocabulary.qpp:325) -/
abbrev Grid (n : ℕ) : Type := Fin n -> Nat

/-- type Rows(k, n) := (NN^n)^k (qpp/examples/vocabulary.qpp:326) -/
abbrev Rows (k n : ℕ) : Type := Fin k -> (Fin n -> Nat)

/-- type Forms(k, n) := ((QQ>=0)^n)^k (qpp/examples/vocabulary.qpp:327) -/
abbrev Forms (k n : ℕ) : Type := Fin k -> (Fin n -> NNRat)

/-- type Sides(k, n) := ((QQ>0)^n)^k (qpp/examples/vocabulary.qpp:328) -/
abbrev Sides (k n : ℕ) : Type := Fin k -> (Fin n -> {x : Rat // 0 < x})

/-- type Line := NN -> QQ>=0 (qpp/examples/vocabulary.qpp:329) -/
abbrev Line : Type := Nat -> NNRat

/-- type Halves(n) := Grid(n) -> Point(n) (qpp/examples/vocabulary.qpp:339) -/
abbrev Halves (n : ℕ) : Type := Grid n -> Point n

/-- type Dyads(n) := Grid(n) -> Grid(n) (qpp/examples/vocabulary.qpp:340) -/
abbrev Dyads (n : ℕ) : Type := Grid n -> Grid n

/-- type Values(n) := Grid(n) -> QQ>=0 (qpp/examples/vocabulary.qpp:341) -/
abbrev Values (n : ℕ) : Type := Grid n -> NNRat

/-- type Depth(n) := {F in Halves(n), N in NN} (qpp/examples/vocabulary.qpp:342) -/
structure Depth (n : ℕ) where
  F : Halves n
  N : ℕ

/-- type Prog(k, n) := {P, N in Rows(k, n), op, om, eps in Grid(k)} (qpp/examples/vocabulary.qpp:361) -/
structure Prog (k n : ℕ) where
  P : Rows k n
  N : Rows k n
  op : Grid k
  om : Grid k
  eps : Grid k

/-- type ZCert(k) := {y in Grid(k), d in NN} (qpp/examples/vocabulary.qpp:364) -/
structure ZCert (k : ℕ) where
  y : Grid k
  d : ℕ

/-- type ZBox(k, n) := {lo, hi in Grid(n), w in Grid(k), d in NN} (qpp/examples/vocabulary.qpp:1891) -/
structure ZBox (k n : ℕ) where
  lo : Grid n
  hi : Grid n
  w : Grid k
  d : ℕ

/-- type Mesh(n) := Grid(n) -> QQ>=0 (qpp/examples/vocabulary.qpp:1921) -/
abbrev Mesh (n : ℕ) : Type := Grid n -> NNRat

/-- type Starz(k) := {N0, w0 in NN>=1, N, w in (NN>=1)^k} (qpp/examples/vocabulary.qpp:2019) -/
structure Starz (k : ℕ) where
  N0 : {x : Nat // 0 < x}
  w0 : {x : Nat // 0 < x}
  N : Fin k -> {x : Nat // 0 < x}
  w : Fin k -> {x : Nat // 0 < x}

/-- type PosGrid(n) := (NN>=1)^n (qpp/examples/vocabulary.qpp:2387) -/
abbrev PosGrid (n : ℕ) : Type := Fin n -> {x : Nat // 0 < x}

/-- type PosRows(k, n) := ((NN>=1)^n)^k (qpp/examples/vocabulary.qpp:2388) -/
abbrev PosRows (k n : ℕ) : Type := Fin k -> (Fin n -> {x : Nat // 0 < x})

/-- type PosLine := NN -> QQ>0 (qpp/examples/vocabulary.qpp:2389) -/
abbrev PosLine : Type := Nat -> {x : Rat // 0 < x}

/-- type StepLine := NN -> NN>=1 (qpp/examples/vocabulary.qpp:2390) -/
abbrev StepLine : Type := Nat -> {x : Nat // 0 < x}

/-- type PosValues(n) := Grid(n) -> QQ>0 (qpp/examples/vocabulary.qpp:2391) -/
abbrev PosValues (n : ℕ) : Type := Grid n -> {x : Rat // 0 < x}

/-- type PosCert(k) := {e in PosGrid(k), m in NN>=1, d in NN} (qpp/examples/vocabulary.qpp:2392) -/
structure PosCert (k : ℕ) where
