/-- type Starz(k) := {N0, w0 in NN>=1, N, w in (NN>=1)^k} (qpp/examples/vocabulary.qpp:2019), over the kernel -/
private theorem Starz.count_left (c : Count) :
    (fun y : {x : Nat // 0 < x} => Count.ofNat y.1) ((fun c => (⟨Count.toNat c, Count.toNat_pos c⟩ : {x : Nat // 0 < x})) c) = c :=
  Count.toNat_inj (Count.toNat_ofNat_of_pos (Count.toNat_pos c))
private theorem Starz.count_right (y : {x : Nat // 0 < x}) :
    (fun c => (⟨Count.toNat c, Count.toNat_pos c⟩ : {x : Nat // 0 < x})) ((fun y : {x : Nat // 0 < x} => Count.ofNat y.1) y) = y :=
  Subtype.ext (Count.toNat_ofNat_of_pos y.2)
private theorem Starz.count_ofNat (c : Count) : Count.ofNat (Count.toNat c) = c :=
  Count.toNat_inj (Count.toNat_ofNat_of_pos (Count.toNat_pos c))
/-- a part read back and read again: its value (the transfer of a statement over the bundle) -/
@[qpp_bridge] theorem Starz.count_toNat (y : {x : Nat // 0 < x}) : (Count.ofNat y.1).toNat = y.1 :=
  Count.toNat_ofNat_of_pos y.2
/-- the bound of a part, as the bound of a count (Count.one_le_toNat) on the other side of the transfer -/
@[qpp_bridge] theorem Starz.one_le_val (y : {x : Nat // 0 < x}) : 1 ≤ y.1 := Nat.one_le_of_lt y.2
@[qpp_bridge] theorem Starz.val_pos (y : {x : Nat // 0 < x}) : 0 < y.1 := y.2

