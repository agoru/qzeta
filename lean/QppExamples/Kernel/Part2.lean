noncomputable def Pair.blk {k : Count0} (X : Idx k → Mass0) (o : Count0) (j : Count0) : Mass0 :=
  Option.elim j 0 (fun c => Idx.extend 0 X (o + c))

theorem Pair.blk_toRat {k : Count0} (X : Idx k → Mass0) (o j : Count0) :
    (Pair.blk X o j).toRat = QppMathlib.Examples.Pair.blk (Idx.map Mass0.toRat X) o.toNat j.toNat := by
  cases j with
  | none => rfl
  | some c =>
    obtain ⟨m, hm⟩ : ∃ m, c.toNat = m + 1 := ⟨c.toNat - 1, (Nat.sub_add_cancel (Count.toNat_pos c)).symm⟩
    have e : (Count0.of (o + c)).toNat = o.toNat + (m + 1) :=
      (Count0.toNat_of _).trans ((Count.toNat_add0' o c).trans (congrArg (o.toNat + ·) hm))
    show (Idx.extend 0 X (o + c)).toRat = QppMathlib.Examples.Pair.blk (Idx.map Mass0.toRat X) o.toNat c.toNat
    rw [hm, QppMathlib.Examples.Pair.blk_succ]
    unfold Idx.extend
    by_cases hk : Count0.of (o + c) ≤ k
    · have hk' : o.toNat + m < k.toNat := e.symm.le.trans (Count0.toNat_le.1 hk)
      rw [dite_eq_left hk, dite_eq_left hk', Idx.map_apply]
      exact congrArg (fun i => (X i).toRat) (Subtype.ext (Count.toNat_inj ((Count.toNat_add0' o c).trans
        ((congrArg (o.toNat + ·) hm).trans ((Nat.add_assoc _ _ _).symm.trans (Count.toNat_ofNatSucc _).symm)))))
    · have hk' : ¬ (o.toNat + m < k.toNat) := fun h => hk (Count0.toNat_le.2 (e.le.trans h))
      rw [dite_eq_right hk, dite_eq_right hk']
      rfl


