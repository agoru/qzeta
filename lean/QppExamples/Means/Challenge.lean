@[expose] public section

-- the congruences of masses rewrite with one list of laws of counts each, not all of which each step uses
set_option linter.unusedSimpArgs false

namespace Qpp

/-- The counts: `1` and its successors. -/
inductive Count where
  | one : Count
  | succ : Count → Count

namespace Count

/-- The count `n + 1`, for a numeral `n` of Lean: the numerals `1, 2, 3, ...` of the counts. -/
def ofNatSucc : Nat → Count
  | 0 => one
  | n + 1 => succ (ofNatSucc n)

instance (n : Nat) : OfNat Count (n + 1) := ⟨ofNatSucc n⟩

theorem one_def : one = 1 := rfl

/-- `ind`: a property of `1` kept by the successor holds for every count (the recursor of `Count`). -/
theorem ind {P : Count → Prop} (h1 : P 1) (hs : ∀ n, P n → P (succ n)) (n : Count) : P n :=
  Count.rec (motive := P) h1 hs n

/-- `neq`: `1` is no successor (no confusion). -/
theorem succ_ne_one (n : Count) : succ n ≠ 1 := fun h => Count.noConfusion h

/-- `neq`: the successor is injective (no confusion). -/
theorem succ_inj {a b : Count} (h : succ a = succ b) : a = b := Count.noConfusion h id

/-! ## Sum -/

/-- The sum, by recursion on the second argument: `a + 1` is the successor of `a`. -/
protected def add : Count → Count → Count
  | a, one => succ a
  | a, succ b => succ (Count.add a b)

instance : Add Count := ⟨Count.add⟩

theorem add_one (a : Count) : a + 1 = succ a := rfl
theorem add_succ (a b : Count) : a + succ b = succ (a + b) := rfl

theorem one_add (a : Count) : 1 + a = succ a := by
  induction a using ind with
  | h1 => rfl
  | hs a ih => show succ (1 + a) = _; rw [ih]

theorem succ_add (a b : Count) : succ a + b = succ (a + b) := by
  induction b using ind with
  | h1 => rfl
  | hs b ih => show succ (succ a + b) = _; rw [ih]; rfl

theorem add_assoc (a b c : Count) : a + b + c = a + (b + c) := by
  induction c using ind with
  | h1 => rfl
  | hs c ih => show succ (a + b + c) = succ (a + (b + c)); rw [ih]

theorem add_comm (a b : Count) : a + b = b + a := by
  induction b using ind with
  | h1 => rw [add_one, one_add]
  | hs b ih => rw [add_succ, succ_add, ih]

/-- No count is the sum of itself and another (the strong form of `neq`). -/
theorem add_ne_left (a b : Count) : a + b ≠ a := by
  induction a using ind with
  | h1 => rw [one_add]; exact succ_ne_one b
  | hs a ih => rw [succ_add]; exact fun h => ih (succ_inj h)

theorem add_right_cancel {a b c : Count} (h : a + c = b + c) : a = b := by
  induction c using ind with
  | h1 => exact succ_inj h
  | hs c ih => exact ih (succ_inj h)

theorem add_left_cancel {a b c : Count} (h : c + a = c + b) : a = b := by
  rw [add_comm c a, add_comm c b] at h; exact add_right_cancel h

/-! ## Product -/

/-- The product, by recursion on the second argument: `a * (b + 1) = a * b + a`. -/
protected def mul : Count → Count → Count
  | a, one => a
  | a, succ b => Count.mul a b + a

instance : Mul Count := ⟨Count.mul⟩

theorem mul_one (a : Count) : a * 1 = a := rfl
theorem mul_succ (a b : Count) : a * succ b = a * b + a := rfl

theorem one_mul (a : Count) : 1 * a = a := by
  induction a using ind with
  | h1 => rfl
  | hs a ih => rw [mul_succ, ih, add_one]

theorem succ_mul (a b : Count) : succ a * b = a * b + b := by
  induction b using ind with
  | h1 => rfl
  | hs b ih => rw [mul_succ, mul_succ, ih, add_succ, add_succ, add_assoc, add_assoc, add_comm b a]

theorem mul_comm (a b : Count) : a * b = b * a := by
  induction b using ind with
  | h1 => rw [mul_one, one_mul]
  | hs b ih => rw [mul_succ, succ_mul, ih]

theorem mul_add (a b c : Count) : a * (b + c) = a * b + a * c := by
  induction c using ind with
  | h1 => rfl
  | hs c ih => rw [add_succ, mul_succ, mul_succ, ih, add_assoc]

theorem add_mul (a b c : Count) : (a + b) * c = a * c + b * c := by
  rw [mul_comm, mul_add, mul_comm c a, mul_comm c b]

theorem mul_assoc (a b c : Count) : a * b * c = a * (b * c) := by
  induction c using ind with
  | h1 => rfl
  | hs c ih => rw [mul_succ, mul_succ, ih, mul_add]

theorem mul_left_comm (a b c : Count) : a * (b * c) = b * (a * c) := by
  rw [← mul_assoc, mul_comm a b, mul_assoc]

theorem mul_right_cancel {a b c : Count} (h : a * c = b * c) : a = b := by
  induction a using ind generalizing b with
  | h1 =>
    cases b with
    | one => rfl
    | succ b => rw [one_mul, succ_mul, add_comm] at h; exact absurd h.symm (add_ne_left c (b * c))
  | hs a ih =>
    cases b with
    | one => rw [one_def, one_mul, succ_mul, add_comm] at h; exact absurd h (add_ne_left c (a * c))
    | succ b => rw [succ_mul, succ_mul] at h; rw [ih (add_right_cancel h)]

/-! ## Powers -/

/-- `a ^ k` for a numeral `k` of Lean; `a ^ 0 = 1` is the empty product. -/
protected def npow (a : Count) : Nat → Count
  | 0 => 1
  | k + 1 => Count.npow a k * a

instance : NatPow Count := ⟨Count.npow⟩

theorem pow_succ (a : Count) (k : Nat) : a ^ (k + 1) = a ^ k * a := rfl

/-! ## The numeral of a count -/

/-- The numeral of Lean of the same size: `1 ↦ 1`, `succ n ↦ n + 1`. -/
def toNat : Count → Nat
  | one => 1
  | succ n => toNat n + 1

theorem toNat_succ (n : Count) : toNat (succ n) = toNat n + 1 := rfl

theorem toNat_ofNatSucc (n : Nat) : toNat (ofNatSucc n) = n + 1 := by
  induction n with
  | zero => rfl
  | succ n ih => show toNat (ofNatSucc n) + 1 = _; rw [ih]

theorem toNat_add (a b : Count) : toNat (a + b) = toNat a + toNat b := by
  induction b using ind with
  | h1 => rfl
  | hs b ih => show toNat (a + b) + 1 = toNat a + (toNat b + 1); rw [ih, Nat.add_assoc]

theorem toNat_mul (a b : Count) : toNat (a * b) = toNat a * toNat b := by
  induction b using ind with
  | h1 => exact (Nat.mul_one _).symm
  | hs b ih => rw [mul_succ, toNat_add, ih, toNat_succ, Nat.mul_succ]

theorem toNat_pow (a : Count) (k : Nat) : toNat (a ^ k) = toNat a ^ k := by
  induction k with
  | zero => rfl
  | succ k ih => rw [pow_succ, toNat_mul, ih, Nat.pow_succ]

theorem toNat_pos (a : Count) : 0 < toNat a := by
  cases a with
  | one => exact Nat.one_pos
  | succ a => exact Nat.succ_pos _

theorem toNat_inj {a b : Count} (h : toNat a = toNat b) : a = b := by
  induction a using ind generalizing b with
  | h1 =>
    cases b with
    | one => rfl
    | succ b => have := toNat_pos b; have h' : 1 = toNat b + 1 := h; omega
  | hs a ih =>
    cases b with
    | one => have := toNat_pos a; have h' : toNat a + 1 = 1 := h; omega
    | succ b => rw [ih (Nat.succ.inj h)]

end Count

/-- A power by a numeral is a power by a numeral of Lean. Without it the elaborator leaves the type of each exponent
open and settles it by default instances at the end, at a cost quadratic in the number of powers. -/
scoped macro_rules | `($x ^ $n:num) => `(HPow.hPow $x ($n : Nat))

/-! ## Masses -/

/-- A pair of counts `(p, q)`: the mass `p / q`. -/
structure Pair where
  num : Count
  den : Count

namespace Pair

/-- The tie of two pairs: `p / q` and `r / s` are the same mass when `p * s = r * q`. -/
def Tie (a b : Pair) : Prop := a.num * b.den = b.num * a.den

theorem Tie.trans {a b c : Pair} (h1 : Tie a b) (h2 : Tie b c) : Tie a c := by
  unfold Tie at *
  apply Count.mul_right_cancel (c := b.den)
  calc a.num * c.den * b.den = (a.num * b.den) * c.den := by
        simp only [Count.mul_assoc, Count.mul_comm c.den]
    _ = (b.num * a.den) * c.den := by rw [h1]
    _ = (b.num * c.den) * a.den := by simp only [Count.mul_assoc, Count.mul_comm a.den]
    _ = (c.num * b.den) * a.den := by rw [h2]
    _ = c.num * a.den * b.den := by simp only [Count.mul_assoc, Count.mul_comm a.den]

instance setoid : Setoid Pair := ⟨Tie, ⟨fun _ => rfl, Eq.symm, Tie.trans⟩⟩

end Pair

/-- The masses: pairs of counts up to the tie. -/
def Mass : Type := Quotient Pair.setoid

namespace Mass

/-- The mass `p / q`. -/
def mk (p q : Count) : Mass := Quotient.mk _ ⟨p, q⟩

theorem mk_eq_mk {p q r s : Count} : mk p q = mk r s ↔ p * s = r * q :=
  ⟨fun h => Quotient.exact h, fun h => Quotient.sound h⟩

/-- The numerals `1, 2, 3, ...` of the masses. -/
instance (n : Nat) : OfNat Mass (n + 1) := ⟨mk (OfNat.ofNat (n + 1)) 1⟩

/-- The sum: `p / q + r / s = (p * s + r * q) / (q * s)`. -/
protected def add : Mass → Mass → Mass :=
  Quotient.lift₂ (fun a b => mk (a.num * b.den + b.num * a.den) (a.den * b.den)) fun a b a' b' h1 h2 => by
    apply mk_eq_mk.mpr
    change a.num * a'.den = a'.num * a.den at h1
    change b.num * b'.den = b'.num * b.den at h2
    calc (a.num * b.den + b.num * a.den) * (a'.den * b'.den)
        = (a.num * a'.den) * (b.den * b'.den) + (b.num * b'.den) * (a.den * a'.den) := by
          simp only [Count.add_mul, Count.mul_add, Count.mul_assoc, Count.mul_comm, Count.mul_left_comm]
      _ = (a'.num * a.den) * (b.den * b'.den) + (b'.num * b.den) * (a.den * a'.den) := by rw [h1, h2]
      _ = (a'.num * b'.den + b'.num * a'.den) * (a.den * b.den) := by
          simp only [Count.add_mul, Count.mul_add, Count.mul_assoc, Count.mul_comm, Count.mul_left_comm]

/-- The division: `(p / q) / (r / s) = (p * s) / (q * r)`. -/
protected def div : Mass → Mass → Mass :=
  Quotient.lift₂ (fun a b => mk (a.num * b.den) (a.den * b.num)) fun a b a' b' h1 h2 => by
    apply mk_eq_mk.mpr
    change a.num * a'.den = a'.num * a.den at h1
    change b.num * b'.den = b'.num * b.den at h2
    calc a.num * b.den * (a'.den * b'.num) = (a.num * a'.den) * (b'.num * b.den) := by
          simp only [Count.mul_assoc, Count.mul_comm, Count.mul_left_comm]
      _ = (a'.num * a.den) * (b.num * b'.den) := by rw [h1, h2]
      _ = a'.num * b'.den * (a.den * b.num) := by
          simp only [Count.mul_assoc, Count.mul_comm, Count.mul_left_comm]

instance : Add Mass := ⟨Mass.add⟩
instance : Div Mass := ⟨Mass.div⟩
/-- The product, derived: `x * y := x / (1 / y)`. -/
instance : Mul Mass := ⟨fun x y => x / (1 / y)⟩
/-- The inverse, derived: `x⁻¹ := 1 / x`. -/
instance : Inv Mass := ⟨fun x => 1 / x⟩

/-- `x ^ k` for a numeral `k` of Lean; `x ^ 0 = 1` is the empty product. -/
protected def npow (x : Mass) : Nat → Mass
  | 0 => 1
  | k + 1 => Mass.npow x k * x

instance : NatPow Mass := ⟨Mass.npow⟩

/-- A count as a mass: `n / 1`. -/
def ofCount (n : Count) : Mass := mk n 1

end Mass

/-! ## The order -/

namespace Count

protected def Lt (a b : Count) : Prop := ∃ c, b = a + c

instance : LT Count := ⟨Count.Lt⟩
instance : LE Count := ⟨fun a b => a = b ∨ a < b⟩

end Count

namespace Mass

/-- `x < y`: `y` is `x` plus a mass. -/
protected def Lt (x y : Mass) : Prop := ∃ z, y = x + z

instance : LT Mass := ⟨Mass.Lt⟩
instance : LE Mass := ⟨fun x y => x = y ∨ x < y⟩

end Mass

/-! ## Sums -/

section Sums

variable {α : Type} [Add α]

/-- The sum of two possibly absent terms; absent is the unit. -/
def oadd : Option α → Option α → Option α
  | none, y => y
  | some x, none => some x
  | some x, some y => some (x + y)

/-- The sum of a list; absent when the list is empty. -/
def osum : List α → Option α
  | [] => none
  | x :: l => oadd (some x) (osum l)

/-- The count of a list: one `1` per entry; absent when the list is empty. -/
def card {β : Type} (l : List β) : Option Count := osum (l.map fun _ => (1 : Count))

end Sums

/-- `Σ_{i=1}^{n} f i`, a sum over the counts up to `n`. -/
def sumTo {β : Type} [Add β] (f : Count → β) : Count → β
  | .one => f 1
  | .succ n => sumTo f n + f (.succ n)

/-- `Π_{i=1}^{n} f i`, a product over the counts up to `n`. -/
def prodTo {β : Type} [Mul β] (f : Count → β) : Count → β
  | .one => f 1
  | .succ n => prodTo f n * f (.succ n)

/-! ## Pairs

A pair `⟨l, r⟩` stands for `l` less `r`; two pairs are tied when `a.l + b.r = b.l + a.r`. The rationals are the
pairs of masses: a statement over `ℚ` is one over `Bal Mass` in which `=` is the tie (`Bal.Tie`), `0` is the level
pair `⟨1, 1⟩` and `-a` is `swap a`. -/

/-- A pair: `l` less `r`. -/
structure Bal (α : Type) where
  l : α
  r : α

namespace Bal

variable {α : Type}

/-- Two pairs stand for the same: `a.l + b.r = b.l + a.r`. -/
def Tie [Add α] (a b : Bal α) : Prop := a.l + b.r = b.l + a.r

instance [Add α] : Add (Bal α) := ⟨fun a b => ⟨a.l + b.l, a.r + b.r⟩⟩

instance [Add α] [Mul α] : Mul (Bal α) := ⟨fun a b => ⟨a.l * b.l + a.r * b.r, a.l * b.r + a.r * b.l⟩⟩

/-- The pair the other way round: `r` less `l`. -/
def swap (a : Bal α) : Bal α := ⟨a.r, a.l⟩

/-- `a < b`: `a.l + b.r < b.l + a.r`. -/
protected def Lt [Add α] [LT α] (a b : Bal α) : Prop := a.l + b.r < b.l + a.r

instance [Add α] [LT α] : LT (Bal α) := ⟨Bal.Lt⟩

instance [Add α] [LT α] : LE (Bal α) := ⟨fun a b => Tie a b ∨ a < b⟩

/-- `x` as a pair: `x + 1` less `1`. -/
def of [Add α] [OfNat α 1] (x : α) : Bal α := ⟨x + 1, 1⟩

/-- A pair that stands for nothing. -/
def level [OfNat α 1] : Bal α := ⟨1, 1⟩

/-- Powers by a natural number; the power `0` is `of 1`. -/
protected def npow [Add α] [Mul α] [OfNat α 1] (a : Bal α) : Nat → Bal α
  | 0 => ⟨1 + 1, 1⟩
  | k + 1 => Bal.npow a k * a

instance [Add α] [Mul α] [OfNat α 1] : NatPow (Bal α) := ⟨Bal.npow⟩

end Bal

/-- A numeral of Lean as a pair: `0` is the level pair. -/
def Bal.nat : Nat → Bal Mass
  | 0 => Bal.level
  | n + 1 => Bal.of (Mass.ofCount (Count.ofNatSucc n))

/-- The values `0` and `1` of a pair, for a vector in `{0,1}^k`. -/
def Bal.IsBit (s : Bal Mass) : Prop := Bal.Tie s Bal.level ∨ Bal.Tie s (Bal.of 1)

/-! ## Words read by relation

No rational function is the larger of two masses, so `max`, `min`, the positive part `(x)_+ = max(x, 0)`, the
size `|x| = max(x, -x)` and the indicator `1[P]` are not words of `1`, `+` and `/`. A statement reads each one as a
name bound by its relation; the relation needs only the order, and its solution exists and is unique up to ties
(`MinMax.lean`). -/

section Relations

variable {α : Type}

/-- `m` is the least of `a` and `b`. -/
def IsMin [LE α] (m a b : α) : Prop := (m = a ∧ a ≤ b) ∨ (m = b ∧ b ≤ a)

/-- `m` is the greatest of `a` and `b`. -/
def IsMax [LE α] (m a b : α) : Prop := (m = a ∧ b ≤ a) ∨ (m = b ∧ a ≤ b)

/-- `m` is the least entry of the list `l`. -/
def IsLeast [LE α] (m : α) (l : List α) : Prop := m ∈ l ∧ ∀ x ∈ l, m ≤ x

/-- `m` is the greatest entry of the list `l`. -/
def IsGreatest [LE α] (m : α) (l : List α) : Prop := m ∈ l ∧ ∀ x ∈ l, x ≤ m

/-- `y` is the indicator `1[P]` of the proposition `P`: `1` if it holds, `0` if not. -/
def IsInd (y : Bal Mass) (P : Prop) : Prop := (P ∧ Bal.Tie y (Bal.of 1)) ∨ (¬P ∧ Bal.Tie y Bal.level)

end Relations

/-! ## Binomial coefficients and sums from zero -/

/-- The binomial coefficient `binom n k`, by Pascal's rule. -/
def binom : Nat → Nat → Nat
  | _, 0 => 1
  | 0, _ + 1 => 0
  | n + 1, k + 1 => binom n k + binom n (k + 1)

/-- `Σ_{h=1}^{n} f h` over the counts up to a numeral `n` of Lean, with the value `z` when `n = 0`. -/
def sumN {β : Type} [Add β] (z : β) (f : Count → β) : Nat → β
  | 0 => z
  | n + 1 => sumN z f n + f (Count.ofNatSucc n)

/-- `Σ_{i=0}^{n-1} f i` over the numerals of Lean below `n`, with the value `z` when `n = 0`. -/
def sumBelow {β : Type} [Add β] (z : β) (f : Nat → β) : Nat → β
  | 0 => z
  | n + 1 => sumBelow z f n + f n

/-! ## Cited facts -/

/-- The source of a cited fact: a DOI and, optionally, the number of the statement. -/
structure Source where
  doi : String
  stmt : Option String := none

/-- A cited fact: a statement over the core, taken as a hypothesis by the results that use it, and its source. -/
structure Cited where
  statement : Prop
  source : Source

end Qpp

@[expose] public section

namespace Qpp

open Classical

/-! ## Zero as absent -/

/-- `NN`: a count, or absent. Absent is the zero of the modules. -/
def Count0 : Type := Option Count

/-- `QQ>=0`: a mass, or absent. -/
def Mass0 : Type := Option Mass

namespace Count0

/-- A count as a count or absent. -/
def of (c : Count) : Count0 := some c

instance : Zero Count0 := ⟨(none : Option Count)⟩
instance : One Count0 := ⟨of 1⟩
/-- The numerals `2, 3, ...`. -/
instance (n : Nat) : OfNat Count0 (n + 2) := ⟨of (Count.ofNatSucc (n + 1))⟩

/-- The sum; absent is its unit. -/
protected def add : Count0 → Count0 → Count0
  | none, y => y
  | some a, none => some a
  | some a, some b => some (a + b)

/-- The product; a product with an absent factor is absent. -/
protected def mul : Count0 → Count0 → Count0
  | some a, some b => some (a * b)
  | _, _ => none

instance : Add Count0 := ⟨Count0.add⟩
instance : Mul Count0 := ⟨Count0.mul⟩

/-- `x < y`: `y` is `x` plus a count. -/
protected def Lt (x y : Count0) : Prop := ∃ c : Count, y = x + of c

instance : LT Count0 := ⟨Count0.Lt⟩
instance : LE Count0 := ⟨fun x y => x = y ∨ x < y⟩

end Count0

/-- A count plus a count or absent: a count (absent adds nothing). A multiplicity `j + r_(j)` of a literal pair, with
`r_(j)` a count, is a count whatever `j`. -/
def Count.add0 (c : Count) : Count0 → Count
  | none => c
  | some d => c + d

instance : HAdd Count Count0 Count := ⟨Count.add0⟩
instance : HAdd Count0 Count Count := ⟨fun j c => Count.add0 c j⟩

namespace Mass0

/-- A mass as a mass or absent. -/
def of (a : Mass) : Mass0 := some a

/-- A count or absent as a mass or absent. -/
def ofCount0 : Count0 → Mass0
  | none => none
  | some c => some (Mass.ofCount c)

instance : Zero Mass0 := ⟨(none : Option Mass)⟩
instance : One Mass0 := ⟨of 1⟩
/-- The numerals `2, 3, ...`. -/
instance (n : Nat) : OfNat Mass0 (n + 2) := ⟨of (OfNat.ofNat (n + 2))⟩

/-- The sum; absent is its unit. -/
protected def add : Mass0 → Mass0 → Mass0
  | none, y => y
  | some a, none => some a
  | some a, some b => some (a + b)

/-- The product; a product with an absent factor is absent. -/
protected def mul : Mass0 → Mass0 → Mass0
  | some a, some b => some (a * b)
  | _, _ => none

/-- The quotient; absent divided, or divided by absent, is absent. -/
protected def div : Mass0 → Mass0 → Mass0
  | some a, some b => some (a / b)
  | _, _ => none

instance : Add Mass0 := ⟨Mass0.add⟩
instance : Mul Mass0 := ⟨Mass0.mul⟩
instance : Div Mass0 := ⟨Mass0.div⟩

/-- `x < y`: `y` is `x` plus a mass. -/
protected def Lt (x y : Mass0) : Prop := ∃ z : Mass, y = x + of z

instance : LT Mass0 := ⟨Mass0.Lt⟩
instance : LE Mass0 := ⟨fun x y => x = y ∨ x < y⟩

end Mass0

/-! ## Powers

`x ^ k` for a numeral `k` of Lean is `NatPow` (as in `Base`); `x ^ e` for an exponent `e` in `NN` or `NN>=1` is the
product of `e` factors `x`, and `x ^ 0 = 1`. -/

section Powers

variable {β : Type} [Mul β] [OfNat β 1]

/-- `x ^ c` for a count `c`: `c` factors `x`. -/
def powCount (x : β) : Count → β
  | .one => x
  | .succ c => powCount x c * x

/-- `x ^ e` for a count or absent `e`; `x ^ 0 = 1`. -/
def powCount0 (x : β) : Count0 → β
  | none => 1
  | some c => powCount x c

instance : HPow β Count β := ⟨powCount⟩
instance : HPow β Count0 β := ⟨powCount0⟩

/-- `x ^ k` for a numeral `k` of Lean. -/
def powNat (x : β) : Nat → β
  | 0 => 1
  | k + 1 => powNat x k * x

end Powers

instance : NatPow Count0 := ⟨powNat⟩
instance : NatPow Mass0 := ⟨powNat⟩

/-! ## The deficit, the least and the greatest of two, the indicator -/

/-- The deficit `max(a - b, 0)`: absent when `a ≤ b`, otherwise the count `c` with `a = b + c`. -/
noncomputable def Count0.deficit (a b : Count0) : Count0 :=
  if h : b < a then Count0.of (Classical.choose h) else 0

/-- The deficit `max(a - b, 0)`: absent when `a ≤ b`, otherwise the mass `c` with `a = b + c`. -/
noncomputable def Mass0.deficit (a b : Mass0) : Mass0 :=
  if h : b < a then Mass0.of (Classical.choose h) else 0

/-- `min(a, b)`: the first when it is at most the second, else the second. -/
noncomputable def least {α : Type} [LE α] (a b : α) : α := if a ≤ b then a else b

/-- `max(a, b)`: the second when the first is at most it, else the first. -/
noncomputable def greatest {α : Type} [LE α] (a b : α) : α := if a ≤ b then b else a

noncomputable instance : Min Count := ⟨least⟩
noncomputable instance : Max Count := ⟨greatest⟩
noncomputable instance : Min Mass := ⟨least⟩
noncomputable instance : Max Mass := ⟨greatest⟩
noncomputable instance : Min Count0 := ⟨least⟩
noncomputable instance : Max Count0 := ⟨greatest⟩
noncomputable instance : Min Mass0 := ⟨least⟩
noncomputable instance : Max Mass0 := ⟨greatest⟩

/-- `iverson(P)`: `1` when `P` holds, absent when it does not. -/
noncomputable def iverson (P : Prop) : Mass0 := if P then 1 else 0

/-- `iverson(P)` as a count or absent. -/
noncomputable def iversonN (P : Prop) : Count0 := if P then 1 else 0

/-- The count before a count: absent before `1`. -/
def Count.pred0 : Count → Count0
  | .one => 0
  | .succ c => Count0.of c

/-- `binom(c, k)` for a count `c`, by Pascal's rule. -/
def Count.binom : Count → Count0 → Count0
  | _, none => 1
  | .one, some .one => 1
  | .one, some (.succ _) => 0
  | .succ c, some k => Count.binom c (Count.pred0 k) + Count.binom c (some k)

/-- `binom(n, k)`: the number of choices of `k` among `n`, by Pascal's rule. -/
def Count0.binom : Count0 → Count0 → Count0
  | none, none => 1
  | none, some _ => 0
  | some c, k => Count.binom c k

/-! ## Indices as counts, tuples, sums over the coordinates -/

/-- The indices of a tuple of `n` coordinates: the counts `1, ..., n`; there are none when `n` is absent. A tuple of
`X^n` is a function `Idx n → X`. -/
def Idx (n : Count0) : Type := {i : Count // Count0.of i ≤ n}

/-- Indices compare as counts. -/
instance {n : Count0} : LT (Idx n) := ⟨fun i j => i.1 < j.1⟩
instance {n : Count0} : LE (Idx n) := ⟨fun i j => i.1 ≤ j.1⟩

/-- A function on the indices of `n`, extended to every count by `z` beyond `n`. -/
noncomputable def Idx.extend {β : Type} {n : Count0} (z : β) (f : Idx n → β) (i : Count) : β :=
  if h : Count0.of i ≤ n then f ⟨i, h⟩ else z

/-- `sum i, f i`: the sum over the indices `1, ..., n`; absent when `n` is. -/
noncomputable def Idx.sum {β : Type} [Add β] [Zero β] : (n : Count0) → (Idx n → β) → β
  | none, _ => 0
  | some c, f => sumTo (Idx.extend 0 f) c

/-- `prod i, f i`: the product over the indices `1, ..., n`; `1` when `n` is absent. -/
noncomputable def Idx.prod {β : Type} [Mul β] [OfNat β 1] : (n : Count0) → (Idx n → β) → β
  | none, _ => 1
  | some c, f => prodTo (Idx.extend 1 f) c

/-! ## Two tuples joined, and the two halves of a tuple -/

/-- A value to read where no index reads one (`default`): `1` for a mass, absent for a mass or a count that may be
absent. -/
instance : Inhabited Mass := ⟨1⟩
instance : Inhabited Mass0 := ⟨0⟩
instance : Inhabited Count0 := ⟨0⟩

/-- `join(x, y)`: the tuple of `n + n'` coordinates that reads `x` at an index up to `n`, and `y` at `j` at the index
`n + j`. The index `j` is chosen; `default` is read at no index. -/
noncomputable def Idx.join {β : Type} [Inhabited β] {n n' : Count0} (x : Idx n → β) (y : Idx n' → β)
    (i : Idx (n + n')) : β :=
  if h : Count0.of i.1 ≤ n then x ⟨i.1, h⟩
  else if h' : ∃ j : Idx n', Count0.of i.1 = n + Count0.of j.1 then y (Classical.choose h') else default

/-- The first equation of `join`: at an index up to `n`, the entry of `x`. -/
theorem Idx.join_left {β : Type} [Inhabited β] {n n' : Count0} (x : Idx n → β) (y : Idx n' → β)
    (i : Idx (n + n')) (h : Count0.of i.1 ≤ n) : Idx.join x y i = x ⟨i.1, h⟩ := by
  unfold Idx.join; simp only [h, ↓reduceDIte]

/-- The second equation of `join`: at the index `n + j`, the entry of `y` at `j` (the index chosen). -/
theorem Idx.join_right {β : Type} [Inhabited β] {n n' : Count0} (x : Idx n → β) (y : Idx n' → β)
    (i : Idx (n + n')) (h : ¬ Count0.of i.1 ≤ n) (h' : ∃ j : Idx n', Count0.of i.1 = n + Count0.of j.1) :
    Idx.join x y i = y (Classical.choose h') := by
  unfold Idx.join; simp only [h, h', ↓reduceDIte]

/-- The first half of a tuple of `n + n'` coordinates: its entries at the indices up to `n`. -/
noncomputable def Idx.fst {β : Type} [Inhabited β] {n n' : Count0} (z : Idx (n + n') → β) (i : Idx n) : β :=
  Idx.extend default z i.1

/-- The second half: at `j` up to `n'`, the entry at the index `n + j`. -/
noncomputable def Idx.snd {β : Type} [Inhabited β] {n n' : Count0} (z : Idx (n + n') → β) (j : Idx n') : β :=
  Idx.extend default z (n + j.1)

/-! ## Sums over a range and over a box -/

/-- `Σ_{v = 0}^{b} g v`: the term at absent, then the terms at the counts up to `b`. -/
def upTo {β : Type} [Add β] (b : Count0) (g : Count0 → β) : β :=
  match b with
  | none => g 0
  | some c => g 0 + sumTo (fun i => g (Count0.of i)) c

/-- `Π_{v = 0}^{b} g v`. -/
def upToProd {β : Type} [Mul β] (b : Count0) (g : Count0 → β) : β :=
  match b with
  | none => g 0
  | some c => g 0 * prodTo (fun i => g (Count0.of i)) c

/-- `sum k in a..b, f k`: the sum over `a ≤ k ≤ b`; absent when `b < a`. -/
noncomputable def rangeSum {β : Type} [Add β] [Zero β] (a b : Count0) (f : Count0 → β) : β :=
  upTo b fun k => if a ≤ k then f k else 0

/-- `prod k in a..b, f k`: the product over `a ≤ k ≤ b`; `1` when `b < a`. -/
noncomputable def rangeProd {β : Type} [Mul β] [OfNat β 1] (a b : Count0) (f : Count0 → β) : β :=
  upToProd b fun k => if a ≤ k then f k else 1

/-- The sum over the lattice points of the box `[0, b]` of the first `c` coordinates, the points read as functions
on every count, absent beyond `c`: the last coordinate `v` runs from `0` to `b c`, and the first `c - 1` over their
box. -/
noncomputable def boxTo {β : Type} [Add β] (b : Count → Count0) : Count → ((Count → Count0) → β) → β
  | .one, f => upTo (b 1) fun v => f fun i => if i = 1 then v else 0
  | .succ c, f => upTo (b (.succ c)) fun v => boxTo b c fun u => f fun i => if i = .succ c then v else u i

/-- `sum u <= b, f u`: the sum over the lattice points `u` of `NN^n` with `u ≤ b` at every coordinate. The box of
no coordinates has one point. -/
noncomputable def boxSum {β : Type} [Add β] : (n : Count0) → (Idx n → Count0) → ((Idx n → Count0) → β) → β
  | none, _, f => f fun _ => 0
  | some c, b, f => boxTo (Idx.extend 0 b) c fun u => f fun i => u i.1

/-! ## The bideterminant

The two halves `(|(T, U)|^+, |(T, U)|^-)` of the determinant of a couple of tables `(T, U)` that stands for `T - U`:
the determinant over the semiring of couples (Akian, Gaubert and Guterman, arXiv:0812.3496, Def. 4.14). By Laplace's
recursion along the first row: the couple of no rows is `(1, absent)`, and the couple of `c` rows is the sum over
the columns `j` of `T_(1, j)` times the couple of the minor of `(1, j)` and `U_(1, j)` times that couple exchanged,
the two halves of the minor exchanged again at the even columns. A half is named by a flag: `true` for `+`. -/

/-- `true` at the odd counts `1, 3, 5, ...`. -/
def Count.odd : Count → Bool
  | .one => true
  | .succ c => !(Count.odd c)

/-- The column `b` of the minor of the column `j`: `b` before `j`, `b + 1` from `j` on. -/
def Count.skip : Count → Count → Count
  | .one, b => .succ b
  | .succ _, .one => .one
  | .succ j, .succ b => .succ (Count.skip j b)

/-- The minor of the entry `(1, j)` of a table on every count. -/
def minorAt (T : Count → Count → Mass0) (j : Count) : Count → Count → Mass0 :=
  fun a b => T (.succ a) (Count.skip j b)

/-- The couple of no rows: `1` on the half `+`, absent on the half `-`. -/
def bidet0 (s : Bool) (_ _ : Count → Count → Mass0) : Mass0 := if s then 1 else 0

/-- One step of Laplace's recursion on the first `c` rows, from the halves `B` of the minors. -/
def bidetStep (B : Bool → (Count → Count → Mass0) → (Count → Count → Mass0) → Mass0) (c : Count) (s : Bool)
    (T U : Count → Count → Mass0) : Mass0 :=
  sumTo (fun j => T 1 j * B (s == Count.odd j) (minorAt T j) (minorAt U j)
    + U 1 j * B (s != Count.odd j) (minorAt T j) (minorAt U j)) c

/-- The half `s` of the couple `(T, U)` on its first `c` rows and columns. -/
def bidetCount : Count → Bool → (Count → Count → Mass0) → (Count → Count → Mass0) → Mass0
  | .one => bidetStep bidet0 1
  | .succ c => bidetStep (bidetCount c) (.succ c)

/-- The half `s` of the couple `(T, U)` on its first `n` rows and columns; the couple of no rows when `n` is absent. -/
def bidetExt : Count0 → Bool → (Count → Count → Mass0) → (Count → Count → Mass0) → Mass0
  | none => bidet0
  | some c => bidetCount c

/-- A table of `Forms(n, n)` extended to every count by absent entries. -/
noncomputable def Idx.extend2 {n : Count0} (T : Idx n → Idx n → Mass0) : Count → Count → Mass0 :=
  Idx.extend (fun _ => 0) (fun i => Idx.extend 0 (T i))

/-- `bidetP(T, U)`: the half `|(T, U)|^+` of the couple of tables `(T, U)`. -/
noncomputable def bidetP {n : Count0} (T U : Idx n → Idx n → Mass0) : Mass0 :=
  bidetExt n true (Idx.extend2 T) (Idx.extend2 U)

/-- `bidetM(T, U)`: the half `|(T, U)|^-` of the couple of tables `(T, U)`. -/
noncomputable def bidetM {n : Count0} (T U : Idx n → Idx n → Mass0) : Mass0 :=
  bidetExt n false (Idx.extend2 T) (Idx.extend2 U)

/-! ## The pair `(l, m)` -/

/-- The pair `(l, m)` of a content `l` (a mass or absent) and a multiplicity `m` (a count), or `top`. -/
inductive PairLM where
  | top : PairLM
  | mk : Mass0 → Count → PairLM

namespace PairLM

/-- `m + m' - 1`: the multiplicity of a sum of pairs. -/
def addMult (m : Count) : Count → Count
  | .one => m
  | .succ m' => m + m'

/-- The sum: contents add, multiplicities add less one; `top` absorbs. -/
protected def add : PairLM → PairLM → PairLM
  | mk l m, mk l' m' => mk (l + l') (addMult m m')
  | _, _ => top

instance : Add PairLM := ⟨PairLM.add⟩

/-- The order: a smaller content, or the same content and a larger multiplicity; `top` is the greatest. -/
protected def Le : PairLM → PairLM → Prop
  | _, top => True
  | top, mk _ _ => False
  | mk l m, mk l' m' => l < l' ∨ (l = l' ∧ m' ≤ m)

instance : LE PairLM := ⟨PairLM.Le⟩
instance : LT PairLM := ⟨fun p q => p ≤ q ∧ ¬ q ≤ p⟩

noncomputable instance : Min PairLM := ⟨least⟩

end PairLM

/-- The least of the pairs `g 0, g 1, ..., g c`. -/
noncomputable def infTo0 (g : Count0 → PairLM) : Count → PairLM
  | .one => min (g 0) (g 1)
  | .succ c => min (infTo0 g c) (g (Count0.of (.succ c)))

/-- The least of the pairs `g v` for `0 ≤ v ≤ b`. -/
noncomputable def infUpTo (b : Count0) (g : Count0 → PairLM) : PairLM :=
  match b with
  | none => g 0
  | some c => infTo0 g c

/-- The least of the pairs `g 1, ..., g J`, `J` a count: `oplus k in 1..J, g k`. A range of candidates is never empty,
here and in `infUpTo` (`oplus k in 0..b`): an empty range would have no least member, and `top` is reached only as
the pair of a program that a Farkas line refutes. -/
noncomputable def infFrom1 (g : Count0 → PairLM) : Count → PairLM
  | .one => g 1
  | .succ c => min (infFrom1 g c) (g (Count0.of (.succ c)))

/-! ## The program atom

A program of `k` coordinates: the feasible points `S` (a predicate on the points of `(QQ>=0)^k`) and a cost `c`. Its
pair is `top` when no point is feasible; otherwise `(L, d + 1)` with `L` the least cost over the feasible points and
`d` the dimension of the face `{x ∈ S : c x = L}`: the largest number of its points, after a first, whose differences
from the first are affinely independent. Differences have both signs, so they are read as balances (`Bal`): a
combination of the differences with balance coefficients that ties with zero at every coordinate has coefficients
that tie with zero. -/

/-- `L` is the least cost of a feasible point. -/
def ProgLeast {k : Count0} (S : (Idx k → Mass0) → Prop) (c : (Idx k → Mass0) → Mass0) (L : Mass0) : Prop :=
  (∃ x, S x ∧ c x = L) ∧ ∀ x, S x → L ≤ c x

/-- A mass or absent as a balance: `x + 1` less `1`, and absent is the level pair. -/
def Mass0.toBal : Mass0 → Bal Mass
  | none => Bal.level
  | some a => Bal.of a

/-- The balance `Σ_{j=1}^{d} y_j (p_j - p_0)` at the coordinate `i`, for the points `p_0, ..., p_d`. -/
def faceComb {k : Count0} (d : Count) (p : Count0 → Idx k → Mass0) (y : Count → Bal Mass) (i : Idx k) : Bal Mass :=
  sumTo (fun j => y j * (Mass0.toBal (p (Count0.of j) i) + Bal.swap (Mass0.toBal (p 0 i)))) d

/-- The points `p_0, ..., p_d` lie in `F` and their differences from `p_0` are affinely independent. -/
def AffIndep {k : Count0} (F : (Idx k → Mass0) → Prop) (d : Count0) (p : Count0 → Idx k → Mass0) : Prop :=
  (∀ j, j ≤ d → F (p j)) ∧
    match d with
    | none => True
    | some d => ∀ y : Count → Bal Mass, (∀ i, Bal.Tie (faceComb d p y i) Bal.level) →
        ∀ j, Count0.of j ≤ some d → Bal.Tie (y j) Bal.level

/-- `d` is the dimension of the face `F`: it has `d + 1` affinely independent points, and no `d + 2`. -/
def FaceDim {k : Count0} (F : (Idx k → Mass0) → Prop) (d : Count0) : Prop :=
  (∃ p, AffIndep F d p) ∧ ∀ e : Count0, d < e → ∀ p, ¬ AffIndep F e p

/-- `prog(S : c) = P`: `P` is `top` and no point is feasible, or `P = (L, d + 1)` with `L` the least cost and `d`
the dimension of the face of the feasible points of cost `L`. -/
def IsProg {k : Count0} (S : (Idx k → Mass0) → Prop) (c : (Idx k → Mass0) → Mass0) : PairLM → Prop
  | .top => ∀ x, ¬ S x
  | .mk L m => ProgLeast S c L ∧ ∃ d : Count0, FaceDim (fun x => S x ∧ c x = L) d ∧ Count0.of m = d + 1

end Qpp

@[expose] public section

namespace Qpp.Means

/-- [fact:powermean(1)] over the kernel, qpp/examples/means.qpp:14: cited, a hypothesis of the rows that cite it -/
def fact_powermean_1.statement : Prop :=
  ∀ (J E : Count) (u : Count0 → Mass), rangeSum (1 : Count0) (Count0.of J) (fun j => Mass0.of (u j)) ^ (Count0.of E + (1 : Count0)) ≤ Mass0.ofCount0 (Count0.of J) ^ Count0.of E * rangeSum (1 : Count0) (Count0.of J) (fun j => Mass0.of (u j) ^ (Count0.of E + (1 : Count0)))

/-- The statement of lem:mean(1) over the kernel, qpp/examples/means.qpp:19 -/
def lem_mean_1.statement : Prop :=
  ∀ (u v : Mass), (u < v) → u < (u + v) / (2 : Mass)

/-- The statement of lem:square(1) over the kernel, qpp/examples/means.qpp:30 -/
def lem_square_1.statement : Prop :=
  ∀ (u v : Mass) (c : Mass0), (c = (2 : Mass0) * Mass0.of u * Mass0.of v) → (Mass0.of u + Mass0.of v) ^ 2 = Mass0.of u ^ 2 + Mass0.of v ^ 2 + c

/-- The statement of lem:square(2) over the kernel, qpp/examples/means.qpp:31 -/
def lem_square_2.statement : Prop :=
  ∀ (u v : Mass) (c : Mass0), (c = (2 : Mass0) * Mass0.of u * Mass0.of v) → c < (Mass0.of u + Mass0.of v) ^ 2

/-- The statement of lem:sumsq(1) over the kernel, qpp/examples/means.qpp:41 -/
def lem_sumsq_1.statement : Prop :=
  fact_powermean_1.statement → ∀ (J : Count) (u : Count0 → Mass), rangeSum (1 : Count0) (Count0.of J) (fun j => Mass0.of (u j)) ^ 2 ≤ Mass0.ofCount0 (Count0.of J) * rangeSum (1 : Count0) (Count0.of J) (fun j => Mass0.of (u j) ^ 2)

end Qpp.Means

namespace Qpp.Means

theorem lem_mean_1 : lem_mean_1.statement := sorry

theorem lem_square_1 : lem_square_1.statement := sorry

theorem lem_square_2 : lem_square_2.statement := sorry

theorem lem_sumsq_1 : lem_sumsq_1.statement := sorry

end Qpp.Means
