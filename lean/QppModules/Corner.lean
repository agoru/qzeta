s of the ray, on either side of its tie \(\kappa D=\nu_S\). For \(\delta<n\) the sign of \(G\) is read on three bounds: (chiz) \((-1)^n\chi(\Sigma\setminus Z)\ge\delta(D-1)^{n-2}\); (magn) and (magnone) \(D^2|\chi(\Sigma)|\le2\delta m|\chi(\Sigma\setminus Z)|\) for \(n\ge4\); (phi) for \(\kappa\ne\gamma\) the cost quotient \((k_0-\gamma^2)/(k_0-1)\) exceeds \(2\delta/D\) in size; and (chiodd) for \(\kappa=\gamma\) that sign is the sign of \(\chi(\Sigma)\), negative for odd \(n\) and \(\delta\ge3\). At \(\delta=1\) the counts \(k=\nu_S-N_S\) and \(M=N_S\) of the corner for \(s_S<-1\) keep \(4k+3M\le nM\), so that the exponents of the chain of (vii) are at least \(1\) (quarter). For \(\delta>n\) and \(\kappa<\gamma\) the sign of \(G\) is read at \(n=3\) (three), at \(n=4\) (four), for \(n\ge5\) on the bound \((X+1)^2(e^n+n\delta)<2\delta^3(\delta-n)X^{n-2}\) with \(X=D-1\ge2\delta+1\) and \(e=\delta-1\) (mup), and at \((n,\delta)=(5,6)\) (mupsix). -/
def thm_corner_core_ratio.statement : Prop :=
  ∀ (a b : ℚ) (x : ℕ), (0 < a) → (0 < b) → (1 ≤ x) → (b ≤ a) → a * b ^ x ≤ b * a ^ x

/-- [qpp:thm:corner] (core ratio) (generated) modules/corner/corner.qpp:725 -/
theorem thm_corner_core_ratio : thm_corner_core_ratio.statement := by
  intro a b x hp_a hp_b hp_x h_1
  induction x, hp_x using Nat.le_induction with
  | base =>
    (push_cast)
    all_goals
      have hw1 : a * b ^ 1 = b * a ^ 1 := by
        ring1
      linear_combination
  | succ x hp_x ih_x =>
    (push_cast)
    all_goals
      have hw2 : a * b ^ (x + (1 : ℕ)) = b * (a * b ^ x) := by
        ring1
      have hw3 : b * (a * b ^ x) ≤ b * (b * a ^ x) := by
        first | (exact (mul_le_mul_of_nonneg_left (by exact_mod_cast ih_x) hp_b.le)) 
      have hw4 : b * (b * a ^ x) ≤ a * (b * a ^ x) := by
        first | (exact (mul_le_mul_of_nonneg_right (by exact_mod_cast h_1) (mul_nonneg hp_b.le (pow_nonneg hp_a.le _)))) 
      have hw5 : a * (b * a ^ x) = b * a ^ (x + (1 : ℕ)) := by
        ring1
      exact (Trans.trans (Trans.trans (Trans.trans hw2 hw3) hw4) hw5)

