def thm_corner_bz.statement : Prop :=
  ∀ (c b x : ℕ), (1 ≤ c) → (1 ≤ b) → (1 ≤ x) → (c * (c + (2 : ℕ)) * b + (2 : ℕ) = (2 : ℕ) * (c + (1 : ℕ)) ^ 2 * x + c ^ 2) → (2 : ℕ) * x < b

