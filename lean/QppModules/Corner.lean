def thm_corner_split.statement : Prop :=
  ∀ (a b l m K : ℚ), (0 < a) → (0 < b) → (0 < l) → (0 < m) → (0 < K) → (K = a * l + b * m) → b / (l * K) + a / (K * m) = (1 : ℚ) / (l * m)

