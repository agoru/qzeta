theorem thm_corner_split : thm_corner_split.statement := by
  intro a b l m K hp_a hp_b hp_l hp_m hp_K h_1
  have hw1 : b / (l * K) + a / (K * m) = (1 : ℚ) / (l * m) := by
    have side_1 : (1 : ℚ) * K = a * l + b * m := by
      linear_combination h_1
    first | exact lem_cone_countsplit (1 : ℚ) b a l m K (by first | exact (by norm_num) ) (by first | exact hp_b ) (by first | exact hp_a ) (by first | exact hp_l ) (by first | exact hp_m ) (by first | exact hp_K ) side_1 
