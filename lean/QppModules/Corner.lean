def thm_corner_core_twice.statement : Prop :=
  ∀ (x : ℕ), (1 ≤ x) → (2 : ℕ) * x ≤ (2 : ℕ) ^ x

/-- [qpp:thm:corner] (core twice) (generated) modules/corner/corner.qpp:726 -/
theorem thm_corner_core_twice : thm_corner_core_twice.statement := by
  intro x hp_x
  induction x, hp_x using Nat.le_induction with
  | base =>
    (push_cast)
    all_goals
      have hw1 : (2 : ℕ) ^ 1 = (2 : ℕ) := by
        ring1
      exact_mod_cast (by linear_combination : (2 : ℚ) * (1 : ℚ) ≤ (2 : ℚ) ^ 1)
  | succ x hp_x ih_x =>
    (push_cast)
    all_goals
      have hw2 : (2 : ℕ) * x ≤ (2 : ℕ) ^ x := by
        first | (exact ih_x) 
      exact_mod_cast (by linear_combination mul_le_mul_of_nonneg_left (by exact_mod_cast hw2 : (2 : ℚ) * (x : ℚ) ≤ (2 : ℚ) ^ x) (by norm_num : (0 : ℚ) ≤ 2) + mul_le_mul_of_nonneg_left (by exact_mod_cast hp_x : (1 : ℚ) ≤ (x : ℚ)) (by norm_num : (0 : ℚ) ≤ 2) : (2 : ℚ) * ((x : ℚ) + (1 : ℚ)) ≤ (2 : ℚ) ^ (x + (1 : ℕ)))

