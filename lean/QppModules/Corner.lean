def thm_corner_core_ratio4.statement : Prop :=
  ∀ (a b : ℚ) (x : ℕ), (0 < a) → (0 < b) → (4 ≤ x) → (b ≤ a) → a ^ 4 * b ^ x ≤ b ^ 4 * a ^ x

/-- [qpp:thm:corner] (core ratio4) (generated) modules/corner/corner.qpp:732 -/
theorem thm_corner_core_ratio4 : thm_corner_core_ratio4.statement := by
  intro a b x hp_a hp_b hp_x h_1
  induction x, hp_x using Nat.le_induction with
  | base =>
    (push_cast)
    all_goals
      have hw1 : a ^ 4 * b ^ 4 = b ^ 4 * a ^ 4 := by
        ring1
      linear_combination
  | succ x hp_x ih_x =>
    (push_cast)
    all_goals
      have hw2 : a ^ 4 * b ^ (x + (1 : ℕ)) = b * (a ^ 4 * b ^ x) := by
        ring1
      have hw3 : b * (a ^ 4 * b ^ x) ≤ b * (b ^ 4 * a ^ x) := by
        first | (exact (mul_le_mul_of_nonneg_left (by exact_mod_cast ih_x) hp_b.le)) 
      have hw4 : b * (b ^ 4 * a ^ x) ≤ a * (b ^ 4 * a ^ x) := by
        first | (exact (mul_le_mul_of_nonneg_right (by exact_mod_cast h_1) (mul_nonneg (pow_nonneg hp_b.le _) (pow_nonneg hp_a.le _)))) 
      have hw5 : a * (b ^ 4 * a ^ x) = b ^ 4 * a ^ (x + (1 : ℕ)) := by
        ring1
