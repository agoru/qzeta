def thm_corner_qtie.statement : Prop :=
  ∀ (a c A B g h : ℚ), (0 < a) → (0 < c) → (0 < A) → (0 < B) → (0 < g) → (0 < h) → (a * c = A * B) → (A = a + g) → (A = c + h) → A + B = a + c + g * h / A

