def thm_corner_corner.statement : Prop :=
  ∀ (x y u w b : ℚ), (0 < x) → (0 < y) → (0 < u) → (0 < w) → (0 < b) → (x + u = (1 : ℚ)) → (y + w = (1 : ℚ)) → (x + y = (1 : ℚ) + b) → ((1 : ℚ) / x + (1 : ℚ) / y + ((1 : ℚ) + b) * u * w / (b * x * y) = (1 : ℚ) + (1 : ℚ) / b) ∧ (u + b = y) ∧ (w + b = x)

