def thm_corner_qone.statement : Prop :=
  ∀ (u v w m : ℚ), (0 < u) → (0 < v) → (0 < w) → (0 < m) → (m + (1 : ℚ) = ((1 : ℚ) + u) * ((1 : ℚ) + v) * ((1 : ℚ) + w)) → (m * (u * v * w + v * w + u * w + u * v) = u * v * w + (u + v + u * v) * (u + w + u * w) * (v + w + v * w)) ∧ (((1 : ℚ) + u) * v * w + m * u = (u + v + u * v) * (u + w + u * w))

