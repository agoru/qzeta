/-- the reading of a Chart: each part read -/
def Chart.toMath {n : Count0} (x : Chart n) : QppMathlib.Chart n.toNat :=
  ⟨(Idx.map Count0.toNat) x.lam, (fun g => fun u => (Idx.map Mass0.toNNRat) (g ((Idx.unmap Count0.ofNat) u))) x.F, Count0.toNat x.N⟩

/-- the Chart of a Mathlib reading: each part read back -/
def Chart.ofMath {n : Count0} (y : QppMathlib.Chart n.toNat) : Chart n :=
  ⟨(Idx.unmap Count0.ofNat) y.lam, (fun g => fun u => (Idx.unmap Mass0.ofNNRat) (g ((Idx.map Count0.toNat) u))) y.F, Count0.ofNat y.N⟩

@[qpp_bridge] theorem Chart.toMath_lam {n : Count0} (x : Chart n) : (Chart.toMath x).lam = (Idx.map Count0.toNat) x.lam := rfl
@[qpp_bridge] theorem Chart.ofMath_lam {n : Count0} (y : QppMathlib.Chart n.toNat) : (Chart.ofMath y).lam = (Idx.unmap Count0.ofNat) y.lam := rfl
@[qpp_bridge] theorem Chart.toMath_F {n : Count0} (x : Chart n) : (Chart.toMath x).F = (fun g => fun u => (Idx.map Mass0.toNNRat) (g ((Idx.unmap Count0.ofNat) u))) x.F := rfl
