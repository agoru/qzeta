@[qpp_bridge] theorem Chart.toMath_N {n : Count0} (x : Chart n) : (Chart.toMath x).N = Count0.toNat x.N := rfl
@[qpp_bridge] theorem Chart.ofMath_N {n : Count0} (y : QppMathlib.Chart n.toNat) : (Chart.ofMath y).N = Count0.ofNat y.N := rfl

@[qpp_bridge] theorem Chart.toMath_ofMath {n : Count0} (y : QppMathlib.Chart n.toNat) : Chart.toMath (Chart.ofMath y) = y := by
  cases y; simp only [Chart.toMath, Chart.ofMath, qpp_bridge, Mass0.toNNRat_ofNNRat]

theorem Chart.ofMath_toMath {n : Count0} (x : Chart n) : Chart.ofMath (Chart.toMath x) = x := by
  cases x; simp only [Chart.toMath, Chart.ofMath, qpp_bridge, Count0.ofNat_toNat, Mass0.ofNNRat_toNNRat]

@[qpp_bridge] theorem Chart.forall_iff {n : Count0} {P : Chart n → Prop} :
    (∀ x, P x) ↔ ∀ y : QppMathlib.Chart n.toNat, P (Chart.ofMath y) :=
  ⟨fun h _ => h _, fun h x => by rw [← Chart.ofMath_toMath x]; exact h _⟩

