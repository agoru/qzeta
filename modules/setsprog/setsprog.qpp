-- The pass on a family of clusters scales the units of each cluster in turn, from the point \(\mathbf 1\), to its
-- capacity (below), and prices that cover every unit once, with no positive price on a cluster or a unit that a later
-- cluster scales, tie the total of the last point (tie). When clusters that meet are nested such prices exist and are
-- read in at most \(k\) steps (cover), so the pass gives the point and the prices of \cref{lem:setbounds}(prices) at a
-- tie.
lemma lem:pass [the pass on a family of clusters]
  core switch: e in NN, a, b, z in QQ>=0, e <= 1, (e = 1 => z = a), (e = 0 => z = b) : z + e * b = b + e * a
  core switched: e in NN, a, z in QQ>=0, e <= 1, (e = 1 => z = a) : e * z = e * a
  core slack: b, x, c in QQ>=0, (0 < b => x = c) : b * x = b * c
  core switchedc: e, a, z in NN, e <= 1, (e = 1 => z = a) : e * z = e * a
  core pair: a, b in NN, a <= 1, b <= 1, a * b = 0 : a + b <= 1
  core off: e, f in NN, r in QQ>=0, e <= 1, f <= 1, (e = 1 => r = 1), (f = 1 => r < 1) : f * e = 0
  core down: n, k in NN, A_(1..k) in Exponent(n), r_(1..k) in QQ>=0, y_(0..k) in Point(n), (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall u in NN>=1 : u <= k => r_(u) <= 1), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i)), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 0 => y_(u + 1)_(i) = y_(u)_(i)) : forall u in NN : u + 1 <= k => forall i : y_(u + 1)_(i) <= y_(u)_(i)
  core own: n, k in NN, A_(1..k) in Exponent(n), r_(1..k) in QQ>=0, y_(0..k) in Point(n), (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i)) : forall u in NN : u + 1 <= k => (sum i, A_(u + 1)_(i) * y_(u + 1)_(i)) = r_(u + 1) * (sum i, A_(u + 1)_(i) * y_(u)_(i))
  core mono: n, k, u, v in NN, y_(0..k) in Point(n), (forall w in NN : w + 1 <= k => forall i : y_(w + 1)_(i) <= y_(w)_(i)) : u <= v => v <= k => forall i : y_(v)_(i) <= y_(u)_(i)
  core still: n, k, u, v in NN, A_(1..k) in Exponent(n), r_(1..k) in QQ>=0, y_(0..k) in Point(n), (forall w in NN>=1 : w <= k => forall i : A_(w)_(i) <= 1), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i)), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 0 => y_(u + 1)_(i) = y_(u)_(i)) : u <= v => v <= k => forall i : (forall w in NN : u < w => w <= v => A_(w)_(i) = 1 => r_(w) = 1) => y_(v)_(i) = y_(u)_(i)
  core read: n, k, u in NN, A_(1..k) in Exponent(n), r_(1..k), q_(1..k) in QQ>=0, y_(0..k) in Point(n), (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall u in NN : u + 1 <= k => q_(u + 1) = (sum i, A_(u + 1)_(i) * y_(u)_(i))), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i)) : 1 <= u => u <= k => (sum i, A_(u)_(i) * y_(u)_(i)) = r_(u) * q_(u)
  core priced: n, k, u in NN, A_(1..k) in Exponent(n), r_(1..k), q_(1..k) in QQ>=0, y_(0..k) in Point(n), (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall u in NN : u + 1 <= k => q_(u + 1) = (sum i, A_(u + 1)_(i) * y_(u)_(i))), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i)), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 0 => y_(u + 1)_(i) = y_(u)_(i)) : 1 <= u => u <= k => (forall v in NN : u < v => v <= k => 1 <= (sum i, A_(u)_(i) * A_(v)_(i)) => r_(v) = 1) => (sum i, A_(u)_(i) * y_(k)_(i)) = r_(u) * q_(u)
  core excl: k, m in NN, z_(1..k) in NN, (forall u in NN>=1 : u <= k => z_(u) <= 1), (forall u in NN>=1 : forall v in NN : u < v => v <= k => z_(u) = 1 => z_(v) = 0) : m <= k => (sum u in 1..m, z_(u)) <= 1
  core ascent: n, k, t in NN, A_(1..k) in Exponent(n), r_(1..k) in QQ>=0, theta_(1..k) in NN, (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall u in NN>=1 : forall v in NN : u < v => v <= k => 1 <= (sum l, A_(u)_(l) * A_(v)_(l)) => forall i : A_(u)_(i) <= A_(v)_(i)), (forall u in NN>=1 : u <= k => r_(u) < 1 => theta_(u) = 0 => exists v in NN : u < v, v <= k, 1 <= (sum l, A_(u)_(l) * A_(v)_(l)), r_(v) < 1) : forall i : forall u in NN>=1 : u <= k => k <= u + t => A_(u)_(i) = 1 => r_(u) < 1 => 1 <= (sum v in 1..k, theta_(v) * A_(v)_(i))
  (below): n, k in NN, A_(1..k) in Exponent(n), r_(1..k), q_(1..k) in QQ>=0, y_(0..k) in Point(n), (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall u in NN>=1 : u <= k => r_(u) <= 1), (forall i : y_(0)_(i) = 1), (forall u in NN : u + 1 <= k => q_(u + 1) = (sum i, A_(u + 1)_(i) * y_(u)_(i))), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i)), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 0 => y_(u + 1)_(i) = y_(u)_(i)) : (forall i : y_(k)_(i) <= 1), (forall u in NN>=1 : u <= k => (sum i, A_(u)_(i) * y_(k)_(i)) <= r_(u) * q_(u))
  fix (below) pass.below
  (tie): n, k in NN, A_(1..k) in Exponent(n), r_(1..k), q_(1..k), theta_(1..k) in QQ>=0, y_(0..k) in Point(n), beta in Point(n), (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall i : y_(0)_(i) = 1), (forall u in NN : u + 1 <= k => q_(u + 1) = (sum i, A_(u + 1)_(i) * y_(u)_(i))), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i)), (forall u in NN : u + 1 <= k => forall i : A_(u + 1)_(i) = 0 => y_(u + 1)_(i) = y_(u)_(i)), (forall u in NN>=1 : forall v in NN : u < v => v <= k => 0 < theta_(u) => 1 <= (sum i, A_(u)_(i) * A_(v)_(i)) => r_(v) = 1), (forall i : beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i)) = 1), (forall u in NN>=1 : u <= k => forall i : 0 < beta_(i) => A_(u)_(i) = 1 => r_(u) = 1) : (sum i, y_(k)_(i)) = (sum u in 1..k, theta_(u) * (r_(u) * q_(u))) + sum i, beta_(i)
  fix (tie) pass.tie
  (cover): n, k in NN, A_(1..k) in Exponent(n), r_(1..k) in QQ>=0, theta_(1..k) in NN, beta in Exponent(n), (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall u in NN>=1 : forall v in NN : u < v => v <= k => 1 <= (sum l, A_(u)_(l) * A_(v)_(l)) => forall i : A_(u)_(i) <= A_(v)_(i)), (forall u in NN>=1 : u <= k => theta_(u) <= 1), (forall i : beta_(i) <= 1), (forall u in NN>=1 : u <= k => theta_(u) = 1 => r_(u) < 1), (forall u in NN>=1 : forall v in NN : u < v => v <= k => theta_(u) = 1 => 1 <= (sum l, A_(u)_(l) * A_(v)_(l)) => r_(v) = 1), (forall u in NN>=1 : u <= k => r_(u) < 1 => theta_(u) = 0 => exists v in NN : u < v, v <= k, 1 <= (sum l, A_(u)_(l) * A_(v)_(l)), r_(v) < 1), (forall u in NN>=1 : u <= k => forall i : beta_(i) = 1 => A_(u)_(i) = 1 => r_(u) = 1), (forall i : beta_(i) = 0 => exists u in NN>=1 : u <= k, A_(u)_(i) = 1, r_(u) < 1) : forall i : beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i)) = 1
  fix (cover) pass.cover
  neqfix (cover) pass.nested
  origin: ?{\text{elementary, proved here: the pass of the scales over the clusters in their order, and complementary slackness at explicit prices}}

proof lem:pass
  "core switch" cases[e = 0; with[z = b by logic; V[1 * hw1, b * hc1 | a * hc1]]; with[e <= 1 by logic; with[e = 1 by V[1 * hw2], V[1 * hn1]; with[z = a by logic; V[1 * hw4, b * hw3 | a * hw3]]]]]
  "core switched" cases[e = 0; V[z * hc1 | a * hc1]; with[e <= 1 by logic; with[e = 1 by V[1 * hw1], V[1 * hn1]; with[z = a by logic; V[e * hw3]]]]]
  "core slack" cases[b <= 0; with[b = 0 by V[1 * hc1], V[0]; V[x * hw1 | c * hw1]]; with[x = c by logic; V[b * hw2]]]
  "core switchedc" cases[e = 0; V[z * hc1 | 1 * a * hc1]; with[e <= 1 by logic; with[e = 1 by V[1 * hw1], V[1 * hn1]; with[z = a by logic; V[e * hw3]]]]]
  "core pair" cases[a = 0; with[b <= 1 by logic; V[1 * hc1, 1 * hw1]]; with[a <= 1 by logic; with[a = 1 by V[1 * hw2], V[1 * hn1]; with[a * b = 0 by logic; V[(1 - b) * hw3, 1 * hw4]]]]]
  "core off" with[f * iverson(r < 1) = f * 1 by lem:pass(core switched)[e := f, a := 1, z := iverson(r < 1); f = 1 => iverson(r < 1) = 1 by logic[with[r < 1 by logic; V[0]]]]; with[e * iverson(r < 1) = e * 0 by lem:pass(core switched)[e := e, a := 0, z := iverson(r < 1); e = 1 => iverson(r < 1) = 0 by logic[with[r = 1 by logic; with[1 <= r by V[| 1 * hw4]; V[0]]]]]; V[f * hw3 | e * hw1]]]
  "core down" logic[with[r_(u + 1) <= 1 by logic; with[A_(u + 1)_(i) <= 1 by logic; with[y_(u + 1)_(i) + A_(u + 1)_(i) * y_(u)_(i) = y_(u)_(i) + A_(u + 1)_(i) * (r_(u + 1) * y_(u)_(i)) by lem:pass(core switch)[e := A_(u + 1)_(i), a := r_(u + 1) * y_(u)_(i), b := y_(u)_(i), z := y_(u + 1)_(i); A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i) by logic; A_(u + 1)_(i) = 0 => y_(u + 1)_(i) = y_(u)_(i) by logic]; with[A_(u + 1)_(i) * (r_(u + 1) * y_(u)_(i)) <= A_(u + 1)_(i) * (1 * y_(u)_(i)) by mono; V[1 * hw3, 1 * hw4]]]]]]
  "core own" logic[with[(sum i, A_(u + 1)_(i) * y_(u + 1)_(i)) = (sum i, r_(u + 1) * (A_(u + 1)_(i) * y_(u)_(i))) by sum[with[A_(u + 1)_(i) <= 1 by logic; with[A_(u + 1)_(i) * y_(u + 1)_(i) = A_(u + 1)_(i) * (r_(u + 1) * y_(u)_(i)) by lem:pass(core switched)[e := A_(u + 1)_(i), a := r_(u + 1) * y_(u)_(i), z := y_(u + 1)_(i); A_(u + 1)_(i) = 1 => y_(u + 1)_(i) = r_(u + 1) * y_(u)_(i) by logic]; V[1 * hw3]]]]; with[(sum i, r_(u + 1) * (A_(u + 1)_(i) * y_(u)_(i))) = r_(u + 1) * (sum i, A_(u + 1)_(i) * y_(u)_(i)) by sum; V[1 * hw1, 1 * hw4]]]]
  "core mono" ind[v; with[u = 0 by V[1 * hi1], V[0]; with[y_(u)_(i) = y_(0)_(i) by eq[hw1]; V[| 1 * hw2]]]; cases[u <= v; with[v <= k by V[1 * hi4]; with[y_(v)_(i) <= y_(u)_(i) by logic; with[y_(v + 1)_(i) <= y_(v)_(i) by logic; V[1 * hw4, 1 * hw5]]]]; with[u = v + 1 by V[1 * hi3], V[1 * hn1]; with[y_(u)_(i) = y_(v + 1)_(i) by eq[hw6]; V[| 1 * hw7]]]]]
  "core still" ind[v; with[u = 0 by V[1 * hi1], V[0]; with[y_(u)_(i) = y_(0)_(i) by eq[hw1]; V[| 1 * hw2]]]; cases[u <= v; with[forall w in NN : u < w => w <= v => A_(w)_(i) = 1 => r_(w) = 1 by logic[with[w <= v + 1 by V[1 * hi8]; logic]]; with[v <= k by V[1 * hi5]; with[y_(v)_(i) = y_(u)_(i) by logic; with[A_(v + 1)_(i) <= 1 by logic; with[u < v + 1 by V[1 * hc1]; with[v + 1 <= v + 1 by V[0]; with[y_(v + 1)_(i) + A_(v + 1)_(i) * y_(v)_(i) = y_(v)_(i) + A_(v + 1)_(i) * (r_(v + 1) * y_(v)_(i)) by lem:pass(core switch)[e := A_(v + 1)_(i), a := r_(v + 1) * y_(v)_(i), b := y_(v)_(i), z := y_(v + 1)_(i); A_(v + 1)_(i) = 1 => y_(v + 1)_(i) = r_(v + 1) * y_(v)_(i) by logic; A_(v + 1)_(i) = 0 => y_(v + 1)_(i) = y_(v)_(i) by logic]; with[A_(v + 1)_(i) * r_(v + 1) = A_(v + 1)_(i) * 1 by lem:pass(core switched)[e := A_(v + 1)_(i), a := 1, z := r_(v + 1); A_(v + 1)_(i) = 1 => r_(v + 1) = 1 by logic]; V[1 * hw10, y_(v)_(i) * hw11, 1 * hw6]]]]]]]]]; with[u = v + 1 by V[1 * hi4], V[1 * hn1]; with[y_(u)_(i) = y_(v + 1)_(i) by eq[hw12]; V[| 1 * hw13]]]]]
  "core read" with[forall w in NN : w + 1 <= k => (sum i, A_(w + 1)_(i) * y_(w + 1)_(i)) = r_(w + 1) * (sum i, A_(w + 1)_(i) * y_(w)_(i)) by lem:pass(core own)[n := n, k := k, A := A, r := r, y := y]; with[exists w in NN : u = w + 1 by take[w := max(u - 1, 0); V[0]]; logic[with[u = w + 1 by logic; with[w + 1 <= k by V[1 * hi2 | 1 * hw3]; with[(sum i, A_(w + 1)_(i) * y_(w + 1)_(i)) = r_(w + 1) * (sum i, A_(w + 1)_(i) * y_(w)_(i)) by logic; with[q_(w + 1) = (sum i, A_(w + 1)_(i) * y_(w)_(i)) by logic; with[(sum i, A_(u)_(i) * y_(u)_(i)) = (sum i, A_(w + 1)_(i) * y_(w + 1)_(i)) by eq[hw3]; with[r_(u) * q_(u) = r_(w + 1) * q_(w + 1) by eq[hw3]; V[1 * hw7, 1 * hw5 | 1 * r_(w + 1) * hw6, 1 * hw8]]]]]]]]]]
  "core priced" with[(sum i, A_(u)_(i) * y_(k)_(i)) = (sum i, A_(u)_(i) * y_(u)_(i)) by sum[with[A_(u)_(i) <= 1 by logic; with[A_(u)_(i) * y_(k)_(i) = A_(u)_(i) * y_(u)_(i) by lem:pass(core switched)[e := A_(u)_(i), a := y_(u)_(i), z := y_(k)_(i); A_(u)_(i) = 1 => y_(k)_(i) = y_(u)_(i) by logic[with[forall w in NN : u < w => w <= k => A_(w)_(i) = 1 => r_(w) = 1 by logic[with[1 <= A_(u)_(i) by V[| 1 * hi4]; with[1 <= A_(w)_(i) by V[| 1 * hi7]; with[1 * 1 <= A_(u)_(i) * A_(w)_(i) by mono; with[A_(u)_(i) * A_(w)_(i) <= (sum l, A_(u)_(l) * A_(w)_(l)) by term[i]; with[1 <= (sum l, A_(u)_(l) * A_(w)_(l)) by V[1 * hw7, 1 * hw8]; logic]]]]]]; with[u <= k => k <= k => forall i : (forall w in NN : u < w => w <= k => A_(w)_(i) = 1 => r_(w) = 1) => y_(k)_(i) = y_(u)_(i) by lem:pass(core still)[n := n, k := k, u := u, v := k, A := A, r := r, y := y]; with[k <= k by V[0]; logic]]]]]; V[1 * hw3]]]]; with[1 <= u => u <= k => (sum i, A_(u)_(i) * y_(u)_(i)) = r_(u) * q_(u) by lem:pass(core read)[n := n, k := k, u := u, A := A, r := r, q := q, y := y]; with[(sum i, A_(u)_(i) * y_(u)_(i)) = r_(u) * q_(u) by logic; V[1 * hw1, 1 * hw13]]]]
  "core excl" ind[m; V; with[m <= k by V[1 * hi2]; with[(sum u in 1..m, z_(u)) <= 1 by logic; with[(sum u in 1..m + 1, z_(u)) = (sum u in 1..m, z_(u)) + z_(m + 1) by sum; with[z_(m + 1) <= 1 by logic; with[(sum u in 1..m, z_(u) * z_(m + 1)) = 0 by sum[with[u <= k by V; with[u < m + 1 by V; with[z_(u) <= 1 by logic; with[z_(u) * z_(m + 1) = z_(u) * 0 by lem:pass(core switchedc)[e := z_(u), a := 0, z := z_(m + 1); z_(u) = 1 => z_(m + 1) = 0 by logic]; V[1 * hw9]]]]]]; with[(sum u in 1..m, z_(u)) * z_(m + 1) = (sum u in 1..m, z_(u) * z_(m + 1)) by sum; with[(sum u in 1..m, z_(u)) * z_(m + 1) = 0 by V[1 * hw10, 1 * hw5]; with[(sum u in 1..m, z_(u)) + z_(m + 1) <= 1 by lem:pass(core pair)[a := (sum u in 1..m, z_(u)), b := z_(m + 1)]; V[1 * hw3, 1 * hw12]]]]]]]]]]
  "core ascent" ind[t; cases[theta_(u) = 0; logic[with[u < v by logic; with[v <= k by logic; with[u + 1 <= v by V; with[0 <= (sum v in 1..k, theta_(v) * A_(v)_(i)) by sum[V]; V[1 * hw3, 1 * hw2, 1 * hi3, 1 * hw4]]]]]]; with[1 <= A_(u)_(i) by V[| 1 * hi4]; with[1 * 1 <= theta_(u) * A_(u)_(i) by mono; with[theta_(u) * A_(u)_(i) <= (sum v in 1..k, theta_(v) * A_(v)_(i)) by term[u]; V[1 * hw6, 1 * hw7]]]]]; cases[theta_(u) = 0; logic[with[u < v by logic; with[v <= k by logic; with[r_(v) < 1 by logic; with[A_(u)_(i) <= A_(v)_(i) by logic; with[A_(v)_(i) <= 1 by logic; with[A_(v)_(i) = 1 by V[1 * hw12], V[1 * hw11 | 1 * hi9]; with[u + 1 <= v by V; with[k <= v + t by V[1 * hi8, 1 * hw14]; logic]]]]]]]]]; with[1 <= A_(u)_(i) by V[| 1 * hi9]; with[1 * 1 <= theta_(u) * A_(u)_(i) by mono; with[theta_(u) * A_(u)_(i) <= (sum v in 1..k, theta_(v) * A_(v)_(i)) by term[u]; V[1 * hw17, 1 * hw18]]]]]]
  (below) with[forall u in NN : u + 1 <= k => forall i : y_(u + 1)_(i) <= y_(u)_(i) by lem:pass(core down)[n := n, k := k, A := A, r := r, y := y]; (with[0 <= k => k <= k => forall i : y_(k)_(i) <= y_(0)_(i) by lem:pass(core mono)[n := n, k := k, u := 0, v := k, y := y]; with[0 <= k by V[0]; with[k <= k by V[0]; with[y_(k)_(i) <= y_(0)_(i) by logic; with[y_(0)_(i) = 1 by logic; V[1 * hw5, 1 * hw6]]]]]], with[1 <= u => u <= k => (sum i, A_(u)_(i) * y_(u)_(i)) = r_(u) * q_(u) by lem:pass(core read)[n := n, k := k, u := u, A := A, r := r, q := q, y := y]; with[u <= k => k <= k => forall i : y_(k)_(i) <= y_(u)_(i) by lem:pass(core mono)[n := n, k := k, u := u, v := k, y := y]; with[k <= k by V[0]; with[(sum i, A_(u)_(i) * y_(u)_(i)) = r_(u) * q_(u) by logic; with[(sum i, A_(u)_(i) * y_(k)_(i)) <= (sum i, A_(u)_(i) * y_(u)_(i)) by sum[with[y_(k)_(i) <= y_(u)_(i) by logic; mono]]; V[1 * hw11, 1 * hw10]]]]]])]
  (tie) with[(sum i, y_(k)_(i)) = (sum i, (beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i))) * y_(k)_(i)) by sum[with[beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i)) = 1 by logic; V[| 1 * y_(k)_(i) * hw2]]]; with[(sum i, (beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i))) * y_(k)_(i)) = (sum i, beta_(i) * y_(k)_(i)) + (sum i, (sum u in 1..k, theta_(u) * A_(u)_(i)) * y_(k)_(i)) by sum[V[0]]; with[(sum i, (sum u in 1..k, theta_(u) * A_(u)_(i)) * y_(k)_(i)) = (sum i, (sum u in 1..k, theta_(u) * (A_(u)_(i) * y_(k)_(i)))) by sum[sum[V[0]]]; with[(sum i, (sum u in 1..k, theta_(u) * (A_(u)_(i) * y_(k)_(i)))) = (sum u in 1..k, (sum i, theta_(u) * (A_(u)_(i) * y_(k)_(i)))) by sum[V]; with[(sum u in 1..k, (sum i, theta_(u) * (A_(u)_(i) * y_(k)_(i)))) = (sum u in 1..k, theta_(u) * (sum i, A_(u)_(i) * y_(k)_(i))) by sum[sum]; with[0 <= k => k <= k => forall i : (forall w in NN : 0 < w => w <= k => A_(w)_(i) = 1 => r_(w) = 1) => y_(k)_(i) = y_(0)_(i) by lem:pass(core still)[n := n, k := k, u := 0, v := k, A := A, r := r, y := y]; with[0 <= k by V[0]; with[k <= k by V[0]; with[(sum i, beta_(i) * y_(k)_(i)) = (sum i, beta_(i)) by sum[with[beta_(i) * y_(k)_(i) = beta_(i) * 1 by lem:pass(core slack)[b := beta_(i), x := y_(k)_(i), c := 1; 0 < beta_(i) => y_(k)_(i) = 1 by logic[with[forall w in NN : 0 < w => w <= k => A_(w)_(i) = 1 => r_(w) = 1 by logic[with[1 <= w by V[1 * hi2]; logic]]; with[y_(k)_(i) = y_(0)_(i) by logic; with[y_(0)_(i) = 1 by logic; V[1 * hw14, 1 * hw15]]]]]]; V[1 * hw11]]]; with[(sum u in 1..k, theta_(u) * (sum i, A_(u)_(i) * y_(k)_(i))) = (sum u in 1..k, theta_(u) * (r_(u) * q_(u))) by sum[with[1 <= u by V; with[u <= k by V; with[theta_(u) * (sum i, A_(u)_(i) * y_(k)_(i)) = theta_(u) * (r_(u) * q_(u)) by lem:pass(core slack)[b := theta_(u), x := (sum i, A_(u)_(i) * y_(k)_(i)), c := r_(u) * q_(u); 0 < theta_(u) => (sum i, A_(u)_(i) * y_(k)_(i)) = r_(u) * q_(u) by logic[with[forall v in NN : u < v => v <= k => 1 <= (sum i, A_(u)_(i) * A_(v)_(i)) => r_(v) = 1 by logic; with[1 <= u => u <= k => (forall v in NN : u < v => v <= k => 1 <= (sum i, A_(u)_(i) * A_(v)_(i)) => r_(v) = 1) => (sum i, A_(u)_(i) * y_(k)_(i)) = r_(u) * q_(u) by lem:pass(core priced)[n := n, k := k, u := u, A := A, r := r, q := q, y := y]; logic]]]]; V[1 * hw19]]]]]; V[1 * hw1, 1 * hw3, 1 * hw4, 1 * hw5, 1 * hw6, 1 * hw10, 1 * hw16]]]]]]]]]]]
  (cover) with[k <= k => (sum u in 1..k, theta_(u) * A_(u)_(i)) <= 1 by lem:pass(core excl)[k := k, m := k, z_(u) := theta_(u) * A_(u)_(i); forall u in NN>=1 : u <= k => theta_(u) * A_(u)_(i) <= 1 by logic[with[theta_(u) <= 1 by logic; with[A_(u)_(i) <= 1 by logic; with[theta_(u) * A_(u)_(i) <= 1 * 1 by mono; V[1 * hw4]]]]]; forall u in NN>=1 : forall v in NN : u < v => v <= k => theta_(u) * A_(u)_(i) = 1 => theta_(v) * A_(v)_(i) = 0 by logic[with[u <= k by V; with[theta_(u) <= 1 by logic; with[A_(u)_(i) <= 1 by logic; with[theta_(u) * A_(u)_(i) <= theta_(u) * 1 by mono; with[theta_(u) * A_(u)_(i) <= 1 * A_(u)_(i) by mono; with[1 <= theta_(u) by V[1 * hw8 | 1 * hi6]; with[1 <= A_(u)_(i) by V[1 * hw9 | 1 * hi6]; with[A_(v)_(i) <= 1 by logic; with[theta_(v) <= 1 by logic; with[theta_(v) * A_(v)_(i) = 0 by lem:pass(core off)[e := A_(v)_(i), f := theta_(v), r := r_(v); A_(v)_(i) = 1 => r_(v) = 1 by logic[with[1 <= A_(v)_(i) by V[| 1 * hi7]; with[1 * 1 <= A_(u)_(i) * A_(v)_(i) by mono; with[A_(u)_(i) * A_(v)_(i) <= (sum l, A_(u)_(l) * A_(v)_(l)) by term[i]; with[1 <= (sum l, A_(u)_(l) * A_(v)_(l)) by V[1 * hw16, 1 * hw17]; with[theta_(u) = 1 by V[1 * hw6], V[1 * hw10]; logic]]]]]]; theta_(v) = 1 => r_(v) < 1 by logic]; V[1 * hw14]]]]]]]]]]]]]; with[(sum u in 1..k, theta_(u) * A_(u)_(i)) <= 1 by logic[with[k <= k by V; logic]]; with[forall i : forall u in NN>=1 : u <= k => k <= u + k => A_(u)_(i) = 1 => r_(u) < 1 => 1 <= (sum v in 1..k, theta_(v) * A_(v)_(i)) by lem:pass(core ascent)[n := n, k := k, t := k, A := A, r := r, theta := theta]; cases[beta_(i) = 0; logic[with[k <= u + k by V; with[1 <= (sum v in 1..k, theta_(v) * A_(v)_(i)) by logic; V[1 * hc1, 1 * hw20], V[1 * hw24 | 1 * hc1]]]]; with[beta_(i) <= 1 by logic; with[beta_(i) = 1 by V[1 * hw25], V[1 * hn1]; with[(sum u in 1..k, theta_(u) * A_(u)_(i)) = 0 by sum[with[1 <= u by V; with[u <= k by V; with[A_(u)_(i) <= 1 by logic; with[theta_(u) <= 1 by logic; with[theta_(u) * A_(u)_(i) = 0 by lem:pass(core off)[e := A_(u)_(i), f := theta_(u), r := r_(u); A_(u)_(i) = 1 => r_(u) = 1 by logic; theta_(u) = 1 => r_(u) < 1 by logic]; V[1 * hw32]]]]]]]; V[1 * hw26, 1 * hw27]]]]]]]]

-- Pair staircases read only the couplings: with the staircase \(a_u\binom r2\) on each cluster, twice the action of a
-- set and its diagonal sum the couplings \(K_{il}=\sum_ua_ud_uA_{ui}A_{ul}\) over the ordered pairs of units, by
-- \(2\binom c2+c=c^2\) (\cref{fact:pascal}).
lemma lem:couplings [pair staircases read the couplings]
  core pairs: c in NN : 2 * binom(c, 2) + c = c^2
  (action): n, k in NN, A_(1..k) in Exponent(n), a_(1..k), d_(1..k) in QQ>=0, J in Exponent(n) : 2 * (sum u in 1..k, d_(u) * a_(u) * binom(sum i, A_(u)_(i) * J_(i), 2)) + (sum i, J_(i) * (sum u in 1..k, a_(u) * d_(u) * A_(u)_(i))) = (sum i, sum l, J_(i) * J_(l) * (sum u in 1..k, a_(u) * d_(u) * A_(u)_(i) * A_(u)_(l)))
  fix (action) couplings.action
  origin: ?{\text{elementary, proved here: the identity \(2\binom c2+c=c^2\) at each cluster, from \cref{fact:pascal}, and the sums exchanged}}

proof lem:couplings
  "core pairs" ind[c; V; with[2 * binom(c, 2) + c = c^2 by logic; with[binom(c + 1, 2) = binom(c, 1) + binom(c, 2) by fact:pascal(1)[n := c, k := 1]; with[binom(c, 1) = c by V; V[2 * hw2, 2 * hw3, 1 * hw1]]]]]
  (action) with[2 * (sum u in 1..k, d_(u) * a_(u) * binom(sum i, A_(u)_(i) * J_(i), 2)) + (sum u in 1..k, d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i))) = (sum u in 1..k, d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i))^2) by with[2 * (sum u in 1..k, d_(u) * a_(u) * binom(sum i, A_(u)_(i) * J_(i), 2)) = (sum u in 1..k, 2 * (d_(u) * a_(u) * binom(sum i, A_(u)_(i) * J_(i), 2))) by sum; with[(sum u in 1..k, 2 * (d_(u) * a_(u) * binom(sum i, A_(u)_(i) * J_(i), 2))) + (sum u in 1..k, d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i))) = (sum u in 1..k, (2 * (d_(u) * a_(u) * binom(sum i, A_(u)_(i) * J_(i), 2)) + d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i)))) by sum; with[(sum u in 1..k, (2 * (d_(u) * a_(u) * binom(sum i, A_(u)_(i) * J_(i), 2)) + d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i)))) = (sum u in 1..k, d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i))^2) by sum[with[2 * binom(sum i, A_(u)_(i) * J_(i), 2) + (sum i, A_(u)_(i) * J_(i)) = (sum i, A_(u)_(i) * J_(i))^2 by lem:couplings(core pairs)[c := (sum i, A_(u)_(i) * J_(i))]; V[(d_(u) * a_(u)) * hw5]]]; V[1 * hw2, 1 * hw3, 1 * hw4]]]]; with[(sum u in 1..k, d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i))) = (sum i, J_(i) * (sum u in 1..k, a_(u) * d_(u) * A_(u)_(i))) by with[(sum u in 1..k, d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i))) = (sum u in 1..k, (sum i, d_(u) * a_(u) * (A_(u)_(i) * J_(i)))) by sum[sum]; with[(sum u in 1..k, (sum i, d_(u) * a_(u) * (A_(u)_(i) * J_(i)))) = (sum i, (sum u in 1..k, d_(u) * a_(u) * (A_(u)_(i) * J_(i)))) by sum[V]; with[(sum i, (sum u in 1..k, d_(u) * a_(u) * (A_(u)_(i) * J_(i)))) = (sum i, J_(i) * (sum u in 1..k, a_(u) * d_(u) * A_(u)_(i))) by sum[sum]; V[1 * hw7, 1 * hw8, 1 * hw9]]]]; with[(sum u in 1..k, d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i))^2) = (sum i, sum l, J_(i) * J_(l) * (sum u in 1..k, a_(u) * d_(u) * A_(u)_(i) * A_(u)_(l))) by with[(sum u in 1..k, d_(u) * a_(u) * (sum i, A_(u)_(i) * J_(i))^2) = (sum u in 1..k, (sum l, (sum i, d_(u) * a_(u) * ((A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))))) by sum[with[(sum i, A_(u)_(i) * J_(i))^2 = (sum i, A_(u)_(i) * J_(i)) * (sum l, A_(u)_(l) * J_(l)) by eq; with[(sum i, A_(u)_(i) * J_(i)) * (sum l, A_(u)_(l) * J_(l)) = (sum l, (sum i, (A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))) by sum[sum[V]]; with[(sum i, A_(u)_(i) * J_(i))^2 = (sum l, (sum i, (A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))) by V[1 * hw12, 1 * hw13]; with[d_(u) * a_(u) * (sum l, (sum i, (A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))) = (sum l, (sum i, d_(u) * a_(u) * ((A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l))))) by sum[sum[V]]; V[(d_(u) * a_(u)) * hw14, 1 * hw15]]]]]]; with[(sum u in 1..k, (sum l, (sum i, d_(u) * a_(u) * ((A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))))) = (sum l, (sum u in 1..k, (sum i, d_(u) * a_(u) * ((A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))))) by sum[V]; with[(sum l, (sum u in 1..k, (sum i, d_(u) * a_(u) * ((A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))))) = (sum l, (sum i, (sum u in 1..k, d_(u) * a_(u) * ((A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))))) by sum[sum[V]]; with[(sum l, (sum i, (sum u in 1..k, d_(u) * a_(u) * ((A_(u)_(i) * J_(i)) * (A_(u)_(l) * J_(l)))))) = (sum l, (sum i, J_(i) * J_(l) * (sum u in 1..k, a_(u) * d_(u) * A_(u)_(i) * A_(u)_(l)))) by sum[sum[sum]]; with[(sum i, sum l, J_(i) * J_(l) * (sum u in 1..k, a_(u) * d_(u) * A_(u)_(i) * A_(u)_(l))) = (sum l, (sum i, J_(i) * J_(l) * (sum u in 1..k, a_(u) * d_(u) * A_(u)_(i) * A_(u)_(l)))) by sum[V]; V[1 * hw11, 1 * hw16, 1 * hw17, 1 * hw18 | 1 * hw19]]]]]]; V[1 * hw1, 1 * hw6, 1 * hw10]]]]

-- Systematic sampling by phases: units of weights at most \(b\) are laid end to end, and the phase \(j\le b\) selects a
-- unit as often as a point \(j+bq\) falls in its range. Every phase selects every unit at most once and \(g\) or
-- \(g+1\) units of a run of total weight \(bg+h\), and the phases together select the total; the quotients and
-- remainders are data with their ties, so that no proof divides.
lemma lem:phases [the phases of a walk by division with remainder]
  core cancel: b, x, y in NN, b * x < b * (y + 1) : x <= y
  core quot: b, x, y, r, s in NN, r < b, s < b, b * x + r = b * y + s : x = y
  core mark: j, x, y in NN, x <= y : iverson(j <= x) <= iverson(j <= y)
  core marks: b, R in NN : (sum j in 1..b, iverson(j <= R)) = min(R, b)
  core unit: b, j, Q, R, Q2, R2, w in NN, x in QQ>=0, w <= b, R < b, R2 < b, b * Q + R + w = b * Q2 + R2, x + Q + iverson(j <= R) = Q2 + iverson(j <= R2) : x <= 1
  core endslo: b, j, g, h, Qa, Ra, Qe, Re, W in NN, S in QQ>=0, h < b, Ra < b, Re < b, W + b * Qa + Ra = b * Qe + Re, W = b * g + h, S + Qa + iverson(j <= Ra) = Qe + iverson(j <= Re) : g <= S
  core endshi: b, j, g, h, Qa, Ra, Qe, Re, W in NN, S in QQ>=0, h < b, Ra < b, Re < b, W + b * Qa + Ra = b * Qe + Re, W = b * g + h, S + Qa + iverson(j <= Ra) = Qe + iverson(j <= Re) : S <= g + 1
  core walk: n, b, a, e in NN, w_(1..n), Q_(1..n), R_(1..n), Q2_(1..n), R2_(1..n) in NN, 1 <= a, (forall i in NN>=1 : i <= n => b * Q_(i) + R_(i) + w_(i) = b * Q2_(i) + R2_(i)), (forall i in NN>=1 : i + 1 <= n => Q_(i + 1) = Q2_(i)), (forall i in NN>=1 : i + 1 <= n => R_(i + 1) = R2_(i)) : a <= e => e <= n => (sum i in a..e, w_(i)) + b * Q_(a) + R_(a) = b * Q2_(e) + R2_(e)
  core tele: n, a, e, j in NN, Q_(1..n), R_(1..n), Q2_(1..n), R2_(1..n) in NN, L in Line, 1 <= a, (forall i in NN>=1 : i + 1 <= n => Q_(i + 1) = Q2_(i)), (forall i in NN>=1 : i + 1 <= n => R_(i + 1) = R2_(i)), (forall i in NN>=1 : i <= n => L(i) + Q_(i) + iverson(j <= R_(i)) = Q2_(i) + iverson(j <= R2_(i))) : a <= e => e <= n => (sum i in a..e, L(i)) + Q_(a) + iverson(j <= R_(a)) = Q2_(e) + iverson(j <= R2_(e))
  core sums: b, K, a, e, c, d, r, s in NN, J_(1..b) in Line, (forall j in NN>=1 : j <= b => (sum i in a..e, J_(j)(i)) + c + iverson(j <= r) = d + iverson(j <= s)) : K <= b => (sum j in 1..K, sum i in a..e, J_(j)(i)) + K * c + (sum j in 1..K, iverson(j <= r)) = K * d + (sum j in 1..K, iverson(j <= s))
  (phases): n, b, g, h, a, e in NN, w_(1..n), Q_(1..n), R_(1..n), Q2_(1..n), R2_(1..n) in NN, J_(1..b) in Line, 1 <= a, a <= e, e <= n, (forall i in NN>=1 : i <= n => w_(i) <= b), (forall i in NN>=1 : i <= n => b * Q_(i) + R_(i) + w_(i) = b * Q2_(i) + R2_(i)), (forall i in NN>=1 : i <= n => R_(i) < b), (forall i in NN>=1 : i <= n => R2_(i) < b), (forall i in NN>=1 : i + 1 <= n => Q_(i + 1) = Q2_(i)), (forall i in NN>=1 : i + 1 <= n => R_(i + 1) = R2_(i)), (forall j in NN>=1 : j <= b => forall i in NN>=1 : i <= n => J_(j)(i) + Q_(i) + iverson(j <= R_(i)) = Q2_(i) + iverson(j <= R2_(i))), (sum i in a..e, w_(i)) = b * g + h, h < b : (forall j in NN>=1 : j <= b => forall i in NN>=1 : i <= n => J_(j)(i) <= 1), (forall j in NN>=1 : j <= b => g <= (sum i in a..e, J_(j)(i))), (forall j in NN>=1 : j <= b => (sum i in a..e, J_(j)(i)) <= g + 1), (sum j in 1..b, sum i in a..e, J_(j)(i)) = sum i in a..e, w_(i)
  fix (phases) phases.sets
  neqfix (phases) phases.remainder
  origin: ?{\text{the rule is systematic sampling \cite[Section~5]{Madow1949}; the count on an interval is stated for a continuous start in \cite[pp.~4--5]{AvramidisDeBergSchmidtKraepelin2026}; proved here on the counts, by division with remainder given as data, its uniqueness by two orders}}

-- Each unit by (unit), since a weight at most \(b\) holds at most one point of each phase; the counts on a run by
-- telescoping the ties, with the carry of the division as the two cases; the total by (sums) and (marks).
proof lem:phases
  "core cancel" cases[y + 1 <= x; with[b * (y + 1) <= b * x by mono; logic]; V]
  "core quot" with[x <= y by lem:phases(core cancel)[b := b, x := x, y := y; b * x < b * (y + 1) by V[1 * h_3, 1 * h_2]]; with[y <= x by lem:phases(core cancel)[b := b, x := y, y := x; b * y < b * (x + 1) by V[1 * h_1 | 1 * h_3]]; V[1 * hw1], V[1 * hw2]]]
  "core mark" cases[j <= x; with[j <= y by V; V[0]]; V[0]]
  "core marks" ind[b; with[0 <= R by V; V]; with[(sum j in 1..b + 1, iverson(j <= R)) = (sum j in 1..b, iverson(j <= R)) + iverson(b + 1 <= R) by sum; with[(sum j in 1..b, iverson(j <= R)) = min(R, b) by logic; cases[b + 1 <= R; with[b <= R by V; V[1 * hw2, 1 * hw3]]; with[R <= b by V; with[R <= b + 1 by V; V[1 * hw2, 1 * hw3]]]]]]]
  "core unit" cases[R + w < b; with[Q = Q2 by lem:phases(core quot)[b := b, x := Q, y := Q2, r := R + w, s := R2; R + w < b by V[1 * hc1]; R2 < b by V[1 * h_4]; b * Q + (R + w) = b * Q2 + R2 by V[1 * h_5]]; with[iverson(j <= R2) <= 1 by V; V[1 * h_6, 1 * hw2 | 1 * hw1]]]; with[exists t in NN : R + w = b + t by take[t := max(R + w - b, 0); V[0]]; logic[with[R + w = b + t by logic; with[Q + 1 = Q2 by lem:phases(core quot)[b := b, x := Q + 1, y := Q2, r := t, s := R2; t < b by V[1 * h_3, 1 * h_2 | 1 * hw4]; R2 < b by V[1 * h_4]; b * (Q + 1) + t = b * Q2 + R2 by V[1 * h_5 | 1 * hw4]]; with[R2 <= R by V[b * hw5, 1 * h_2 | 1 * h_5]; with[iverson(j <= R2) <= iverson(j <= R) by lem:phases(core mark)[j := j, x := R2, y := R]; V[1 * h_6, 1 * hw7 | 1 * hw5]]]]]]]]
