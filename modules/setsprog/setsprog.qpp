-- Q++ 0.2
module setsprog
uses sidesrows

subsection sec:setsprog The program of sets

  -- Clusters of units carry staircases on their counts: a list of sets of units bounds the cost from below, prices on
  -- the clusters and the units bound it from above (\cref{lem:setbounds}), and where they meet every set and every
  -- priced cluster ties (\cref{lem:settie}). A list with a given rational mean whose sets round each cluster count to
  -- its floor or ceiling exists exactly when the table of the clusters is totally unimodular
  -- (\cref{fact:hoffmankruskal}, \cref{fact:ghouilahouri}); the rows take the list and the prices as data either way.

-- The theorem of Hoffman and Kruskal. For a table \(A\) with entries \(0,1,-1\) that is totally unimodular and a whole
-- vector \(b\), the polyhedron \(\{x:\ Ax\le b\}\) is integral, the convex hull of its whole points; the tables \(-A\),
-- \((A,\mathrm{Id})\) and \(A^{\mathsf T}\) are then totally unimodular too \cite[p.~11]{Kaibel2011}.
cit fact:hoffmankruskal [the theorem of Hoffman and Kruskal]
  doi: 10.1002/9780470400531.eorms0091
  stmt: Theorem 27, p. 11, of arXiv:1001.2161v1
  origin: ?{\text{cited: \cite[Theorem~27]{Kaibel2011}, read in its arXiv version 1001.2161v1, which attributes it to Hoffman and Kruskal (1956); the source states it over the reals, and here it is read at points with rational coordinates, which are means of whole points with rational weights}}

-- The criterion of Ghouila-Houri. A table with entries \(0,1,-1\) is totally unimodular if and only if, for each of
-- its submatrices, the columns split into two classes whose sums differ by at most one on every row.
cit fact:ghouilahouri [the criterion of Ghouila-Houri]
  doi: 10.1016/j.disopt.2026.100938
  stmt: Theorem 1.1, p. 4, of arXiv:2410.21468v1
  origin: ?{\text{cited: \cite[Theorem~1.1]{BiroKezdyLehel2026}, read in its arXiv version 2410.21468v1, which attributes it to Ghouila-Houri (1962)}}

-- Units with weights, clusters with a table \(A\), convex staircases on the counts and budgets: the action of a set of
-- units is the staircase cost of its counts on the clusters. A list of sets that meets the budgets in the mean bounds
-- from below the cost of every pair of sizes feasible at its sets, by \cref{lem:count}(weak) (list), and prices on the
-- clusters and the units that cover the weights bound the weight of every set by its action (prices), weak duality with
-- the line of each cluster in place of its bound.
lemma lem:setbounds [the two bounds of the program of sets]
  core spend: n, k, b in NN, A_(1..k) in Exponent(n), S_(1..k) in Line, B_(1..k), d_(1..k) in QQ>=0, Z in QQ>=0, J in IntForms(b, n), (forall u in NN>=1 : u <= k => (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= b * B_(u)) : (sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) <= b * ((sum u in 1..k, B_(u) * d_(u)) + Z)
  (list): n, k, b in NN, A_(1..k) in Exponent(n), S_(1..k) in Line, B_(1..k), d_(1..k) in QQ>=0, Z in QQ>=0, p in Point(n), J in IntForms(b, n), (forall u in NN>=1 : u <= k => (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= b * B_(u)), (forall j : Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) >= sum i, p_(i) * J_(j)_(i)) : b * ((sum u in 1..k, B_(u) * d_(u)) + Z) >= sum j, sum i, p_(i) * J_(j)_(i)
  fix (list) setbounds.list
  neqfix (list) setbounds.list.budget
  (prices): n, k in NN, A_(1..k) in Exponent(n), S_(1..k) in Line, B_(1..k), d_(1..k), theta_(1..k), kappa_(1..k) in QQ>=0, p, beta in Point(n), (forall u in NN>=1 : u <= k => forall r in NN : r <= (sum i, A_(u)_(i)) => d_(u) * S_(u)(r) + theta_(u) * kappa_(u) >= d_(u) * B_(u) + theta_(u) * r), (forall i : beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i)) >= p_(i)) : forall J in Exponent(n) : (forall i : J_(i) <= 1) => (sum i, p_(i) * J_(i)) + (sum u in 1..k, B_(u) * d_(u)) <= (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(i))) + (sum u in 1..k, theta_(u) * kappa_(u)) + sum i, beta_(i)
  fix (prices) setbounds.prices
  neqfix (prices) setbounds.prices.cover
  origin: ?{\text{elementary, proved here: weak duality of linear programming, as in \cref{lem:count}(weak), at a list of sets and at prices on units}}

proof lem:setbounds
  "core spend" with[(sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) = (sum j, Z) + (sum j, (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) by sum; with[(sum j, Z) = b * Z by sum; with[(sum j, (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) = (sum u in 1..k, (sum j, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) by sum[V]; with[(sum u in 1..k, (sum j, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) <= (sum u in 1..k, b * (B_(u) * d_(u))) by sum[with[1 <= u by V; with[u <= k by V; with[(sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= b * B_(u) by logic; with[(sum j, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) = d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) by sum; with[d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= d_(u) * (b * B_(u)) by mono; V[1 * hw8, 1 * hw9]]]]]]]; with[(sum u in 1..k, b * (B_(u) * d_(u))) = b * (sum u in 1..k, B_(u) * d_(u)) by sum; V[1 * hw1, 1 * hw2, 1 * hw3, 1 * hw4, 1 * hw10]]]]]]
  (list) with[(sum j, sum i, p_(i) * J_(j)_(i)) <= (sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) by sum[V[1 * h_5(j)]]; with[(sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) <= b * ((sum u in 1..k, B_(u) * d_(u)) + Z) by lem:setbounds(core spend)[n := n, k := k, b := b, A := A, S := S, B := B, d := d, Z := Z, J := J]; V[1 * hw1, 1 * hw2]]]
  (prices) with[(sum i, p_(i) * J_(i)) <= (sum i, (beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i))) * J_(i)) by sum[mono]; with[(sum i, (beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i))) * J_(i)) = (sum i, beta_(i) * J_(i)) + (sum i, (sum u in 1..k, theta_(u) * A_(u)_(i)) * J_(i)) by sum[V[0]]; with[(sum i, (sum u in 1..k, theta_(u) * A_(u)_(i)) * J_(i)) = (sum i, (sum u in 1..k, theta_(u) * (A_(u)_(i) * J_(i)))) by sum[sum[V[0]]]; with[(sum i, (sum u in 1..k, theta_(u) * (A_(u)_(i) * J_(i)))) = (sum u in 1..k, (sum i, theta_(u) * (A_(u)_(i) * J_(i)))) by sum[V]; with[(sum u in 1..k, (sum i, theta_(u) * (A_(u)_(i) * J_(i)))) = (sum u in 1..k, theta_(u) * (sum i, A_(u)_(i) * J_(i))) by sum[sum]; with[(sum i, beta_(i) * J_(i)) <= (sum i, beta_(i)) by sum[with[J_(i) <= 1 by logic; with[beta_(i) * J_(i) <= beta_(i) * 1 by mono; V[1 * hw8]]]]; with[(sum u in 1..k, (B_(u) * d_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(i)))) <= (sum u in 1..k, (d_(u) * S_(u)(sum i, A_(u)_(i) * J_(i)) + theta_(u) * kappa_(u))) by sum[with[1 <= u by V; with[u <= k by V; with[(sum i, A_(u)_(i) * J_(i)) <= (sum i, A_(u)_(i)) by sum[with[J_(i) <= 1 by logic; with[A_(u)_(i) * J_(i) <= A_(u)_(i) * 1 by mono; V[1 * hw14]]]]; with[d_(u) * S_(u)(sum i, A_(u)_(i) * J_(i)) + theta_(u) * kappa_(u) >= d_(u) * B_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(i)) by logic; V[1 * hw15]]]]]]; with[(sum u in 1..k, (B_(u) * d_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(i)))) = (sum u in 1..k, B_(u) * d_(u)) + (sum u in 1..k, theta_(u) * (sum i, A_(u)_(i) * J_(i))) by sum; with[(sum u in 1..k, (d_(u) * S_(u)(sum i, A_(u)_(i) * J_(i)) + theta_(u) * kappa_(u))) = (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(i))) + (sum u in 1..k, theta_(u) * kappa_(u)) by sum; V[1 * hw1, 1 * hw2, 1 * hw3, 1 * hw4, 1 * hw5, 1 * hw6, 1 * hw9, 1 * hw17 | 1 * hw16]]]]]]]]]]

-- A convex staircase lies above each of its supporting lines (support), which gives the prices of
-- \cref{lem:setbounds}(prices); on counts that differ by at most one it is that line, so it spends exactly the line on
-- a mean (mean), the case of equality of Jensen's inequality.
lemma lem:staircase [the supporting line of a convex staircase]
  core up: M, g, t in NN, S in Line, s in QQ>=0, (forall q in NN : q + 2 <= M => 2 * S(q + 1) <= S(q) + S(q + 2)), (g + 1 <= M => S(g) + s <= S(g + 1)) : g + t + 1 <= M => S(g + t) + s <= S(g + t + 1)
  core gain: M, g, t in NN, S in Line, s in QQ>=0, (forall q in NN : q + 2 <= M => 2 * S(q + 1) <= S(q) + S(q + 2)), (g + 1 <= M => S(g) + s <= S(g + 1)) : g + t <= M => S(g) + s * t <= S(g + t)
  core down: M, g, t in NN, S in Line, s in QQ>=0, g <= M, (forall q in NN : q + 2 <= M => 2 * S(q + 1) <= S(q) + S(q + 2)), (forall g0 in NN : g0 < g, g0 + 1 = g => S(g) <= S(g0) + s) : forall r in NN : r + t + 1 = g => S(r + 1) <= S(r) + s
  core loss: M, g, t in NN, S in Line, s in QQ>=0, g <= M, (forall q in NN : q + 2 <= M => 2 * S(q + 1) <= S(q) + S(q + 2)), (forall g0 in NN : g0 < g, g0 + 1 = g => S(g) <= S(g0) + s) : forall r in NN : r + t <= g => S(r + t) + s * r <= S(r) + s * (r + t)
  core term: g, x in NN, e in QQ>=0, S in Line, x = g + e, e <= 1 : S(x) + e * S(g) = S(g) + e * S(g + 1)
  core shift: g0, g1 in NN, S in Line, s in QQ>=0, g1 + 1 = g0 + 1, S(g0 + 1) <= S(g0) + s : S(g0 + 1) <= S(g1) + s
  (support): M, g, r in NN, S in Line, s in QQ>=0, g <= M, r <= M, (forall q in NN : q + 2 <= M => 2 * S(q + 1) <= S(q) + S(q + 2)), (g + 1 <= M => S(g) + s <= S(g + 1)), (forall g0 in NN : g0 < g, g0 + 1 = g => S(g) <= S(g0) + s) : S(r) + s * g >= S(g) + s * r
  fix (support) staircase.support
  neqfix (support) staircase.convex
  (mean): b, g, h, h2 in NN, r in Exponent(b), S in Line, (forall j : g <= r_(j), r_(j) <= g + 1), (sum j, r_(j)) = b * g + h, h + h2 = b : (sum j, S(r_(j))) = h2 * S(g) + h * S(g + 1)
  fix (mean) staircase.mean
  origin: ?{\text{a convex sequence lies above its supporting lines, stated for the broken line of points of the plane \cite[(7) in the proof of Theorem~1.2]{GoswamiSzalkai2024}; proved here on the counts. The case of equality of Jensen's inequality on one piece of the broken line is elementary, proved here}}

proof lem:staircase
  "core up" ind[t; with[g + 1 <= M by V[1 * hi1]; with[S(g + 0) + s <= S(g + 0 + 1) by logic; V[1 * hw2]]]; with[g + t + 1 <= M by V[1 * hi2]; with[S(g + t) + s <= S(g + (t + 1)) by logic; with[g + t + 2 <= M by V[1 * hi2]; with[2 * S(g + (t + 1)) <= S(g + t) + S(g + (t + 1) + 1) by logic; V[1 * hw4, 1 * hw6]]]]]]
  "core gain" ind[t; V; with[g + t <= M by V[1 * hi2]; with[S(g) + s * t <= S(g + t) by logic; with[g + t + 1 <= M by V[1 * hi2]; with[g + t + 1 <= M => S(g + t) + s <= S(g + t + 1) by lem:staircase(core up)[M := M, g := g, t := t, S := S, s := s]; with[S(g + t) + s <= S(g + (t + 1)) by logic; V[1 * hw2, 1 * hw5]]]]]]]
  "core down" ind[t; with[r + 1 = g by V[1 * hi1]; with[r < g by V[1 * hi1]; with[S(g) <= S(r) + s by logic; with[S(r + 1) = S(g) by eq[hw1]; V[1 * hw3, 1 * hw4]]]]]; with[r + 1 + t + 1 = g by V[1 * hi2]; with[S(r + 1 + 1) <= S(r + 1) + s by logic; with[r + 2 <= M by V[1 * hi2, 1 * h_2]; with[2 * S(r + 1) <= S(r) + S(r + 1 + 1) by logic; V[1 * hw6, 1 * hw8]]]]]]
  "core loss" ind[t; V; with[r + t <= g by V[1 * hi2]; with[S(r + t) + s * r <= S(r) + s * (r + t) by logic; with[r + t + 1 <= g by V[1 * hi2]; with[r + t + max(g - (r + t + 1), 0) + 1 = g by V[0]; with[forall q in NN : q + max(g - (r + t + 1), 0) + 1 = g => S(q + 1) <= S(q) + s by lem:staircase(core down)[M := M, g := g, t := max(g - (r + t + 1), 0), S := S, s := s]; with[S(r + (t + 1)) <= S(r + t) + s by logic; V[1 * hw2, 1 * hw6]]]]]]]]
  "core term" cases[x <= g; with[x = g by V[1 * hc1], V[1 * h_1 | 1 * h_2]; with[e = 0 by V[1 * hw1 | 1 * h_2]; with[S(x) = S(g) by eq[hw1]; V[1 * hw3, S(g) * hw2 | S(g + 1) * hw2]]]]; with[x <= g + 1 by V[1 * h_2, 1 * h_3]; with[x = g + 1 by V[1 * hw4], V[1 * hn1]; with[e = 1 by V[1 * hw5 | 1 * h_2]; with[S(x) = S(g + 1) by eq[hw5]; V[1 * hw7, S(g) * hw6 | S(g + 1) * hw6]]]]]]
  "core shift" with[g1 = g0 by V[1 * h_2]; with[S(g1) = S(g0) by eq[hw1]; V[1 * h_3 | 1 * hw2]]]
  (support) cases[g <= r; cases[r <= g; with[g = r by V[1 * hc1], V[1 * hc2]; with[S(r) = S(g) by eq[hw1]; V[| 1 * hw2, s * hw1]]]; with[g + 1 < r + 1 by V[1 * hn2]; with[1 <= g + 1 by V[0]; with[1 <= r + 1 by V[0]; with[exists m in NN>=1 : g + 1 + m = r + 1 by fact:gap(core)[u := g + 1, v := r + 1]; logic[with[g + 1 + m = r + 1 by logic; with[r = g + m by V[1 * hw7]; with[g + m <= M by V[1 * h_3 | 1 * hw8]; with[g + m <= M => S(g) + s * m <= S(g + m) by lem:staircase(core gain)[M := M, g := g, t := m, S := S, s := s]; with[S(g) + s * m <= S(g + m) by logic; with[S(g + m) = S(r) by eq[hw8]; V[1 * hw11, 1 * hw12, s * hw8]]]]]]]]]]]]]; with[r + 1 < g + 1 by V[1 * hn1]; with[1 <= r + 1 by V[0]; with[1 <= g + 1 by V[0]; with[exists m in NN>=1 : r + 1 + m = g + 1 by fact:gap(core)[u := r + 1, v := g + 1]; logic[with[r + 1 + m = g + 1 by logic; with[r + m = g by V[1 * hw17]; with[r + m <= g by V[1 * hw18]; with[forall q in NN : q + m <= g => S(q + m) + s * q <= S(q) + s * (q + m) by lem:staircase(core loss)[M := M, g := g, t := m, S := S, s := s]; with[S(r + m) + s * r <= S(r) + s * (r + m) by logic; with[S(g) = S(r + m) by eq[hw18]; V[1 * hw21, 1 * hw22, s * hw18]]]]]]]]]]]]]
  (mean) with[exists e in Point(b) : forall j : r_(j) = g + e_(j) by take[e_(j) := max(r_(j) - g, 0); with[g <= r_(j) by logic; V[0]]]; logic[with[(sum j, (S(r_(j)) + e_(j) * S(g))) = (sum j, (S(g) + e_(j) * S(g + 1))) by sum[with[r_(j) = g + e_(j) by logic; with[r_(j) <= g + 1 by logic; with[e_(j) <= 1 by V[1 * hw5 | 1 * hw4]; lem:staircase(core term)[g := g, x := r_(j), e := e_(j), S := S]]]]]; with[(sum j, (S(r_(j)) + e_(j) * S(g))) = (sum j, S(r_(j))) + (sum j, e_(j) * S(g)) by sum; with[(sum j, e_(j) * S(g)) = (sum j, e_(j)) * S(g) by sum; with[(sum j, (S(g) + e_(j) * S(g + 1))) = (sum j, S(g)) + (sum j, e_(j) * S(g + 1)) by sum; with[(sum j, e_(j) * S(g + 1)) = (sum j, e_(j)) * S(g + 1) by sum; with[(sum j, S(g)) = b * S(g) by sum; with[(sum j, r_(j)) = (sum j, (g + e_(j))) by sum[logic]; with[(sum j, (g + e_(j))) = (sum j, g) + (sum j, e_(j)) by sum; with[(sum j, g) = b * g by sum; with[(sum j, e_(j)) = h by V[1 * h_2, 1 * hw12, 1 * hw13, 1 * hw14]; with[(sum j, e_(j)) * S(g) = h * S(g) by V[S(g) * hw15]; with[(sum j, e_(j)) * S(g + 1) = h * S(g + 1) by V[S(g + 1) * hw15]; with[b * S(g) = h2 * S(g) + h * S(g) by V[S(g) * h_3]; V[1 * hw3, 1 * hw9, 1 * hw11, 1 * hw10, 1 * hw17, 1 * hw18 | 1 * hw7, 1 * hw8, 1 * hw16]]]]]]]]]]]]]]]]

-- Complementary slackness at the two bounds of \cref{lem:setbounds}: where they meet, every set of the list ties
-- (tight), every cluster with a positive size spends its budget in the mean (slack), every set of the list is least
-- against every other set (least), and its count lies on the line of every cluster (piece). Each is a sum of orders
-- that ties, so every order ties, as in \cref{lem:selfdual}.
lemma lem:settie [the sets of a tying list]
  core rangewise: k in NN, a_(1..k), c_(1..k) in QQ>=0, (forall u in NN>=1 : u <= k => a_(u) <= c_(u)), (sum u in 1..k, a_(u)) = sum u in 1..k, c_(u) : forall u in NN>=1 : u <= k => a_(u) = c_(u)
  (tight): n, k, b in NN, A_(1..k) in Exponent(n), S_(1..k) in Line, B_(1..k), d_(1..k) in QQ>=0, Z in QQ>=0, p in Point(n), J in IntForms(b, n), (forall u in NN>=1 : u <= k => (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= b * B_(u)), (forall j : Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) >= sum i, p_(i) * J_(j)_(i)), b * ((sum u in 1..k, B_(u) * d_(u)) + Z) = (sum j, sum i, p_(i) * J_(j)_(i)) : forall j : Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) = sum i, p_(i) * J_(j)_(i)
  fix (tight) settie.tight
  (slack): n, k, b in NN, A_(1..k) in Exponent(n), S_(1..k) in Line, B_(1..k), d_(1..k) in QQ>=0, Z in QQ>=0, p in Point(n), J in IntForms(b, n), (forall u in NN>=1 : u <= k => (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= b * B_(u)), (forall j : Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) >= sum i, p_(i) * J_(j)_(i)), b * ((sum u in 1..k, B_(u) * d_(u)) + Z) = (sum j, sum i, p_(i) * J_(j)_(i)) : forall u in NN>=1 : u <= k => d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) = d_(u) * (b * B_(u))
  fix (slack) settie.slack
  (least): n, k, b in NN, A_(1..k) in Exponent(n), S_(1..k) in Line, B_(1..k), d_(1..k) in QQ>=0, Z in QQ>=0, p in Point(n), J in IntForms(b, n), (forall u in NN>=1 : u <= k => (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= b * B_(u)), (forall X in Exponent(n) : (forall i : X_(i) <= 1) => Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * X_(i))) >= sum i, p_(i) * X_(i)), (forall j : forall i : J_(j)_(i) <= 1), b * ((sum u in 1..k, B_(u) * d_(u)) + Z) = (sum j, sum i, p_(i) * J_(j)_(i)) : forall j : forall X in Exponent(n) : (forall i : X_(i) <= 1) => (sum i, p_(i) * X_(i)) + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= (sum i, p_(i) * J_(j)_(i)) + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * X_(i)))
  fix (least) settie.least
  (piece): n, k, b in NN, A_(1..k) in Exponent(n), S_(1..k) in Line, B_(1..k), d_(1..k), theta_(1..k), kappa_(1..k) in QQ>=0, p, beta in Point(n), J in IntForms(b, n), (forall u in NN>=1 : u <= k => forall r in NN : r <= (sum i, A_(u)_(i)) => d_(u) * S_(u)(r) + theta_(u) * kappa_(u) >= d_(u) * B_(u) + theta_(u) * r), (forall i : beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i)) >= p_(i)), (forall j : forall i : J_(j)_(i) <= 1), (forall u in NN>=1 : u <= k => (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= b * B_(u)), (sum j, sum i, p_(i) * J_(j)_(i)) = b * ((sum u in 1..k, theta_(u) * kappa_(u)) + sum i, beta_(i)) : forall u in NN>=1 : u <= k => forall j : d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)) + theta_(u) * kappa_(u) = d_(u) * B_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i))
  fix (piece) settie.piece
  neqfix (piece) settie.piece.tie
  origin: ?{\text{elementary, proved here: complementary slackness at the two bounds of \cref{lem:setbounds}}}

proof lem:settie
  "core rangewise" logic[with[(sum v in 1..k, a_(v)) + (sum v in 1..k, max(c_(v) - a_(v), 0)) = (sum v in 1..k, c_(v)) by sum[V[0]]; with[max(c_(u) - a_(u), 0) <= (sum v in 1..k, max(c_(v) - a_(v), 0)) by term[u]; with[a_(u) <= c_(u) by logic; V[1 * hw3], V[1 * hw2, 1 * hw1 | 1 * h_4]]]]]
  (tight) with[(sum j, sum i, p_(i) * J_(j)_(i)) <= (sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) by sum[V[1 * h_5(j)]]; with[(sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) <= b * ((sum u in 1..k, B_(u) * d_(u)) + Z) by lem:setbounds(core spend)[n := n, k := k, b := b, A := A, S := S, B := B, d := d, Z := Z, J := J]; with[exists a in Point(b) : forall j : a_(j) = Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) by take[a_(j) := Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))); V]; with[exists c in Point(b) : forall j : c_(j) = (sum i, p_(i) * J_(j)_(i)) by take[c_(j) := (sum i, p_(i) * J_(j)_(i)); V]; logic[with[forall l : c_(l) <= a_(l) by logic[with[c_(l) = (sum i, p_(i) * J_(l)_(i)) by logic; with[a_(l) = Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(l)_(i))) by logic; with[Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(l)_(i))) >= (sum i, p_(i) * J_(l)_(i)) by logic; V[1 * hw6, 1 * hw8 | 1 * hw7]]]]]; with[(sum j, a_(j)) = (sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) by sum[logic]; with[(sum j, c_(j)) = (sum j, sum i, p_(i) * J_(j)_(i)) by sum[logic]; with[(sum j, a_(j)) = (sum j, c_(j)) by V[1 * hw9, 1 * hw2, 1 * h_6 | 1 * hw10], V[1 * hw10, 1 * hw1 | 1 * hw9]; with[(sum i, a_(i)) = (sum i, c_(i)) by V[1 * hw11]; with[forall j : a_(j) = c_(j) by lem:selfdual(core termwise)[n := b, a := a, b := c]; logic[with[a_(j) = Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) by logic; with[c_(j) = (sum i, p_(i) * J_(j)_(i)) by logic; with[a_(j) = c_(j) by logic; V[1 * hw14, 1 * hw15, 1 * hw16]]]]]]]]]]]]]]]]
  (slack) with[(sum j, sum i, p_(i) * J_(j)_(i)) <= (sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) by sum[V[1 * h_5(j)]]; with[(sum j, (Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i))))) = (sum j, Z) + (sum j, (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) by sum; with[(sum j, Z) = b * Z by sum; with[(sum j, (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) = (sum u in 1..k, (sum j, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) by sum[V]; with[(sum u in 1..k, (sum j, d_(u) * S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) = (sum u in 1..k, d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) by sum[sum]; with[forall u in NN>=1 : u <= k => d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= d_(u) * (b * B_(u)) by logic[with[(sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) <= b * B_(u) by logic; mono]]; with[(sum u in 1..k, d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) <= (sum u in 1..k, d_(u) * (b * B_(u))) by sum[V]; with[(sum u in 1..k, d_(u) * (b * B_(u))) = b * (sum u in 1..k, B_(u) * d_(u)) by sum; with[(sum u in 1..k, d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i)))) = (sum u in 1..k, d_(u) * (b * B_(u))) by V[1 * hw8], V[1 * hw9, 1 * h_6, 1 * hw1, 1 * hw2, 1 * hw3, 1 * hw4, 1 * hw5]; with[forall u in NN>=1 : u <= k => d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))) = d_(u) * (b * B_(u)) by lem:settie(core rangewise)[k := k, a_(u) := d_(u) * (sum j, S_(u)(sum i, A_(u)_(i) * J_(j)_(i))), c_(u) := d_(u) * (b * B_(u))]; logic]]]]]]]]]]
  (least) with[forall j : Z + (sum u in 1..k, d_(u) * S_(u)((sum i, A_(u)_(i) * J_(j)_(i)))) >= (sum i, p_(i) * J_(j)_(i)) by with[forall i : J_(j)_(i) <= 1 by logic; logic]; with[forall j : Z + (sum u in 1..k, d_(u) * S_(u)((sum i, A_(u)_(i) * J_(j)_(i)))) = (sum i, p_(i) * J_(j)_(i)) by lem:settie(tight)[n := n, k := k, b := b, A := A, S := S, B := B, d := d, Z := Z, p := p, J := J]; with[Z + (sum u in 1..k, d_(u) * S_(u)((sum i, A_(u)_(i) * J_(j)_(i)))) = (sum i, p_(i) * J_(j)_(i)) by logic; logic[with[Z + (sum u in 1..k, d_(u) * S_(u)(sum i, A_(u)_(i) * X_(i))) >= (sum i, p_(i) * X_(i)) by logic; V[1 * hw5, 1 * hw4]]]]]]
  (piece) with[(sum j, sum i, p_(i) * J_(j)_(i)) <= (sum j, sum i, (beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i))) * J_(j)_(i)) by sum[sum[mono]]; with[(sum j, sum i, (beta_(i) + (sum u in 1..k, theta_(u) * A_(u)_(i))) * J_(j)_(i)) = (sum j, sum i, beta_(i) * J_(j)_(i)) + (sum j, sum i, (sum u in 1..k, theta_(u) * A_(u)_(i)) * J_(j)_(i)) by sum[sum[V[0]]]; with[(sum j, sum i, beta_(i) * J_(j)_(i)) <= (sum j, sum i, beta_(i)) by sum[sum[with[J_(j)_(i) <= 1 by logic; with[beta_(i) * J_(j)_(i) <= beta_(i) * 1 by mono; V[1 * hw5]]]]]; with[(sum j, sum i, beta_(i)) = (sum i, sum j, beta_(i)) by sum[V]; with[(sum i, sum j, beta_(i)) = (sum i, b * beta_(i)) by sum[sum]; with[(sum i, b * beta_(i)) = b * (sum i, beta_(i)) by sum; with[(sum j, sum i, (sum u in 1..k, theta_(u) * A_(u)_(i)) * J_(j)_(i)) = (sum j, sum i, (sum u in 1..k, theta_(u) * (A_(u)_(i) * J_(j)_(i)))) by sum[sum[sum[V[0]]]]; with[(sum j, sum i, (sum u in 1..k, theta_(u) * (A_(u)_(i) * J_(j)_(i)))) = (sum j, (sum u in 1..k, (sum i, theta_(u) * (A_(u)_(i) * J_(j)_(i))))) by sum[sum[V]]; with[(sum j, (sum u in 1..k, (sum i, theta_(u) * (A_(u)_(i) * J_(j)_(i))))) = (sum j, (sum u in 1..k, theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i)))) by sum[sum[sum]]; with[(sum j, (sum u in 1..k, theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i)))) = (sum u in 1..k, (sum j, theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i)))) by sum[V]; with[(sum u in 1..k, sum j, (d_(u) * B_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i)))) = (sum u in 1..k, ((sum j, d_(u) * B_(u)) + (sum j, theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i))))) by sum[sum]; with[(sum u in 1..k, ((sum j, d_(u) * B_(u)) + (sum j, theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i))))) = (sum u in 1..k, b * (B_(u) * d_(u))) + (sum u in 1..k, (sum j, theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i)))) by sum[with[(sum j, d_(u) * B_(u)) = b * (B_(u) * d_(u)) by sum; V[1 * hw15]]]; with[(sum u in 1..k, b * (B_(u) * d_(u))) = b * (sum u in 1..k, B_(u) * d_(u)) by sum; with[(sum u in 1..k, sum j, (d_(u) * S_(u)((sum i, A_(u)_(i) * J_(j)_(i))) + theta_(u) * kappa_(u))) = (sum u in 1..k, ((sum j, d_(u) * S_(u)((sum i, A_(u)_(i) * J_(j)_(i)))) + (sum j, theta_(u) * kappa_(u)))) by sum[sum]; with[(sum w in 1..k, ((sum j, d_(w) * S_(w)((sum i, A_(w)_(i) * J_(j)_(i)))) + (sum j, theta_(w) * kappa_(w)))) <= (sum w in 1..k, b * (B_(w) * d_(w))) + (sum w in 1..k, b * (theta_(w) * kappa_(w))) by sum[with[1 <= w by V; with[w <= k by V; with[(sum j, S_(w)((sum i, A_(w)_(i) * J_(j)_(i)))) <= b * B_(w) by logic; with[(sum j, d_(w) * S_(w)((sum i, A_(w)_(i) * J_(j)_(i)))) = d_(w) * (sum j, S_(w)((sum i, A_(w)_(i) * J_(j)_(i)))) by sum; with[d_(w) * (sum j, S_(w)((sum i, A_(w)_(i) * J_(j)_(i)))) <= d_(w) * (b * B_(w)) by mono; with[(sum j, theta_(w) * kappa_(w)) = b * (theta_(w) * kappa_(w)) by sum; V[1 * hw22, 1 * hw23, 1 * hw24]]]]]]]]; with[(sum u in 1..k, b * (theta_(u) * kappa_(u))) = b * (sum u in 1..k, theta_(u) * kappa_(u)) by sum; with[(sum v in 1..k, sum l, (d_(v) * S_(v)((sum i, A_(v)_(i) * J_(l)_(i))) + theta_(v) * kappa_(v))) = (sum v in 1..k, sum l, (d_(v) * B_(v) + theta_(v) * (sum i, A_(v)_(i) * J_(l)_(i)))) + (sum v in 1..k, sum l, max((d_(v) * S_(v)((sum i, A_(v)_(i) * J_(l)_(i))) + theta_(v) * kappa_(v)) - (d_(v) * B_(v) + theta_(v) * (sum i, A_(v)_(i) * J_(l)_(i))), 0)) by sum[sum[with[1 <= v by V; with[v <= k by V; with[(sum i, A_(v)_(i) * J_(l)_(i)) <= (sum i, A_(v)_(i)) by sum[with[J_(l)_(i) <= 1 by V[1 * h_7(l, i)]; with[A_(v)_(i) * J_(l)_(i) <= A_(v)_(i) * 1 by mono; V[1 * hw31]]]]; with[d_(v) * S_(v)((sum i, A_(v)_(i) * J_(l)_(i))) + theta_(v) * kappa_(v) >= d_(v) * B_(v) + theta_(v) * (sum i, A_(v)_(i) * J_(l)_(i)) by logic; V[0]]]]]]]; with[max((d_(u) * S_(u)((sum i, A_(u)_(i) * J_(j)_(i))) + theta_(u) * kappa_(u)) - (d_(u) * B_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i))), 0) <= (sum l, max((d_(u) * S_(u)((sum i, A_(u)_(i) * J_(l)_(i))) + theta_(u) * kappa_(u)) - (d_(u) * B_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(l)_(i))), 0)) by term[j]; with[(sum l, max((d_(u) * S_(u)((sum i, A_(u)_(i) * J_(l)_(i))) + theta_(u) * kappa_(u)) - (d_(u) * B_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(l)_(i))), 0)) <= (sum v in 1..k, sum l, max((d_(v) * S_(v)((sum i, A_(v)_(i) * J_(l)_(i))) + theta_(v) * kappa_(v)) - (d_(v) * B_(v) + theta_(v) * (sum i, A_(v)_(i) * J_(l)_(i))), 0)) by term[u]; with[(sum i, A_(u)_(i) * J_(j)_(i)) <= (sum i, A_(u)_(i)) by sum[with[J_(j)_(i) <= 1 by logic; with[A_(u)_(i) * J_(j)_(i) <= A_(u)_(i) * 1 by mono; V[1 * hw37]]]]; with[d_(u) * S_(u)((sum i, A_(u)_(i) * J_(j)_(i))) + theta_(u) * kappa_(u) >= d_(u) * B_(u) + theta_(u) * (sum i, A_(u)_(i) * J_(j)_(i)) by logic; V[1 * hw33, 1 * hw34, 1 * hw17, 1 * hw18, 1 * hw25, 1 * hw9, 1 * hw10, 1 * hw11, 1 * hw12, 1 * hw2, 1 * hw1, 1 * hw3, 1 * hw6, 1 * hw7, 1 * hw8 | 1 * hw26, 1 * hw13, 1 * hw14, 1 * h_9], V[1 * hw38]]]]]]]]]]]]]]]]]]]]]]

-- The chord of a convex line. (chord): a convex line that is zero at \(1\) lies below its chord from \(1\).
lemma lem:chord [the chord of a convex line]
  (chord): n0, s0 in NN, T in Line, s0 <= n0, T(1) = 0, (forall r in NN : r + 2 <= n0 + 1 => 2 * T(r + 1) <= T(r) + T(r + 2)) : n0 * T(s0 + 1) <= s0 * T(n0 + 1)
  fix (chord) chord
  neqfix (chord) chord.convex
  origin: ?{\text{the three-chord lemma on a convex sequence: its slopes from a fixed point do not decrease, stated for the broken line of points of the plane \cite[(3), and (7)--(8) with Lemma~1.1 in the proof of Theorem~1.2]{GoswamiSzalkai2024}; proved here on the counts, with the slopes compared as products}}

proof lem:chord
  (chord) cases[s0 = 0; with[s0 + 1 = 1 by V[1 * hc1]; with[T(s0 + 1) = T(1) by eq[hw1]; V[n0 * hw2, n0 * h_2 | 1 * T(n0 + 1) * hc1]]]; with[exists p in NN : 1 + p = s0 by take[p := max(s0 - 1, 0); V[0]]; logic[with[1 + p = s0 by logic; with[1 + p + 1 <= n0 + 1 => T(1 + p) + 0 <= T(1 + p + 1) by lem:staircase(core up)[M := n0 + 1, g := 1, t := p, S := T, s := 0; (1 + 1 <= n0 + 1 => T(1) + 0 <= T(1 + 1)) by V[1 * h_2]]; with[1 + p + 1 <= n0 + 1 by V[1 * hw4, 1 * h_1]; with[T(1 + p) + 0 <= T(1 + p + 1) by logic; with[T(1 + p) = T(s0) by eq[hw4]; with[T(1 + p + 1) = T(s0 + 1) by eq[hw4]; with[T(s0) <= T(s0 + 1) by V[1 * hw7, 1 * hw9 | 1 * hw8]; with[exists s in QQ>=0 : s = max(T(s0 + 1) - T(s0), 0) by take[s := max(T(s0 + 1) - T(s0), 0); V]; logic[with[s = max(T(s0 + 1) - T(s0), 0) by logic; with[s0 + 1 <= n0 + 1 by V[1 * h_1]; with[s0 + 1 + 1 <= n0 + 1 => T(s0 + 1) + s <= T(s0 + 1 + 1) by with[s0 + 2 <= n0 + 1 by V[1 * hi3]; with[2 * T(s0 + 1) <= T(s0) + T(s0 + 1 + 1) by logic; V[1 * hw16, 1 * hw12]]]; with[T(s0 + 1) <= T(s0) + s by V[| 1 * hw12]; with[forall g0 in NN : g0 < s0 + 1, g0 + 1 = s0 + 1 => T(s0 + 1) <= T(g0) + s by lem:staircase(core shift)[g0 := s0, g1 := g0, S := T, s := s]; with[1 <= n0 + 1 by V; with[n0 + 1 <= n0 + 1 by V; with[T(1) + s * (s0 + 1) >= T(s0 + 1) + s * 1 by lem:staircase(support)[M := n0 + 1, g := s0 + 1, r := 1, S := T, s := s]; with[T(n0 + 1) + s * (s0 + 1) >= T(s0 + 1) + s * (n0 + 1) by lem:staircase(support)[M := n0 + 1, g := s0 + 1, r := n0 + 1, S := T, s := s]; with[exists w in NN : n0 = s0 + w by take[w := max(n0 - s0, 0); V[0]]; logic[with[n0 = s0 + w by logic; with[T(s0 + 1) <= s * s0 by V[1 * hw21, 1 * h_2]; with[w * T(s0 + 1) <= w * (s * s0) by mono; with[s0 * (T(s0 + 1) + s * (n0 + 1)) <= s0 * (T(n0 + 1) + s * (s0 + 1)) by mono; with[n0 * T(s0 + 1) = s0 * T(s0 + 1) + w * T(s0 + 1) by V[T(s0 + 1) * hw24]; with[s0 * (s * n0) = s0 * (s * s0) + w * (s * s0) by V[(s0 * s) * hw24]; V[1 * hw28, 1 * hw26, 1 * hw27 | 1 * hw29]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]

-- Pairs feasible on every set of one size: on clusters of zero-one rows with a convex staircase that vanishes at \(0\)
-- and \(1\), the bound on every set of \(m\) units gives \(n_0Z+S(m)\sum_ud_us_u\ge n_0m\) on \(n=n_0+1\) units
-- (bound). The proof deletes one unit at a time, the bound on a set being the mean of the bounds on its subsets with
-- one unit less, and closes with the chord of \cref{lem:chord}.
lemma lem:allsets [pairs feasible on every set of one size]
  core chord: N, m0, c in NN, S in Line, c <= m0 + 1, m0 + 1 <= N, S(0) = 0, S(1) = 0, (forall r in NN : r + 2 <= N => 2 * S(r + 1) <= S(r) + S(r + 2)) : m0 * S(c) <= max(c - 1, 0) * S(m0 + 1)
  core term: a, s, t in NN, v in QQ>=0, a <= 1, t + a = s : v * max(t - 1, 0) + v * a * iverson(2 <= s) = v * max(s - 1, 0)
  core share: y, s in NN, P, w in QQ>=0, s <= y + 2, P + w * iverson(2 <= s) * s = (y + 2) * (w * max(s - 1, 0)) : (y + 1) * P <= (y + 2) * y * (w * max(s - 1, 0))
  core deletion: n, k, m0, x in NN, A_(1..k) in Exponent(n), d_(1..k) in QQ>=0, Z in QQ>=0, S in Line, 1 <= m0, m0 + 1 <= n, (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), S(0) = 0, S(1) = 0, (forall r in NN : r + 2 <= n => 2 * S(r + 1) <= S(r) + S(r + 2)) : forall V in Exponent(n) : (forall i : V_(i) <= 1) => (sum i, V_(i)) = m0 + 1 + x => (forall J in Exponent(n) : (forall i : J_(i) <= V_(i)) => (sum i, J_(i)) = m0 + 1 => Z + (sum u in 1..k, d_(u) * S(sum i, A_(u)_(i) * J_(i))) >= m0 + 1) => (m0 + x) * Z + S(m0 + 1) * (sum u in 1..k, d_(u) * max((sum i, A_(u)_(i) * V_(i)) - 1, 0)) >= (m0 + x) * (m0 + 1)
  (bound): n, n0, k, m in NN, A_(1..k) in Exponent(n), s_(1..k) in NN, d_(1..k) in QQ>=0, Z in QQ>=0, S in Line, n = n0 + 1, m <= n, (forall u in NN>=1 : u <= k => forall i : A_(u)_(i) <= 1), (forall u in NN>=1 : u <= k => (sum i, A_(u)_(i)) = s_(u) + 1), S(0) = 0, S(1) = 0, (forall r in NN : r + 2 <= n => 2 * S(r + 1) <= S(r) + S(r + 2)), (forall J in Exponent(n) : (forall i : J_(i) <= 1) => (sum i, J_(i)) = m => Z + (sum u in 1..k, d_(u) * S(sum i, A_(u)_(i) * J_(i))) >= m) : n0 * Z + S(m) * (sum u in 1..k, d_(u) * s_(u)) >= n0 * m
  fix (bound) allsets.list
  neqfix (bound) allsets.convex
  neqfix (bound) allsets.zero
  neqfix (bound) allsets.feasible
  origin: ?{\text{the mean over the subsets with one unit less is the averaging of Katona, Nemetz and Simonovits (1964), in the form of \cite[Lemma~6]{HalfpapPalmer2021}, numbered as in its arXiv version 1909.13043v1; proved here: its run on the clusters, with the chord of \cref{lem:chord} on each cluster}}

proof lem:allsets
  "core chord" cases[1 <= c; with[max(c - 1, 0) <= m0 by V[1 * h_1]; with[m0 * S(max(c - 1, 0) + 1) <= max(c - 1, 0) * S(m0 + 1) by lem:chord(chord)[n0 := m0, s0 := max(c - 1, 0), T := S; S(1) = 0 by V[1 * h_4]; (forall r in NN : r + 2 <= m0 + 1 => 2 * S(r + 1) <= S(r) + S(r + 2)) by with[r + 2 <= N by V[1 * hi1, 1 * h_2]; V[1 * h_5(r)]]]; with[max(c - 1, 0) + 1 = c by V[0]; with[S(max(c - 1, 0) + 1) = S(c) by eq[hw4]; V[1 * hw2 | m0 * hw5]]]]]; with[c = 0 by V, V; with[S(c) = S(0) by eq[hw6]; with[c <= 1 by V; V[m0 * hw7, m0 * h_3]]]]]
