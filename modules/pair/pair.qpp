-- Q++ 0.2
module pair
uses pivots

subsection sec:pair The pair of a potential

-- A chamber counts a potential, from above or from below, when the sublevel points of every box are its weighted count of
-- feasible sizes times \(2^{nN}\), up to a constant; \cref{thm:pivots} gives both on a chart.
relation (K #counted Pr #content c #by C #from Lz #depth a #plus h #box rho) := n, k, r in NN, K in Potential(n), Pr in Chamber(k, r), c in Exponent(r), C in QQ>0, Lz, a, h in NN, rho in Weight(n), (forall L, N in NN, b in Exponent(n) : L >= Lz, N >= a * L + h, (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1) => exists B in Exponent(r) : (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))))
relation (K #countedin Pr #content c #by C #from Lz #depth a #plus h #box rho) := n, k, r in NN, K in Potential(n), Pr in Chamber(k, r), c in Exponent(r), C in QQ>0, Lz, a, h in NN, rho in Weight(n), (forall L, N, Lp in NN, b in Exponent(n), B in Exponent(r) : L >= Lz, N >= a * L + h, L <= Lp, (forall X : B_(X) + 1 <= N), (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1) => C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X))) <= sum u <= b, iverson((u #sublevel K #depth N #level L)))

-- The certificate of a chamber: prices of value \(\lambda\) tied to \(p\) affinely independent points of its
-- face at level \(q\); the directions the prices tie are those of the face, and a second price vector bounds every size.
relation (R #face Pr #prices pi #bound sig #content c #value lambda #level q) := k, r, p in NN, q in NN>=1, Pr in Chamber(k, r), pi, sig in Point(k), R in IntForms(p, r), c in Exponent(r), lambda in QQ>=0, (pi #prices Pr #content c #value lambda), (exists mu in QQ>=0 : (sig #prices Pr #content c #value mu)), (forall jj : exists yP, yM in Point(k) : (forall iota : pi_(iota) + sig_(iota) = 0 => yP_(iota) + yM_(iota) = 0), (forall x in Exponent(r) : x_(jj) + (sum iota, yP_(iota) * (sum i, Pr.N_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, Pr.P_(iota)_(i) * x_(i))) = (sum iota, yP_(iota) * (sum i, Pr.P_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, Pr.N_(iota)_(i) * x_(i))))), (forall vP, vM in Point(r) : (forall iota : 0 < pi_(iota) => (sum i, Pr.P_(iota)_(i) * vP_(i)) + (sum i, Pr.N_(iota)_(i) * vM_(i)) = (sum i, Pr.N_(iota)_(i) * vP_(i)) + (sum i, Pr.P_(iota)_(i) * vM_(i))) => exists zP, zM in Point(p) : (sum l, zP_(l)) = (sum l, zM_(l)), (forall i : vP_(i) + (sum l, zM_(l) * R_(l)_(i)) = vM_(i) + (sum l, zP_(l) * R_(l)_(i)))), (forall iota : forall l : (sum i, Pr.P_(iota)_(i) * R_(l)_(i)) + q * Pr.epsP_(iota) >= (sum i, Pr.N_(iota)_(i) * R_(l)_(i)) + q * Pr.epsM_(iota)), (forall l : forall iota : pi_(iota) * ((sum i, Pr.P_(iota)_(i) * R_(l)_(i)) + q * Pr.epsP_(iota)) = pi_(iota) * ((sum i, Pr.N_(iota)_(i) * R_(l)_(i)) + q * Pr.epsM_(iota))), (forall zP, zM in Point(p) : (forall i : (sum l, zP_(l) * R_(l)_(i)) = sum l, zM_(l) * R_(l)_(i)), (sum l, zP_(l)) = (sum l, zM_(l)) => forall l : zP_(l) = zM_(l))

-- The value of a certificate: the value of its prices and one more than the dimension of its face (\cref{def:pair}).
relation (Pr #pair lambda #multiplicity m #content c) := k, r in NN, m in NN>=1, Pr in Chamber(k, r), c in Exponent(r), lambda in QQ>=0, (exists p, d in NN : exists pi, sig in Point(k) : exists R in IntForms(p, r) : exists q in NN>=1 : p = d + 1, m = d + 1, (R #face Pr #prices pi #bound sig #content c #value lambda #level q))

-- The pair of a potential from its chamber: prices with the value \(\lambda\), the \(d+1\) points of the least face and a
-- second price vector give the bounds from above and from below at \(m=d+1\). The pair is the value
-- of the given prices and the dimension of the given face. The value \(\lambda\) is in \(\Q_{\ge0}\) in every row and
-- relation, and every row holds at \(\lambda=0\), where the directions of the face have content \(0\). There a count from
-- below is no larger than the box: with \(\kappa=0\) the bound from below gives \(cL^{m-1}\le\prod_i(\rho_i+1)\) at every
-- level \(L\), so a potential has a pair of value \(0\) only at \(m=1\), where its sublevel points keep a positive fraction of
-- the box at every level.
theorem thm:pair [the pair of a potential from its chamber]
  core read: n, k, r, Lz, a, h, L, N in NN, K in Potential(n), Pr in Chamber(k, r), c in Exponent(r), C in QQ>0, rho in Weight(n), b in Exponent(n), (K #counted Pr #content c #by C #from Lz #depth a #plus h #box rho), L >= Lz, N >= a * L + h, (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1) : exists B in Exponent(r) : (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X)))
  core readin: n, k, r, Lz, a, h, L, N, Lp in NN, K in Potential(n), Pr in Chamber(k, r), c in Exponent(r), C in QQ>0, rho in Weight(n), b in Exponent(n), B in Exponent(r), (K #countedin Pr #content c #by C #from Lz #depth a #plus h #box rho), L >= Lz, N >= a * L + h, L <= Lp, (forall X : B_(X) + 1 <= N), (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1) : C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X))) <= sum u <= b, iverson((u #sublevel K #depth N #level L))
  core outlevel: n, N, L, kappa, f, d, m, Kc in NN, S, W, Q in QQ>=0, C in QQ>0, S <= C * 2^(n * N) * W, W <= Kc * Q * L^f / 2^kappa, f <= d, m = d + 1, 1 <= L : L * 2^kappa * S <= C * (Kc + 1) * Q * L^m * 2^(n * N)
  fix core outlevel pairout
  core ceil: L in NN, q in NN>=1 : exists t in NN : L <= q * t, q * t <= L + q
  fix core ceil pairceil
  core levels: L, Lp, q, kappa, kp, E in NN, lambda in QQ>=0, Lp <= L + q, kp <= lambda * Lp, lambda * L < kappa + 1, lambda * q + 1 <= E : kp <= kappa + E
  fix core levels pairlevels
  core fit: r, p, N, L, t, a, h in NN, q in NN>=1, u0, B in Exponent(r), R in IntForms(p, r), (forall X : B_(X) = u0_(X) + t * (sum l, R_(l)_(X))), q * t <= L + q, N >= a * L + h, (forall X : u0_(X) + (sum l, R_(l)_(X)) + 1 <= h), (forall X : (sum l, R_(l)_(X)) <= a) : forall X : B_(X) + 1 <= N
  core scale: r, L in NN, e in Exponent(r), 1 <= L : forall alpha : e_(alpha) <= e_(alpha) * L
  core grid: n, N, L in NN, K in Potential(n), G in Grid(n), b in Exponent(n), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), (u #sublevel K #depth N #level L) => G(u) <= 1 / 2^L) : (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= (sum u <= b, iverson(G(u) <= 1 / 2^L))
  core gridin: n, N, L in NN, K in Potential(n), G in Grid(n), b in Exponent(n), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L => (u #sublevel K #depth N #level L)) : (sum u <= b, iverson(G(u) <= 1 / 2^L)) <= (sum u <= b, iverson((u #sublevel K #depth N #level L)))
  core cap: r, p, t in NN, u0 in Exponent(r), R in IntForms(p, r) : exists B in Exponent(r) : (forall X : B_(X) = u0_(X) + t * (sum l, R_(l)_(X))), (forall i : u0_(i) + (sum l, t * R_(l)_(i)) <= B_(i))
  core inlevel: n, N, L, Lp, kappa, kp, E, K0, d, m in NN, D, S, W, Wr in QQ>=0, C in QQ>0, C * 2^(n * N) * W <= S, Lp^d / 2^(kp + K0) <= D * Wr, Wr <= W, L <= Lp, kp <= kappa + E, m = d + 1 : C / ((D + 1) * 2^(E + K0)) * L^m * 2^(n * N) <= L * 2^kappa * S
  fix core inlevel pairin
  (outer): n, k, r, p, d, Lz, a, h in NN, m in NN>=1, K in Potential(n), rho in Weight(n), Pr in Chamber(k, r), pi, sig in Point(k), R in IntForms(p, r), c in Exponent(r), lambda, lambda2 in QQ>=0, C in QQ>0, (K #counted Pr #content c #by C #from Lz #depth a #plus h #box rho), 1 <= Lz, (pi #prices Pr #content c #value lambda), (sig #prices Pr #content c #value lambda2), p = d + 1, m = d + 1, (forall j : exists yP, yM in Point(k) : (forall iota : pi_(iota) + sig_(iota) = 0 => yP_(iota) + yM_(iota) = 0), (forall x in Exponent(r) : x_(j) + (sum iota, yP_(iota) * (sum i, Pr.N_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, Pr.P_(iota)_(i) * x_(i))) = (sum iota, yP_(iota) * (sum i, Pr.P_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, Pr.N_(iota)_(i) * x_(i))))), (forall vP, vM in Point(r) : (forall iota : 0 < pi_(iota) => (sum i, Pr.P_(iota)_(i) * vP_(i)) + (sum i, Pr.N_(iota)_(i) * vM_(i)) = (sum i, Pr.N_(iota)_(i) * vP_(i)) + (sum i, Pr.P_(iota)_(i) * vM_(i))) => exists zP, zM in Point(p) : (sum l, zP_(l)) = (sum l, zM_(l)), (forall i : vP_(i) + (sum l, zM_(l) * R_(l)_(i)) = vM_(i) + (sum l, zP_(l) * R_(l)_(i)))), (forall zP, zM in Point(p) : (forall i : (sum l, zP_(l) * R_(l)_(i)) = sum l, zM_(l) * R_(l)_(i)), (sum l, zP_(l)) = (sum l, zM_(l)) => forall l : zP_(l) = zM_(l)) : exists Cp in QQ>0 : (K #outer lambda #multiplicity m #box rho #at Cp #from Lz #depth a #plus h)
  (inner): n, k, r, p, d, Lz, a, h, K0 in NN, m, q in NN>=1, K in Potential(n), rho in Weight(n), Pr in Chamber(k, r), pi in Point(k), u0, c in Exponent(r), R in IntForms(p, r), lambda in QQ>=0, C in QQ>0, (K #countedin Pr #content c #by C #from Lz #depth a #plus h #box rho), (pi #prices Pr #content c #value lambda), (forall iota : (sum i, Pr.P_(iota)_(i) * u0_(i)) + Pr.op_(iota) >= (sum i, Pr.N_(iota)_(i) * u0_(i)) + Pr.om_(iota)), (forall iota : forall l : (sum i, Pr.P_(iota)_(i) * R_(l)_(i)) + q * Pr.epsP_(iota) >= (sum i, Pr.N_(iota)_(i) * R_(l)_(i)) + q * Pr.epsM_(iota)), (forall l : forall iota : pi_(iota) * ((sum i, Pr.P_(iota)_(i) * R_(l)_(i)) + q * Pr.epsP_(iota)) = pi_(iota) * ((sum i, Pr.N_(iota)_(i) * R_(l)_(i)) + q * Pr.epsM_(iota))), (forall zP, zM in Point(p) : (forall i : (sum l, zP_(l) * R_(l)_(i)) = sum l, zM_(l) * R_(l)_(i)), (sum l, zP_(l)) = (sum l, zM_(l)) => forall l : zP_(l) = zM_(l)), p = d + 1, m = d + 1, (sum i, c_(i) * u0_(i)) <= K0, (forall i : u0_(i) + (sum l, R_(l)_(i)) + 1 <= h), (forall i : (sum l, R_(l)_(i)) <= a) : exists cp in QQ>0 : (K #inner lambda #multiplicity m #box rho #at cp #from Lz #depth a #plus h)
  core points: n, k, ku, r, p, d, Lz, a, h, K0 in NN, m, q in NN>=1, K in Potential(n), rho in Weight(n), Pr in Chamber(k, r), Pru in Chamber(ku, r), pi, sig in Point(k), piu in Point(ku), u0, c, cu in Exponent(r), R, Ru in IntForms(p, r), lambda, lambda2 in QQ>=0, C, Ci in QQ>0, (K #counted Pr #content c #by C #from Lz #depth a #plus h #box rho), 1 <= Lz, (pi #prices Pr #content c #value lambda), (sig #prices Pr #content c #value lambda2), p = d + 1, m = d + 1, (forall j : exists yP, yM in Point(k) : (forall iota : pi_(iota) + sig_(iota) = 0 => yP_(iota) + yM_(iota) = 0), (forall x in Exponent(r) : x_(j) + (sum iota, yP_(iota) * (sum i, Pr.N_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, Pr.P_(iota)_(i) * x_(i))) = (sum iota, yP_(iota) * (sum i, Pr.P_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, Pr.N_(iota)_(i) * x_(i))))), (forall vP, vM in Point(r) : (forall iota : 0 < pi_(iota) => (sum i, Pr.P_(iota)_(i) * vP_(i)) + (sum i, Pr.N_(iota)_(i) * vM_(i)) = (sum i, Pr.N_(iota)_(i) * vP_(i)) + (sum i, Pr.P_(iota)_(i) * vM_(i))) => exists zP, zM in Point(p) : (sum l, zP_(l)) = (sum l, zM_(l)), (forall i : vP_(i) + (sum l, zM_(l) * R_(l)_(i)) = vM_(i) + (sum l, zP_(l) * R_(l)_(i)))), (forall zP, zM in Point(p) : (forall i : (sum l, zP_(l) * R_(l)_(i)) = sum l, zM_(l) * R_(l)_(i)), (sum l, zP_(l)) = (sum l, zM_(l)) => forall l : zP_(l) = zM_(l)), (K #countedin Pru #content cu #by Ci #from Lz #depth a #plus h #box rho), (piu #prices Pru #content cu #value lambda), (forall iota : (sum i, Pru.P_(iota)_(i) * u0_(i)) + Pru.op_(iota) >= (sum i, Pru.N_(iota)_(i) * u0_(i)) + Pru.om_(iota)), (forall iota : forall l : (sum i, Pru.P_(iota)_(i) * Ru_(l)_(i)) + q * Pru.epsP_(iota) >= (sum i, Pru.N_(iota)_(i) * Ru_(l)_(i)) + q * Pru.epsM_(iota)), (forall l : forall iota : piu_(iota) * ((sum i, Pru.P_(iota)_(i) * Ru_(l)_(i)) + q * Pru.epsP_(iota)) = piu_(iota) * ((sum i, Pru.N_(iota)_(i) * Ru_(l)_(i)) + q * Pru.epsM_(iota))), (forall zP, zM in Point(p) : (forall i : (sum l, zP_(l) * Ru_(l)_(i)) = sum l, zM_(l) * Ru_(l)_(i)), (sum l, zP_(l)) = (sum l, zM_(l)) => forall l : zP_(l) = zM_(l)), (sum i, cu_(i) * u0_(i)) <= K0, (forall i : u0_(i) + (sum l, Ru_(l)_(i)) + 1 <= h), (forall i : (sum l, Ru_(l)_(i)) <= a) : exists cp in QQ>0 : exists Cp in QQ>0 : (K #points lambda #multiplicity m #box rho #between cp #and Cp #from Lz #depth a #plus h)
  (reading): n, k, ku, r, p, d, Lz, a, h, K0 in NN, m, q, qu in NN>=1, K in Potential(n), rho in Weight(n), Pr in Chamber(k, r), Pru in Chamber(ku, r), pi, sig in Point(k), piu, sigu in Point(ku), R, Ru in IntForms(p, r), u0, c, cu in Exponent(r), lambda in QQ>=0, C, Ci in QQ>0, p = d + 1, m = d + 1, (R #face Pr #prices pi #bound sig #content c #value lambda #level q), (K #counted Pr #content c #by C #from Lz #depth a #plus h #box rho), 1 <= Lz, (Ru #face Pru #prices piu #bound sigu #content cu #value lambda #level qu), (K #countedin Pru #content cu #by Ci #from Lz #depth a #plus h #box rho), (forall iota : (sum i, Pru.P_(iota)_(i) * u0_(i)) + Pru.op_(iota) >= (sum i, Pru.N_(iota)_(i) * u0_(i)) + Pru.om_(iota)), (sum i, cu_(i) * u0_(i)) <= K0, (forall i : u0_(i) + (sum l, Ru_(l)_(i)) + 1 <= h), (forall i : (sum l, Ru_(l)_(i)) <= a) : exists cp in QQ>0 : exists Cp in QQ>0 : (K #points lambda #multiplicity m #box rho #between cp #and Cp #from Lz #depth a #plus h)
  (chart): n, r, k, kk, L in NN, K in Potential(n), b in Exponent(n), B, c in Exponent(r), T in IntForms(n, r), G in Grid(n), Y in Moduli(n, r), S in Sizes(n, r), Te in Terms(k, r), Ch in Chart(n), Pr in Chamber(kk, r), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), (u #sublevel K #depth Ch.N #level L) => G(u) <= 1 / 2^L), (Y #sizes S #cap B #box b), (G #atleast Te #moduli Y #box b), (forall kappa : forall X : 1 <= Te.E_(kappa)_(X) => L + 1 <= Te.E_(kappa)_(X) * B_(X) + (sum Z, Te.E_(kappa)_(Z)) + Te.A_(kappa)), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall s in Exponent(r) : S(u) = s, (forall kappa : L + 1 <= (sum X, Te.E_(kappa)_(X) * (s_(X) + 1)) + Te.A_(kappa)) => (s #feasible Pr #level L)), (Ch #carries G #join T #sizes S #cap B #level L #box b), (forall X : c_(X) <= sum j, T_(j)_(X)) : (sum u <= b, iverson((u #sublevel K #depth Ch.N #level L))) <= 3^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X)))
  (chartin): n, k, kk, L, Lp, H in NN, K in Potential(n), b, B, c in Exponent(n), G in Grid(n), S, M in Sizes(n, n), Te in Terms(k, n), Ch in Chart(n), Pr in Chamber(kk, n), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L => (u #sublevel K #depth Ch.N #level L)), (Ch.F #sizes S #cap B #box b), (G #atmost Te #moduli Ch.F #box b), k <= 2^H, L <= Lp, (Ch #windows M #box b), (forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => forall kappa : Lp + Te.A_(kappa) + H <= sum X, Te.E_(kappa)_(X) * s_(X)), (forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => (forall j : s_(j) + 1 <= Ch.N), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : Ch.lam_(i) < Ch.lam_(j) => y_(i) * 2^(s_(i) + 1) + 2^(Ch.N) < u_(i) * 2^(s_(i) + 1), u_(i) * 2^(s_(i)) <= y_(i) * 2^(s_(i)) + 2^(Ch.N)) => y_(j) * 2^(s_(j)) + 2^(Ch.N) <= b_(j) * 2^(s_(j)))), (forall j : 1 <= c_(j)) : (1 / 2)^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X))) <= (sum u <= b, iverson((u #sublevel K #depth Ch.N #level L)))
  origin: ?{\text{proved here: the pair of a potential from the count of its chamber at every level, with the triple of the chamber (prices, the points of its least face, a second price vector) as the certificate, through \cref{lem:count}, and the counts of the chamber from a chart at every level through \cref{thm:pivots}. For a potential comparable to the monomials of a Newton polyhedron it is, in counts, the case of equality of \cite[Theorem~1.3]{Lin2017}, whose integral form over the reals, for a distance above one, goes back to \cite[Theorem~0.4]{Varchenko1976}; for the sum over the cone of the polyhedron, the leading pole of \cite[Lemma~5.4]{DenefHoornaert2001}}}

-- (outer): \cref{lem:count}(face) turns the prices \(\pi\), the second price vector and the \(d+1\) points of the face
-- into the data of \cref{lem:count}(above), whose power of \(L\) is at most \(L^d\) with \(m=d+1\), and the chamber
-- carries the bound to the potential. (inner): \cref{lem:count}(below) finds \(L^d\) points of the face near the value,
-- up to a constant, and the chamber carries them to the potential. (reading) joins the two, read from certificates
-- of one value; (chart) and (chartin) are \cref{thm:pivots} on one chart. For a potential comparable to the monomials
-- of a Newton polyhedron the pair is, in counts, the case of equality of \cite[Theorem~1.3]{Lin2017}, whose integral
-- form, for a distance above one, goes back to \cite[Theorem~0.4]{Varchenko1976}; for the sum over the cone of the
-- polyhedron it is the leading pole of \cite[Lemma~5.4]{DenefHoornaert2001}.
proof thm:pair
  "core read" with[L >= Lz by V[1 * h_2]; logic]
  "core readin" with[L >= Lz by V[1 * h_2]; logic]
  "core outlevel" with[L^f <= L^d by mono; with[L^m = L * L^d by eq; chain[L * 2^kappa * S <= L * 2^kappa * (C * 2^(n * N) * W) by mono; <= L * 2^kappa * (C * 2^(n * N) * (Kc * Q * L^f / 2^kappa)) by mono; = C * Kc * Q * (L * L^f) * 2^(n * N) by eq; <= C * Kc * Q * (L * L^d) * 2^(n * N) by mono; = C * Kc * Q * L^m * 2^(n * N) by eq; <= C * (Kc + 1) * Q * L^m * 2^(n * N) by mono]]]
  "core ceil" with[exists t0 in NN : t0 <= L / q, L / q < t0 + 1 by fact:floor(core)[x := L / q]; with[q * (L / q) = L by V; with[q * t0 <= q * (L / q) by mono; with[q * (L / q) < q * (t0 + 1) by mono; take[t := t0 + 1; (V, V)]]]]]
  "core levels" with[lambda * Lp <= lambda * (L + q) by mono; V[1 * h_3, 1 * h_4, 1 * h_5, 1 * hw1]]
  "core fit" logic[with[t <= L + 1 by V; with[t * (sum l, R_(l)_(X)) <= (L + 1) * (sum l, R_(l)_(X)) by mono; with[L * (sum l, R_(l)_(X)) <= L * a by mono; with[B_(X) = u0_(X) + t * (sum l, R_(l)_(X)) by logic; V[1 * h_1(X), 1 * h_3, 1 * h_4(X), 1 * hw2, 1 * hw3]]]]]]
  "core scale" logic[V[e_(alpha) * h_1]]
  "core grid" sum[cases[(u #sublevel K #depth N #level L); with[G(u) <= 1 / 2^L by logic; logic]; chain[iverson((u #sublevel K #depth N #level L)) <= iverson(1 <= 0) by logic; = 0 by V[0]; <= iverson(G(u) <= 1 / 2^L) by cases[G(u) <= 1 / 2^L; V[0]; V[0]]]]]
  "core gridin" sum[cases[G(u) <= 1 / 2^L; with[(u #sublevel K #depth N #level L) by logic; logic]; chain[iverson(G(u) <= 1 / 2^L) <= iverson(1 <= 0) by logic; = 0 by V[0]; <= iverson((u #sublevel K #depth N #level L)) by V[0]]]]
  "core cap" take[B_(X) := u0_(X) + t * (sum l, R_(l)_(X)); (logic, logic[with[(sum l, t * R_(l)_(i)) = t * (sum l, R_(l)_(i)) by sum; V[1 * hw1]]])]
