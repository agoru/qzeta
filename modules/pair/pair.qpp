  (outer) with[exists g, O, Kc in NN : exists zeta in IntForms(r, k) : exists nuP, nuM in Forms(r, r) : exists Am, Bm, e in Exponent(r) : exists psiP, psiM in Forms(p, r) : exists gP, gM in Point(p) : lambda <= lambda2 + g, (sum iota, pi_(iota) * Pr.op_(iota)) <= O, (forall alpha : Am_(alpha) * (sum iota, pi_(iota) * Pr.op_(iota)) + Bm_(alpha) * (sum iota, sig_(iota) * Pr.op_(iota)) <= O), (forall alpha : forall iota : zeta_(alpha)_(iota) <= Am_(alpha) * pi_(iota) + Bm_(alpha) * sig_(iota)), (forall i : forall x in Exponent(r) : x_(i) + (sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.N_(iota)_(j) * x_(j))) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.P_(iota)_(j) * x_(j))))) = sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.P_(iota)_(j) * x_(j))) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.N_(iota)_(j) * x_(j))))), 2^O * (prod alpha, (Am_(alpha) + Bm_(alpha) + O + 1)) * (prod i in 1..r, i) * 2^(r + 1) <= Kc, (forall alpha : Bm_(alpha) * g <= Bm_(alpha) * g * e_(alpha)), (forall alpha : e_(alpha) <= 1), (sum alpha, e_(alpha)) <= d, (forall kk : forall z in Exponent(p) : (sum l, z_(l) * ((sum i, psiP_(kk)_(i) * R_(l)_(i)) + gP_(kk))) = (sum l, z_(l) * ((sum i, psiM_(kk)_(i) * R_(l)_(i)) + gM_(kk))) + z_(kk)) by lem:count(face)[n := r, k := k, r := p, d := d, Pr := Pr, pi := pi, rho := sig, R := R, lambda := lambda, lambda2 := lambda2]; take[Cp := C * (Kc + 1) * (prod alpha, (1 + Bm_(alpha) * g)); logic[with[exists B in Exponent(r) : (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) by thm:pair(core read)[n := n, k := k, r := r, Lz := Lz, a := a, h := h, L := L, N := N, K := K, Pr := Pr, c := c, C := C, rho := rho, b := b]; with[1 <= L by V; with[forall alpha : e_(alpha) <= e_(alpha) * L by thm:pair(core scale)[r := r, L := L, e := e]; with[(sum iota, pi_(iota) * Pr.op_(iota)) <= O + (sum iota, pi_(iota) * Pr.om_(iota)) by lem:count(core netOffset)[n := r, k := k, O := O, Pr := Pr, pi := pi]; with[forall alpha : Am_(alpha) * (sum iota, pi_(iota) * Pr.op_(iota)) + Bm_(alpha) * (sum iota, sig_(iota) * Pr.op_(iota)) <= O + Am_(alpha) * (sum iota, pi_(iota) * Pr.om_(iota)) + Bm_(alpha) * (sum iota, sig_(iota) * Pr.om_(iota)) by lem:count(core netOffsets)[n := r, k := k, O := O, Pr := Pr, pi := pi, rho := sig, A := Am, B := Bm]; with[forall u, w in Exponent(r) : (forall i : u_(i) <= B_(i)), (forall i : w_(i) <= B_(i)), (forall alpha : (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.P_(iota)_(j) * u_(j))) + (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.N_(iota)_(j) * w_(j))) = (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.P_(iota)_(j) * w_(j))) + (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.N_(iota)_(j) * u_(j)))) => forall i : u_(i) = w_(i) by lem:count(core inject)[n := r, k := k, P := Pr.P, N := Pr.N, zeta := zeta, nuP := nuP, nuM := nuM, b := B]; with[(sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) <= Kc * (prod alpha, (1 + Bm_(alpha) * g)) * L^(sum alpha, e_(alpha)) / 2^kappa by lem:count(above)[kappa := kappa, n := r, k := k, L := L, O := O, K := Kc, g := g, Pr := Pr, pi := pi, rho := sig, zeta := zeta, c := c, b := B, A := Am, B := Bm, h := e, lambda := lambda, lambda2 := lambda2]; thm:pair(core outlevel)[n := n, N := N, L := L, kappa := kappa, f := (sum alpha, e_(alpha)), d := d, m := m, Kc := Kc, S := (sum u <= b, iverson((u #sublevel K #depth N #level L))), W := (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))), Q := (prod alpha, (1 + Bm_(alpha) * g)), C := C]]]]]]]]]]]
  (inner) with[exists E in NN : lambda * q + 1 <= E, lambda * q + 1 <= E by lem:count(core ceil)[x := lambda * q + 1, y := lambda * q + 1]; with[exists psiP, psiM in Forms(p, r) : exists gP, gM in Point(p) : forall kk : forall z in Exponent(p) : (sum l, z_(l) * ((sum i, psiP_(kk)_(i) * R_(l)_(i)) + gP_(kk))) = (sum l, z_(l) * ((sum i, psiM_(kk)_(i) * R_(l)_(i)) + gM_(kk))) + z_(kk) by fact:dual(core)[m := r, r := p, R := R]; take[cp := C / ((q^d * (prod i in 1..d, i) + 1) * 2^(E + K0)); logic[with[exists t in NN : L <= q * t, q * t <= L + q by thm:pair(core ceil)[L := L, q := q]; with[exists kp in NN : kp <= lambda * (q * t), lambda * (q * t) < kp + 1 by fact:floor(core)[x := lambda * (q * t)]; with[exists B in Exponent(r) : (forall X : B_(X) = u0_(X) + t * (sum l, R_(l)_(X))), (forall i : u0_(i) + (sum l, t * R_(l)_(i)) <= B_(i)) by thm:pair(core cap)[r := r, p := p, t := t, u0 := u0, R := R]; with[forall X : B_(X) + 1 <= N by thm:pair(core fit)[r := r, p := p, N := N, L := L, t := t, a := a, h := h, q := q, u0 := u0, B := B, R := R]; with[C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level q * t)) / 2^(sum X, c_(X) * s_(X))) <= sum u <= b, iverson((u #sublevel K #depth N #level L)) by thm:pair(core readin)[n := n, k := k, r := r, Lz := Lz, a := a, h := h, L := L, N := N, Lp := q * t, K := K, Pr := Pr, c := c, C := C, rho := rho, b := b, B := B]; with[(q * t)^d / 2^(kp + K0) <= q^d * (prod i in 1..d, i) * (sum s <= B, iverson((s #feasible Pr #level q * t), (sum X, c_(X) * s_(X)) <= kp + K0) / 2^(sum X, c_(X) * s_(X))) by lem:count(below)[n := r, k := k, r := p, d := d, L := q * t, q := q, m := t, kappa := kp, K0 := K0, D := q^d * (prod i in 1..d, i), Pr := Pr, pi := pi, u0 := u0, R := R, psiP := psiP, psiM := psiM, gP := gP, gM := gM, c := c, b := B, lambda := lambda; q * t = q * t by V[0]; q^d * (prod i in 1..d, i) = q^d * (prod i in 1..d, i) by logic]; with[(sum s <= B, iverson((s #feasible Pr #level q * t), (sum X, c_(X) * s_(X)) <= kp + K0) / 2^(sum X, c_(X) * s_(X))) <= (sum s <= B, iverson((s #feasible Pr #level q * t)) / 2^(sum X, c_(X) * s_(X))) by sum[with[iverson((s #feasible Pr #level q * t), (sum X, c_(X) * s_(X)) <= kp + K0) <= iverson((s #feasible Pr #level q * t)) by logic; mono]]; with[kp <= kappa + E by thm:pair(core levels)[L := L, Lp := q * t, q := q, kappa := kappa, kp := kp, E := E, lambda := lambda]; thm:pair(core inlevel)[n := n, N := N, L := L, Lp := q * t, kappa := kappa, kp := kp, E := E, K0 := K0, d := d, m := m, S := (sum u <= b, iverson((u #sublevel K #depth N #level L))), W := (sum s <= B, iverson((s #feasible Pr #level q * t)) / 2^(sum X, c_(X) * s_(X))), Wr := (sum s <= B, iverson((s #feasible Pr #level q * t), (sum X, c_(X) * s_(X)) <= kp + K0) / 2^(sum X, c_(X) * s_(X))), C := C, D := q^d * (prod i in 1..d, i)]]]]]]]]]]]]]
  "core points" with[exists Cp in QQ>0 : (K #outer lambda #multiplicity m #box rho #at Cp #from Lz #depth a #plus h) by thm:pair(outer)[n := n, k := k, r := r, p := p, d := d, Lz := Lz, a := a, h := h, m := m, K := K, rho := rho, Pr := Pr, pi := pi, sig := sig, R := R, c := c, lambda := lambda, lambda2 := lambda2, C := C]; with[exists cp in QQ>0 : (K #inner lambda #multiplicity m #box rho #at cp #from Lz #depth a #plus h) by thm:pair(inner)[n := n, k := ku, r := r, p := p, d := d, Lz := Lz, a := a, h := h, K0 := K0, m := m, q := q, K := K, rho := rho, Pr := Pru, pi := piu, u0 := u0, c := cu, R := Ru, lambda := lambda, C := Ci]; take[cp := cp; take[Cp := Cp; (logic, logic)]]]]
  (reading) with[exists mu in QQ>=0 : (sig #prices Pr #content c #value mu) by logic; with[exists Cp in QQ>0 : (K #outer lambda #multiplicity m #box rho #at Cp #from Lz #depth a #plus h) by thm:pair(outer)[n := n, k := k, r := r, p := p, d := d, Lz := Lz, a := a, h := h, m := m, K := K, rho := rho, Pr := Pr, pi := pi, sig := sig, R := R, c := c, lambda := lambda, lambda2 := mu, C := C]; with[exists cp in QQ>0 : (K #inner lambda #multiplicity m #box rho #at cp #from Lz #depth a #plus h) by thm:pair(inner)[n := n, k := ku, r := r, p := p, d := d, Lz := Lz, a := a, h := h, K0 := K0, m := m, q := qu, K := K, rho := rho, Pr := Pru, pi := piu, u0 := u0, c := cu, R := Ru, lambda := lambda, C := Ci]; take[cp := cp; take[Cp := Cp; (logic, logic)]]]]]
  (chart) with[(sum u <= b, iverson((u #sublevel K #depth Ch.N #level L))) <= (sum u <= b, iverson(G(u) <= 1 / 2^L)) by thm:pair(core grid)[n := n, N := Ch.N, L := L, K := K, G := G, b := b]; with[(sum u <= b, iverson(G(u) <= 1 / 2^L)) <= 3^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) by thm:pivots(above)[n := n, r := r, k := k, m := kk, L := L, b := b, B := B, c := c, T := T, G := G, Y := Y, S := S, Te := Te, Ch := Ch, Pr := Pr]; chain[(sum u <= b, iverson((u #sublevel K #depth Ch.N #level L))) <= (sum u <= b, iverson(G(u) <= 1 / 2^L)) by V[1 * hw1]; <= 3^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) by V[1 * hw2]]]]
  (chartin) with[(sum u <= b, iverson(G(u) <= 1 / 2^L)) <= (sum u <= b, iverson((u #sublevel K #depth Ch.N #level L))) by thm:pair(core gridin)[n := n, N := Ch.N, L := L, K := K, G := G, b := b]; with[(1 / 2)^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X))) <= (sum u <= b, iverson(G(u) <= 1 / 2^L)) by thm:pivots(below)[n := n, k := k, m := kk, L := L, Lp := Lp, H := H, b := b, B := B, c := c, G := G, S := S, M := M, Te := Te, Ch := Ch, Pr := Pr]; chain[(1 / 2)^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X))) <= (sum u <= b, iverson(G(u) <= 1 / 2^L)) by V[1 * hw2]; <= (sum u <= b, iverson((u #sublevel K #depth Ch.N #level L))) by V[1 * hw1]]]]

-- At the depth \(2\) the box \([0,\frac34]^2\) holds the \(16\) points \((u_1/4,u_2/4)\), \(0\le u_i\le3\). On the
-- chart whose members are the coordinates \(x\) and \(y\), the sizes of the coordinates \(\frac34\), \(\frac12\) and
-- \(\frac14\) are \(0\), \(1\) and \(2\), and the coordinate \(0\) takes the cap \(2\). The potential \(K=x^2y^2\) is
-- one monomial, its own term, so \cref{lem:compare} gives the one row \(L\le2s_1+2s_2\) of its chamber in the sizes
-- \(s\) (below), and the row \(L+1\le2s_1+2s_2+4\) at every counted point (above). At the level \(2\) the \(15\) points
-- with \(K\le\frac14\) are exactly the points whose sizes meet the row, all but \((\frac34,\frac34)\); at the level
-- \(5\) the row keeps \(8\) points, each with \(K\le\frac1{32}\); and at the level \(7\) the \(8\) points with
-- \(K\le\frac1{128}\) all meet the row of (above). The grid points whose coordinate has the size \(s_i\) are about
-- \(1\) halved \(s_i\) times of all of them, so the content is \(c=(1,1)\), and the price \(\frac12\) on the row ties it,
-- \(\frac12(2,2)=c\), with the value \(\lambda=\frac12\). The least face \(s_1+s_2=L/2\) is a segment, so \(m=2\), and
-- the pair of \(x^2y^2\) is \((\frac12,2)\) by \cref{thm:pivots} and \cref{thm:pair}, its real log canonical threshold
-- and its multiplicity \cite[Theorem~1.1]{Greenblatt2008}. For \(K=f^2\) with \(f=xy\), \(\lambda\) is half the
-- threshold of \(f\), since \(f^2\le t^2\) exactly where \(|f|\le t\), and the topological zeta function of \(xy\) has
-- its one pole, of order two, at \(-1=-2\lambda\).
example ex:monomial [the chamber of \(x^2y^2\) on the chart of the coordinates]
  origin: ?{\text{a classical case, read by \cref{lem:compare}, \cref{thm:pivots} and \cref{thm:pair} at the depth 2; the pair is that of the volume of \cref{rem:volume}}}
