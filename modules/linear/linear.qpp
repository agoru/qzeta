-- Q++ 0.2
module linear
uses identity

subsection sec:linear The linear chart

word lindist(mu in Exponent(n), beta in IntForms(n, n)) : Sizes(n, n)
define lindist(mu, beta)(u)_(j) := max(mu_(j) * u_(j) - (sum i, beta_(j)_(i) * u_(i)), 0) + max((sum i, beta_(j)_(i) * u_(i)) - mu_(j) * u_(j), 0)
word linmod(mu in Exponent(n), beta in IntForms(n, n), N in NN) : Moduli(n, n)
define linmod(mu, beta, N)(u)_(j) := lindist(mu, beta)(u)_(j) / 2^N
word linsize(mu in Exponent(n), beta in IntForms(n, n), B in Exponent(n), N in NN) : Sizes(n, n)
define linsize(mu, beta, B, N)(u)_(j) := sum k in 1..B_(j), iverson(lindist(mu, beta)(u)_(j) * 2^k <= 2^N)
word linstart(mu in Exponent(n), beta in IntForms(n, n)) : Sizes(n, n)
define linstart(mu, beta)(u)_(j) := sum k in 1..(sum i, beta_(j)_(i) * u_(i)), iverson(mu_(j) * k <= sum i, beta_(j)_(i) * u_(i))
word lingap(mu in Exponent(n), beta in IntForms(n, n)) : Sizes(n, n)
define lingap(mu, beta)(u)_(j) := max(u_(j) - linstart(mu, beta)(u)_(j), 0)
word linlow(mu in Exponent(n), beta in IntForms(n, n), N in NN) : Moduli(n, n)
define linlow(mu, beta, N)(u)_(j) := lingap(mu, beta)(u)_(j) / 2^N
word linlowsize(mu in Exponent(n), beta in IntForms(n, n), B in Exponent(n), N in NN) : Sizes(n, n)
define linlowsize(mu, beta, B, N)(u)_(j) := sum k in 1..B_(j), iverson(lingap(mu, beta)(u)_(j) * 2^k <= 2^N)

-- The linear chart reads a point of the box at the distances of its coordinates to the forms of the lower ones,
-- by depth; on it a loss between diagonal terms of those distances has the pair \((\sum_X1/E_X,1)\) (points).
lemma lem:linear [the linear chart]
  core floorcap: mu, S, K in NN : (sum k in 1..K, iverson(mu * k <= S)) <= K
  fix core floorcap linear.floor
  core floortop: mu, S, K in NN : forall s in NN : s = (sum k in 1..K, iverson(mu * k <= S)) => (K <= s or S < mu * (s + 1))
  fix core floortop linear.floor
  core floorsize: mu, S, K in NN : forall s in NN : s = (sum k in 1..K, iverson(mu * k <= S)) => mu * s <= S
  fix core floorsize linear.floor
  core floor: mu, S, M in NN, 1 <= mu, M = (sum k in 1..S, iverson(mu * k <= S)) : mu * M <= S, S < mu * (M + 1)
  fix core floor linear.floor
  core sizedcap: N, B, d, s in NN, s = (sum k in 1..B, iverson(d * 2^k <= 2^N)) : s <= B
  core sizedabove: N, B, d, s in NN, y in QQ>=0, d <= 2^N, 2^N * y = d, s = (sum k in 1..B, iverson(d * 2^k <= 2^N)) : y <= 1 / 2^s
  core sizedbelow: N, B, d, s in NN, y in QQ>=0, 2^N * y = d, s = (sum k in 1..B, iverson(d * 2^k <= 2^N)) : (s = B or 1 / 2^(s + 1) < y)
  core sizes: n, N in NN, Y in Moduli(n, n), S, D in Sizes(n, n), B, b in Exponent(n), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall d in Exponent(n) : D(u) = d => forall j : d_(j) <= 2^N), (forall u in Exponent(n) : forall y in Point(n) : Y(u) = y => forall d in Exponent(n) : D(u) = d => forall j : 2^N * y_(j) = d_(j)), (forall u in Exponent(n) : forall s in Exponent(n) : S(u) = s => forall d in Exponent(n) : D(u) = d => forall j : s_(j) = sum k in 1..B_(j), iverson(d_(j) * 2^k <= 2^N)) : (Y #sizes S #cap B #box b)
  core modread: n, N in NN, mu, u, d in Exponent(n), beta in IntForms(n, n), x in Point(n), (forall i : 2^N * x_(i) = u_(i)), (forall j : d_(j) = max(mu_(j) * u_(j) - (sum i, beta_(j)_(i) * u_(i)), 0) + max((sum i, beta_(j)_(i) * u_(i)) - mu_(j) * u_(j), 0)) : forall j : 2^N * (max(mu_(j) * x_(j) - (sum i, beta_(j)_(i) * x_(i)), 0) + max((sum i, beta_(j)_(i) * x_(i)) - mu_(j) * x_(j), 0)) = d_(j)
  core bound: n, N in NN, mu, u in Exponent(n), beta in IntForms(n, n), rho in Weight(n), (forall i : u_(i) <= 2^N * rho_(i)), (forall j : mu_(j) * rho_(j) <= 1), (forall j : (sum i, beta_(j)_(i) * rho_(i)) <= 1) : forall j : max(mu_(j) * u_(j) - (sum i, beta_(j)_(i) * u_(i)), 0) + max((sum i, beta_(j)_(i) * u_(i)) - mu_(j) * u_(j), 0) <= 2^N
  core reads: n in NN, lam, u, w in Exponent(n), beta in IntForms(n, n), (forall j : forall i : 1 <= beta_(j)_(i) => lam_(i) < lam_(j)) : forall j : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)) => (sum i, beta_(j)_(i) * u_(i)) = (sum i, beta_(j)_(i) * w_(i))
  core twopoint: mu, a, c, S, T in NN, 1 <= mu, S = T : a <= c + (max(mu * a - S, 0) + max(S - mu * a, 0)) + (max(mu * c - T, 0) + max(T - mu * c, 0))
  fix core twopoint linear.start
  core lowbound: mu, S, M, x in NN, 1 <= mu, mu * M <= S, S < mu * (M + 1), M + 1 <= x : max(mu * x - S, 0) + max(S - mu * x, 0) <= mu * max(x - M, 0), 1 <= max(mu * x - S, 0) + max(S - mu * x, 0)
  fix core lowbound linear.lowread
  core wall: N, g, s, u, M in NN, g <= s, u * 2^s <= M * 2^s + 2^N : u * 2^g <= M * 2^g + 2^N
  fix core wall linear.wall
  core zerosum: n in NN, lam, u in Exponent(n), beta in IntForms(n, n), (forall i : forall l : 1 <= beta_(i)_(l) => lam_(l) < lam_(i)) : forall i : lam_(i) <= 0 => (sum l, beta_(i)_(l) * u_(l)) <= 0
  core termsum: n, g, P, Gam in NN, lam, u in Exponent(n), beta in IntForms(n, n), (forall i : forall l : 1 <= beta_(i)_(l) => lam_(l) < lam_(i)), 1 + (sum m, sum l, beta_(m)_(l)) <= Gam : forall i : (forall l : lam_(l) < lam_(i) => u_(l) * 2^g <= P) => (sum l, beta_(i)_(l) * u_(l)) * 2^g + P <= Gam * P
  core ladder: n, N, g, L0, Gam, t in NN, lam, mu, u, M in Exponent(n), beta in IntForms(n, n), (forall i : 1 <= mu_(i)), (forall i : forall l : 1 <= beta_(i)_(l) => lam_(l) < lam_(i)), 1 + (sum m, sum l, beta_(m)_(l)) <= Gam, (forall i : mu_(i) * M_(i) <= (sum l, beta_(i)_(l) * u_(l))), (forall i : lam_(i) < L0 => u_(i) * 2^g <= M_(i) * 2^g + 2^N) : forall i : lam_(i) <= L0, lam_(i) <= t => M_(i) * 2^g + 2^N <= Gam^t * 2^N
  core room: n, N, g, Gam in NN, lam, mu, u, M, s in Exponent(n), beta in IntForms(n, n), (forall i : 1 <= mu_(i)), (forall i : forall l : 1 <= beta_(i)_(l) => lam_(l) < lam_(i)), 1 + (sum m, sum l, beta_(m)_(l)) <= Gam, (forall i : mu_(i) * M_(i) <= (sum l, beta_(i)_(l) * u_(l))), (forall i : g <= s_(i)) : forall j : (forall i : lam_(i) < lam_(j) => u_(i) * 2^(s_(i)) <= M_(i) * 2^(s_(i)) + 2^N) => M_(j) * 2^g + 2^N <= Gam^(lam_(j)) * 2^N
  core rescale: N, g, s, M, b in NN, g <= s, M * 2^g + 2^N <= b * 2^g : M * 2^s + 2^N <= b * 2^s
  fix core rescale linear.wall
  core roombox: N, g, h, Lam, Gam, b in NN, rho in QQ>0, 2 * Gam^Lam <= 2^g * rho, 2 <= 2^h * rho, h <= N, b <= 2^N * rho, 2^N * rho < b + 1 : Gam^Lam * 2^N <= b * 2^g
  fix core roombox linear.roombox
  core chart: n, N in NN, lam, mu in Exponent(n), beta in IntForms(n, n) : exists Ch in Chart(n) : (forall i : Ch.lam_(i) = lam_(i)), Ch.N = N, (forall u in Exponent(n) : forall x in Point(n) : Ch.F(u) = x => forall d in Exponent(n) : (forall j : d_(j) = max(mu_(j) * u_(j) - (sum i, beta_(j)_(i) * u_(i)), 0) + max((sum i, beta_(j)_(i) * u_(i)) - mu_(j) * u_(j), 0)) => forall j : 2^(Ch.N) * x_(j) = d_(j))
  core same: N, d in NN, y, z in QQ>=0, 2^N * y = d, 2^N * z = d : y = z
  core inbox: N, u in NN, x in QQ>=0, rho in QQ>0, 2^N * x = u, u <= 2^N * rho : x <= rho
  core above: n, k, L, N in NN, K in Potential(n), Te in Terms(k, n), lam, mu, b, B, c in Exponent(n), beta in IntForms(n, n), rho in Weight(n), Pr in Chamber(k, n), (forall j : forall i : 1 <= beta_(j)_(i) => lam_(i) < lam_(j)), (forall i : 1 <= mu_(i)), (forall j : mu_(j) * rho_(j) <= 1), (forall j : (sum i, beta_(j)_(i) * rho_(i)) <= 1), (forall i : b_(i) <= 2^N * rho_(i)), (forall X : B_(X) <= N), (forall x in Point(n) : (forall i : x_(i) <= rho_(i)) => forall y in Point(n) : (forall X : y_(X) = max(mu_(X) * x_(X) - (sum i, beta_(X)_(i) * x_(i)), 0) + max((sum i, beta_(X)_(i) * x_(i)) - mu_(X) * x_(X), 0)) => forall kappa : Te.q_(kappa) * (prod X, y_(X)^(Te.E_(kappa)_(X))) <= K(x)), (forall kappa : exists X : 1 <= Te.E_(kappa)_(X)), (forall kappa : 1 <= Te.q_(kappa) * 2^(Te.A_(kappa))), (forall kappa : forall X : 1 <= Te.E_(kappa)_(X) => L + 1 <= Te.E_(kappa)_(X) * B_(X) + (sum Z, Te.E_(kappa)_(Z)) + Te.A_(kappa)), (forall kappa : forall i : Pr.P_(kappa)_(i) = Te.E_(kappa)_(i), Pr.N_(kappa)_(i) = 0), (forall kappa : Pr.op_(kappa) = (sum X, Te.E_(kappa)_(X)) + Te.A_(kappa), Pr.om_(kappa) = 1), (forall kappa : Pr.epsP_(kappa) = 0, Pr.epsM_(kappa) = 1), (forall X : c_(X) = 1) : (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= 3^n * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X)))
  core lowread: N, mu, S, M, x, p, d in NN, y, v in QQ>=0, 1 <= mu, M = (sum k in 1..S, iverson(mu * k <= S)), p = max(x - M, 0), d = max(mu * x - S, 0) + max(S - mu * x, 0), 2^N * y = p, 2^N * v = d, 0 < y : v <= mu * y, 0 < v
  fix core lowread linear.lowread
  core chartlow: n, N in NN, lam, mu in Exponent(n), beta in IntForms(n, n) : exists Ch in Chart(n) : (forall i : Ch.lam_(i) = lam_(i)), Ch.N = N, (forall u in Exponent(n) : forall x in Point(n) : Ch.F(u) = x => forall e in Exponent(n) : (forall j : e_(j) = (sum k in 1..(sum i, beta_(j)_(i) * u_(i)), iverson(mu_(j) * k <= (sum i, beta_(j)_(i) * u_(i))))) => forall d in Exponent(n) : (forall j : d_(j) = max(u_(j) - e_(j), 0)) => forall j : 2^(Ch.N) * x_(j) = d_(j))
  core lowwin: N, x, M, p in NN, y in QQ>=0, p = max(x - M, 0), 2^N * y = p, M <= x : 2^N * y + M = x
  fix core lowwin linear.lowread
  core startsame: mu, S, T, y, z in NN, S = T, y = (sum k in 1..S, iverson(mu * k <= S)), z = (sum k in 1..T, iverson(mu * k <= T)) : y = z
  fix core startsame linear.start
  core below: n, k, L, Lp, H, N, g, Gam in NN, K in Potential(n), Te in Terms(k, n), lam, mu, b, B, c in Exponent(n), beta in IntForms(n, n), rho in Weight(n), Pr in Chamber(k, n), (forall j : forall i : 1 <= beta_(j)_(i) => lam_(i) < lam_(j)), (forall i : 1 <= mu_(i)), (forall j : mu_(j) * rho_(j) <= 1), (forall j : (sum i, beta_(j)_(i) * rho_(i)) <= 1), (forall i : b_(i) <= 2^N * rho_(i)), (forall X : B_(X) + 1 <= N), L <= Lp, k <= 2^H, (forall x in Point(n) : (forall i : x_(i) <= rho_(i)) => forall y in Point(n) : (forall X : y_(X) = max(mu_(X) * x_(X) - (sum i, beta_(X)_(i) * x_(i)), 0) + max((sum i, beta_(X)_(i) * x_(i)) - mu_(X) * x_(X), 0)), (forall X : 0 < y_(X)) => K(x) <= sum kappa, Te.q_(kappa) * (prod X, y_(X)^(Te.E_(kappa)_(X)))), (forall kappa : Te.q_(kappa) * (prod X, mu_(X)^(Te.E_(kappa)_(X))) <= 2^(Te.A_(kappa))), 1 + (sum m, sum l, beta_(m)_(l)) <= Gam, (forall j : Gam^(lam_(j)) * 2^N <= b_(j) * 2^g), (forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => (forall kappa : Lp + Te.A_(kappa) + H <= sum X, Te.E_(kappa)_(X) * s_(X)), (forall X : g <= s_(X))), (forall j : 1 <= c_(j)) : (1 / 2)^n * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X))) <= (sum u <= b, iverson((u #sublevel K #depth N #level L)))
  (countedin): n, k, Lz, a, h, H, g, Gam in NN, K in Potential(n), Te in Terms(k, n), lam, mu, c in Exponent(n), beta in IntForms(n, n), Pr in Chamber(k, n), rho in Weight(n), (forall j : forall i : 1 <= beta_(j)_(i) => lam_(i) < lam_(j)), (forall i : 1 <= mu_(i)), (forall j : mu_(j) * rho_(j) <= 1), (forall j : (sum i, beta_(j)_(i) * rho_(i)) <= 1), k <= 2^H, (forall x in Point(n) : (forall i : x_(i) <= rho_(i)) => forall y in Point(n) : (forall X : y_(X) = max(mu_(X) * x_(X) - (sum i, beta_(X)_(i) * x_(i)), 0) + max((sum i, beta_(X)_(i) * x_(i)) - mu_(X) * x_(X), 0)), (forall X : 0 < y_(X)) => K(x) <= sum kappa, Te.q_(kappa) * (prod X, y_(X)^(Te.E_(kappa)_(X)))), (forall kappa : Te.q_(kappa) * (prod X, mu_(X)^(Te.E_(kappa)_(X))) <= 2^(Te.A_(kappa))), 1 + (sum m, sum l, beta_(m)_(l)) <= Gam, (forall j : 2 * Gam^(lam_(j)) <= 2^g * rho_(j)), (forall j : 2 <= 2^h * rho_(j)), (forall Lp in NN : Lp >= Lz => forall s in Exponent(n) : (s #feasible Pr #level Lp) => (forall kappa : Lp + Te.A_(kappa) + H <= sum X, Te.E_(kappa)_(X) * s_(X)), (forall X : g <= s_(X))), (forall j : 1 <= c_(j)) : (K #countedin Pr #content c #by (1 / 2)^n #from Lz #depth a #plus h #box rho)
  (counted): n, k, Lz, a, h in NN, K in Potential(n), Te in Terms(k, n), lam, mu, c in Exponent(n), beta in IntForms(n, n), Pr in Chamber(k, n), rho in Weight(n), 1 <= a, (forall j : forall i : 1 <= beta_(j)_(i) => lam_(i) < lam_(j)), (forall i : 1 <= mu_(i)), (forall j : mu_(j) * rho_(j) <= 1), (forall j : (sum i, beta_(j)_(i) * rho_(i)) <= 1), (forall x in Point(n) : (forall i : x_(i) <= rho_(i)) => forall y in Point(n) : (forall X : y_(X) = max(mu_(X) * x_(X) - (sum i, beta_(X)_(i) * x_(i)), 0) + max((sum i, beta_(X)_(i) * x_(i)) - mu_(X) * x_(X), 0)) => forall kappa : Te.q_(kappa) * (prod X, y_(X)^(Te.E_(kappa)_(X))) <= K(x)), (forall kappa : exists X : 1 <= Te.E_(kappa)_(X)), (forall kappa : 1 <= Te.q_(kappa) * 2^(Te.A_(kappa))), (forall kappa : forall i : Pr.P_(kappa)_(i) = Te.E_(kappa)_(i), Pr.N_(kappa)_(i) = 0), (forall kappa : Pr.op_(kappa) = (sum X, Te.E_(kappa)_(X)) + Te.A_(kappa), Pr.om_(kappa) = 1), (forall kappa : Pr.epsP_(kappa) = 0, Pr.epsM_(kappa) = 1), (forall X : c_(X) = 1) : (K #counted Pr #content c #by 3^n #from Lz #depth a #plus h #box rho)
  core diagabove: n, Lz, a, h, a0 in NN, K in Potential(n), rho in Weight(n), lam, mu, E, c in Exponent(n), beta in IntForms(n, n), Q1 in QQ>0, (forall j : forall i : 1 <= beta_(j)_(i) => lam_(i) < lam_(j)), (forall i : 1 <= mu_(i)), (forall j : mu_(j) * rho_(j) <= 1), (forall j : (sum i, beta_(j)_(i) * rho_(i)) <= 1), (forall x in Point(n) : (forall i : x_(i) <= rho_(i)) => forall y in Point(n) : (forall X : y_(X) = max(mu_(X) * x_(X) - (sum i, beta_(X)_(i) * x_(i)), 0) + max((sum i, beta_(X)_(i) * x_(i)) - mu_(X) * x_(X), 0)) => forall X : Q1 * y_(X)^(E_(X)) <= K(x)), 1 <= Q1 * 2^a0, (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), 1 <= a : exists Pr in Chamber(n, n) : (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pr.N_(iota)_(i) = 0), (forall iota : Pr.epsP_(iota) = 0), (forall iota : Pr.epsM_(iota) = 1), (K #counted Pr #content c #by 3^n #from Lz #depth a #plus h #box rho)
  core diagbelow: n, Lz, a, h, a0, H, g, Gam in NN, K in Potential(n), rho in Weight(n), lam, mu, E, c in Exponent(n), beta in IntForms(n, n), Q2 in QQ>0, (forall j : forall i : 1 <= beta_(j)_(i) => lam_(i) < lam_(j)), (forall i : 1 <= mu_(i)), (forall j : mu_(j) * rho_(j) <= 1), (forall j : (sum i, beta_(j)_(i) * rho_(i)) <= 1), (forall x in Point(n) : (forall i : x_(i) <= rho_(i)) => forall y in Point(n) : (forall X : y_(X) = max(mu_(X) * x_(X) - (sum i, beta_(X)_(i) * x_(i)), 0) + max((sum i, beta_(X)_(i) * x_(i)) - mu_(X) * x_(X), 0)), (forall X : 0 < y_(X)) => K(x) <= Q2 * (sum X, y_(X)^(E_(X)))), (forall X : Q2 * mu_(X)^(E_(X)) <= 2^a0), n <= 2^H, (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), 1 + (sum m, sum l, beta_(m)_(l)) <= Gam, (forall j : 2 * Gam^(lam_(j)) <= 2^g * rho_(j)), (forall j : 2 <= 2^h * rho_(j)), (forall X : g * E_(X) <= Lz + a0 + H) : exists Pru in Chamber(n, n) : (forall iota : forall i : Pru.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pru.N_(iota)_(i) = 0), (forall iota : Pru.op_(iota) = 0), (forall iota : Pru.om_(iota) = a0 + H), (forall iota : Pru.epsP_(iota) = 0), (forall iota : Pru.epsM_(iota) = 1), (K #countedin Pru #content c #by (1 / 2)^n #from Lz #depth a #plus h #box rho)
  (points): n, Lz, a, h, a0, H, g, Gam in NN, q in NN>=1, K in Potential(n), rho in Weight(n), lam, mu, E, c in Exponent(n), beta in IntForms(n, n), R in IntForms(1, n), Q1, Q2 in QQ>0, (forall j : forall i : 1 <= beta_(j)_(i) => lam_(i) < lam_(j)), (forall i : 1 <= mu_(i)), (forall j : mu_(j) * rho_(j) <= 1), (forall j : (sum i, beta_(j)_(i) * rho_(i)) <= 1), (forall x in Point(n) : (forall i : x_(i) <= rho_(i)) => forall y in Point(n) : (forall X : y_(X) = max(mu_(X) * x_(X) - (sum i, beta_(X)_(i) * x_(i)), 0) + max((sum i, beta_(X)_(i) * x_(i)) - mu_(X) * x_(X), 0)) => forall X : Q1 * y_(X)^(E_(X)) <= K(x)), (forall x in Point(n) : (forall i : x_(i) <= rho_(i)) => forall y in Point(n) : (forall X : y_(X) = max(mu_(X) * x_(X) - (sum i, beta_(X)_(i) * x_(i)), 0) + max((sum i, beta_(X)_(i) * x_(i)) - mu_(X) * x_(X), 0)), (forall X : 0 < y_(X)) => K(x) <= Q2 * (sum X, y_(X)^(E_(X)))), 1 <= Q1 * 2^a0, (forall X : Q2 * mu_(X)^(E_(X)) <= 2^a0), n <= 2^H, (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), 1 <= a, 1 + (sum m, sum l, beta_(m)_(l)) <= Gam, (forall j : 2 * Gam^(lam_(j)) <= 2^g * rho_(j)), (forall j : 2 <= 2^h * rho_(j)), (forall X : g * E_(X) <= Lz + a0 + H), (forall l : forall j : E_(j) * R_(l)_(j) = q), 1 <= Lz, (forall i : a0 + H + (sum l, R_(l)_(i)) + 1 <= h), (forall i : (sum l, R_(l)_(i)) <= a) : exists cp in QQ>0 : exists Cp in QQ>0 : (K #points (sum iota, 1 / E_(iota)) #multiplicity 1 #box rho #between cp #and Cp #from Lz #depth a #plus h)

proof lem:linear
  "core floorcap" ind[K; V; with[(sum k in 1..K + 1, iverson(mu * k <= S)) = (sum k in 1..K, iverson(mu * k <= S)) + iverson(mu * (K + 1) <= S) by sum; with[(sum k in 1..K, iverson(mu * k <= S)) <= K by logic; with[iverson(mu * (K + 1) <= S) <= 1 by V; V[1 * hw1, 1 * hw2, 1 * hw3]]]]]
