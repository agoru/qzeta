-- Q++ 0.2
module layers
uses compare

subsection sec:layers Layers at the unit letter

-- A bundle \(T\) of terms is the polynomial \(\sum_\kappa q_\kappa X^{E_\kappa}=\sum_u c_u(T)\,(X-1)^u\), with
-- \(c_u(T)=\sum_\kappa q_\kappa\prod_X\binom{E_{\kappa X}}{u_X}\), its coefficients in the gaps at the unit letter. Two sums
-- \(A+B\) and \(C+D\) tie through degree \(j\) off \(c\) when their coefficients of degree at most \(j\) tie, on the gaps
-- of the letters outside the tie set \(c\) (degree), and on all gaps when the tie set is empty (through). They tie in the layer of \(X^a-X^b\) when their masses tie on every class
-- of exponents modulo \(a-b\), counted up to \(n\) steps (layer).
relation (A #plus B #tie C #plus D #degree j #off c) := k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), j in NN, c in Exponent(r), (forall u in Exponent(r) : (forall X : u_(X) <= j) => (forall X : 1 <= c_(X) => u_(X) = 0) => (sum X, u_(X)) <= j => (sum kappa, A.q_(kappa) * (prod X, binom(A.E_(kappa)_(X), u_(X)))) + (sum kappa, B.q_(kappa) * (prod X, binom(B.E_(kappa)_(X), u_(X)))) = (sum kappa, C.q_(kappa) * (prod X, binom(C.E_(kappa)_(X), u_(X)))) + (sum kappa, D.q_(kappa) * (prod X, binom(D.E_(kappa)_(X), u_(X)))))
relation (A #plus B #tie C #plus D #through j) := k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), j in NN, (forall u in Exponent(r) : (forall X : u_(X) <= j) => (sum X, u_(X)) <= j => (sum kappa, A.q_(kappa) * (prod X, binom(A.E_(kappa)_(X), u_(X)))) + (sum kappa, B.q_(kappa) * (prod X, binom(B.E_(kappa)_(X), u_(X)))) = (sum kappa, C.q_(kappa) * (prod X, binom(C.E_(kappa)_(X), u_(X)))) + (sum kappa, D.q_(kappa) * (prod X, binom(D.E_(kappa)_(X), u_(X)))))
relation (A #plus B #tie C #plus D #layer a #minus b #to n) := k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), a, b in Exponent(r), n in NN, (forall lambda : (sum kappa, A.q_(kappa) * (sum t in 0..n, iverson((forall X : A.E_(kappa)_(X) + t * b_(X) = A.E_(lambda)_(X) + t * a_(X)) or (forall X : A.E_(kappa)_(X) + t * a_(X) = A.E_(lambda)_(X) + t * b_(X))))) + (sum kappa, B.q_(kappa) * (sum t in 0..n, iverson((forall X : B.E_(kappa)_(X) + t * b_(X) = A.E_(lambda)_(X) + t * a_(X)) or (forall X : B.E_(kappa)_(X) + t * a_(X) = A.E_(lambda)_(X) + t * b_(X))))) = (sum kappa, C.q_(kappa) * (sum t in 0..n, iverson((forall X : C.E_(kappa)_(X) + t * b_(X) = A.E_(lambda)_(X) + t * a_(X)) or (forall X : C.E_(kappa)_(X) + t * a_(X) = A.E_(lambda)_(X) + t * b_(X))))) + (sum kappa, D.q_(kappa) * (sum t in 0..n, iverson((forall X : D.E_(kappa)_(X) + t * b_(X) = A.E_(lambda)_(X) + t * a_(X)) or (forall X : D.E_(kappa)_(X) + t * a_(X) = A.E_(lambda)_(X) + t * b_(X)))))), (forall lambda : (sum kappa, A.q_(kappa) * (sum t in 0..n, iverson((forall X : A.E_(kappa)_(X) + t * b_(X) = B.E_(lambda)_(X) + t * a_(X)) or (forall X : A.E_(kappa)_(X) + t * a_(X) = B.E_(lambda)_(X) + t * b_(X))))) + (sum kappa, B.q_(kappa) * (sum t in 0..n, iverson((forall X : B.E_(kappa)_(X) + t * b_(X) = B.E_(lambda)_(X) + t * a_(X)) or (forall X : B.E_(kappa)_(X) + t * a_(X) = B.E_(lambda)_(X) + t * b_(X))))) = (sum kappa, C.q_(kappa) * (sum t in 0..n, iverson((forall X : C.E_(kappa)_(X) + t * b_(X) = B.E_(lambda)_(X) + t * a_(X)) or (forall X : C.E_(kappa)_(X) + t * a_(X) = B.E_(lambda)_(X) + t * b_(X))))) + (sum kappa, D.q_(kappa) * (sum t in 0..n, iverson((forall X : D.E_(kappa)_(X) + t * b_(X) = B.E_(lambda)_(X) + t * a_(X)) or (forall X : D.E_(kappa)_(X) + t * a_(X) = B.E_(lambda)_(X) + t * b_(X)))))), (forall lambda : (sum kappa, A.q_(kappa) * (sum t in 0..n, iverson((forall X : A.E_(kappa)_(X) + t * b_(X) = C.E_(lambda)_(X) + t * a_(X)) or (forall X : A.E_(kappa)_(X) + t * a_(X) = C.E_(lambda)_(X) + t * b_(X))))) + (sum kappa, B.q_(kappa) * (sum t in 0..n, iverson((forall X : B.E_(kappa)_(X) + t * b_(X) = C.E_(lambda)_(X) + t * a_(X)) or (forall X : B.E_(kappa)_(X) + t * a_(X) = C.E_(lambda)_(X) + t * b_(X))))) = (sum kappa, C.q_(kappa) * (sum t in 0..n, iverson((forall X : C.E_(kappa)_(X) + t * b_(X) = C.E_(lambda)_(X) + t * a_(X)) or (forall X : C.E_(kappa)_(X) + t * a_(X) = C.E_(lambda)_(X) + t * b_(X))))) + (sum kappa, D.q_(kappa) * (sum t in 0..n, iverson((forall X : D.E_(kappa)_(X) + t * b_(X) = C.E_(lambda)_(X) + t * a_(X)) or (forall X : D.E_(kappa)_(X) + t * a_(X) = C.E_(lambda)_(X) + t * b_(X)))))), (forall lambda : (sum kappa, A.q_(kappa) * (sum t in 0..n, iverson((forall X : A.E_(kappa)_(X) + t * b_(X) = D.E_(lambda)_(X) + t * a_(X)) or (forall X : A.E_(kappa)_(X) + t * a_(X) = D.E_(lambda)_(X) + t * b_(X))))) + (sum kappa, B.q_(kappa) * (sum t in 0..n, iverson((forall X : B.E_(kappa)_(X) + t * b_(X) = D.E_(lambda)_(X) + t * a_(X)) or (forall X : B.E_(kappa)_(X) + t * a_(X) = D.E_(lambda)_(X) + t * b_(X))))) = (sum kappa, C.q_(kappa) * (sum t in 0..n, iverson((forall X : C.E_(kappa)_(X) + t * b_(X) = D.E_(lambda)_(X) + t * a_(X)) or (forall X : C.E_(kappa)_(X) + t * a_(X) = D.E_(lambda)_(X) + t * b_(X))))) + (sum kappa, D.q_(kappa) * (sum t in 0..n, iverson((forall X : D.E_(kappa)_(X) + t * b_(X) = D.E_(lambda)_(X) + t * a_(X)) or (forall X : D.E_(kappa)_(X) + t * a_(X) = D.E_(lambda)_(X) + t * b_(X))))))
relation (A #within n) := k, r, n in NN, A in Terms(k, r), (forall kappa : forall X : A.E_(kappa)_(X) <= n)
relation (E #within n #less a #plus b) := k, r, n in NN, E in Terms(k, r), a, b in Exponent(r), (forall kappa : forall X : E.E_(kappa)_(X) + a_(X) + b_(X) <= n)
relation (A #plus B #tie C #plus D #times a #minus b #by E #less F #to n) := k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), l in NN, E, F in Terms(l, r), a, b in Exponent(r), n in NN, (forall u in Exponent(r) : (forall X : u_(X) <= n) => (sum kappa, A.q_(kappa) * (prod X, binom(A.E_(kappa)_(X), u_(X)))) + (sum kappa, B.q_(kappa) * (prod X, binom(B.E_(kappa)_(X), u_(X)))) + (sum kappa, E.q_(kappa) * (prod X, binom(E.E_(kappa)_(X) + b_(X), u_(X)))) + (sum kappa, F.q_(kappa) * (prod X, binom(F.E_(kappa)_(X) + a_(X), u_(X)))) = (sum kappa, C.q_(kappa) * (prod X, binom(C.E_(kappa)_(X), u_(X)))) + (sum kappa, D.q_(kappa) * (prod X, binom(D.E_(kappa)_(X), u_(X)))) + (sum kappa, E.q_(kappa) * (prod X, binom(E.E_(kappa)_(X) + a_(X), u_(X)))) + (sum kappa, F.q_(kappa) * (prod X, binom(F.E_(kappa)_(X) + b_(X), u_(X)))))
relation (a #minus b #hinge w #minus v) := r in NN, a, b, w, v in Exponent(r), (forall X : a_(X) * b_(X) = 0), (sum X, (a_(X) * w_(X) + b_(X) * v_(X))) = 1 + (sum X, (a_(X) * v_(X) + b_(X) * w_(X)))
relation (a #minus b #apart f #minus g) := r in NN, a, b, f, g in Exponent(r), (exists X : a_(X) != f_(X) or b_(X) != g_(X)), (exists X : a_(X) != g_(X) or b_(X) != f_(X))
relation (a #minus b #across c) := r in NN, a, b, c in Exponent(r), (exists X : c_(X) = 0, 1 <= a_(X) + b_(X))

-- A polynomial in the layer of a hinge is the hinge times a quotient of the same box.
cit fact:hquot [the quotient by a hinge]
  doi: 10.1215/S0012-7094-96-08401-X
  stmt: Corollaries 2.3 and 2.4
  (1): k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), n in NN, a, b, w, v in Exponent(r), (a #minus b #hinge w #minus v), (A #within n), (B #within n), (C #within n), (D #within n), (A #plus B #tie C #plus D #layer a #minus b #to n) : exists l in NN : exists E, F in Terms(l, r) : (E #within n #less a #plus b), (F #within n #less a #plus b), (A #plus B #tie C #plus D #times a #minus b #by E #less F #to n)
  origin: ?{\text{cited: \cite[Corollaries~2.3 and~2.4]{EisenbudSturmfels1996}, numbered as in its arXiv version alg-geom/9401001, over the algebraic closure}\ \overline{\Q}\text{: the Bezout witness makes}\ a-b\ \text{primitive, so the ideal of the hinge}\ h=X^a-X^b\ \text{is the binomial prime of the saturated lattice}\ \Z(a-b)\ \text{with the trivial character, the kernel (2.5) of}\ \overline{\Q}[X]\to\overline{\Q}[\Z^r/\Z(a-b)]\text{, whose classes are those of the layer. The descent to}\ \Q\ \text{is ours:}\ \overline{\Q}[X]\ \text{is a free}\ \Q[X]\text{-module on a basis that contains}\ 1\text{, so}\ h\overline{\Q}[X]\cap\Q[X]=h\Q[X]\text{. The quotient lies in the box, as the degree in each letter adds up on a product}}
  fix (1) layers.hquot

-- A hinge is prime: when a hinge times a quotient lies in the layer of a hinge apart from it, so does the quotient.
cit fact:hprime [a hinge is prime]
  doi: 10.1215/S0012-7094-96-08401-X
  stmt: Theorem 2.1 (c) and Corollary 2.4
  (1): k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), l in NN, E, F in Terms(l, r), n in NN, a, b, w, v, f, g, p, s in Exponent(r), (a #minus b #hinge w #minus v), (f #minus g #hinge p #minus s), (f #minus g #apart a #minus b), (A #within n), (B #within n), (C #within n), (D #within n), (E #within n #less f #plus g), (F #within n #less f #plus g), (A #plus B #tie C #plus D #times f #minus g #by E #less F #to n), (A #plus B #tie C #plus D #layer a #minus b #to n) : (E #plus E #tie F #plus E #layer a #minus b #to n)
  origin: ?{\text{cited: \cite[Theorem~2.1~(c) and Corollary~2.4]{EisenbudSturmfels1996}, numbered as in its arXiv version alg-geom/9401001, over the algebraic closure}\ \overline{\Q}\text{: the lattice}\ \Z(f-g)\ \text{is saturated by the Bezout witness, so the ideal of the hinge}\ X^f-X^g\ \text{is prime; two hinges apart are prime and not associate, so neither divides the other. The descent to}\ \Q\ \text{is ours: the ideal over}\ \Q\ \text{is the contraction of the ideal over}\ \overline{\Q}\text{, as in \cref{fact:hquot}, and a contraction of a prime is prime}}
  fix (1) layers.hprime

-- Off the tie set a hinge has a lowest form of degree one, so dividing by it lowers the degree by one.
cit fact:hdomain [the lowest forms multiply]
  doi: 10.1145/3372885.3373824
  stmt: the order of a product, in Mathlib.RingTheory.MvPowerSeries.NoZeroDivisors
  (1): k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), l in NN, E, F in Terms(l, r), n, j in NN, a, b, w, v, c in Exponent(r), (a #minus b #hinge w #minus v), (a #minus b #across c), (A #within n), (B #within n), (C #within n), (D #within n), (E #within n #less a #plus b), (F #within n #less a #plus b), (A #plus B #tie C #plus D #times a #minus b #by E #less F #to n), (A #plus B #tie C #plus D #degree j + 1 #off c) : (E #plus E #tie F #plus E #degree j #off c)
  origin: ?{\text{cited: \cite{Mathlib2020}, its lemma MvPowerSeries.order\_mul: the order of a product of power series over a ring with no zero divisors is the sum of the orders, read after}\ X=1+y\ \text{and}\ y_c=0\text{, in the letters off the tie set: there the hinge has order one, as it is across}\ c\text{. The reading of the gaps}\ c_u\ \text{as the coefficients of the power series is not written in Lean, so the statement enters as a hypothesis}}
  fix (1) layers.hdomain

-- A hinge vanishes at the unit letter, so multiplying by it raises the degree by one.
cit fact:hproduct [the powers of the ideal of the unit letter multiply]
  doi: 10.1145/3372885.3373824
  stmt: the order of a product, in Mathlib.RingTheory.MvPowerSeries.Order
  (1): k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), l in NN, E, F in Terms(l, r), n, j in NN, a, b in Exponent(r), (A #within n), (B #within n), (C #within n), (D #within n), (E #within n #less a #plus b), (F #within n #less a #plus b), (A #plus B #tie C #plus D #times a #minus b #by E #less F #to n), (E #plus E #tie F #plus E #through j) : (A #plus B #tie C #plus D #through j + 1)
  origin: ?{\text{cited: \cite{Mathlib2020}, its lemma MvPowerSeries.le\_order\_mul: the order of a product of power series is at least the sum of the orders, read after}\ X=1+y\text{: a hinge vanishes at}\ y=0\text{, so it has order at least one. The reading of the gaps}\ c_u\ \text{as the coefficients of the power series is not written in Lean, so the statement enters as a hypothesis}}
  fix (1) layers.hproduct

-- A polynomial in the layers of k hinges, each across the tie set, that ties through degree k off the tie set ties
-- through degree k.
lemma lem:hinges [the degree at the unit letter through the hinges]
  core zero: r in NN, u in Exponent(r), (sum X, u_(X)) <= 0 : forall X : u_(X) = 0
  core boxless: k, r, n in NN, E in Terms(k, r), a, b in Exponent(r), (E #within n #less a #plus b) : (E #within n)
  core chain: r, K, k, n in NN, c in Exponent(r), a_(1..K), b_(1..K), w_(1..K), v_(1..K) in Exponent(r), (forall j in NN>=1 : j <= K => (a_(j) #minus b_(j) #hinge w_(j) #minus v_(j))), (forall j in NN>=1 : j <= K => forall i in NN>=1 : i < j => (a_(j) #minus b_(j) #apart a_(i) #minus b_(i))), (forall j in NN>=1 : j <= K => (a_(j) #minus b_(j) #across c)) : forall k1, k2, k3, k4 in NN : forall A in Terms(k1, r) : forall B in Terms(k2, r) : forall C in Terms(k3, r) : forall D in Terms(k4, r) : forall u in Exponent(r) : k <= K => (forall j in NN>=1 : j <= k => (A #plus B #tie C #plus D #layer a_(j) #minus b_(j) #to n)) => (A #within n) => (B #within n) => (C #within n) => (D #within n) => (A #plus B #tie C #plus D #degree k #off c) => (forall X : u_(X) <= k) => (sum X, u_(X)) <= k => (sum kappa, A.q_(kappa) * (prod X, binom(A.E_(kappa)_(X), u_(X)))) + (sum kappa, B.q_(kappa) * (prod X, binom(B.E_(kappa)_(X), u_(X)))) = (sum kappa, C.q_(kappa) * (prod X, binom(C.E_(kappa)_(X), u_(X)))) + (sum kappa, D.q_(kappa) * (prod X, binom(D.E_(kappa)_(X), u_(X))))
  (hinges): k1, k2, k3, k4, r in NN, A in Terms(k1, r), B in Terms(k2, r), C in Terms(k3, r), D in Terms(k4, r), k, n in NN, c in Exponent(r), a_(1..k), b_(1..k), w_(1..k), v_(1..k) in Exponent(r), (forall j in NN>=1 : j <= k => (a_(j) #minus b_(j) #hinge w_(j) #minus v_(j))), (forall j in NN>=1 : j <= k => forall i in NN>=1 : i < j => (a_(j) #minus b_(j) #apart a_(i) #minus b_(i))), (forall j in NN>=1 : j <= k => (a_(j) #minus b_(j) #across c)), (forall j in NN>=1 : j <= k => (A #plus B #tie C #plus D #layer a_(j) #minus b_(j) #to n)), (A #within n), (B #within n), (C #within n), (D #within n), (A #plus B #tie C #plus D #degree k #off c) : (A #plus B #tie C #plus D #through k)
  fix (hinges) layers.hinges
  neqfix (hinges) layers.hinges.associate
  neqfix (hinges) layers.hinges.inside
  (facet): k1, k2, k3, k4, r in NN, Np in Terms(k1, r), Nm in Terms(k2, r), Sp in Terms(k3, r), Sm in Terms(k4, r), k, n in NN, c in Exponent(r), a_(1..k), b_(1..k), w_(1..k), v_(1..k) in Exponent(r), (forall j in NN>=1 : j <= k => (a_(j) #minus b_(j) #hinge w_(j) #minus v_(j))), (forall j in NN>=1 : j <= k => forall i in NN>=1 : i < j => (a_(j) #minus b_(j) #apart a_(i) #minus b_(i))), (forall j in NN>=1 : j <= k => (a_(j) #minus b_(j) #across c)), (Np #within n), (Nm #within n), (Sp #within n), (Sm #within n), (Np #plus Np #tie Nm #plus Np #degree k #off c), (Sp #plus Sp #tie Sm #plus Sp #through k), (forall j in NN>=1 : j <= k => (Np #plus Sm #tie Nm #plus Sp #layer a_(j) #minus b_(j) #to n)) : (Np #plus Np #tie Nm #plus Np #through k)
  fix (facet) layers.facet
  neqfix (facet) layers.facet.notie
  neqfix (facet) layers.facet.low

proof lem:hinges
  "core zero" logic[with[u_(X) <= (sum Z, u_(Z)) by term[X]; V[1 * hw1, 1 * h_1], V[0]]]
  "core boxless" unfold[logic[with[E.E_(kappa)_(X) + a_(X) + b_(X) <= n by logic; V[1 * hw1]]]]
  "core chain" ind[k; logic[with[forall X : u_(X) = 0 by lem:hinges(core zero)[r := r, u := u]; with[forall X : 1 <= c_(X) => u_(X) = 0 by logic; logic]]]; logic[with[k <= K by V; with[k + 1 <= k + 1 by V; with[(A #plus B #tie C #plus D #layer a_(k + 1) #minus b_(k + 1) #to n) by logic; with[exists l in NN : exists E, F in Terms(l, r) : (E #within n #less a_(k + 1) #plus b_(k + 1)), (F #within n #less a_(k + 1) #plus b_(k + 1)), (A #plus B #tie C #plus D #times a_(k + 1) #minus b_(k + 1) #by E #less F #to n) by fact:hquot(1)[k1 := k1, k2 := k2, k3 := k3, k4 := k4, r := r, A := A, B := B, C := C, D := D, n := n, a := a_(k + 1), b := b_(k + 1), w := w_(k + 1), v := v_(k + 1)]; with[forall j in NN>=1 : j <= k => (E #plus E #tie F #plus E #layer a_(j) #minus b_(j) #to n) by with[j <= K by V; with[j < k + 1 by V; with[j <= k + 1 by V; with[1 <= k + 1 by V; with[(a_(j) #minus b_(j) #hinge w_(j) #minus v_(j)) by logic; with[(a_(k + 1) #minus b_(k + 1) #apart a_(j) #minus b_(j)) by logic; with[(A #plus B #tie C #plus D #layer a_(j) #minus b_(j) #to n) by logic; fact:hprime(1)[k1 := k1, k2 := k2, k3 := k3, k4 := k4, r := r, A := A, B := B, C := C, D := D, n := n, l := l, E := E, F := F, a := a_(j), b := b_(j), w := w_(j), v := v_(j), f := a_(k + 1), g := b_(k + 1), p := w_(k + 1), s := v_(k + 1)]]]]]]]]; with[(E #plus E #tie F #plus E #degree k #off c) by fact:hdomain(1)[k1 := k1, k2 := k2, k3 := k3, k4 := k4, r := r, A := A, B := B, C := C, D := D, n := n, l := l, E := E, F := F, j := k, a := a_(k + 1), b := b_(k + 1), w := w_(k + 1), v := v_(k + 1), c := c]; with[(E #within n) by lem:hinges(core boxless)[k := l, r := r, n := n, E := E, a := a_(k + 1), b := b_(k + 1)]; with[(F #within n) by lem:hinges(core boxless)[k := l, r := r, n := n, E := F, a := a_(k + 1), b := b_(k + 1)]; with[forall u2 in Exponent(r) : (forall X : u2_(X) <= k) => (sum X, u2_(X)) <= k => (sum kappa, E.q_(kappa) * (prod X, binom(E.E_(kappa)_(X), u2_(X)))) + (sum kappa, E.q_(kappa) * (prod X, binom(E.E_(kappa)_(X), u2_(X)))) = (sum kappa, F.q_(kappa) * (prod X, binom(F.E_(kappa)_(X), u2_(X)))) + (sum kappa, E.q_(kappa) * (prod X, binom(E.E_(kappa)_(X), u2_(X)))) by ih_k[k1 := l, k2 := l, k3 := l, k4 := l, A := E, B := E, C := F, D := E, u := u2]; with[(E #plus E #tie F #plus E #through k) by unfold[logic]; with[(A #plus B #tie C #plus D #through k + 1) by fact:hproduct(1)[k1 := k1, k2 := k2, k3 := k3, k4 := k4, r := r, A := A, B := B, C := C, D := D, n := n, l := l, E := E, F := F, j := k, a := a_(k + 1), b := b_(k + 1)]; logic]]]]]]]]]]]]]
  (hinges) logic[with[k <= k by V; with[(A #within n) by logic; with[(B #within n) by logic; with[(C #within n) by logic; with[(D #within n) by logic; with[(A #plus B #tie C #plus D #degree k #off c) by logic; with[forall k1, k2, k3, k4 in NN : forall A in Terms(k1, r) : forall B in Terms(k2, r) : forall C in Terms(k3, r) : forall D in Terms(k4, r) : forall u in Exponent(r) : k <= k => (forall j in NN>=1 : j <= k => (A #plus B #tie C #plus D #layer a_(j) #minus b_(j) #to n)) => (A #within n) => (B #within n) => (C #within n) => (D #within n) => (A #plus B #tie C #plus D #degree k #off c) => (forall X : u_(X) <= k) => (sum X, u_(X)) <= k => (sum kappa, A.q_(kappa) * (prod X, binom(A.E_(kappa)_(X), u_(X)))) + (sum kappa, B.q_(kappa) * (prod X, binom(B.E_(kappa)_(X), u_(X)))) = (sum kappa, C.q_(kappa) * (prod X, binom(C.E_(kappa)_(X), u_(X)))) + (sum kappa, D.q_(kappa) * (prod X, binom(D.E_(kappa)_(X), u_(X)))) by lem:hinges(core chain)[r := r, K := k, k := k, n := n, c := c, a := a, b := b, w := w, v := v]; hw7[k1 := k1, k2 := k2, k3 := k3, k4 := k4, A := A, B := B, C := C, D := D, u := u]]]]]]]]]
