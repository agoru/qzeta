-- Q++ 0.2
module cell
uses parity

subsection sec:cell The stratum sum of a cell

type Pairs(n) := ((QQ>0)^n)^n

-- Each spoke of a cell is a block whose parts \(x_i\), on a resolution \(x_i=1/\sigma_i\), and \(y_i=1-x_i\) tie to one, and two such blocks tie the product \(x_ix_j\) and the two \(y_i\), \(y_j\) to one and the product \(y_iy_j\), the product of the two ties \cref{lem:parity} (pair). Summed over the pairs of spokes, with the block of each spoke, it gives the stratum sum of a cell: at the \(x_i\), together with the Euler characteristics \(\chi(E_J)\) of its curves at the \(y_i\), it ties the Euler characteristic of the cell and of its points at the products of the \(y_i\) (cell). The counts of a cell of a resolution are of both signs, and some pairings are absent: two curves that do not meet have none, and a curve has none with itself. Such counts are a balance of two positive halves, an absent pairing two equal halves: (cell) holds at each half, and its two ties, added with their sides exchanged, give the tie of the balance (balance).
lemma lem:cell [the stratum sum of a cell]
  (pair): a, b, u, v in QQ>0, a + u = 1, b + v = 1 : a * b + u + v = 1 + u * v
  fix (pair) cell.pair
  neqfix (pair) cell.pair.noleft
  neqfix (pair) cell.pair.noright
  (cell): k in NN>=1, o, K in QQ>0, x, y, c, d in Weight(k), T in Pairs(k), (forall i : x_(i) + y_(i) = 1), (forall i : d_(i) = c_(i) + (sum j, (T_(i)_(j) + T_(j)_(i)))), K = o + (sum i, c_(i)) + (sum i, sum j, T_(i)_(j)) : o + (sum i, c_(i) * x_(i)) + (sum i, sum j, T_(i)_(j) * x_(i) * x_(j)) + (sum i, d_(i) * y_(i)) = K + (sum i, sum j, T_(i)_(j) * y_(i) * y_(j))
  fix (cell) cell.cell
  neqfix (cell) cell.cell.noblock
  neqfix (cell) cell.cell.nocurve
  neqfix (cell) cell.cell.nocell
  (balance): k in NN>=1, oP, oM, KP, KM in QQ>0, x, y, cP, cM, dP, dM in Weight(k), TP, TM in Pairs(k), (forall i : x_(i) + y_(i) = 1), (forall i : dP_(i) = cP_(i) + (sum j, (TP_(i)_(j) + TP_(j)_(i)))), (forall i : dM_(i) = cM_(i) + (sum j, (TM_(i)_(j) + TM_(j)_(i)))), KP = oP + (sum i, cP_(i)) + (sum i, sum j, TP_(i)_(j)), KM = oM + (sum i, cM_(i)) + (sum i, sum j, TM_(i)_(j)) : oP + (sum i, cP_(i) * x_(i)) + (sum i, sum j, TP_(i)_(j) * x_(i) * x_(j)) + (sum i, dP_(i) * y_(i)) + KM + (sum i, sum j, TM_(i)_(j) * y_(i) * y_(j)) = KP + (sum i, sum j, TP_(i)_(j) * y_(i) * y_(j)) + oM + (sum i, cM_(i) * x_(i)) + (sum i, sum j, TM_(i)_(j) * x_(i) * x_(j)) + (sum i, dM_(i) * y_(i))
  fix (balance) cell.balance
  neqfix (balance) cell.balance.noblock
  origin: ?{\text{form proved: (pair) is \cref{lem:parity}(product) at two attached blocks, and (cell) is (pair) summed over the pairs of spokes with the block of each spoke; the stratum sum of a cell read at the \(x_i\) and at the \(y_i=1-x_i\) of its spokes, the cell level of the identity of a cluster; (balance) form proved: (cell) at two halves, its two ties added with their sides exchanged, so that the counts of both signs of a cell of a resolution and its absent pairings are read as a balance of two positive halves, an absent pairing two equal halves, as the prices of both signs of a cost}}

proof lem:cell
  (pair) with[1 = u + a by V[1 * h_1]; with[1 = v + b by V[1 * h_2]; with[1 * 1 + u * v = 1 * v + u * 1 + a * b by lem:parity(product)[E := 1, O := u, X := a, F := 1, P := v, Y := b]; V[1 * hw3]]]]
  (cell) with[(sum i, d_(i) * y_(i)) = sum i, (c_(i) * y_(i) + (sum j, (T_(i)_(j) + T_(j)_(i))) * y_(i)) by sum[V[y_(i) * h_2(i)]]; with[(sum i, (c_(i) * y_(i) + (sum j, (T_(i)_(j) + T_(j)_(i))) * y_(i))) = (sum i, c_(i) * y_(i)) + (sum i, (sum j, (T_(i)_(j) + T_(j)_(i))) * y_(i)) by eq; with[(sum i, (sum j, (T_(i)_(j) + T_(j)_(i))) * y_(i)) = sum i, sum j, (T_(i)_(j) + T_(j)_(i)) * y_(i) by eq; with[(sum i, sum j, (T_(i)_(j) + T_(j)_(i)) * y_(i)) = sum i, sum j, (T_(i)_(j) * y_(i) + T_(j)_(i) * y_(i)) by eq; with[(sum i, sum j, (T_(i)_(j) * y_(i) + T_(j)_(i) * y_(i))) = sum i, ((sum j, T_(i)_(j) * y_(i)) + (sum j, T_(j)_(i) * y_(i))) by eq; with[(sum i, ((sum j, T_(i)_(j) * y_(i)) + (sum j, T_(j)_(i) * y_(i)))) = (sum i, sum j, T_(i)_(j) * y_(i)) + (sum i, sum j, T_(j)_(i) * y_(i)) by eq; with[(sum i, sum j, T_(j)_(i) * y_(i)) = (sum i, sum j, T_(i)_(j) * y_(j)) by eq; with[(sum i, c_(i) * x_(i)) + (sum i, c_(i) * y_(i)) = sum i, (c_(i) * x_(i) + c_(i) * y_(i)) by eq; with[(sum i, (c_(i) * x_(i) + c_(i) * y_(i))) = sum i, c_(i) by sum[V[c_(i) * h_1(i)]]; with[(sum i, sum j, T_(i)_(j) * x_(i) * x_(j)) + (sum i, sum j, T_(i)_(j) * y_(i)) = sum i, ((sum j, T_(i)_(j) * x_(i) * x_(j)) + (sum j, T_(i)_(j) * y_(i))) by eq; with[(sum i, ((sum j, T_(i)_(j) * x_(i) * x_(j)) + (sum j, T_(i)_(j) * y_(i)))) = sum i, sum j, (T_(i)_(j) * x_(i) * x_(j) + T_(i)_(j) * y_(i)) by eq; with[(sum i, sum j, (T_(i)_(j) * x_(i) * x_(j) + T_(i)_(j) * y_(i))) + (sum i, sum j, T_(i)_(j) * y_(j)) = sum i, ((sum j, (T_(i)_(j) * x_(i) * x_(j) + T_(i)_(j) * y_(i))) + (sum j, T_(i)_(j) * y_(j))) by eq; with[(sum i, ((sum j, (T_(i)_(j) * x_(i) * x_(j) + T_(i)_(j) * y_(i))) + (sum j, T_(i)_(j) * y_(j)))) = sum i, sum j, (T_(i)_(j) * x_(i) * x_(j) + T_(i)_(j) * y_(i) + T_(i)_(j) * y_(j)) by eq; with[(sum i, sum j, (T_(i)_(j) * x_(i) * x_(j) + T_(i)_(j) * y_(i) + T_(i)_(j) * y_(j))) = sum i, sum j, (T_(i)_(j) + T_(i)_(j) * y_(i) * y_(j)) by sum[sum[with[x_(i) * x_(j) + y_(i) + y_(j) = 1 + y_(i) * y_(j) by lem:cell(pair)[a := x_(i), b := x_(j), u := y_(i), v := y_(j)]; V[T_(i)_(j) * hw15]]]]; with[(sum i, sum j, (T_(i)_(j) + T_(i)_(j) * y_(i) * y_(j))) = sum i, ((sum j, T_(i)_(j)) + (sum j, T_(i)_(j) * y_(i) * y_(j))) by eq; with[(sum i, ((sum j, T_(i)_(j)) + (sum j, T_(i)_(j) * y_(i) * y_(j)))) = (sum i, sum j, T_(i)_(j)) + (sum i, sum j, T_(i)_(j) * y_(i) * y_(j)) by eq; eq[1 * hw1, 1 * hw2, 1 * hw3, 1 * hw4, 1 * hw5, 1 * hw6, 1 * hw7, 1 * hw8, 1 * hw9, 1 * hw10, 1 * hw11, 1 * hw12, 1 * hw13, 1 * hw14, 1 * hw16, 1 * hw17]]]]]]]]]]]]]]]]]
  (balance) with[oP + (sum i, cP_(i) * x_(i)) + (sum i, sum j, TP_(i)_(j) * x_(i) * x_(j)) + (sum i, dP_(i) * y_(i)) = KP + (sum i, sum j, TP_(i)_(j) * y_(i) * y_(j)) by lem:cell(cell)[k := k, o := oP, K := KP, x := x, y := y, c := cP, d := dP, T := TP]; with[oM + (sum i, cM_(i) * x_(i)) + (sum i, sum j, TM_(i)_(j) * x_(i) * x_(j)) + (sum i, dM_(i) * y_(i)) = KM + (sum i, sum j, TM_(i)_(j) * y_(i) * y_(j)) by lem:cell(cell)[k := k, o := oM, K := KM, x := x, y := y, c := cM, d := dM, T := TM]; V[1 * hw1 | 1 * hw2]]]
