-- The site at a wall of its chamber: \(J\) realized moments, fixed by two comparisons (chamber), and a cap \(D>2J\).
-- With \(T=\frac{J(J+1)}2\) its least content is \(\frac{J+1}2+\frac{k-T}D\), at one point for \(k>T\) and on a segment
-- at the tie \(k=T\) (cap, capat, face, tieat); without the cap the row of the breakpoint plays the cap at \(D=2(J+1)\)
-- (free).
lemma lem:walls [the site at a wall]
  (chamber): p, V, J, L in NN>=1, k in QQ>0, J <= p, J <= V, J * (J + 1) <= 2 * k, (J = p or (J = V or 2 * k < (J + 1) * (J + 2))), L <= p, L <= V, L * (L + 1) <= 2 * k, (L = p or (L = V or 2 * k < (L + 1) * (L + 2))) : J = L
  fix (chamber) walls.chamber
  neqfix (chamber) walls.chamber.neq
  (cap): J in NN>=1, k, c, x, D in QQ>0, v_(1..J) in QQ>0, J * (J + 1) <= 2 * k, 2 * c >= 1, D * x >= 1, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) >= 1) : c + k * x + (sum i in 1..J, v_(i)) + J * (J + 1) / (2 * D) >= (J + 1) / 2 + k / D
  fix (cap) walls.cap
  neqfix (cap) walls.cap.neq
  (capat): J in NN>=1, k, c, x, D in QQ>0, v_(1..J) in QQ>0, 2 * c = 1, D * x = 1, (forall i in NN>=1 : i <= J => 2 * D * v_(i) + 2 * i = D) : (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) = 1), c + k * x + (sum i in 1..J, v_(i)) + J * (J + 1) / (2 * D) = (J + 1) / 2 + k / D
  fix (capat) walls.capat
  (face): J in NN>=1, k, c, x, D in QQ>0, v_(1..J) in QQ>0, J * (J + 1) <= 2 * k, 2 * c >= 1, D * x >= 1, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) >= 1), c + k * x + (sum i in 1..J, v_(i)) + J * (J + 1) / (2 * D) = (J + 1) / 2 + k / D : 2 * c = 1, k * x + J * (J + 1) / (2 * D) = k / D + J * (J + 1) / 2 * x, (sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x = J / 2, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) = 1)
  fix (face) walls.face
  (tieat): J in NN>=1, k, c, x, D in QQ>0, v_(1..J) in QQ>0, 2 * k = J * (J + 1), 2 * J < D, 2 * c = 1, 4 * J * D * x = 2 * J + D, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) = 1) : D * x > 1, c + k * x + (sum i in 1..J, v_(i)) + J * (J + 1) / (2 * D) = (J + 1) / 2 + k / D
  fix (tieat) walls.tieat
  (free): J in NN>=1, k, c, x, w, D in QQ>0, v_(1..J) in QQ>0, D = 2 * (J + 1), J * (J + 1) <= 2 * k, 2 * k < (J + 1) * (J + 2), 2 * c >= 1, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) >= 1), D * x + 2 * w >= 1 : c + k * x + (sum i in 1..J, v_(i)) + w + J * (J + 1) / (2 * D) > (J + 1) / 2 + k / D
  fix (free) walls.free
  neqfix (free) walls.free.neq
  origin: ?{\text{elementary: the site (\cref{lem:site}) at the parameters of a wall; its reading as the pair of a model waits for its way in, as the site's does}}

proof lem:walls
  (chamber) with[J <= L by cases[L + 1 <= J; with[L < p by V[1 * hc1, 1 * h_1]; with[L < V by V[1 * hc1, 1 * h_2]; cases[L = p; with[p <= L by V[| 1 * hc2]; logic]; with[(L = V or 2 * k < (L + 1) * (L + 2)) by logic; cases[L = V; with[V <= L by V[| 1 * hc3]; logic]; with[2 * k < (L + 1) * (L + 2) by logic; with[(L + 1) * (L + 2) <= J * (J + 1) by V[(J + L + 2) * hc1]; with[2 * k < J * (J + 1) by V[1 * hw7, 1 * hw8]; logic]]]]]]]]; V[1 * hn1]]; with[L <= J by cases[J + 1 <= L; with[J < p by V[1 * hc4, 1 * h_5]; with[J < V by V[1 * hc4, 1 * h_6]; cases[J = p; with[p <= J by V[| 1 * hc5]; logic]; with[(J = V or 2 * k < (J + 1) * (J + 2)) by logic; cases[J = V; with[V <= J by V[| 1 * hc6]; logic]; with[2 * k < (J + 1) * (J + 2) by logic; with[(J + 1) * (J + 2) <= L * (L + 1) by V[(J + L + 2) * hc4]; with[2 * k < L * (L + 1) by V[1 * hw16, 1 * hw17]; logic]]]]]]]]; V[1 * hn4]]; (V[1 * hw1], V[1 * hw10])]]
  (cap) with[(sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x >= J / 2 by lem:site(core rows)[J := J, x := x, v := v]; with[J * (J + 1) * (D * x) + 2 * k <= 2 * k * (D * x) + J * (J + 1) by V[h_1 * h_3]; V[(1 / 2) * h_2, 1 * hw1, (1 / (2 * D)) * hw2]]]
  (capat) with[forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) = 1 by with[D * (2 * i * x + 2 * v_(i)) = D * 1 by V[(2 * i) * h_2, 1 * h_3(i)]; div[D]]; (logic, with[(sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x = J / 2 by lem:site(core tight)[J := J, x := x, v := v]; V[(1 / 2) * h_1, 1 * hw3, (k / D) * h_2, (J * (J + 1) / (2 * D)) * h_2]])]
  (face) with[(sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x >= J / 2 by lem:site(core rows)[J := J, x := x, v := v]; with[J * (J + 1) * (D * x) + 2 * k <= 2 * k * (D * x) + J * (J + 1) by V[h_1 * h_3]; with[k / D + J * (J + 1) / 2 * x <= k * x + J * (J + 1) / (2 * D) by V[(1 / (2 * D)) * hw2]; ((V[2 * h_5, 2 * hw1, 2 * hw3], V[1 * h_2]), (V[1 * h_5, (1 / 2) * h_2, 1 * hw1], V[1 * hw3]), (V[1 * h_5, (1 / 2) * h_2, 1 * hw3], V[1 * hw1]), with[(sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x = J / 2 by (V[1 * h_5, (1 / 2) * h_2, 1 * hw3], V[1 * hw1]); with[forall j in NN>=1 : j <= J => 1 / 2 <= v_(j) + j * x by with[1 / 2 <= v_(j) + j * x by V[(1 / 2) * h_4(j)]; logic]; with[(sum i in 1..J, 1 / 2) = J / 2 by lem:site(core half)[J := J]; with[(sum i in 1..J, (v_(i) + i * x)) = (sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x by lem:site(core sums)[J := J, x := x, v := v]; with[(sum i in 1..J, 1 / 2) = (sum i in 1..J, (v_(i) + i * x)) by V[1 * hw7 | 1 * hw8, 1 * hw4]; with[forall j in NN>=1 : j <= J => 1 / 2 = v_(j) + j * x by fact:termtie[N := J, a_(i) := 1 / 2, b_(i) := v_(i) + i * x]; V[| 2 * hw10(i)]]]]]]])]]]
  (tieat) with[(sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x = J / 2 by lem:site(core tight)[J := J, x := x, v := v]; (with[4 * J * (D * x) > 4 * J * 1 by V[1 * h_2 | 1 * h_4]; div[4 * J]], V[(1 / 2) * h_3, 1 * hw1, (x / 2) * h_1, (1 / (2 * D)) * h_1])]
  (free) with[(sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x >= J / 2 by lem:site(core rows)[J := J, x := x, v := v]; with[J * (J + 1) * (D * x + 2 * w) + 2 * k <= 2 * k * (D * x + 2 * w) + J * (J + 1) by V[h_2 * h_6]; with[2 * k < D + J * (J + 1) by V[1 * h_3 | 1 * h_1]; V[(1 / 2) * h_4, 1 * hw1, (1 / (2 * D)) * hw2, (w / D) * hw3]]]]

-- The first two rungs with their faces, the cap \(D=2J+e\) at the gap \(e\) above the last moment, \(J=1,2\): the face
-- is an edge at the slope \(\frac{J(J+1)}2\) with \(e>0\), and a point elsewhere. With \(\frac12\) added they are the
-- values \(\big(1+\frac{k-1}D,1\big)\) at one moment and \(\big(\frac32+\frac{k-3}D,1\big)\), \(\big(\frac32,2\big)\) at
-- \(k=3\), at two.
lemma lem:rungs [the first two rungs]
  (one): kp in QQ>0, e in QQ>=0 : prog(x, v in QQ>=0, (2 + e) * x >= 1, 2 * x + 2 * v >= 1 : x + kp * x + v) = (1 / 2 + kp / (2 + e), 1)
  fix (one) rowcaps.three
  fix (one) rowcaps.four
  (tie): kq in QQ>=0, e in QQ>0, kq = 0 : prog(x, v, w in QQ>=0, (4 + e) * x >= 1, 2 * x + 2 * v >= 1, 4 * x + 2 * w >= 1 : 3 * x + kq * x + v + w) = (1, 2)
  fix (tie) capfive.tie
  neqfix (tie) capfive.offtie
  (two): kq in QQ>0, e in QQ>=0 : prog(x, v, w in QQ>=0, (4 + e) * x >= 1, 2 * x + 2 * v >= 1, 4 * x + 2 * w >= 1 : 3 * x + kq * x + v + w) = (1 + kq / (4 + e), 1)
  fix (two) capfive.above
  origin: ?{\text{elementary}}

-- Both moment rows carry the price one half; the cap carries the rest of the slope, zero at the tie, where the face
-- is the edge between the two points.
proof lem:rungs
  (one) face[V[kp / (2 + e) * h_4, 1 / 2 * h_5]; x := 1 / (2 + e), v := e / (2 * (2 + e)) by V[0], V[0], V[0], V[0], V[0]; (2 + e) * x = 1, x + v = 1 / 2 by (V[(2 + e) / kp * h_6, (2 + e) / (2 * kp) * h_5], V[1 * h_4]), (V[1 * h_6, kp / (2 + e) * h_4], V[1 / 2 * h_5])]
  (tie) face[V[1 / 2 * h_7, 1 / 2 * h_8, x * h_2]; x := 1 / (4 + e), v := (2 + e) / (2 * (4 + e)), w := e / (2 * (4 + e)) by V[0], V[0], V[0], V[0], V[0], V[0], V[1 / (4 + e) * h_2]; x := 1 / 4, v := 1 / 4 by V[0], V[0], V[0], V[0], V[0], V[1 / 4 * h_2]; x + v = 1 / 2, 2 * x + w = 1 / 2 by (V[1 * h_9, 1 / 2 * h_8, x * h_2], V[1 / 2 * h_7]), (V[1 * h_9, 1 / 2 * h_7, x * h_2], V[1 / 2 * h_8]); V[0]]
  (two) face[V[kq / (4 + e) * h_5, 1 / 2 * h_6, 1 / 2 * h_7]; x := 1 / (4 + e), v := (2 + e) / (2 * (4 + e)), w := e / (2 * (4 + e)) by V[0], V[0], V[0], V[0], V[0], V[0], V[0]; (4 + e) * x = 1, x + v = 1 / 2, 2 * x + w = 1 / 2 by (V[(4 + e) / kq * h_8, (4 + e) / (2 * kq) * h_6, (4 + e) / (2 * kq) * h_7], V[1 * h_5]), (V[1 * h_8, kq / (4 + e) * h_5, 1 / 2 * h_7], V[1 / 2 * h_6]), (V[1 * h_8, kq / (4 + e) * h_5, 1 / 2 * h_6], V[1 / 2 * h_7])]
