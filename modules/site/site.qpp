  core gapback: Z, n in NN, n = 2 * Z, pi in Point(n), g, f in Exponent(n), (forall kappa : forall j : kappa = Z + j => g_(kappa) = g_(j)), (forall kappa : forall j : kappa = Z + j => f_(kappa) = f_(j)), (forall iota : pi_(iota) = iverson(iota <= Z) * min(1 / (2 * g_(iota)), 1 / f_(iota)) + iverson(Z < iota) * (max(f_(iota) - 2 * g_(iota), 0) / f_(iota) + max(2 * g_(iota) - f_(iota), 0) / (2 * g_(iota)))) : forall i : forall iota : iverson(i = Z + iota) * (pi_(iota) * f_(iota)) = iverson(i = Z + iota) * (f_(i) * min(1 / (2 * g_(i)), 1 / f_(i)))
  core gapslope: Z, n in NN, n = 2 * Z, pi in Point(n), g, f in Exponent(n), (forall kappa : forall j : kappa = Z + j => g_(kappa) = g_(j)), (forall kappa : forall j : kappa = Z + j => f_(kappa) = f_(j)), (forall kappa : 1 <= g_(kappa), 1 <= f_(kappa)), (forall kappa : iverson(2 * g_(kappa) < f_(kappa)) + iverson(f_(kappa) < 2 * g_(kappa)) = 1), (forall iota : pi_(iota) = iverson(iota <= Z) * min(1 / (2 * g_(iota)), 1 / f_(iota)) + iverson(Z < iota) * (max(f_(iota) - 2 * g_(iota), 0) / f_(iota) + max(2 * g_(iota) - f_(iota), 0) / (2 * g_(iota)))) : forall i : i <= Z => (sum iota, iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota))))) + (sum iota, iverson(i = Z + iota) * (pi_(iota) * f_(iota))) + (sum iota, iverson(iota = Z + i) * (pi_(iota) * iverson(2 * g_(iota) < f_(iota)))) = min(1 / (2 * g_(i)), 1 / f_(i)) * (2 * g_(i)) + iverson(2 * g_(i) < f_(i)) * (max(f_(i) - 2 * g_(i), 0) / f_(i) + max(2 * g_(i) - f_(i), 0) / (2 * g_(i)))
