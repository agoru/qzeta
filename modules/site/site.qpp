  core ladderrows: J, m, n, a in NN, n = J + 1, m <= J, Pr in Chamber(n, n), x in Exponent(n), (forall iota : forall i : Pr.P_(iota)_(i) = iverson(iota <= m) * (2 * iverson(i = iota) + 2 * iota * iverson(i = n)) + iverson(m < iota, iota <= J) * iverson(i = iota) + iverson(iota = n) * a * iverson(i = n)) : forall iota : (sum j, Pr.P_(iota)_(j) * x_(j)) = iverson(iota <= m) * (2 * x_(iota) + 2 * iota * (sum j, iverson(j = n) * x_(j))) + iverson(m < iota, iota <= J) * x_(iota) + iverson(iota = n) * a * (sum j, iverson(j = n) * x_(j))
  core ladderdirection: J, m, n, a, d in NN, n = J + 1, m <= J, Pr in Chamber(n, n), R in IntForms(1, n), (forall iota : forall i : Pr.P_(iota)_(i) = iverson(iota <= m) * (2 * iverson(i = iota) + 2 * iota * iverson(i = n)) + iverson(m < iota, iota <= J) * iverson(i = iota) + iverson(iota = n) * a * iverson(i = n)), (forall iota : Pr.epsM_(iota) = iverson(iota <= m) + iverson(iota = n) * d), (forall l : forall i : R_(l)_(i) + iverson(i <= m) * (2 * i * d) = iverson(i <= m) * a + iverson(i = n) * (2 * d)) : forall iota : forall l : (sum i, Pr.P_(iota)_(i) * R_(l)_(i)) = 2 * a * Pr.epsM_(iota)
  core laddersabove: J, x0, r, B in NN, b, s, l in Exponent(J) : (sum x in 0..B, sum v <= b, iverson(x0 <= x) / 2^((r + 1) * x) * prod i, iverson(l_(i) <= v_(i) + s_(i) * x) / 2^(v_(i) + s_(i) * x)) <= (prod i, 2 / 2^(l_(i))) * (2 / 2^((r + 1) * x0))
  fix core laddersabove site.laddersabove
  core laddersbelow: J, x0, kq, B, kappa, q in NN, b, s, l, p in Exponent(J), x0 <= q, q <= B, (forall i : l_(i) <= p_(i) + s_(i) * q, p_(i) <= b_(i)), (sum i, (p_(i) + s_(i) * q)) + kq * q <= kappa : 1 / 2^kappa <= (sum x in 0..B, sum v <= b, iverson(x0 <= x) / 2^(kq * x) * prod i, iverson(l_(i) <= v_(i) + s_(i) * x) / 2^(v_(i) + s_(i) * x))
  fix core laddersbelow site.laddersbelow
  origin: ?{\text{elementary: the site in closed form in its features at every cap, with its point and prices; its reading as the pair of a model waits for its way in (\cref{thm:chain}). At a cluster of}\ H\ \text{units about a true unit, with one input and one output, (free) at the slope}\ k=H\ \text{is the term of the cluster in \cite[Theorem~2]{Aoyagi2009} read as the least value over the true parameters, as \cite[Theorem~4]{Aoyagi2009} uses it; stated at each true parameter, as it is there, it fails: at weights of one sign the second moment is definite and the value is (out) at}\ J=1,\ D=4,\ \tfrac{H+3}4,\ \text{above it for}\ H\ge4\ (\tfrac74\ \text{against}\ \tfrac53\ \text{at}\ H=4)}

-- The prices: \(\frac12\) on the row of \(c\) and on each moment with \(2i\le D\), the rest of the slope on the cap,
-- \(\frac1{E_h}\) on a loud unit and the value of its surplus unit on a silent gap (\cref{lem:surplus}); without the
-- cap, the rest on the row of the breakpoint.
proof lem:site
  "core readout" sum[cases[b_(r) * x <= 1; with[b_(r) * x / c_(r) <= 1 / c_(r) by V[(1 / c_(r)) * hc1]; V[(1 / c_(r)) * h_4(r)]]; with[1 / c_(r) <= b_(r) * x / c_(r) by V[(1 / c_(r)) * hn1]; V[0]]]]
  "core sums" ind
  "core half" with[(sum i in 1..J, 1 / 2) = J * (1 / 2) by sum; V[1 * hw1]]
  "core slope" with[(sum i in 1..l, (max(1 / 2 - i * x, 0) + i * x)) = (sum i in 1..l, 1 / 2) by sum[with[i * x <= l * x by mono; with[i * x <= 1 / 2 by V[1 * hw2, (1 / 2) * h_4]; V[0]]]]; with[(sum i in 1..l, (max(1 / 2 - i * x, 0) + i * x)) = (sum i in 1..l, max(1 / 2 - i * x, 0)) + l * (l + 1) / 2 * x by lem:site(core sums)[J := l, x := x, v_(i) := max(1 / 2 - i * x, 0)]; with[(sum i in 1..l, 1 / 2) = l / 2 by lem:site(core half)[J := l]; with[(sum i in 1..m, max(1 / 2 - (l + i) * x, 0)) <= 0 by sum[with[(l + 1) * x <= (l + i) * x by mono; with[1 / 2 <= (l + i) * x by V[1 * hw7, (1 / 2) * h_3]; V[0]]]]; with[0 <= (sum i in 1..m, max(1 / 2 - (l + i) * x, 0)) by sum[V[0]]; with[(sum i in 1..m, max(1 / 2 - (l + i) * x, 0)) = 0 by V[1 * hw6], V[1 * hw9]; V[1 * hw1, 1 * hw4, 1 * hw5, 1 * hw10]]]]]]]
  "core rows" with[(sum i in 1..J, (v_(i) + i * x)) >= (sum i in 1..J, 1 / 2) by sum[V[(1 / 2) * h_3(i)]]; with[(sum i in 1..J, (v_(i) + i * x)) = (sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x by lem:site(core sums)[J := J, x := x, v := v]; with[(sum i in 1..J, 1 / 2) = J / 2 by lem:site(core half)[J := J]; V[1 * hw1, 1 * hw2 | 1 * hw3]]]]
  "core tight" with[(sum i in 1..J, (v_(i) + i * x)) = (sum i in 1..J, 1 / 2) by sum[V[(1 / 2) * h_3(i)]]; with[(sum i in 1..J, (v_(i) + i * x)) = (sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x by lem:site(core sums)[J := J, x := x, v := v]; with[(sum i in 1..J, 1 / 2) = J / 2 by lem:site(core half)[J := J]; V[1 * hw1, 1 * hw2, 1 * hw3]]]]
  "core gap" cases[F <= 2; with[1 / 2 <= 1 / F by V[(1 / (2 * F)) * hc1]; with[s + e >= 1 / 2 by V[(1 / 2) * h_3, (e / 2) * hc1]; V[1 * hw2]]]; with[1 / F <= 1 / 2 by V[(1 / (2 * F)) * hn1]; with[s + e >= 1 / F by V[(1 / F) * h_3, (s / F) * hn1]; V[1 * hw4]]]]
  (out) with[(sum i in 1..J, (v_(i) + i * x)) >= (sum i in 1..J, max(1 / 2, i / D)) by sum[with[i / D <= i * x by V[(i / D) * h_9]; cases[2 * i <= D; with[i / D <= 1 / 2 by V[(1 / (2 * D)) * hc1]; V[(1 / 2) * h_10(i)]]; with[1 / 2 <= i / D by V[(1 / (2 * D)) * hn1]; V[1 * hw2]]]]]; with[(sum i in 1..J, (v_(i) + i * x)) = (sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x by lem:site(core sums)[J := J, x := x, v := v]; with[(sum h in 1..n, u_(h)) >= (sum h in 1..n, 1 / E_(h)) by sum[V[(1 / E_(h)) * h_11(h)]]; with[(sum z in 1..Z, (s_(z) + e_(z))) >= (sum z in 1..Z, min(1 / 2, 1 / F_(z))) by sum[lem:site(core gap)[F := F_(z), s := s_(z), e := e_(z)]]; with[kq * x >= kq / D by V[(kq / D) * h_9]; V[1 * hw1, 1 * hw5, 1 * hw6, 1 * hw7, 1 * hw8, (1 / 2) * h_8]]]]]]
  "core point" cases[2 * i * x <= 1; V[| 2 * h_3]; V[2 * h_3, 1 * hn1]]; cases[F <= 2; V[2 * h_6, F * h_7]; V[2 * h_6, F * h_7]]
  (at) with[(sum i in 1..J, (max(1 / 2 - i * (1 / D), 0) + i * (1 / D))) = (sum i in 1..J, max(1 / 2, i / D)) by sum[cases[2 * i <= D; with[i * (1 / D) <= 1 / 2 by V[(1 / (2 * D)) * hc1]; with[i / D <= 1 / 2 by V[(1 / (2 * D)) * hc1]; V[0]]]; with[1 / 2 <= i * (1 / D) by V[(1 / (2 * D)) * hn1]; with[1 / 2 <= i / D by V[(1 / (2 * D)) * hn1]; V[0]]]]]; with[(sum i in 1..J, (max(1 / 2 - i * (1 / D), 0) + i * (1 / D))) = (sum i in 1..J, max(1 / 2 - i * (1 / D), 0)) + J * (J + 1) / 2 * (1 / D) by lem:site(core sums)[J := J, x := 1 / D, v_(i) := max(1 / 2 - i * (1 / D), 0)]; with[(sum z in 1..Z, (iverson(F_(z) <= 2) / 2 + iverson(2 < F_(z)) / F_(z))) = (sum z in 1..Z, min(1 / 2, 1 / F_(z))) by sum[cases[F_(z) <= 2; with[1 / 2 <= 1 / F_(z) by V[(1 / (2 * F_(z))) * hc2]; V[0]]; with[1 / F_(z) <= 1 / 2 by V[(1 / (2 * F_(z))) * hn2]; V[0]]]]; with[kq * (1 / D) = kq / D by V; V[1 * hw1, 1 * hw7, 1 * hw10 | 1 * hw6]]]]]
  "core prices" (cases[2 * i <= D; V[0]; V[0]], cases[2 * i <= D; with[i / D <= 1 / 2 by V[(1 / (2 * D)) * hc2]; V[0]]; with[1 / 2 <= i / D by V[(1 / (2 * D)) * hn2]; V[0]]]); (cases[F <= 2; with[1 / 2 <= 1 / F by V[(1 / (2 * F)) * hc3]; V[0]]; with[1 / F <= 1 / 2 by V[(1 / (2 * F)) * hn3]; V[2 * hw4]]], cases[F <= 2; with[1 / 2 <= 1 / F by V[(1 / (2 * F)) * hc4]; V[(1 / 2) * hc4]]; with[1 / F <= 1 / 2 by V[(1 / (2 * F)) * hn4]; V[0]]])
  (free) with[(sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x >= J / 2 by lem:site(core rows)[J := J, x := x, v := v]; with[4 * (J + 1) * ((J + 2) / 4 + k / (2 * (J + 1))) = (J + 1) * (J + 2) + 2 * k by V[0]; div[4 * (J + 1); V[(2 * (J + 1)) * h_7, (4 * (J + 1)) * hw1, 1 * h_5 * h_9, (2 * w) * h_6, 1 * hw2]]]]
  (freeat) with[(sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x = J / 2 by lem:site(core tight)[J := J, x := x, v := v]; with[k * x = k / (2 * (J + 1)) by V[(k / (2 * (J + 1))) * h_5]; V[(1 / 2) * h_4, 1 * hw1, 1 * hw2, (J / 4) * h_5]]]
  "core rung" ind[N; take[J := 0; (V[0], V)]; with[N + 1 <= (J + 1) * (J + 2) by logic; cases[N + 1 + 1 <= (J + 1) * (J + 1 + 1); take[J := J; (V, V[1 * hc1])]; take[J := J + 1; (V, V[1 * hw1])]]]]
  (cover) with[exists N in NN : N <= 2 * k, 2 * k < N + 1 by fact:floor(core)[x := 2 * k]; logic[with[exists J in NN : J * (J + 1) <= N, N + 1 <= (J + 1) * (J + 2) by lem:site(core rung)[N := N]; logic[with[N <= 2 * k by logic; with[2 * k < N + 1 by logic; with[J * (J + 1) <= N by logic; with[N + 1 <= (J + 1) * (J + 2) by logic; take[J := J; (V[1 * hw5, 1 * hw3], V[1 * hw4, 1 * hw6])]]]]]]]]]
  "core gapcell" cases[2 * g < f; with[1 / f <= 1 / (2 * g) by V[(1 / (2 * g * f)) * hc1]; with[g / f <= 1 / 2 by V[(1 / (2 * f)) * hc1]; (V[0], V[0], V)]]; with[1 / (2 * g) <= 1 / f by V[(1 / (2 * g * f)) * hn1]; with[1 / 2 <= g / f by V[(1 / (2 * f)) * hn1]; (V[0], V[(max(2 * g - f, 0) / (2 * g)) * h_3], V[0])]]]
  "core gapsplit" chain[(sum iota, pi_(iota) * Pr.P_(iota)_(i)) = sum iota, (iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota)))) + iverson(i = Z + iota) * (pi_(iota) * f_(iota)) + iverson(iota = Z + i) * (pi_(iota) * iverson(2 * g_(iota) < f_(iota)))) by sum[chain[pi_(iota) * Pr.P_(iota)_(i) = pi_(iota) * (iverson(i = iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota))) + iverson(i = Z + iota) * f_(iota) + iverson(iota = Z + i) * iverson(2 * g_(iota) < f_(iota))) by with[Pr.P_(iota)_(i) = iverson(i = iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota))) + iverson(i = Z + iota) * f_(iota) + iverson(iota = Z + i) * iverson(2 * g_(iota) < f_(iota)) by logic; mono, mono]; = iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota)))) + iverson(i = Z + iota) * (pi_(iota) * f_(iota)) + iverson(iota = Z + i) * (pi_(iota) * iverson(2 * g_(iota) < f_(iota))) by eq]]; = (sum iota, (iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota)))) + iverson(i = Z + iota) * (pi_(iota) * f_(iota)))) + (sum iota, iverson(iota = Z + i) * (pi_(iota) * iverson(2 * g_(iota) < f_(iota)))) by sum; = (sum iota, iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota))))) + (sum iota, iverson(i = Z + iota) * (pi_(iota) * f_(iota))) + (sum iota, iverson(iota = Z + i) * (pi_(iota) * iverson(2 * g_(iota) < f_(iota)))) by with[(sum iota, (iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota)))) + iverson(i = Z + iota) * (pi_(iota) * f_(iota)))) = (sum iota, iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota))))) + (sum iota, iverson(i = Z + iota) * (pi_(iota) * f_(iota))) by sum; V[1 * hw7]]]
  "core gapmove" cases[iota = Z + i; with[Z < iota by V[| 1 * hc1]; with[g_(iota) = g_(i) by logic; with[f_(iota) = f_(i) by logic; with[pi_(iota) = iverson(iota <= Z) * min(1 / (2 * g_(iota)), 1 / f_(iota)) + iverson(Z < iota) * (max(f_(iota) - 2 * g_(iota), 0) / f_(iota) + max(2 * g_(iota) - f_(iota), 0) / (2 * g_(iota))) by logic; cases V]]]]; V[0]]
  "core gapback" cases[i = Z + iota; with[iota <= Z by V[1 * hb(i), 1 * h_1 | 1 * hc1]; with[g_(i) = g_(iota) by logic; with[f_(i) = f_(iota) by logic; with[pi_(iota) = iverson(iota <= Z) * min(1 / (2 * g_(iota)), 1 / f_(iota)) + iverson(Z < iota) * (max(f_(iota) - 2 * g_(iota), 0) / f_(iota) + max(2 * g_(iota) - f_(iota), 0) / (2 * g_(iota))) by logic; cases V]]]]; V[0]]
  "core gapslope" with[(sum iota, iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota))))) = pi_(i) * (iverson(i <= Z) * 2 * g_(i) + iverson(Z < i) * iverson(f_(i) < 2 * g_(i))) by sum; with[pi_(i) * (iverson(i <= Z) * 2 * g_(i) + iverson(Z < i) * iverson(f_(i) < 2 * g_(i))) = min(1 / (2 * g_(i)), 1 / f_(i)) * (2 * g_(i)) by with[pi_(i) = iverson(i <= Z) * min(1 / (2 * g_(i)), 1 / f_(i)) + iverson(Z < i) * (max(f_(i) - 2 * g_(i), 0) / f_(i) + max(2 * g_(i) - f_(i), 0) / (2 * g_(i))) by logic; cases V]; with[(sum iota, iverson(i = Z + iota) * (pi_(iota) * f_(iota))) = 0 by sum[with[i < Z + iota by V[1 * hi1]; V[0]]]; with[(sum iota, iverson(iota = Z + i) * (pi_(iota) * iverson(2 * g_(iota) < f_(iota)))) = (sum iota, iverson(iota = Z + i) * (iverson(2 * g_(i) < f_(i)) * (max(f_(i) - 2 * g_(i), 0) / f_(i) + max(2 * g_(i) - f_(i), 0) / (2 * g_(i))))) by sum[lem:site(core gapmove)[Z := Z, n := n, pi := pi, g := g, f := f]]; with[Z + i <= n by V[1 * hi1 | 1 * h_1]; with[(sum iota, iverson(iota = Z + i) * (iverson(2 * g_(i) < f_(i)) * (max(f_(i) - 2 * g_(i), 0) / f_(i) + max(2 * g_(i) - f_(i), 0) / (2 * g_(i))))) = iverson(2 * g_(i) < f_(i)) * (max(f_(i) - 2 * g_(i), 0) / f_(i) + max(2 * g_(i) - f_(i), 0) / (2 * g_(i))) by sum; V[1 * hw1, 1 * hw2, 1 * hw4, 1 * hw6, 1 * hw8]]]]]]]
  "core gaplength" with[(sum iota, iverson(i = iota) * (pi_(iota) * (iverson(iota <= Z) * 2 * g_(iota) + iverson(Z < iota) * iverson(f_(iota) < 2 * g_(iota))))) = pi_(i) * (iverson(i <= Z) * 2 * g_(i) + iverson(Z < i) * iverson(f_(i) < 2 * g_(i))) by sum; with[pi_(i) * (iverson(i <= Z) * 2 * g_(i) + iverson(Z < i) * iverson(f_(i) < 2 * g_(i))) = iverson(f_(i) < 2 * g_(i)) * (max(f_(i) - 2 * g_(i), 0) / f_(i) + max(2 * g_(i) - f_(i), 0) / (2 * g_(i))) by with[pi_(i) = iverson(i <= Z) * min(1 / (2 * g_(i)), 1 / f_(i)) + iverson(Z < i) * (max(f_(i) - 2 * g_(i), 0) / f_(i) + max(2 * g_(i) - f_(i), 0) / (2 * g_(i))) by logic; cases V]; with[(sum iota, iverson(iota = Z + i) * (pi_(iota) * iverson(2 * g_(iota) < f_(iota)))) = 0 by sum[with[iota < Z + i by V[1 * hb(iota), 1 * h_1, 1 * hi1]; V[0]]]; with[(sum iota, iverson(i = Z + iota) * (pi_(iota) * f_(iota))) = (sum iota, iverson(i = Z + iota) * (f_(i) * min(1 / (2 * g_(i)), 1 / f_(i)))) by sum[lem:site(core gapback)[Z := Z, n := n, pi := pi, g := g, f := f]]; with[(sum iota, iverson(i = Z + iota) * (f_(i) * min(1 / (2 * g_(i)), 1 / f_(i)))) = f_(i) * min(1 / (2 * g_(i)), 1 / f_(i)) by sum; V[1 * hw1, 1 * hw2, 1 * hw4, 1 * hw6, 1 * hw7]]]]]]
