-- Q++ 0.2
module site
uses regular

subsection sec:site The site

  -- At a site of \(k\) units of order \(p\), a chamber is an order of the units and the site, and \(d\) is the least
  -- degree whose two sides of the moments do not tie, as the partial sums of the masses change side too few times. The
  -- units share one scale \(x\): a realized moment is a row \(2ix+2v_i\ge1\), the term of degree \(d\) the cap
  -- \(Dx\ge1\), a loud unit off the scale a row \(E_hu_h\ge1\), and a silent gap the surplus unit of
  -- \cref{lem:surplus}.

-- A surplus unit either empties its weight, one row at the price of the weight, or keeps it and pays its \(d\) position
-- coordinates as one scale at the price \(1/D\) each (\cref{thm:pivots}). The least is the cheaper of the two, and at
-- the tie \(\alpha D=2d\) the segment between them is optimal, so the multiplicity rises by one.
lemma lem:surplus [a surplus unit: emptied, merged, or both at the tie]
  given: alpha, D, d in QQ>0
  (below): alpha * D < 2 * d : prog(v, w in QQ>=0, 2 * v + D * w >= 1 : alpha * v + d * w) = (alpha / 2, 1)
  fix (below) surplusbelow
  fix (below) gmunit.below
  fix (below) silentpair.below
  (tie): alpha = 2 * d / D : prog(v, w in QQ>=0, 2 * v + D * w >= 1 : alpha * v + d * w) = (d / D, 2)
  fix (tie) surplustie
  fix (tie) gmunit.tie
  fix (tie) silentpair.tie
  (above): 2 * d < alpha * D : prog(v, w in QQ>=0, 2 * v + D * w >= 1 : alpha * v + d * w) = (d / D, 1)
  fix (above) surplusabove
  fix (above) gmunit.above
  fix (above) silentpair.above
  core unit: alpha, d in QQ>0, d = 2 * alpha : prog(v, w in QQ>=0, 2 * v + 4 * w >= 1 : alpha * v + d * w) = (alpha / 2, 2)
  neqfix core unit gmunit.offtie
  core wall: D in QQ>0, D = 2 : prog(v, w in QQ>=0, 2 * v + D * w >= 1 : v + w) = (1 / 2, 2)
  neqfix core wall silentpair.offtie
  origin: ?{\text{elementary, proved here by prices and, at the tie, two vertices; the switch at}\ \alpha D=2d\ \text{is the threshold of \cite{RousseauMengersen2011}}}

proof lem:surplus
  (below) face[V[alpha / 2 * h_4, 1 / 2 * w * h_1]; v := 1 / 2 by V[0], V[0], V[0]; 2 * v = 1, w = 0 by (V[2 / alpha * h_5, 2 * d / alpha * h_3], V[2 * d / (2 * d - alpha * D) * h_4, 2 * D / (2 * d - alpha * D) * h_5]), with[(2 * d - alpha * D) * w = 0 by (V[2 * h_5, alpha * h_4], V[w * h_1]); V[1 / (2 * d - alpha * D) * hw1]]]
  (tie) face[V[d / D * h_4 | v * h_1]; w := 1 / D by V[0], V[0], V[0]; v := 1 / 2 by V[0], V[0], V[1 / 2 * h_1]; 2 * v + D * w = 1 by (V[D / d * h_5 | D / d * v * h_1], V[1 * h_4]); V[0]]
  (above) face[V[d / D * h_4, 1 / D * v * h_1]; w := 1 / D by V[0], V[0], V[0]; v = 0, 2 * v + D * w = 1 by with[(alpha * D - 2 * d) * v = 0 by (V[D * h_5, d * h_4], V[v * h_1]); V[1 / (alpha * D - 2 * d) * hw1]], (V[D / d * h_5, 1 / d * v * h_1], V[1 * h_4])]
  "core unit" face[V[alpha / 2 * h_4 | w * h_1]; w := 1 / 4 by V[0], V[0], V[1 / 4 * h_1]; v := 1 / 2 by V[0], V[0], V[0]; 2 * v + 4 * w = 1 by (V[2 / alpha * h_5 | 2 / alpha * w * h_1], V[1 * h_4]); V[0]]
  "core wall" face[V[1 / 2 * h_4, 1 / 2 * w * h_1]; w := 1 / 2 by V[0], V[| 1 / 2 * h_1], V[0]; v := 1 / 2 by V[0], V[0], V[0]; 2 * v + D * w = 1 by (V[2 * h_5, w * h_1], V[1 * h_4]); V[0]]

lemma lem:block [the count of a block]
  core range: M, c in NN : (sum v in 0..c, iverson(v <= M)) = min(c, M) + 1
  core unit: c, d, b in NN : (sum t in 0..b, iverson(t + c = d)) = iverson(c <= d) * iverson(d <= b + c)
  core tail: r, l, s, b in NN : iverson(l <= b + s) / 2^((r + 1) * b + (r + 1) * s) + (sum t in 0..b, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) <= 2 / 2^((r + 1) * l)
  fix core tail block.tail
  core point: A, B, M, T, k, t, v, J in NN, B + 1 <= A, A <= T, A * k <= M, t + v <= J : iverson(A * t + B * v >= M) / 2^(t + v) <= 1 / 2^k * (sum j in 0..J, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j)
  core strict: A, B, M, T, k, b, c in NN, B + 1 <= A, A <= T, A * k <= M : (sum t in 0..b, sum v in 0..c, iverson(A * t + B * v >= M) / 2^(t + v)) <= 4 * T / 2^k
  (above): A, B, M, T, k, b, c in NN, A <= T, B <= T, 1 <= A + B, A * k <= M, B * k <= M : (sum t in 0..b, sum v in 0..c, iverson(A * t + B * v >= M) / 2^(t + v)) <= (4 * T + 2 * k * iverson(A = B)) / 2^k
  fix (above) block.above
  neqfix (above) block.above.equal

proof lem:block
  "core range" ind[c; with[(sum v in 0..0, iverson(v <= M)) = iverson(0 <= M) by sum; with[0 <= M by V[0]; with[iverson(0 <= M) = 1 by V[0]; with[min(0, M) = 0 by V[0]; V[1 * hw1, 1 * hw3, 1 * hw4]]]]]; with[(sum v in 0..c + 1, iverson(v <= M)) = (sum v in 0..c, iverson(v <= M)) + iverson(c + 1 <= M) by sum; with[(sum v in 0..c, iverson(v <= M)) = min(c, M) + 1 by logic; cases[c + 1 <= M; with[iverson(c + 1 <= M) = 1 by V[0]; with[c <= M by V[1 * hc1]; with[min(c, M) = c by V[0]; with[min(c + 1, M) = c + 1 by V[0]; V[1 * hw5, 1 * hw7, 1 * hw6, 1 * hw9, 1 * hw10]]]]]; with[iverson(c + 1 <= M) = 0 by V[0]; with[M <= c by V; with[min(c, M) = M by V[0]; with[min(c + 1, M) = M by V[0]; V[1 * hw5, 1 * hw11, 1 * hw6, 1 * hw13, 1 * hw14]]]]]]]]]
  "core unit" cases[c <= d; ind[b; with[(sum t in 0..0, iverson(t + c = d)) = iverson(0 + c = d) by sum; cases[0 + c = d; with[iverson(0 + c = d) = 1 by V[0]; V[1 * hw1, 1 * hw2]]; with[0 + c <= d by V[1 * hc1]; with[iverson(0 + c = d) = 0 by V[0]; V[1 * hw1, 1 * hw4]]]]]; with[(sum t in 0..b + 1, iverson(t + c = d)) = (sum t in 0..b, iverson(t + c = d)) + iverson(b + 1 + c = d) by sum; with[(sum t in 0..b, iverson(t + c = d)) = iverson(c <= d) * iverson(d <= b + c) by logic; cases[d <= b + c; with[d < b + 1 + c by V[1 * hc3]; with[iverson(b + 1 + c = d) = 0 by V[0]; V[1 * hw5, 1 * hw6, 1 * hw8]]]; cases[d = b + 1 + c; with[iverson(b + 1 + c = d) = 1 by V[0]; V[1 * hw5, 1 * hw6, 1 * hw9]]; with[b + 1 + c <= d by V[1 * hn3]; with[iverson(b + 1 + c = d) = 0 by V[0]; V[1 * hw5, 1 * hw6, 1 * hw11]]]]]]]]; with[(sum t in 0..b, iverson(t + c = d)) = 0 by sum[with[d < t + c by V[1 * hn1]; V[0]]]; V[1 * hw12]]]
  "core tail" ind[b; with[(sum t in 0..0, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) = iverson(l <= 0 + s) / 2^((r + 1) * 0 + (r + 1) * s) by sum; cases[l <= 0 + s; with[(r + 1) * l <= (r + 1) * 0 + (r + 1) * s by V[(r + 1) * hc1]; chain[iverson(l <= 0 + s) / 2^((r + 1) * 0 + (r + 1) * s) + (sum t in 0..0, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) = 2 / 2^((r + 1) * 0 + (r + 1) * s) by V[1 * hw1]; <= 2 / 2^((r + 1) * l) by mono]]; chain[iverson(l <= 0 + s) / 2^((r + 1) * 0 + (r + 1) * s) + (sum t in 0..0, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) = 0 by V[1 * hw1]; <= 2 / 2^((r + 1) * l) by mono]]]; with[(sum t in 0..b + 1, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) = (sum t in 0..b, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) + iverson(l <= b + 1 + s) / 2^((r + 1) * (b + 1) + (r + 1) * s) by sum; with[iverson(l <= b + s) / 2^((r + 1) * b + (r + 1) * s) + (sum t in 0..b, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) <= 2 / 2^((r + 1) * l) by logic; cases[l <= b + s; with[l <= b + 1 + s by V[1 * hc2]; with[2 / 2^((r + 1) * (b + 1) + (r + 1) * s) = 1 / 2^(r + (r + 1) * b + (r + 1) * s) by eq; with[1 / 2^(r + (r + 1) * b + (r + 1) * s) <= 1 / 2^((r + 1) * b + (r + 1) * s) by mono; chain[iverson(l <= b + 1 + s) / 2^((r + 1) * (b + 1) + (r + 1) * s) + (sum t in 0..b + 1, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) = 1 / 2^(r + (r + 1) * b + (r + 1) * s) + (sum t in 0..b, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) by V[1 * hw7, 1 * hw10]; <= 1 / 2^((r + 1) * b + (r + 1) * s) + (sum t in 0..b, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) by mono; = iverson(l <= b + s) / 2^((r + 1) * b + (r + 1) * s) + (sum t in 0..b, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) by V[0]; <= 2 / 2^((r + 1) * l) by logic]]]]; with[(sum t in 0..b, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) = 0 by sum[with[t <= b by logic; with[t + s < l by V[1 * hw17, 1 * hn2]; V[0]]]]; cases[l <= b + 1 + s; with[(r + 1) * l <= (r + 1) * (b + 1) + (r + 1) * s by V[(r + 1) * hc3]; chain[iverson(l <= b + 1 + s) / 2^((r + 1) * (b + 1) + (r + 1) * s) + (sum t in 0..b + 1, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) = 2 / 2^((r + 1) * (b + 1) + (r + 1) * s) by V[1 * hw7, 1 * hw16]; <= 2 / 2^((r + 1) * l) by mono]]; chain[iverson(l <= b + 1 + s) / 2^((r + 1) * (b + 1) + (r + 1) * s) + (sum t in 0..b + 1, iverson(l <= t + s) / 2^((r + 1) * t + (r + 1) * s)) = 0 by V[1 * hw7, 1 * hw16]; <= 2 / 2^((r + 1) * l) by mono]]]]]]]
  "core point" cases[k <= t + v; cases[A * t + B * v >= M; with[T * (t + v) >= T * k + v by V[h_2 * hc1, 1 * hc2, 1 * h_3, v * h_1]; with[exists l in NN : t + v = k + l, l <= J, v <= T * l, k + l <= t + v by take[l := max(t + v - k, 0); (V[0], V[1 * h_4], V[1 * hw1], V[0])]; chain[iverson(A * t + B * v >= M) / 2^(t + v) = 1 / 2^(t + v) by V[0]; <= 1 / 2^(k + l) by mono; = 1 / 2^k * (1 / 2^l) by eq; <= 1 / 2^k * (sum j in 0..J, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j) by with[1 / 2^l <= (sum j in 0..J, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j) by term[l]; mono]]]]; chain[iverson(A * t + B * v >= M) / 2^(t + v) = 0 by V[0]; <= 1 / 2^k * (sum j in 0..J, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j) by V]]; with[A * t + B * v < M by V[1 * h_3, A * hn1, v * h_1, 1 * h_1]; chain[iverson(A * t + B * v >= M) / 2^(t + v) = 0 by V[0]; <= 1 / 2^k * (sum j in 0..J, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j) by V]]]
  "core strict" with[1 <= T by V[h_1, h_2]; with[(sum j in 0..b + c, (j + 1) / 2^j) <= 4 by lem:count(core geometric)[k := 1, J := b + c]; chain[(sum t in 0..b, sum v in 0..c, iverson(A * t + B * v >= M) / 2^(t + v)) <= (sum t in 0..b, sum v in 0..c, 1 / 2^k * (sum j in 0..b + c, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j)) by sum[sum[with[t <= b by logic; with[v <= c by logic; with[t + v <= b + c by V[1 * hw4, 1 * hw5]; lem:block(core point)[A := A, B := B, M := M, T := T, k := k, t := t, v := v, J := b + c]]]]]]; = (sum t in 0..b, 1 / 2^k * (sum v in 0..c, sum j in 0..b + c, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j)) by eq; = 1 / 2^k * (sum t in 0..b, sum v in 0..c, sum j in 0..b + c, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j) by eq; = 1 / 2^k * (sum t in 0..b, sum j in 0..b + c, sum v in 0..c, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j) by eq; = 1 / 2^k * (sum j in 0..b + c, sum t in 0..b, sum v in 0..c, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j) by eq; = 1 / 2^k * (sum j in 0..b + c, sum v in 0..c, sum t in 0..b, iverson(t + v = k + j) * iverson(v <= T * j) / 2^j) by eq; = 1 / 2^k * (sum j in 0..b + c, sum v in 0..c, sum t in 0..b, (1 / 2^j * iverson(v <= T * j)) * iverson(t + v = k + j)) by eq; = 1 / 2^k * (sum j in 0..b + c, sum v in 0..c, (1 / 2^j * iverson(v <= T * j)) * (sum t in 0..b, iverson(t + v = k + j))) by eq; = 1 / 2^k * (sum j in 0..b + c, sum v in 0..c, 1 / 2^j * (iverson(v <= T * j) * (sum t in 0..b, iverson(t + v = k + j)))) by eq; = 1 / 2^k * (sum j in 0..b + c, 1 / 2^j * (sum v in 0..c, iverson(v <= T * j) * (sum t in 0..b, iverson(t + v = k + j)))) by eq; <= 1 / 2^k * (sum j in 0..b + c, 1 / 2^j * (T * (j + 1))) by sum[with[(sum v in 0..c, iverson(v <= T * j) * (sum t in 0..b, iverson(t + v = k + j))) <= (sum v in 0..c, iverson(v <= T * j)) by sum[with[(sum t in 0..b, iverson(t + v = k + j)) <= 1 by with[(sum t in 0..b, iverson(t + v = k + j)) = iverson(v <= k + j) * iverson(k + j <= b + v) by lem:block(core unit)[c := v, d := k + j, b := b]; cases[v <= k + j; cases[k + j <= b + v; V[1 * hw19]; V[1 * hw19]]; V[1 * hw19]]]; cases[v <= T * j; V[1 * hw18]; V[0]]]]; with[(sum v in 0..c, iverson(v <= T * j)) = min(c, T * j) + 1 by lem:block(core range)[M := T * j, c := c]; with[min(c, T * j) <= T * j by cases[c <= T * j; V[1 * hc4]; V[0]]; with[(sum v in 0..c, iverson(v <= T * j) * (sum t in 0..b, iverson(t + v = k + j))) <= T * (j + 1) by V[1 * hw17, 1 * hw20, 1 * hw21, 1 * hw1]; mono]]]]]; = 1 / 2^k * (sum j in 0..b + c, T * ((j + 1) / 2^j)) by eq; = 1 / 2^k * (T * (sum j in 0..b + c, (j + 1) / 2^j)) by eq; <= 1 / 2^k * (T * 4) by mono; = 4 * T / 2^k by eq]]]
  (above) cases[B < A; with[B + 1 <= A by V[1 * hc1]; chain[(sum t in 0..b, sum v in 0..c, iverson(A * t + B * v >= M) / 2^(t + v)) <= 4 * T / 2^k by lem:block(core strict)[A := A, B := B, M := M, T := T, k := k, b := b, c := c]; = (4 * T + 2 * k * iverson(A = B)) / 2^k by V[0]]]; cases[A < B; with[A + 1 <= B by V[1 * hc2]; chain[(sum t in 0..b, sum v in 0..c, iverson(A * t + B * v >= M) / 2^(t + v)) = (sum v in 0..c, sum t in 0..b, iverson(A * t + B * v >= M) / 2^(t + v)) by eq; = (sum v in 0..c, sum t in 0..b, iverson(B * v + A * t >= M) / 2^(v + t)) by sum[sum[cases[A * t + B * v >= M; with[B * v + A * t >= M by V[1 * hc3]; V[0]]; with[B * v + A * t < M by V[1 * hn3]; V[0]]]]]; <= 4 * T / 2^k by lem:block(core strict)[A := B, B := A, M := M, T := T, k := k, b := c, c := b]; = (4 * T + 2 * k * iverson(A = B)) / 2^k by V[0]]]; with[A = B by V[1 * hn1], V[1 * hn2]; cases[1 <= A; with[(sum j in 0..b + c, 1 / 2^j) <= 2 by lem:count(core geometric)[k := 0, J := b + c]; with[(sum j in 0..b + c, (j + 1) / 2^j) <= 4 by lem:count(core geometric)[k := 1, J := b + c]; chain[(sum t in 0..b, sum v in 0..c, iverson(A * t + B * v >= M) / 2^(t + v)) <= (sum t in 0..b, sum v in 0..c, 1 / 2^k * (sum j in 0..b + c, iverson(t + v = k + j) / 2^j)) by sum[sum[with[t <= b by logic; with[v <= c by logic; with[t + v <= b + c by V[1 * hw15, 1 * hw16]; cases[k <= t + v; cases[A * t + B * v >= M; with[exists l in NN : t + v = k + l, l <= b + c, k + l <= t + v by take[l := max(t + v - k, 0); (V[0], V[1 * hw17], V[0])]; chain[iverson(A * t + B * v >= M) / 2^(t + v) = 1 / 2^(t + v) by V[0]; <= 1 / 2^(k + l) by mono; = 1 / 2^k * (1 / 2^l) by eq; <= 1 / 2^k * (sum j in 0..b + c, iverson(t + v = k + j) / 2^j) by with[1 / 2^l <= (sum j in 0..b + c, iverson(t + v = k + j) / 2^j) by term[l]; mono]]]; chain[iverson(A * t + B * v >= M) / 2^(t + v) = 0 by V[0]; <= 1 / 2^k * (sum j in 0..b + c, iverson(t + v = k + j) / 2^j) by V]]; with[A * t + B * v < M by V[1 * h_4, A * hn5, v * hn2, 1 * hc4]; chain[iverson(A * t + B * v >= M) / 2^(t + v) = 0 by V[0]; <= 1 / 2^k * (sum j in 0..b + c, iverson(t + v = k + j) / 2^j) by V]]]]]]]]; = (sum t in 0..b, 1 / 2^k * (sum v in 0..c, sum j in 0..b + c, iverson(t + v = k + j) / 2^j)) by eq; = 1 / 2^k * (sum t in 0..b, sum v in 0..c, sum j in 0..b + c, iverson(t + v = k + j) / 2^j) by eq; = 1 / 2^k * (sum t in 0..b, sum j in 0..b + c, sum v in 0..c, iverson(t + v = k + j) / 2^j) by eq; = 1 / 2^k * (sum j in 0..b + c, sum t in 0..b, sum v in 0..c, iverson(t + v = k + j) / 2^j) by eq; = 1 / 2^k * (sum j in 0..b + c, sum v in 0..c, sum t in 0..b, iverson(t + v = k + j) / 2^j) by eq; = 1 / 2^k * (sum j in 0..b + c, sum v in 0..c, sum t in 0..b, 1 / 2^j * iverson(t + v = k + j)) by eq; = 1 / 2^k * (sum j in 0..b + c, sum v in 0..c, 1 / 2^j * (sum t in 0..b, iverson(t + v = k + j))) by eq; = 1 / 2^k * (sum j in 0..b + c, 1 / 2^j * (sum v in 0..c, sum t in 0..b, iverson(t + v = k + j))) by eq; <= 1 / 2^k * (sum j in 0..b + c, 1 / 2^j * (k + j + 1)) by sum[with[(sum v in 0..c, sum t in 0..b, iverson(t + v = k + j)) <= (sum v in 0..c, iverson(v <= k + j)) by sum[with[(sum t in 0..b, iverson(t + v = k + j)) = iverson(v <= k + j) * iverson(k + j <= b + v) by lem:block(core unit)[c := v, d := k + j, b := b]; cases[v <= k + j; cases[k + j <= b + v; V[1 * hw39]; V[1 * hw39]]; V[1 * hw39]]]]; with[(sum v in 0..c, iverson(v <= k + j)) = min(c, k + j) + 1 by lem:block(core range)[M := k + j, c := c]; with[min(c, k + j) <= k + j by cases[c <= k + j; V[1 * hc9]; V[0]]; with[(sum v in 0..c, sum t in 0..b, iverson(t + v = k + j)) <= k + j + 1 by V[1 * hw38, 1 * hw40, 1 * hw41]; mono]]]]]; = 1 / 2^k * (sum j in 0..b + c, (k * (1 / 2^j) + (j + 1) / 2^j)) by eq; = 1 / 2^k * ((sum j in 0..b + c, k * (1 / 2^j)) + (sum j in 0..b + c, (j + 1) / 2^j)) by eq; = 1 / 2^k * (k * (sum j in 0..b + c, 1 / 2^j) + (sum j in 0..b + c, (j + 1) / 2^j)) by eq; <= 1 / 2^k * (k * 2 + (sum j in 0..b + c, (j + 1) / 2^j)) by mono; <= 1 / 2^k * (k * 2 + 4) by mono; = (2 * k + 4) / 2^k by eq; <= (4 * T + 2 * k * iverson(A = B)) / 2^k by with[2 * k + 4 <= 4 * T + 2 * k * iverson(A = B) by V[4 * h_1, 4 * hc4]; mono]]]]; with[A + B + 1 <= 1 by V[2 * hn4 | 1 * hw11]; with[1 < A + B + 1 by V[1 * h_3]; logic]]]]]]

lemma lem:assembly [the count of an assembly]
  (gaps): Z, L in NN, b, b2, g, f in Exponent(Z) : (sum s <= b, sum e <= b2, prod z, iverson(2 * g_(z) * s_(z) + f_(z) * e_(z) >= g_(z) * L) / 2^(s_(z) + e_(z))) = prod z, (sum t in 0..b_(z), sum t2 in 0..b2_(z), iverson(2 * g_(z) * t + f_(z) * t2 >= g_(z) * L) / 2^(t + t2))
  fix (gaps) assembly.gaps
  (star): J, x0, kq, B in NN, b, s, l in Exponent(J) : (sum x in 0..B, sum v <= b, iverson(x0 <= x) / 2^(kq * x) * prod i, iverson(l_(i) <= v_(i) + s_(i) * x) / 2^(v_(i) + s_(i) * x)) = sum x in 0..B, iverson(x0 <= x) / 2^(kq * x) * prod i, (sum t in 0..b_(i), iverson(l_(i) <= t + s_(i) * x) / 2^(t + s_(i) * x))
  fix (star) assembly.star

proof lem:assembly
  (gaps) eq
  (star) eq

-- The site at its features: \(J\) realized moments, the slope of the scale, the cap \(D\), loud units and silent gaps.
-- Its least content is \(\lambda=\frac12+\sum_{i\le J}\max(\frac12,\frac
-- iD)+\frac{k'}D+\sum_h\frac1{E_h}+\sum_z\min(\frac12,\frac1{F_z})\), at an explicit point (out, at); without the cap
-- the scale stops at the breakpoint of the next moment (free), a range that holds every slope (cover).
lemma lem:site [the site]
  core readout: N in NN, x in QQ>=0, c_(1..N) in QQ>0, b_(1..N), v_(1..N) in QQ>=0, (forall r in NN>=1 : r <= N => c_(r) * v_(r) + b_(r) * x >= 1) : (sum r in 1..N, v_(r)) >= (sum r in 1..N, max(1 / c_(r) - b_(r) * x / c_(r), 0))
  fix core readout ladder.core
  core sums: J in NN, x in QQ>=0, v_(1..J) in QQ>=0 : (sum i in 1..J, (v_(i) + i * x)) = (sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x
  fix core sums ladder.rows
  core half: J in NN : (sum i in 1..J, 1 / 2) = J / 2
  fix core half ladder.half
  core slope: x in QQ>=0, l, m in NN, 1 <= l, 1 <= 2 * (l + 1) * x, 2 * l * x <= 1 : (sum i in 1..l, max(1 / 2 - i * x, 0)) + (sum i in 1..m, max(1 / 2 - (l + i) * x, 0)) + l * (l + 1) / 2 * x = l / 2
  fix core slope remladder.core
  core rows: J in NN, x in QQ>=0, v_(1..J) in QQ>=0, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) >= 1) : (sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x >= J / 2
  fix core rows ladder.moments
  core tight: J in NN, x in QQ>=0, v_(1..J) in QQ>=0, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) = 1) : (sum i in 1..J, v_(i)) + J * (J + 1) / 2 * x = J / 2
  fix core tight ladder.tight
  core gap: F in QQ>0, s, e in QQ>=0, 2 * s + F * e >= 1 : s + e >= min(1 / 2, 1 / F)
  fix core gap site.gap
  fix core gap jumpwall.core
  (out): J, n, Z in NN, kq, c, x in QQ>=0, D in QQ>0, E_(1..n), F_(1..Z) in QQ>0, v_(1..J), u_(1..n), s_(1..Z), e_(1..Z) in QQ>=0, 2 * c >= 1, D * x >= 1, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) >= 1), (forall h in NN>=1 : h <= n => E_(h) * u_(h) >= 1), (forall z in NN>=1 : z <= Z => 2 * s_(z) + F_(z) * e_(z) >= 1) : c + (J * (J + 1) / 2 + kq) * x + (sum i in 1..J, v_(i)) + (sum h in 1..n, u_(h)) + (sum z in 1..Z, (s_(z) + e_(z))) >= 1 / 2 + (sum i in 1..J, max(1 / 2, i / D)) + kq / D + (sum h in 1..n, 1 / E_(h)) + (sum z in 1..Z, min(1 / 2, 1 / F_(z)))
  fix (out) site.out
  fix (out) escape.core
  core point: i in NN, x, v in QQ>=0, v = max(1 / 2 - i * x, 0) : 2 * i * x + 2 * v >= 1; F in QQ>0, s, e in QQ>=0, s = iverson(F <= 2) / 2, e = iverson(2 < F) / F : 2 * s + F * e = 1
  fix core point site.point
  (at): J, Z in NN, kq in QQ>=0, D in QQ>0, F_(1..Z) in QQ>0 : 1 / 2 + (J * (J + 1) / 2 + kq) * (1 / D) + (sum i in 1..J, max(1 / 2 - i * (1 / D), 0)) + (sum z in 1..Z, (iverson(F_(z) <= 2) / 2 + iverson(2 < F_(z)) / F_(z))) = 1 / 2 + (sum i in 1..J, max(1 / 2, i / D)) + kq / D + (sum z in 1..Z, min(1 / 2, 1 / F_(z)))
  eqfix (at) site.values
  core prices: i in NN, D in QQ>0 : iverson(D < 2 * i) * i + iverson(2 * i <= D) * i = i, iverson(D < 2 * i) * i / D + iverson(2 * i <= D) / 2 = max(1 / 2, i / D); F in QQ>0 : 2 * min(1 / 2, 1 / F) <= 1, F * min(1 / 2, 1 / F) <= 1
  fix core prices site.prices
  (free): J in NN, k in QQ>0, c, x, w in QQ>=0, v_(1..J) in QQ>=0, J * (J + 1) <= 2 * k, 2 * k <= (J + 1) * (J + 2), 2 * c >= 1, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) >= 1), 2 * (J + 1) * x + 2 * w >= 1 : c + k * x + (sum i in 1..J, v_(i)) + w >= (J + 2) / 4 + k / (2 * (J + 1))
  fix (free) ladder.free
  (freeat): J in NN, k in QQ>0, c, x in QQ>=0, v_(1..J) in QQ>=0, 2 * c = 1, 2 * (J + 1) * x = 1, (forall i in NN>=1 : i <= J => 2 * i * x + 2 * v_(i) = 1) : c + k * x + (sum i in 1..J, v_(i)) = (J + 2) / 4 + k / (2 * (J + 1))
  eqfix (freeat) ladder.breakpoints
  core rung: N in NN : exists J in NN : J * (J + 1) <= N, N + 1 <= (J + 1) * (J + 2)
  fix core rung ladder.rung
  (cover): k in QQ>0 : exists J in NN : J * (J + 1) <= 2 * k, 2 * k <= (J + 1) * (J + 2)
  fix (cover) ladder.cover
  core gapcell: g, f in NN, 1 <= g, 1 <= f, iverson(2 * g < f) + iverson(f < 2 * g) = 1 : min(1 / (2 * g), 1 / f) * (2 * g) + iverson(2 * g < f) * (max(f - 2 * g, 0) / f + max(2 * g - f, 0) / (2 * g)) = 1, iverson(f < 2 * g) * (max(f - 2 * g, 0) / f + max(2 * g - f, 0) / (2 * g)) + f * min(1 / (2 * g), 1 / f) = 1, g * min(1 / (2 * g), 1 / f) = min(1 / 2, g / f)
