-- Q++ 0.2
module cells
uses regular

subsection sec:cells The cells of a chamber

  -- The way in of a model of order one: its loss as a sum over the cells of a chamber, and the ties across a cell.

-- Jensen's inequality for the power \(m+1\) on two masses: \((x+y)^{m+1}\le2^m(x^{m+1}+y^{m+1})\).
cit fact:jensentwo [Jensen's inequality for two powers]
  mathlib: add_pow_le (Mathlib.Algebra.Order.Ring.Basic)
  (1): m in NN, x, y in QQ>=0 : (x + y)^(m + 1) <= 2^m * (x^(m + 1) + y^(m + 1))
  fix (1) jensentwo.powers

-- On a chamber the knots and the site cut the hull into cells, and on each cell the difference of the model and the
-- truth is a line whose term in the loss is \(\kappa_j(e_jm_j^2+\frac1{12}e_j^3S_j^2)\), from its midpoint value and
-- its slope. The ties of the node and midpoint values bound the cells from above by the slopes (walk, upper), the outer
-- cell by the moments \(g_0,g_1\) of the site (outer), and, when no nonempty set of the true weights sums to zero, each
-- inner cell from below by a power of its gap (units, inner).
lemma lem:chamber [the cells of a chamber]
  core tie: a, b, c in QQ>=0, (a = b + c or b = a + c or c = a + b) : a <= b + c, b <= a + c, c <= a + b
  fix core tie cells.tie
  core power: m in NN, a, b, c in QQ>=0, (a = b + c or b = a + c or c = a + b) : a^(m + 1) <= 2^m * (b^(m + 1) + c^(m + 1)), b^(m + 1) <= 2^m * (a^(m + 1) + c^(m + 1)), c^(m + 1) <= 2^m * (a^(m + 1) + b^(m + 1))
  fix core power cells.power
  core telescope: N, n in NN, e_(1..N) in QQ>0, p_(1..N + 1) in QQ>=0, (forall j in NN>=1 : j <= N => p_(j + 1) = p_(j) + e_(j)) : n <= N => p_(1) + (sum j in 1..n, e_(j)) = p_(n + 1)
  fix core telescope cells.telescope
  core cell: j, eta in NN, C, A, W in QQ>=0, e_(1..j) in QQ>0, T_(1..j), M_(1..j), V_(1..j), p_(1..j + 1), x_(1..j), Y_(1..j) in QQ>=0, (M_(j) = V_(j) + T_(j) * e_(j) / 2 or V_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + V_(j)), T_(j) <= A, p_(j + 1) = p_(j) + e_(j), V_(j) <= A * p_(j), p_(j + 1) <= W, x_(j) <= W, Y_(j) <= C * x_(j)^eta * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12) : Y_(j) <= 13 / 12 * C * A^2 * W^(2 + eta) * e_(j)
  fix core cell cells.cell
  (walk): N in NN, n in NN>=1, A in QQ>=0, e_(1..N) in QQ>0, T_(1..N), M_(1..N) in QQ>=0, V_(1..N + 1), p_(1..N + 1) in QQ>=0, (forall j in NN>=1 : j <= N => (M_(j) = V_(j) + T_(j) * e_(j) / 2 or V_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + V_(j)), (V_(j + 1) = M_(j) + T_(j) * e_(j) / 2 or M_(j) = V_(j + 1) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = V_(j + 1) + M_(j)), T_(j) <= A, p_(j + 1) = p_(j) + e_(j)) : n <= N + 1 => V_(n) + A * p_(1) <= V_(1) + A * p_(n)
  fix (walk) cells.walk
  (units): k in NN>=1, b in QQ>0, P, Q, R in QQ>=0, d in Point(k), b <= Q, (Q = P + R or P = Q + R or R = Q + P), R <= (sum h, d_(h)), (forall h : d_(h) <= b / (2 * k)) : b <= 2 * P
  fix (units) cells.units
  fix (units) cells.units.comparison
  neqfix (units) cells.units.silent
  (outer): l, X, c, C in QQ>0, F, G, M, Y in QQ>=0, c * (l * M^2 + l^3 * F^2 / 12) <= Y, Y <= C * (l * M^2 + l^3 * F^2 / 12), (G = M + F * X or M = G + F * X or F * X = G + M) : c * l^3 * F^2 <= 12 * Y, c * l^3 * G^2 <= (4 * l^2 + 48 * X^2) * Y, Y <= C * ((4 * l * X^2 + l^3 / 12) * F^2 + 4 * l * G^2)
  fix (outer) cells.outer
  (inner): eta in NN, c, a, x, e in QQ>0, T, Y in QQ>=0, a <= T, e <= x, c * x^eta * (e / 2)^3 * T^2 / 12 <= Y : c * a^2 * x^eta * e^3 <= 96 * Y, c * a^2 * e^(3 + eta) <= 96 * Y
  fix (inner) cells.inner
  neqfix (inner) cells.inner.silent
  (upper): N, eta in NN, C, A, W in QQ>=0, e_(1..N) in QQ>0, T_(1..N), M_(1..N), x_(1..N), Y_(1..N) in QQ>=0, V_(1..N + 1), p_(1..N + 1) in QQ>=0, V_(1) = 0, p_(1) = 0, (forall j in NN>=1 : j <= N => (M_(j) = V_(j) + T_(j) * e_(j) / 2 or V_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + V_(j)), (V_(j + 1) = M_(j) + T_(j) * e_(j) / 2 or M_(j) = V_(j + 1) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = V_(j + 1) + M_(j)), T_(j) <= A, p_(j + 1) = p_(j) + e_(j)), (forall j in NN>=1 : j <= N => p_(j + 1) <= W, x_(j) <= W, Y_(j) <= C * x_(j)^eta * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12)) : (sum j in 1..N, Y_(j)) <= 13 / 12 * C * A^2 * W^(3 + eta)
  fix (upper) cells.upper
  origin: ?{\text{elementary, proved here}}

-- Each modulus of a tie is at most the sum of the other two; the walk and the positions are inductions on the node;
-- (upper) bounds cell \(j\) by \(\frac{13}{12}C\,A^2W^{2+\eta}e_j\) through the walk, and the gaps sum to at most \(W\).
proof lem:chamber
  "core tie" (cases[a = b + c; V[1 * hc1]; cases[b = a + c; V[2 * h_3 | 1 * hc2]; with[c = a + b by logic; V[2 * h_2 | 1 * hw1]]]], cases[a = b + c; V[2 * h_3 | 1 * hc3]; cases[b = a + c; V[1 * hc4]; with[c = a + b by logic; V[2 * h_1 | 1 * hw2]]]], cases[a = b + c; V[2 * h_2 | 1 * hc5]; cases[b = a + c; V[2 * h_1 | 1 * hc6]; with[c = a + b by logic; V[1 * hw3]]]])
  "core power" with[(a <= b + c, b <= a + c, c <= a + b) by lem:chamber(core tie)[a := a, b := b, c := c]; (with[a <= b + c by V; with[a^(m + 1) <= (b + c)^(m + 1) by mono; with[(b + c)^(m + 1) <= 2^m * (b^(m + 1) + c^(m + 1)) by fact:jensentwo(1)[m := m, x := b, y := c]; V[1 * hw3, 1 * hw4]]]], with[b <= a + c by V; with[b^(m + 1) <= (a + c)^(m + 1) by mono; with[(a + c)^(m + 1) <= 2^m * (a^(m + 1) + c^(m + 1)) by fact:jensentwo(1)[m := m, x := a, y := c]; V[1 * hw6, 1 * hw7]]]], with[c <= a + b by V; with[c^(m + 1) <= (a + b)^(m + 1) by mono; with[(a + b)^(m + 1) <= 2^m * (a^(m + 1) + b^(m + 1)) by fact:jensentwo(1)[m := m, x := a, y := b]; V[1 * hw9, 1 * hw10]]]])]
  "core telescope" ind[n; with[(sum j in 1..0, e_(j)) = 0 by sum[V]; eq]; with[n <= N by V[1 * hi2]; with[p_(1) + (sum j in 1..n, e_(j)) = p_(n + 1) by logic; with[p_(n + 1 + 1) = p_(n + 1) + e_(n + 1) by logic; with[(sum j in 1..n + 1, e_(j)) = (sum j in 1..n, e_(j)) + e_(n + 1) by sum; V[1 * hw3, 1 * hw4, 1 * hw5]]]]]]
  "core cell" with[0 <= T_(j) by logic; with[0 < e_(j) by logic; with[0 <= M_(j) by logic; with[0 <= V_(j) by logic; with[0 <= p_(j) by logic; with[0 <= x_(j) by logic; with[0 <= T_(j) * e_(j) / 2 by V; with[(M_(j) <= V_(j) + T_(j) * e_(j) / 2, V_(j) <= M_(j) + T_(j) * e_(j) / 2, T_(j) * e_(j) / 2 <= M_(j) + V_(j)) by lem:chamber(core tie)[a := M_(j), b := V_(j), c := T_(j) * e_(j) / 2]; with[T_(j) * e_(j) <= A * e_(j) by mono; with[A * p_(j + 1) = A * p_(j) + A * e_(j) by eq[A * h_12]; with[A * p_(j + 1) <= A * W by mono; with[M_(j) <= V_(j) + T_(j) * e_(j) / 2 by V; with[M_(j) <= A * W by V[1 * hw12, 1 * h_13, 1/2 * hw9, 1 * hw11 | 1 * hw10]; with[e_(j) <= W by V[1 * h_14, 1 * hw5 | 1 * h_12]; with[x_(j)^eta <= W^eta by mono; with[M_(j)^2 <= (A * W)^2 by mono; with[T_(j)^2 <= A^2 by mono; with[e_(j) * M_(j)^2 <= e_(j) * (A * W)^2 by mono; with[e_(j)^2 * T_(j)^2 <= W^2 * A^2 by mono; with[e_(j)^3 * T_(j)^2 = e_(j) * (e_(j)^2 * T_(j)^2) by eq; with[e_(j) * (e_(j)^2 * T_(j)^2) <= e_(j) * (W^2 * A^2) by mono; with[e_(j)^3 * T_(j)^2 <= e_(j) * (W^2 * A^2) by V[1 * hw21]; with[C * x_(j)^eta * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12) <= C * W^eta * (e_(j) * (A * W)^2 + e_(j) * (W^2 * A^2) / 12) by mono; with[C * W^eta * (e_(j) * (A * W)^2 + e_(j) * (W^2 * A^2) / 12) = 13 / 12 * C * A^2 * W^(2 + eta) * e_(j) by eq; V[1 * h_16, 1 * hw23, 1 * hw24]]]]]]]]]]]]]]]]]]]]]]]]]
  (walk) ind[n; V; with[n <= N by V[1 * hi2]; with[n <= N + 1 by V; with[V_(n) + A * p_(1) <= V_(1) + A * p_(n) by logic; with[((M_(n) = V_(n) + T_(n) * e_(n) / 2 or V_(n) = M_(n) + T_(n) * e_(n) / 2 or T_(n) * e_(n) / 2 = M_(n) + V_(n)), (V_(n + 1) = M_(n) + T_(n) * e_(n) / 2 or M_(n) = V_(n + 1) + T_(n) * e_(n) / 2 or T_(n) * e_(n) / 2 = V_(n + 1) + M_(n)), T_(n) <= A, p_(n + 1) = p_(n) + e_(n)) by (logic, logic, logic, logic); with[0 <= T_(n) by logic; with[0 < e_(n) by logic; with[0 <= T_(n) * e_(n) / 2 by V; with[(M_(n) <= V_(n) + T_(n) * e_(n) / 2, V_(n) <= M_(n) + T_(n) * e_(n) / 2, T_(n) * e_(n) / 2 <= M_(n) + V_(n)) by lem:chamber(core tie)[a := M_(n), b := V_(n), c := T_(n) * e_(n) / 2]; with[(V_(n + 1) <= M_(n) + T_(n) * e_(n) / 2, M_(n) <= V_(n + 1) + T_(n) * e_(n) / 2, T_(n) * e_(n) / 2 <= V_(n + 1) + M_(n)) by lem:chamber(core tie)[a := V_(n + 1), b := M_(n), c := T_(n) * e_(n) / 2]; with[T_(n) * e_(n) <= A * e_(n) by mono; with[p_(n + 1) = p_(n) + e_(n) by V; with[V_(n + 1) <= M_(n) + T_(n) * e_(n) / 2 by V; with[M_(n) <= V_(n) + T_(n) * e_(n) / 2 by V; V[1 * hw3, 1 * hw12, 1 * hw13, 1 * hw10 | A * hw11]]]]]]]]]]]]]]]
  (units) with[(Q <= P + R, P <= Q + R, R <= Q + P) by lem:chamber(core tie)[a := Q, b := P, c := R]; with[Q <= P + R by logic; with[R <= b / 2 by chain[R <= k * (b / (2 * k)) by lem:rules(several)[r := k, M := R, D := b / (2 * k), m := d]; = b / 2 by V]; V[2 * h_4, 2 * hw2, 2 * hw3]]]]
  (outer) with[(G^(1 + 1) <= 2^1 * (M^(1 + 1) + (F * X)^(1 + 1)), M^(1 + 1) <= 2^1 * (G^(1 + 1) + (F * X)^(1 + 1)), (F * X)^(1 + 1) <= 2^1 * (G^(1 + 1) + M^(1 + 1))) by lem:chamber(core power)[m := 1, a := G, b := M, c := F * X]; (V[12 * h_5], with[G^(1 + 1) <= 2^1 * (M^(1 + 1) + (F * X)^(1 + 1)) by V; V[(c * l^3) * hw2, (2 * l^2 + 24 * X^2) * h_5]], with[M^(1 + 1) <= 2^1 * (G^(1 + 1) + (F * X)^(1 + 1)) by V; V[1 * h_6, (C * l) * hw3]])]
  (inner) (with[a^2 <= T^2 by mono; with[c * a^2 * x^eta * e^3 <= c * T^2 * x^eta * e^3 by mono; with[c * T^2 * x^eta * e^3 = 96 * (c * x^eta * (e / 2)^3 * T^2 / 12) by eq; V[1 * hw2, 1 * hw3, 96 * h_5]]]], with[a^2 <= T^2 by mono; with[c * a^2 * x^eta * e^3 <= c * T^2 * x^eta * e^3 by mono; with[c * T^2 * x^eta * e^3 = 96 * (c * x^eta * (e / 2)^3 * T^2 / 12) by eq; with[e^eta <= x^eta by mono; with[c * a^2 * e^3 * e^eta <= c * a^2 * e^3 * x^eta by mono; with[c * a^2 * e^(3 + eta) = c * a^2 * e^3 * e^eta by eq; V[1 * hw9, 1 * hw8, 1 * hw5, 1 * hw6, 96 * h_5]]]]]]])
  (upper) chain[(sum j in 1..N, Y_(j)) <= (sum j in 1..N, 13 / 12 * C * A^2 * W^(2 + eta) * e_(j)) by sum[with[1 <= j by V; with[j <= N + 1 by V; with[V_(j) + A * p_(1) <= V_(1) + A * p_(j) by lem:chamber(walk)[N := N, n := j, A := A, e := e, T := T, M := M, V := V, p := p]; with[V_(j) <= A * p_(j) by V[1 * hw4, 1 * h_10, A * h_11]; with[((M_(j) = V_(j) + T_(j) * e_(j) / 2 or V_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + V_(j)), (V_(j + 1) = M_(j) + T_(j) * e_(j) / 2 or M_(j) = V_(j + 1) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = V_(j + 1) + M_(j)), T_(j) <= A, p_(j + 1) = p_(j) + e_(j)) by (logic, logic, logic, logic); with[(p_(j + 1) <= W, x_(j) <= W, Y_(j) <= C * x_(j)^eta * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12)) by (logic, logic, logic); lem:chamber(core cell)[j := j, eta := eta, C := C, A := A, W := W, e := e, T := T, M := M, V := V, p := p, x := x, Y := Y]]]]]]]]; = 13 / 12 * C * A^2 * W^(2 + eta) * (sum j in 1..N, e_(j)) by sum; <= 13 / 12 * C * A^2 * W^(2 + eta) * W by with[forall j in NN>=1 : j <= N => p_(j + 1) = p_(j) + e_(j) by logic; with[N <= N by V; with[p_(1) + (sum j in 1..N, e_(j)) = p_(N + 1) by lem:chamber(core telescope)[N := N, n := N, e := e, p := p]; with[(sum j in 1..N, e_(j)) <= W by cases[1 <= N; with[p_(N + 1) <= W by logic; V[1 * hw12, 1 * hw14, 1 * h_11]]; with[N = 0 by V[1 * hn1], V[0]; with[p_(N + 1) = p_(1) by eq[hw15]; V[1 * hw12, 1 * hw16, 1 * h_3]]]]; mono]]]]; = 13 / 12 * C * A^2 * W^(3 + eta) by eq]

-- Jensen's inequality for the power \(m+1\) on \(N\) positive masses: \((\sum_je_j)^{m+1}\le N^m\sum_je_j^{m+1}\).
cit fact:jensen [Jensen's inequality for sums of powers]
  mathlib: pow_sum_le_card_mul_sum_pow (Mathlib.Algebra.Order.Chebyshev)
  (1): N, m in NN, e_(1..N) in QQ>0 : (sum j in 1..N, e_(j))^(m + 1) <= N^m * (sum j in 1..N, e_(j)^(m + 1))
  fix (1) jensen.powers

-- The Cauchy--Schwarz inequality for two families of \(n+1\) masses: \((\sum_if_ig_i)^2\le\sum_if_i^2\sum_ig_i^2\).
cit fact:cauchy [the Cauchy--Schwarz inequality for sums]
  mathlib: Finset.sum_mul_sq_le_sq_mul_sq (Mathlib.Algebra.Order.BigOperators.Ring.Finset)
  (1): n in NN, f_(0..n), g_(0..n) in QQ>=0 : (sum i in 0..n, f_(i) * g_(i))^2 <= (sum i in 0..n, f_(i)^2) * (sum i in 0..n, g_(i)^2)
  fix (1) cauchy.sums

-- Vandermonde's identity for the squares of a row of binomial coefficients: \(\sum_i\binom pi^2=\binom{2p}p\).
cit fact:vandermonde [Vandermonde's identity for the squares of a row]
  mathlib: Nat.sum_range_choose_sq (Mathlib.Data.Nat.Choose.Vandermonde)
  (1): p in NN : (sum i in 0..p, binom(p, i)^2) = binom(2 * p, p)
  fix (1) vandermonde.squares

-- At one site the loss is the outer term plus the terms of the cells inside the hull, and it lies between multiples of
-- \(F^2\), \(G^2\) and the powers \(e_j^{3+\eta}\) of the gaps, with \(F=|g_0|\) and \(G=|g_1|\) (\cref{lem:chamber},
-- \cref{fact:jensen}). In the chart where \(g_1\) replaces one gap, the chain at one site has the terms of
-- \cref{lem:regular}(above) at \(E=(2,2,3+\eta,\dots,3+\eta)\).
lemma lem:onesite [the loss at one site]
  core terms: N, eta in NN, c, C, A, l, X in QQ>0, F, G, U, Z, W, K in QQ>=0, e_(1..N) in QQ>0, T_(1..N), M_(1..N), x_(1..N), Y_(1..N) in QQ>=0, V_(1..N + 1), p_(1..N + 1) in QQ>=0, c * (l * U^2 + l^3 * F^2 / 12) <= Z, Z <= C * (l * U^2 + l^3 * F^2 / 12), (G = U + F * X or U = G + F * X or F * X = G + U), V_(1) = 0, p_(1) = 0, (forall j in NN>=1 : j <= N => (M_(j) = V_(j) + T_(j) * e_(j) / 2 or V_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + V_(j)), (V_(j + 1) = M_(j) + T_(j) * e_(j) / 2 or M_(j) = V_(j + 1) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = V_(j + 1) + M_(j)), T_(j) <= A, p_(j + 1) = p_(j) + e_(j)), (forall j in NN>=1 : j <= N => p_(j + 1) <= W, x_(j) <= W, Y_(j) <= C * x_(j)^eta * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12)), W = (sum j in 1..N, e_(j)), K = Z + (sum j in 1..N, Y_(j)) : c * l^3 * F^2 <= 12 * K, c * l^3 * G^2 <= (4 * l^2 + 48 * X^2) * K
  fix core terms onesite.models
  core gaps: N, eta in NN, c, C, a, A, l, X in QQ>0, F, G, U, Z, W, K in QQ>=0, e_(1..N) in QQ>0, T_(1..N), M_(1..N), x_(1..N), Y_(1..N) in QQ>=0, V_(1..N + 1), p_(1..N + 1) in QQ>=0, c * (l * U^2 + l^3 * F^2 / 12) <= Z, Z <= C * (l * U^2 + l^3 * F^2 / 12), (G = U + F * X or U = G + F * X or F * X = G + U), V_(1) = 0, p_(1) = 0, (forall j in NN>=1 : j <= N => (M_(j) = V_(j) + T_(j) * e_(j) / 2 or V_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + V_(j)), (V_(j + 1) = M_(j) + T_(j) * e_(j) / 2 or M_(j) = V_(j + 1) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = V_(j + 1) + M_(j)), T_(j) <= A, p_(j + 1) = p_(j) + e_(j)), (forall j in NN>=1 : j <= N => p_(j + 1) <= W, x_(j) <= W, Y_(j) <= C * x_(j)^eta * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12)), (forall j in NN>=1 : j <= N => a <= T_(j), e_(j) <= x_(j), c * x_(j)^eta * (e_(j) / 2)^3 * T_(j)^2 / 12 <= Y_(j)), W = (sum j in 1..N, e_(j)), K = Z + (sum j in 1..N, Y_(j)), r in NN>=1, r <= N : c * a^2 * e_(r)^(3 + eta) <= 96 * K
  fix core gaps onesite.gaps
  core sum: N, eta in NN, c, C, A, l, X in QQ>0, F, G, U, Z, W, K in QQ>=0, e_(1..N) in QQ>0, T_(1..N), M_(1..N), x_(1..N), Y_(1..N) in QQ>=0, V_(1..N + 1), p_(1..N + 1) in QQ>=0, c * (l * U^2 + l^3 * F^2 / 12) <= Z, Z <= C * (l * U^2 + l^3 * F^2 / 12), (G = U + F * X or U = G + F * X or F * X = G + U), V_(1) = 0, p_(1) = 0, (forall j in NN>=1 : j <= N => (M_(j) = V_(j) + T_(j) * e_(j) / 2 or V_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + V_(j)), (V_(j + 1) = M_(j) + T_(j) * e_(j) / 2 or M_(j) = V_(j + 1) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = V_(j + 1) + M_(j)), T_(j) <= A, p_(j + 1) = p_(j) + e_(j)), (forall j in NN>=1 : j <= N => p_(j + 1) <= W, x_(j) <= W, Y_(j) <= C * x_(j)^eta * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12)), W = (sum j in 1..N, e_(j)), K = Z + (sum j in 1..N, Y_(j)) : K <= C * ((4 * l * X^2 + l^3 / 12) * F^2 + 4 * l * G^2) + 13 / 12 * C * A^2 * N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta))
  fix core sum onesite.models
  core pivot: N, eta in NN, R, S, T, b, B in QQ>0, F, G, K, d in QQ>=0, e_(1..N) in QQ>0, G <= 1, d <= b * (G + B * (sum j in 1..N, e_(j))), K <= R * F^2 + S * G^2 + T * ((sum j in 1..N, e_(j)^(3 + eta)) + d^(3 + eta)) : K <= R * F^2 + (S + T * (2 * b)^(3 + eta)) * G^2 + T * (1 + (2 * b * B)^(3 + eta) * N^(2 + eta)) * (sum j in 1..N, e_(j)^(3 + eta))
  fix core pivot onesite.pivot
  origin: ?{\text{proved here, from \cref{lem:chamber} and \cref{fact:jensen}}}

proof lem:onesite
  "core terms" (with[Z <= K by with[0 <= (sum j in 1..N, Y_(j)) by sum[V]; V[1 * hw2 | 1 * h_21]]; with[(c * l^3 * F^2 <= 12 * Z, c * l^3 * G^2 <= (4 * l^2 + 48 * X^2) * Z, Z <= C * ((4 * l * X^2 + l^3 / 12) * F^2 + 4 * l * G^2)) by lem:chamber(outer)[l := l, X := X, c := c, C := C, F := F, G := G, M := U, Y := Z]; V]], with[Z <= K by with[0 <= (sum j in 1..N, Y_(j)) by sum[V]; V[1 * hw5 | 1 * h_21]]; with[(c * l^3 * F^2 <= 12 * Z, c * l^3 * G^2 <= (4 * l^2 + 48 * X^2) * Z, Z <= C * ((4 * l * X^2 + l^3 / 12) * F^2 + 4 * l * G^2)) by lem:chamber(outer)[l := l, X := X, c := c, C := C, F := F, G := G, M := U, Y := Z]; with[(4 * l^2 + 48 * X^2) * Z <= (4 * l^2 + 48 * X^2) * K by mono; V]]])
  "core gaps" with[1 <= r by V; with[r <= N by V[1 * h_23]; with[(a <= T_(r), e_(r) <= x_(r), c * x_(r)^eta * (e_(r) / 2)^3 * T_(r)^2 / 12 <= Y_(r)) by (logic, logic, logic); with[0 < e_(r) by logic; with[0 <= T_(r) by logic; with[0 < x_(r) by V; with[(c * a^2 * x_(r)^eta * e_(r)^3 <= 96 * Y_(r), c * a^2 * e_(r)^(3 + eta) <= 96 * Y_(r)) by lem:chamber(inner)[eta := eta, c := c, a := a, x := x_(r), e := e_(r), T := T_(r), Y := Y_(r)]; with[forall i in NN : 0 <= Y_(i) by logic; with[Y_(r) <= sum i in 1..N, Y_(i) by term[r]; V]]]]]]]]]
  "core sum" with[(c * l^3 * F^2 <= 12 * Z, c * l^3 * G^2 <= (4 * l^2 + 48 * X^2) * Z, Z <= C * ((4 * l * X^2 + l^3 / 12) * F^2 + 4 * l * G^2)) by lem:chamber(outer)[l := l, X := X, c := c, C := C, F := F, G := G, M := U, Y := Z]; with[(sum j in 1..N, Y_(j)) <= 13 / 12 * C * A^2 * W^(3 + eta) by lem:chamber(upper)[N := N, eta := eta, C := C, A := A, W := W, e := e, T := T, M := M, x := x, Y := Y, V := V, p := p]; with[(sum j in 1..N, e_(j))^(2 + eta + 1) <= N^(2 + eta) * (sum j in 1..N, e_(j)^(2 + eta + 1)) by fact:jensen(1)[N := N, m := 2 + eta, e := e]; with[(sum j in 1..N, e_(j)^(2 + eta + 1)) = (sum j in 1..N, e_(j)^(3 + eta)) by sum[eq]; with[(sum j in 1..N, e_(j)^(2 + eta + 1)) <= (sum j in 1..N, e_(j)^(3 + eta)) by V; with[W^(3 + eta) = (sum j in 1..N, e_(j))^(2 + eta + 1) by eq; with[N^(2 + eta) * (sum j in 1..N, e_(j)^(2 + eta + 1)) <= N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta)) by mono; with[W^(3 + eta) <= N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta)) by V; with[13 / 12 * C * A^2 * W^(3 + eta) <= 13 / 12 * C * A^2 * (N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta))) by mono; V]]]]]]]]]
  "core pivot" with[0 <= (sum j in 1..N, e_(j)) by sum[V[0]]; with[(sum j in 1..N, e_(j))^(2 + eta + 1) <= N^(2 + eta) * (sum j in 1..N, e_(j)^(2 + eta + 1)) by fact:jensen(1)[N := N, m := 2 + eta, e := e]; with[(sum j in 1..N, e_(j)^(2 + eta + 1)) = (sum j in 1..N, e_(j)^(3 + eta)) by sum[eq]; with[(sum j in 1..N, e_(j)^(2 + eta + 1)) <= (sum j in 1..N, e_(j)^(3 + eta)) by V[1 * hw3]; with[N^(2 + eta) * (sum j in 1..N, e_(j)^(2 + eta + 1)) <= N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta)) by mono; with[(sum j in 1..N, e_(j))^(3 + eta) = (sum j in 1..N, e_(j))^(2 + eta + 1) by eq; with[(sum j in 1..N, e_(j))^(3 + eta) <= N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta)) by V[1 * hw2, 1 * hw5, 1 * hw6]; with[G^(1 + eta) <= 1^(1 + eta) by mono; with[1^(1 + eta) = 1 by eq; with[G^(1 + eta) <= 1 by V[hw8, hw9]; with[G^(3 + eta) = G^2 * G^(1 + eta) by eq; with[G^2 * G^(1 + eta) <= G^2 * 1 by mono; with[0 <= G^(3 + eta) by V; with[0 <= (B * (sum j in 1..N, e_(j)))^(3 + eta) by V; with[G + B * (sum j in 1..N, e_(j)) <= 2 * max(G, B * (sum j in 1..N, e_(j))) by cases V; with[(G + B * (sum j in 1..N, e_(j)))^(3 + eta) <= (2 * max(G, B * (sum j in 1..N, e_(j))))^(3 + eta) by mono; with[(2 * max(G, B * (sum j in 1..N, e_(j))))^(3 + eta) = 2^(3 + eta) * max(G, B * (sum j in 1..N, e_(j)))^(3 + eta) by eq; with[max(G, B * (sum j in 1..N, e_(j)))^(3 + eta) <= G^(3 + eta) + (B * (sum j in 1..N, e_(j)))^(3 + eta) by cases V; with[(B * (sum j in 1..N, e_(j)))^(3 + eta) = B^(3 + eta) * (sum j in 1..N, e_(j))^(3 + eta) by eq; with[B^(3 + eta) * (sum j in 1..N, e_(j))^(3 + eta) <= B^(3 + eta) * (N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta))) by mono; with[max(G, B * (sum j in 1..N, e_(j)))^(3 + eta) <= G^2 + B^(3 + eta) * (N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta))) by V[1 * hw11, 1 * hw12, 1 * hw18, 1 * hw19, 1 * hw20]; with[2^(3 + eta) * max(G, B * (sum j in 1..N, e_(j)))^(3 + eta) <= 2^(3 + eta) * (G^2 + B^(3 + eta) * (N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta)))) by mono; with[(G + B * (sum j in 1..N, e_(j)))^(3 + eta) <= 2^(3 + eta) * (G^2 + B^(3 + eta) * (N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta)))) by V[1 * hw16, 1 * hw17, 1 * hw22]; with[d^(3 + eta) <= (b * (G + B * (sum j in 1..N, e_(j))))^(3 + eta) by mono; with[(b * (G + B * (sum j in 1..N, e_(j))))^(3 + eta) = b^(3 + eta) * (G + B * (sum j in 1..N, e_(j)))^(3 + eta) by eq; with[b^(3 + eta) * (G + B * (sum j in 1..N, e_(j)))^(3 + eta) <= b^(3 + eta) * (2^(3 + eta) * (G^2 + B^(3 + eta) * (N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta))))) by mono; with[b^(3 + eta) * (2^(3 + eta) * (G^2 + B^(3 + eta) * (N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta))))) = (2 * b)^(3 + eta) * G^2 + (2 * b * B)^(3 + eta) * N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta)) by eq; with[d^(3 + eta) <= (2 * b)^(3 + eta) * G^2 + (2 * b * B)^(3 + eta) * N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta)) by V[1 * hw24, 1 * hw25, 1 * hw26, 1 * hw27]; with[T * d^(3 + eta) <= T * ((2 * b)^(3 + eta) * G^2 + (2 * b * B)^(3 + eta) * N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta))) by mono; with[R * F^2 + S * G^2 + T * ((sum j in 1..N, e_(j)^(3 + eta)) + d^(3 + eta)) = R * F^2 + S * G^2 + T * (sum j in 1..N, e_(j)^(3 + eta)) + T * d^(3 + eta) by eq; with[R * F^2 + S * G^2 + T * (sum j in 1..N, e_(j)^(3 + eta)) + T * ((2 * b)^(3 + eta) * G^2 + (2 * b * B)^(3 + eta) * N^(2 + eta) * (sum j in 1..N, e_(j)^(3 + eta))) = R * F^2 + (S + T * (2 * b)^(3 + eta)) * G^2 + T * (1 + (2 * b * B)^(3 + eta) * N^(2 + eta)) * (sum j in 1..N, e_(j)^(3 + eta)) by eq; V[1 * h_7, 1 * hw29]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]

-- A regular spline has one unit near each of its \(H\) true kinks, so its cells alternate between \(H+1\) long cells
-- and \(H\) short ones. The long cells bound the loss from below (\cref{lem:chamber}(outer)), the short ones are
-- bounded through the ends they share, and each of the \(2H+2\) coefficients has a pivot member: the regular spline has
-- the terms of \cref{lem:regular} at \(E=(2,\dots,2)\), with the value \(H+1\).
lemma lem:spline [the loss of a regular spline]
  core terms: H in NN, c, C, Ln, Lm, Xm in QQ>0, K in QQ>=0, l_(1..H + 1), X_(1..H + 1) in QQ>0, F_(1..H + 1), G_(1..H + 1), U_(1..H + 1), Z_(1..H + 1), Y_(1..H) in QQ>=0, (forall J in NN>=1 : J <= H + 1 => c * (l_(J) * U_(J)^2 + l_(J)^3 * F_(J)^2 / 12) <= Z_(J), Z_(J) <= C * (l_(J) * U_(J)^2 + l_(J)^3 * F_(J)^2 / 12), (G_(J) = U_(J) + F_(J) * X_(J) or U_(J) = G_(J) + F_(J) * X_(J) or F_(J) * X_(J) = G_(J) + U_(J)), Ln <= l_(J), l_(J) <= Lm, X_(J) <= Xm), K = (sum J in 1..H + 1, Z_(J)) + (sum j in 1..H, Y_(j)), i in NN>=1, i <= H + 1 : c * Ln^3 * F_(i)^2 <= 12 * K, c * Ln^3 * G_(i)^2 <= (4 * Lm^2 + 48 * Xm^2) * K
  fix core terms spline.terms
  core square: a, b in QQ>=0 : (2 * max(a, b))^2 <= 4 * (a^2 + b^2)
  fix core square spline.square
  core short: j in NN>=1, C, r, D in QQ>0, l_(1..j + 1), X_(1..j + 1), e_(1..j) in QQ>0, F_(1..j + 1), G_(1..j + 1), U_(1..j + 1), V_(1..j + 1), W_(1..j + 1), T_(1..j), M_(1..j), Y_(1..j) in QQ>=0, (G_(j) = U_(j) + F_(j) * X_(j) or U_(j) = G_(j) + F_(j) * X_(j) or F_(j) * X_(j) = G_(j) + U_(j)), (W_(j) = U_(j) + F_(j) * l_(j) / 2 or U_(j) = W_(j) + F_(j) * l_(j) / 2 or F_(j) * l_(j) / 2 = W_(j) + U_(j)), (G_(j + 1) = U_(j + 1) + F_(j + 1) * X_(j + 1) or U_(j + 1) = G_(j + 1) + F_(j + 1) * X_(j + 1) or F_(j + 1) * X_(j + 1) = G_(j + 1) + U_(j + 1)), (V_(j + 1) = U_(j + 1) + F_(j + 1) * l_(j + 1) / 2 or U_(j + 1) = V_(j + 1) + F_(j + 1) * l_(j + 1) / 2 or F_(j + 1) * l_(j + 1) / 2 = V_(j + 1) + U_(j + 1)), (M_(j) = W_(j) + T_(j) * e_(j) / 2 or W_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + W_(j)), (V_(j + 1) = W_(j) + T_(j) * e_(j) or W_(j) = V_(j + 1) + T_(j) * e_(j) or T_(j) * e_(j) = V_(j + 1) + W_(j)), X_(j) + l_(j) / 2 <= D, X_(j + 1) + l_(j + 1) / 2 <= D, e_(j) <= r, Y_(j) <= C * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12) : Y_(j) <= 52 / 3 * C * r * ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))
  fix core short spline.short
  core shift: N, n in NN, D in QQ>0, F_(1..N), G_(1..N) in QQ>=0 : n + 1 <= N => (sum j in 1..n, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) + (G_(n + 1)^2 + D^2 * F_(n + 1)^2) <= 2 * (sum j in 1..n + 1, (G_(j)^2 + D^2 * F_(j)^2))
  fix core shift spline.shift
  core sum: H in NN, C, r, D, Lm, Xm in QQ>0, K in QQ>=0, l_(1..H + 1), X_(1..H + 1), e_(1..H) in QQ>0, F_(1..H + 1), G_(1..H + 1), U_(1..H + 1), V_(1..H + 1), W_(1..H + 1), Z_(1..H + 1), T_(1..H), M_(1..H), Y_(1..H) in QQ>=0, (forall J in NN>=1 : J <= H + 1 => Z_(J) <= C * (l_(J) * U_(J)^2 + l_(J)^3 * F_(J)^2 / 12), (G_(J) = U_(J) + F_(J) * X_(J) or U_(J) = G_(J) + F_(J) * X_(J) or F_(J) * X_(J) = G_(J) + U_(J)), (V_(J) = U_(J) + F_(J) * l_(J) / 2 or U_(J) = V_(J) + F_(J) * l_(J) / 2 or F_(J) * l_(J) / 2 = V_(J) + U_(J)), (W_(J) = U_(J) + F_(J) * l_(J) / 2 or U_(J) = W_(J) + F_(J) * l_(J) / 2 or F_(J) * l_(J) / 2 = W_(J) + U_(J)), l_(J) <= Lm, X_(J) <= Xm, X_(J) + l_(J) / 2 <= D), (forall j in NN>=1 : j <= H => (M_(j) = W_(j) + T_(j) * e_(j) / 2 or W_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + W_(j)), (V_(j + 1) = W_(j) + T_(j) * e_(j) or W_(j) = V_(j + 1) + T_(j) * e_(j) or T_(j) * e_(j) = V_(j + 1) + W_(j)), e_(j) <= r, Y_(j) <= C * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12)), K = (sum J in 1..H + 1, Z_(J)) + (sum j in 1..H, Y_(j)) : K <= C * (sum J in 1..H + 1, ((4 * Lm * Xm^2 + Lm^3 / 12) * F_(J)^2 + 4 * Lm * G_(J)^2)) + 104 / 3 * C * r * (sum J in 1..H + 1, (G_(J)^2 + D^2 * F_(J)^2))
  fix core sum spline.sum
  origin: ?{\text{proved here, from \cref{lem:chamber}}}

proof lem:spline
  "core terms" with[1 <= i by V; with[i <= H + 1 by V[1 * h_9]; with[(c * (l_(i) * U_(i)^2 + l_(i)^3 * F_(i)^2 / 12) <= Z_(i), Z_(i) <= C * (l_(i) * U_(i)^2 + l_(i)^3 * F_(i)^2 / 12), (G_(i) = U_(i) + F_(i) * X_(i) or U_(i) = G_(i) + F_(i) * X_(i) or F_(i) * X_(i) = G_(i) + U_(i)), Ln <= l_(i), l_(i) <= Lm, X_(i) <= Xm) by (logic, logic, logic, logic, logic, logic); with[0 < l_(i) by logic; with[0 < X_(i) by logic; with[0 <= F_(i) by logic; with[0 <= G_(i) by logic; with[0 <= U_(i) by logic; with[0 <= Z_(i) by logic; with[(c * l_(i)^3 * F_(i)^2 <= 12 * Z_(i), c * l_(i)^3 * G_(i)^2 <= (4 * l_(i)^2 + 48 * X_(i)^2) * Z_(i), Z_(i) <= C * ((4 * l_(i) * X_(i)^2 + l_(i)^3 / 12) * F_(i)^2 + 4 * l_(i) * G_(i)^2)) by lem:chamber(outer)[l := l_(i), X := X_(i), c := c, C := C, F := F_(i), G := G_(i), M := U_(i), Y := Z_(i)]; with[forall J in NN : 0 <= Z_(J) by logic; with[Z_(i) <= (sum J in 1..H + 1, Z_(J)) by term[i]; with[0 <= (sum j in 1..H, Y_(j)) by sum[V]; with[Z_(i) <= K by V[1 * hw12, 1 * hw13 | 1 * h_8]; with[Ln^3 <= l_(i)^3 by mono; with[l_(i)^2 <= Lm^2 by mono; with[X_(i)^2 <= Xm^2 by mono; (with[c * Ln^3 * F_(i)^2 <= c * l_(i)^3 * F_(i)^2 by mono; with[c * l_(i)^3 * F_(i)^2 <= 12 * Z_(i) by V; V[1 * hw18, 1 * hw19, 12 * hw14]]], with[c * Ln^3 * G_(i)^2 <= c * l_(i)^3 * G_(i)^2 by mono; with[(4 * l_(i)^2 + 48 * X_(i)^2) * Z_(i) <= (4 * Lm^2 + 48 * Xm^2) * K by mono; with[c * l_(i)^3 * G_(i)^2 <= (4 * l_(i)^2 + 48 * X_(i)^2) * Z_(i) by V; V[1 * hw20, 1 * hw22, 1 * hw21]]]])]]]]]]]]]]]]]]]]]
  "core square" cases[a <= b; V[0]; V[0]]
  "core short" with[0 <= F_(j) by logic; with[0 <= G_(j) by logic; with[0 <= U_(j) by logic; with[0 <= W_(j) by logic; with[0 < X_(j) by logic; with[0 < l_(j) by logic; with[0 <= F_(j + 1) by logic; with[0 <= G_(j + 1) by logic; with[0 <= U_(j + 1) by logic; with[0 <= V_(j + 1) by logic; with[0 < X_(j + 1) by logic; with[0 < l_(j + 1) by logic; with[0 <= T_(j) by logic; with[0 < e_(j) by logic; with[0 <= M_(j) by logic; with[(G_(j) <= U_(j) + F_(j) * X_(j), U_(j) <= G_(j) + F_(j) * X_(j), F_(j) * X_(j) <= G_(j) + U_(j)) by lem:chamber(core tie)[a := G_(j), b := U_(j), c := F_(j) * X_(j)]; with[(W_(j) <= U_(j) + F_(j) * l_(j) / 2, U_(j) <= W_(j) + F_(j) * l_(j) / 2, F_(j) * l_(j) / 2 <= W_(j) + U_(j)) by lem:chamber(core tie)[a := W_(j), b := U_(j), c := F_(j) * l_(j) / 2]; with[(G_(j + 1) <= U_(j + 1) + F_(j + 1) * X_(j + 1), U_(j + 1) <= G_(j + 1) + F_(j + 1) * X_(j + 1), F_(j + 1) * X_(j + 1) <= G_(j + 1) + U_(j + 1)) by lem:chamber(core tie)[a := G_(j + 1), b := U_(j + 1), c := F_(j + 1) * X_(j + 1)]; with[(V_(j + 1) <= U_(j + 1) + F_(j + 1) * l_(j + 1) / 2, U_(j + 1) <= V_(j + 1) + F_(j + 1) * l_(j + 1) / 2, F_(j + 1) * l_(j + 1) / 2 <= V_(j + 1) + U_(j + 1)) by lem:chamber(core tie)[a := V_(j + 1), b := U_(j + 1), c := F_(j + 1) * l_(j + 1) / 2]; with[(M_(j)^(1 + 1) <= 2^1 * (W_(j)^(1 + 1) + (T_(j) * e_(j) / 2)^(1 + 1)), W_(j)^(1 + 1) <= 2^1 * (M_(j)^(1 + 1) + (T_(j) * e_(j) / 2)^(1 + 1)), (T_(j) * e_(j) / 2)^(1 + 1) <= 2^1 * (M_(j)^(1 + 1) + W_(j)^(1 + 1))) by lem:chamber(core power)[m := 1, a := M_(j), b := W_(j), c := T_(j) * e_(j) / 2]; with[(V_(j + 1)^(1 + 1) <= 2^1 * (W_(j)^(1 + 1) + (T_(j) * e_(j))^(1 + 1)), W_(j)^(1 + 1) <= 2^1 * (V_(j + 1)^(1 + 1) + (T_(j) * e_(j))^(1 + 1)), (T_(j) * e_(j))^(1 + 1) <= 2^1 * (V_(j + 1)^(1 + 1) + W_(j)^(1 + 1))) by lem:chamber(core power)[m := 1, a := V_(j + 1), b := W_(j), c := T_(j) * e_(j)]; with[U_(j) <= G_(j) + F_(j) * X_(j) by V; with[W_(j) <= U_(j) + F_(j) * l_(j) / 2 by V; with[U_(j + 1) <= G_(j + 1) + F_(j + 1) * X_(j + 1) by V; with[V_(j + 1) <= U_(j + 1) + F_(j + 1) * l_(j + 1) / 2 by V; with[F_(j) * (X_(j) + l_(j) / 2) <= F_(j) * D by mono; with[F_(j + 1) * (X_(j + 1) + l_(j + 1) / 2) <= F_(j + 1) * D by mono; with[W_(j) <= G_(j) + F_(j) * D by V[1 * hw22, 1 * hw23, 1 * hw26]; with[V_(j + 1) <= G_(j + 1) + F_(j + 1) * D by V[1 * hw24, 1 * hw25, 1 * hw27]; with[W_(j)^2 <= (G_(j) + F_(j) * D)^2 by mono; with[V_(j + 1)^2 <= (G_(j + 1) + F_(j + 1) * D)^2 by mono; with[(G_(j) + F_(j) * D)^(1 + 1) <= 2^1 * (G_(j)^(1 + 1) + (F_(j) * D)^(1 + 1)) by fact:jensentwo(1)[m := 1, x := G_(j), y := F_(j) * D]; with[(G_(j + 1) + F_(j + 1) * D)^(1 + 1) <= 2^1 * (G_(j + 1)^(1 + 1) + (F_(j + 1) * D)^(1 + 1)) by fact:jensentwo(1)[m := 1, x := G_(j + 1), y := F_(j + 1) * D]; with[M_(j)^(1 + 1) <= 2^1 * (W_(j)^(1 + 1) + (T_(j) * e_(j) / 2)^(1 + 1)) by V; with[(T_(j) * e_(j))^(1 + 1) <= 2^1 * (V_(j + 1)^(1 + 1) + W_(j)^(1 + 1)) by V; with[e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12 <= 19 / 3 * e_(j) * ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2)) by V[e_(j) * hw34, (7 / 12 * e_(j)) * hw35, (19 / 6 * e_(j)) * hw30, (7 / 6 * e_(j)) * hw31, (19 / 6 * e_(j)) * hw32, (7 / 6 * e_(j)) * hw33]; V[1 * h_18, C * hw36, (19 / 3 * C * ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) * h_17]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
  "core shift" ind[n; with[(sum j in 1..0, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) = 0 by sum[V]; with[(sum j in 1..0 + 1, (G_(j)^2 + D^2 * F_(j)^2)) = (sum j in 1..0, (G_(j)^2 + D^2 * F_(j)^2)) + (G_(0 + 1)^2 + D^2 * F_(0 + 1)^2) by sum; with[(sum j in 1..0, (G_(j)^2 + D^2 * F_(j)^2)) = 0 by sum[V]; V[2 * hw3, 1 * G_(0 + 1)^2, 1 * D^2 * F_(0 + 1)^2 | 2 * hw2]]]]; with[n + 1 <= N by V[1 * hi2]; with[(sum j in 1..n, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) + (G_(n + 1)^2 + D^2 * F_(n + 1)^2) <= 2 * (sum j in 1..n + 1, (G_(j)^2 + D^2 * F_(j)^2)) by logic; with[(sum j in 1..n + 1, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) = (sum j in 1..n, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) + ((G_(n + 1)^2 + D^2 * F_(n + 1)^2) + (G_(n + 1 + 1)^2 + D^2 * F_(n + 1 + 1)^2)) by sum; with[(sum j in 1..n + 1 + 1, (G_(j)^2 + D^2 * F_(j)^2)) = (sum j in 1..n + 1, (G_(j)^2 + D^2 * F_(j)^2)) + (G_(n + 1 + 1)^2 + D^2 * F_(n + 1 + 1)^2) by sum; V[1 * hw5, 1 * hw6 | 2 * hw7]]]]]]
  "core sum" with[(sum J in 1..H + 1, Z_(J)) <= (sum J in 1..H + 1, C * ((4 * Lm * Xm^2 + Lm^3 / 12) * F_(J)^2 + 4 * Lm * G_(J)^2)) by sum[with[(Z_(J) <= C * (l_(J) * U_(J)^2 + l_(J)^3 * F_(J)^2 / 12), (G_(J) = U_(J) + F_(J) * X_(J) or U_(J) = G_(J) + F_(J) * X_(J) or F_(J) * X_(J) = G_(J) + U_(J)), (V_(J) = U_(J) + F_(J) * l_(J) / 2 or U_(J) = V_(J) + F_(J) * l_(J) / 2 or F_(J) * l_(J) / 2 = V_(J) + U_(J)), (W_(J) = U_(J) + F_(J) * l_(J) / 2 or U_(J) = W_(J) + F_(J) * l_(J) / 2 or F_(J) * l_(J) / 2 = W_(J) + U_(J)), l_(J) <= Lm, X_(J) <= Xm, X_(J) + l_(J) / 2 <= D) by (logic, logic, logic, logic, logic, logic, logic); with[0 <= F_(J) by logic; with[0 <= G_(J) by logic; with[0 <= U_(J) by logic; with[0 < l_(J) by logic; with[0 < X_(J) by logic; with[(G_(J)^(1 + 1) <= 2^1 * (U_(J)^(1 + 1) + (F_(J) * X_(J))^(1 + 1)), U_(J)^(1 + 1) <= 2^1 * (G_(J)^(1 + 1) + (F_(J) * X_(J))^(1 + 1)), (F_(J) * X_(J))^(1 + 1) <= 2^1 * (G_(J)^(1 + 1) + U_(J)^(1 + 1))) by lem:chamber(core power)[m := 1, a := G_(J), b := U_(J), c := F_(J) * X_(J)]; with[U_(J)^(1 + 1) <= 2^1 * (G_(J)^(1 + 1) + (F_(J) * X_(J))^(1 + 1)) by V; with[X_(J)^2 <= Xm^2 by mono; with[F_(J)^2 * X_(J)^2 <= F_(J)^2 * Xm^2 by mono; with[U_(J)^2 <= 4 * (G_(J)^2 + F_(J)^2 * Xm^2) by V[1 * hw9, 2 * hw11]; chain[Z_(J) <= C * (l_(J) * U_(J)^2 + l_(J)^3 * F_(J)^2 / 12) by V; <= C * (Lm * (4 * (G_(J)^2 + F_(J)^2 * Xm^2)) + Lm^3 * F_(J)^2 / 12) by mono; = C * ((4 * Lm * Xm^2 + Lm^3 / 12) * F_(J)^2 + 4 * Lm * G_(J)^2) by eq]]]]]]]]]]]]]; with[(sum J in 1..H + 1, C * ((4 * Lm * Xm^2 + Lm^3 / 12) * F_(J)^2 + 4 * Lm * G_(J)^2)) = C * (sum J in 1..H + 1, ((4 * Lm * Xm^2 + Lm^3 / 12) * F_(J)^2 + 4 * Lm * G_(J)^2)) by sum; with[(sum j in 1..H, Y_(j)) <= (sum j in 1..H, 52 / 3 * C * r * ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) by sum[with[1 <= j by V; with[((M_(j) = W_(j) + T_(j) * e_(j) / 2 or W_(j) = M_(j) + T_(j) * e_(j) / 2 or T_(j) * e_(j) / 2 = M_(j) + W_(j)), (V_(j + 1) = W_(j) + T_(j) * e_(j) or W_(j) = V_(j + 1) + T_(j) * e_(j) or T_(j) * e_(j) = V_(j + 1) + W_(j)), e_(j) <= r, Y_(j) <= C * (e_(j) * M_(j)^2 + e_(j)^3 * T_(j)^2 / 12)) by (logic, logic, logic, logic); with[j <= H + 1 by V; with[(Z_(j) <= C * (l_(j) * U_(j)^2 + l_(j)^3 * F_(j)^2 / 12), (G_(j) = U_(j) + F_(j) * X_(j) or U_(j) = G_(j) + F_(j) * X_(j) or F_(j) * X_(j) = G_(j) + U_(j)), (V_(j) = U_(j) + F_(j) * l_(j) / 2 or U_(j) = V_(j) + F_(j) * l_(j) / 2 or F_(j) * l_(j) / 2 = V_(j) + U_(j)), (W_(j) = U_(j) + F_(j) * l_(j) / 2 or U_(j) = W_(j) + F_(j) * l_(j) / 2 or F_(j) * l_(j) / 2 = W_(j) + U_(j)), l_(j) <= Lm, X_(j) <= Xm, X_(j) + l_(j) / 2 <= D) by (logic, logic, logic, logic, logic, logic, logic); with[1 <= j + 1 by V; with[j + 1 <= H + 1 by V; with[(Z_(j + 1) <= C * (l_(j + 1) * U_(j + 1)^2 + l_(j + 1)^3 * F_(j + 1)^2 / 12), (G_(j + 1) = U_(j + 1) + F_(j + 1) * X_(j + 1) or U_(j + 1) = G_(j + 1) + F_(j + 1) * X_(j + 1) or F_(j + 1) * X_(j + 1) = G_(j + 1) + U_(j + 1)), (V_(j + 1) = U_(j + 1) + F_(j + 1) * l_(j + 1) / 2 or U_(j + 1) = V_(j + 1) + F_(j + 1) * l_(j + 1) / 2 or F_(j + 1) * l_(j + 1) / 2 = V_(j + 1) + U_(j + 1)), (W_(j + 1) = U_(j + 1) + F_(j + 1) * l_(j + 1) / 2 or U_(j + 1) = W_(j + 1) + F_(j + 1) * l_(j + 1) / 2 or F_(j + 1) * l_(j + 1) / 2 = W_(j + 1) + U_(j + 1)), l_(j + 1) <= Lm, X_(j + 1) <= Xm, X_(j + 1) + l_(j + 1) / 2 <= D) by (logic, logic, logic, logic, logic, logic, logic); lem:spline(core short)[j := j, C := C, r := r, D := D, l := l, X := X, e := e, F := F, G := G, U := U, V := V, W := W, T := T, M := M, Y := Y]]]]]]]]]; with[(sum j in 1..H, 52 / 3 * C * r * ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) = 52 / 3 * C * r * (sum j in 1..H, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) by sum; with[H + 1 <= H + 1 by V; with[(sum j in 1..H, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) + (G_(H + 1)^2 + D^2 * F_(H + 1)^2) <= 2 * (sum J in 1..H + 1, (G_(J)^2 + D^2 * F_(J)^2)) by lem:spline(core shift)[N := H + 1, n := H, D := D, F := F, G := G]; with[0 <= (G_(H + 1)^2 + D^2 * F_(H + 1)^2) by V; with[(sum j in 1..H, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) <= 2 * (sum J in 1..H + 1, (G_(J)^2 + D^2 * F_(J)^2)) by V[1 * hw27, 1 * hw28]; with[52 / 3 * C * r * (sum j in 1..H, ((G_(j)^2 + D^2 * F_(j)^2) + (G_(j + 1)^2 + D^2 * F_(j + 1)^2))) <= 52 / 3 * C * r * (2 * (sum J in 1..H + 1, (G_(J)^2 + D^2 * F_(J)^2))) by mono; V[1 * h_13, 1 * hw1, 1 * hw16, 1 * hw17, 1 * hw25, 1 * hw30]]]]]]]]]]

-- At a site of order \(p\) the knots cut each side of the hull into cells, and on each cell the difference of the model
-- and the truth is a polynomial of degree at most \(p\) whose leading coefficient is a sum of weights. When no nonempty
-- set of the true weights sums to zero, the Legendre polynomial, the monic one of least mean square \cite{Szego1975},
-- bounds each cell from below by a power \(e_j^{2p+1+\eta}\) of its gap, and the moments of the site bound it from
-- above (\cref{fact:cauchy}, \cref{fact:vandermonde}): the loss lies between multiples of the moments, the atom and
-- these powers, the comparisons that \cref{lem:compare} reads.
lemma lem:kinkloss [the loss at a site of order p]
  core least: p, eta in NN, c, a, x, e, Lp in QQ>0, S, Y in QQ>=0, Lp = 2^(2 * p + 1) * (2 * p + 1) * binom(2 * p, p)^2, a <= S, e <= x, c * x^eta * e^(2 * p + 1) * S^2 <= Lp * Y : c * a^2 * e^(2 * p + 1 + eta) <= Lp * Y
  fix core least kinkloss.least
  neqfix core least kinkloss.least.silent
  core two: m in NN, s, t in QQ>=0 : s^(m + 1) + t^(m + 1) <= (s + t)^(m + 1)
  fix core two kinkloss.two
  core power: N, m in NN, e_(1..N) in QQ>0 : (sum j in 1..N, e_(j)^(m + 1)) <= (sum j in 1..N, e_(j))^(m + 1)
  fix core power kinkloss.power
  core ends: w, n, m in NN, e_(1..w + n) in QQ>0 : (sum j in 1..w, e_(j)^(m + 1)) <= (sum j in 1..w, e_(j))^(m + 1), (sum j in 1..w, e_(j))^(m + 1) <= w^m * (sum j in 1..w, e_(j)^(m + 1)), (sum j in 1..n, e_(w + j)^(m + 1)) <= (sum j in 1..n, e_(w + j))^(m + 1), (sum j in 1..n, e_(w + j))^(m + 1) <= n^m * (sum j in 1..n, e_(w + j)^(m + 1))
  fix core ends kinkloss.ends
  fix core ends kinkloss.ends.2
  core radius: D in NN, Hm, Hp, r in QQ>=0, Hm <= r, Hp <= r, (r = Hm or r = Hp) : r^D <= Hm^D + Hp^D, Hm^D + Hp^D <= 2 * r^D
  fix core radius kinkloss.radius
  core side: N, p, eta in NN, c, C, a, Lp in QQ>0, A, Psi, H in QQ>=0, e_(1..N), x_(1..N) in QQ>0, S_(1..N), U_(1..N), Y_(1..N) in QQ>=0, Lp = 2^(2 * p + 1) * (2 * p + 1) * binom(2 * p, p)^2, H = (sum j in 1..N, e_(j)), (forall j in NN>=1 : j <= N => a <= S_(j)), (forall j in NN>=1 : j <= N => e_(j) <= x_(j), x_(j) <= H, c * x_(j)^eta * e_(j)^(2 * p + 1) * S_(j)^2 <= Lp * Y_(j), Y_(j) <= C * x_(j)^eta * e_(j) * U_(j)^2, U_(j) <= Psi + A * H^p) : c * a^2 * (sum j in 1..N, e_(j)^(2 * p + 1 + eta)) <= Lp * (sum j in 1..N, Y_(j)), (sum j in 1..N, Y_(j)) <= 4 * C * (H^(1 + eta) * Psi^2 + A^2 * H^(2 * p + 1 + eta))
  fix core side kinkloss.side
  neqfix core side kinkloss.side.silent
  core moments: p in NN, G_(0..p) in QQ>=0 : (sum i in 0..p, binom(p, i) * G_(i))^2 <= binom(2 * p, p) * (sum i in 0..p, G_(i)^2)
  fix core moments kinkloss.moments
  fix core moments kinkloss.moments.2
  core site: p, em, ep, Nm, Np in NN, c, C, cF, CF, a, Lp in QQ>0, A, Psi, X, Z, Ym, Yp, Gm, Gp, Hm, Hp, mu, v, K in QQ>=0, Lp = 2^(2 * p + 1) * (2 * p + 1) * binom(2 * p, p)^2, Hm <= 1, Hp <= 1, Psi^2 <= binom(2 * p, p) * X, cF * X <= Z, Z <= CF * X, c * a^2 * Gm <= Lp * Ym, Ym <= 4 * C * (Hm^(1 + em) * Psi^2 + A^2 * Hm^(2 * p + 1 + em)), c * a^2 * Gp <= Lp * Yp, Yp <= 4 * C * (Hp^(1 + ep) * Psi^2 + A^2 * Hp^(2 * p + 1 + ep)), Hm^(2 * p + 1 + em) <= Nm^(2 * p + em) * Gm, Hp^(2 * p + 1 + ep) <= Np^(2 * p + ep) * Gp, K = Z + Ym + Yp + mu * v^2 : Lp * (cF * X + mu * v^2) + c * a^2 * (Gm + Gp) <= Lp * K, K <= (CF + 8 * C * binom(2 * p, p)) * X + 4 * C * A^2 * (Nm^(2 * p + em) * Gm + Np^(2 * p + ep) * Gp) + mu * v^2, Lp * (cF * X + mu * v^2) + c * a^2 * (Hm^(2 * p + 1 + em) + Hp^(2 * p + 1 + ep)) <= (1 + Nm^(2 * p + em) + Np^(2 * p + ep)) * Lp * K, K <= (CF + 8 * C * binom(2 * p, p)) * X + 4 * C * A^2 * (Hm^(2 * p + 1 + em) + Hp^(2 * p + 1 + ep)) + mu * v^2
  fix core site kinkloss.site
  origin: ?{\text{proved here, from \cref{lem:chamber}, \cref{lem:spline}, \cref{fact:jensen}, \cref{fact:cauchy} and \cref{fact:vandermonde}; the reading of a cell by the least mean square of a polynomial with a given leading coefficient is classical \cite{Szego1975}}}

-- A cell is priced by its leading coefficient and bounded by its largest value; the sides add their cells, and the
-- site adds the far term, the two sides and the atom.
proof lem:kinkloss
  "core least" with[a^2 <= S^2 by mono; with[e^eta <= x^eta by mono; with[c * a^2 * e^(2 * p + 1 + eta) = c * a^2 * e^(2 * p + 1) * e^eta by eq; with[c * a^2 * e^(2 * p + 1) * e^eta <= c * S^2 * e^(2 * p + 1) * x^eta by mono; with[c * S^2 * e^(2 * p + 1) * x^eta = c * x^eta * e^(2 * p + 1) * S^2 by eq; V[1 * h_6, 1 * hw3, 1 * hw4]]]]]]
  "core two" with[s <= s + t by V[1 * h_2]; with[t <= s + t by V[1 * h_1]; with[s^m <= (s + t)^m by mono; with[t^m <= (s + t)^m by mono; with[s^m * s <= (s + t)^m * s by mono; with[t^m * t <= (s + t)^m * t by mono; with[(s + t)^(m + 1) = (s + t)^m * s + (s + t)^m * t by eq; with[s^(m + 1) = s^m * s by eq; with[t^(m + 1) = t^m * t by eq; V[1 * hw5, 1 * hw6, 1 * hw8, 1 * hw9 | 1 * hw7]]]]]]]]]]
  "core power" ind[N; with[(sum j in 1..0, e_(j)^(m + 1)) = 0 by sum[V]; with[(sum j in 1..0, e_(j)) = 0 by sum[V]; with[0 <= (sum j in 1..0, e_(j))^(m + 1) by V; V]]]; with[(sum j in 1..N + 1, e_(j)^(m + 1)) = (sum j in 1..N, e_(j)^(m + 1)) + e_(N + 1)^(m + 1) by sum; with[(sum j in 1..N + 1, e_(j)) = (sum j in 1..N, e_(j)) + e_(N + 1) by sum; with[0 <= (sum j in 1..N, e_(j)) by sum[V[0]]; with[0 < e_(N + 1) by logic; with[(sum j in 1..N, e_(j))^(m + 1) + e_(N + 1)^(m + 1) <= ((sum j in 1..N, e_(j)) + e_(N + 1))^(m + 1) by lem:kinkloss(core two)[m := m, s := (sum j in 1..N, e_(j)), t := e_(N + 1)]; with[(sum j in 1..N, e_(j)) + e_(N + 1) <= (sum j in 1..N + 1, e_(j)) by V[| 1 * hw5]; with[((sum j in 1..N, e_(j)) + e_(N + 1))^(m + 1) <= (sum j in 1..N + 1, e_(j))^(m + 1) by mono; V]]]]]]]]
  "core ends" (lem:kinkloss(core power)[N := w, m := m, e := e], fact:jensen(1)[N := w, m := m, e := e], lem:kinkloss(core power)[N := n, m := m, e_(j) := e_(w + j)], fact:jensen(1)[N := n, m := m, e_(j) := e_(w + j)])
  "core radius" (with[0 <= Hm^D by V; with[0 <= Hp^D by V; cases[r = Hm; with[r^D = Hm^D by eq; V[1 * hw2, 1 * hw3]]; with[r = Hp by logic; with[r^D = Hp^D by eq; V[1 * hw1, 1 * hw5]]]]]], with[Hm^D <= r^D by mono; with[Hp^D <= r^D by mono; V[1 * hw6, 1 * hw7]]])
  "core side" (chain[c * a^2 * (sum j in 1..N, e_(j)^(2 * p + 1 + eta)) = (sum j in 1..N, c * a^2 * e_(j)^(2 * p + 1 + eta)) by sum; <= (sum j in 1..N, Lp * Y_(j)) by sum[with[1 <= j by V; with[j <= N by V; with[a <= S_(j) by logic; with[(e_(j) <= x_(j), x_(j) <= H, c * x_(j)^eta * e_(j)^(2 * p + 1) * S_(j)^2 <= Lp * Y_(j), Y_(j) <= C * x_(j)^eta * e_(j) * U_(j)^2, U_(j) <= Psi + A * H^p) by (logic, logic, logic, logic, logic); with[0 < e_(j) by logic; with[0 < x_(j) by logic; with[0 <= S_(j) by logic; with[0 <= Y_(j) by logic; lem:kinkloss(core least)[p := p, eta := eta, c := c, a := a, x := x_(j), e := e_(j), Lp := Lp, S := S_(j), Y := Y_(j)]]]]]]]]]]; = Lp * (sum j in 1..N, Y_(j)) by sum], chain[(sum j in 1..N, Y_(j)) <= (sum j in 1..N, 4 * C * H^eta * (Psi^2 + A^2 * H^(2 * p)) * e_(j)) by sum[with[1 <= j by V; with[j <= N by V; with[(e_(j) <= x_(j), x_(j) <= H, c * x_(j)^eta * e_(j)^(2 * p + 1) * S_(j)^2 <= Lp * Y_(j), Y_(j) <= C * x_(j)^eta * e_(j) * U_(j)^2, U_(j) <= Psi + A * H^p) by (logic, logic, logic, logic, logic); with[0 < e_(j) by logic; with[0 < x_(j) by logic; with[0 <= U_(j) by logic; with[U_(j) <= 2 * max(Psi, A * H^p) by cases V; with[U_(j)^2 <= (2 * max(Psi, A * H^p))^2 by mono; with[(2 * max(Psi, A * H^p))^2 <= 4 * (Psi^2 + (A * H^p)^2) by lem:spline(core square)[a := Psi, b := A * H^p]; with[(A * H^p)^2 = A^2 * H^(2 * p) by eq; with[U_(j)^2 <= 4 * (Psi^2 + A^2 * H^(2 * p)) by V[1 * hw20, 1 * hw21, 4 * hw22]; with[x_(j)^eta <= H^eta by mono; with[C * x_(j)^eta * e_(j) * U_(j)^2 <= C * H^eta * e_(j) * (4 * (Psi^2 + A^2 * H^(2 * p))) by mono; V]]]]]]]]]]]]]]; = 4 * C * H^eta * (Psi^2 + A^2 * H^(2 * p)) * (sum j in 1..N, e_(j)) by sum; = 4 * C * (H^(1 + eta) * Psi^2 + A^2 * H^(2 * p + 1 + eta)) by eq])
  "core moments" with[0 <= (sum i in 0..p, G_(i)^2) by sum[V]; with[(sum i in 0..p, binom(p, i) * G_(i))^2 <= (sum i in 0..p, binom(p, i)^2) * (sum i in 0..p, G_(i)^2) by fact:cauchy(1)[n := p, f_(i) := binom(p, i), g := G]; with[(sum i in 0..p, binom(p, i)^2) = binom(2 * p, p) by fact:vandermonde(1)[p := p]; with[(sum i in 0..p, G_(i)^2) * (sum i in 0..p, binom(p, i)^2) = (sum i in 0..p, G_(i)^2) * binom(2 * p, p) by lem:binomial(core ncast)[u := (sum i in 0..p, binom(p, i)^2), w := binom(2 * p, p), c := (sum i in 0..p, G_(i)^2)]; V[1 * hw2, 1 * hw4]]]]]
  "core site" with[0 <= Lp * Z by V; with[0 <= Lp * Ym by V; with[0 <= Lp * Yp by V; with[0 <= mu * v^2 by V; with[0 <= Lp * (mu * v^2) by V; with[Lp * K = Lp * Z + Lp * Ym + Lp * Yp + Lp * (mu * v^2) by eq; with[Lp * (cF * X) <= Lp * Z by mono; with[Ym <= K by V[1 * h_4, 1 * h_6, 1 * hw4 | 1 * h_26]; with[Yp <= K by V[1 * h_4, 1 * h_5, 1 * hw4 | 1 * h_26]; with[Hm^(1 + em) <= 1^(1 + em) by mono; with[Hp^(1 + ep) <= 1^(1 + ep) by mono; with[1^(1 + em) = 1 by eq; with[1^(1 + ep) = 1 by eq; with[Hm^(1 + em) <= 1 by V; with[Hp^(1 + ep) <= 1 by V; with[Hm^(1 + em) * Psi^2 <= 1 * Psi^2 by mono; with[Hp^(1 + ep) * Psi^2 <= 1 * Psi^2 by mono; with[Hm^(1 + em) * Psi^2 <= binom(2 * p, p) * X by V[1 * h_17, 1 * hw16]; with[Hp^(1 + ep) * Psi^2 <= binom(2 * p, p) * X by V[1 * h_17, 1 * hw17]; with[4 * C * (Hm^(1 + em) * Psi^2) <= 4 * C * (binom(2 * p, p) * X) by mono; with[4 * C * (Hp^(1 + ep) * Psi^2) <= 4 * C * (binom(2 * p, p) * X) by mono; with[4 * C * (A^2 * Hm^(2 * p + 1 + em)) <= 4 * C * (A^2 * (Nm^(2 * p + em) * Gm)) by mono; with[4 * C * (A^2 * Hp^(2 * p + 1 + ep)) <= 4 * C * (A^2 * (Np^(2 * p + ep) * Gp)) by mono; with[c * a^2 * Hm^(2 * p + 1 + em) <= c * a^2 * (Nm^(2 * p + em) * Gm) by mono; with[c * a^2 * Hp^(2 * p + 1 + ep) <= c * a^2 * (Np^(2 * p + ep) * Gp) by mono; with[Nm^(2 * p + em) * (c * a^2 * Gm) <= Nm^(2 * p + em) * (Lp * Ym) by mono; with[Np^(2 * p + ep) * (c * a^2 * Gp) <= Np^(2 * p + ep) * (Lp * Yp) by mono; with[Nm^(2 * p + em) * (Lp * Ym) <= Nm^(2 * p + em) * (Lp * K) by mono; with[Np^(2 * p + ep) * (Lp * Yp) <= Np^(2 * p + ep) * (Lp * K) by mono; (V[1 * h_20, 1 * h_22, 1 * hw7 | 1 * hw6], V[1 * h_19, 1 * h_21, 1 * h_23, 1 * h_26, 1 * hw20, 1 * hw21, 1 * hw22, 1 * hw23], V[1 * hw2, 1 * hw3, 1 * hw7, 1 * hw24, 1 * hw25, 1 * hw26, 1 * hw27, 1 * hw28, 1 * hw29 | 1 * hw6], V[1 * h_19, 1 * h_21, 1 * h_23, 1 * h_26, 1 * hw20, 1 * hw21])]]]]]]]]]]]]]]]]]]]]]]]]]]]]]

-- At any weight vector the knots, the sites and the ends of the support cut the line into cells, and on each near cell
-- the difference splits into its own part, from the units between it and its coarser cell, and the part inherited from
-- that coarser cell (split). When the far polynomials have a positive definite Gram matrix the inherited parts are
-- absorbed (absorb, top), each cell of a chamber is read at \(p+1\) nodes by Lagrange interpolation and the Legendre
-- bound \cite{Szego1975} (cells), and the loss lies between multiples of the error of the coefficients and the sum of
-- the site losses (localize).
lemma lem:masses [the loss against the terms of its masses]
  core split: R, P, S in QQ>=0, (R = P + S or P = R + S or S = R + P) : R^2 <= 2 * S^2 + 2 * P^2, S^2 <= 2 * R^2 + 2 * P^2
  fix core split masses.split
  fix core split masses.split.2
  core absorb: n in NN, d in QQ>0, A, B, Z, K in QQ>=0, T_(1..n), O_(1..n), I_(1..n) in QQ>=0, K = Z + (sum j in 1..n, T_(j)), (forall j in NN>=1 : j <= n => O_(j) <= 2 * T_(j) + 2 * I_(j), T_(j) <= 2 * O_(j) + 2 * I_(j)), d * (sum j in 1..n, I_(j)) <= A * K, d * (sum j in 1..n, I_(j)) <= B * (Z + (sum j in 1..n, O_(j))) : d * (Z + (sum j in 1..n, O_(j))) <= (2 * d + 2 * A) * K, d * K <= (2 * d + 2 * B) * (Z + (sum j in 1..n, O_(j)))
  fix core absorb masses.absorb
  core top: n in NN, cF, CF in QQ>0, beta, M, X, Z, K in QQ>=0, m_(1..n), Psi_(1..n), U_(1..n), T_(1..n), O_(1..n), I_(1..n) in QQ>=0, cF * X <= Z, Z <= CF * X, K = Z + (sum j in 1..n, T_(j)), M = (sum j in 1..n, m_(j)), (forall j in NN>=1 : j <= n => O_(j) <= 2 * T_(j) + 2 * I_(j), T_(j) <= 2 * O_(j) + 2 * I_(j)), (forall j in NN>=1 : j <= n => I_(j) <= m_(j) * Psi_(j)^2, Psi_(j)^2 <= beta * X, O_(j) <= m_(j) * U_(j)^2) : cF^2 * (X + (sum j in 1..n, O_(j))) <= 2 * (1 + cF) * (cF + beta * M) * K, cF * K <= 2 * (CF + 1) * (cF + beta * M) * (X + (sum j in 1..n, O_(j))), (sum j in 1..n, O_(j)) <= (sum j in 1..n, m_(j) * U_(j)^2)
  fix core top masses.top
  core cells: n, H in NN, cl, Cu in QQ>=0, eta_(1..n) in NN, R_(1..n), e_(1..n), V_(1..n), W_(1..n), Y_(1..n) in QQ>=0, (forall j in NN>=1 : j <= n => eta_(j) <= H, cl * R_(j)^(eta_(j)) * e_(j) * V_(j) <= 2^(eta_(j)) * Y_(j), Y_(j) <= Cu * R_(j)^(eta_(j)) * e_(j) * W_(j)) : cl * (sum j in 1..n, R_(j)^(eta_(j)) * e_(j) * V_(j)) <= 2^H * (sum j in 1..n, Y_(j)), (sum j in 1..n, Y_(j)) <= Cu * (sum j in 1..n, R_(j)^(eta_(j)) * e_(j) * W_(j))
  fix core cells masses.cells
  fix core cells masses.cells.2
  core localize: s in NN, cL, CL, cS, CS in QQ>0, Bb, K in QQ>=0, X_(1..s), Y_(1..s), L_(1..s) in QQ>=0, cL * (Bb + (sum v in 1..s, (X_(v) + Y_(v)))) <= K, K <= CL * (Bb + (sum v in 1..s, (X_(v) + Y_(v)))), (forall v in NN>=1 : v <= s => cS * (X_(v) + Y_(v)) <= L_(v), L_(v) <= CS * (X_(v) + Y_(v))) : cL * (Bb + (sum v in 1..s, L_(v))) <= (1 + CS) * K, cS * K <= CL * (1 + cS) * (Bb + (sum v in 1..s, L_(v)))
  fix core localize masses.localize
  origin: ?{\text{proved here; the readings of a cell are Lagrange interpolation and the least mean square of a polynomial with a given leading coefficient \cite{Szego1975}}}

-- A tie bounds each modulus by the sum of the other two; the parts sum over the cells; the inherited parts are
-- absorbed; at the top level they are read through the far term, and the cells and the sites add.
proof lem:masses
  "core split" with[(R <= P + S, P <= R + S, S <= R + P) by lem:chamber(core tie)[a := R, b := P, c := S]; (with[R^2 <= (S + P)^2 by mono; with[(S + P)^2 <= 2 * S^2 + 2 * P^2 by cases[S <= P; V[hc1 * hc1]; V[hn1 * hn1]]; V[1 * hw2, 1 * hw3]]], with[S^2 <= (R + P)^2 by mono; with[(R + P)^2 <= 2 * R^2 + 2 * P^2 by cases[R <= P; V[hc2 * hc2]; V[hn2 * hn2]]; V[1 * hw4, 1 * hw5]]])]
  "core absorb" with[0 <= (sum j in 1..n, T_(j)) by sum[V]; with[0 <= (sum j in 1..n, I_(j)) by sum[V]; with[(sum j in 1..n, (2 * T_(j))) = 2 * (sum j in 1..n, T_(j)) by sum; with[(sum j in 1..n, (2 * I_(j))) = 2 * (sum j in 1..n, I_(j)) by sum; with[(sum j in 1..n, (2 * O_(j))) = 2 * (sum j in 1..n, O_(j)) by sum; with[(sum j in 1..n, O_(j)) <= (sum j in 1..n, (2 * T_(j) + 2 * I_(j))) by sum[with[1 <= j by V; with[j <= n by V; with[(O_(j) <= 2 * T_(j) + 2 * I_(j), T_(j) <= 2 * O_(j) + 2 * I_(j)) by (logic, logic); V]]]]; with[(sum j in 1..n, (2 * T_(j) + 2 * I_(j))) = (sum j in 1..n, (2 * T_(j))) + (sum j in 1..n, (2 * I_(j))) by sum[V]; with[(sum j in 1..n, T_(j)) <= (sum j in 1..n, (2 * O_(j) + 2 * I_(j))) by sum[with[1 <= j by V; with[j <= n by V; with[(O_(j) <= 2 * T_(j) + 2 * I_(j), T_(j) <= 2 * O_(j) + 2 * I_(j)) by (logic, logic); V]]]]; with[(sum j in 1..n, (2 * O_(j) + 2 * I_(j))) = (sum j in 1..n, (2 * O_(j))) + (sum j in 1..n, (2 * I_(j))) by sum[V]; with[(sum j in 1..n, O_(j)) <= 2 * (sum j in 1..n, T_(j)) + 2 * (sum j in 1..n, I_(j)) by V[1 * hw3, 1 * hw4, 1 * hw6, 1 * hw10]; with[(sum j in 1..n, T_(j)) <= 2 * (sum j in 1..n, O_(j)) + 2 * (sum j in 1..n, I_(j)) by V[1 * hw4, 1 * hw5, 1 * hw11, 1 * hw15]; with[d * (sum j in 1..n, O_(j)) <= d * (2 * (sum j in 1..n, T_(j)) + 2 * (sum j in 1..n, I_(j))) by mono; with[d * (sum j in 1..n, T_(j)) <= d * (2 * (sum j in 1..n, O_(j)) + 2 * (sum j in 1..n, I_(j))) by mono; with[d * K = d * Z + d * (sum j in 1..n, T_(j)) by eq; with[0 <= d * Z by V; (V[2 * h_10, 1 * hw18, 1 * hw21 | 2 * hw20], V[2 * h_11, 1 * hw19, 1 * hw20, 1 * hw21])]]]]]]]]]]]]]]]
  "core top" with[0 <= (sum j in 1..n, T_(j)) by sum[V]; with[0 <= (sum j in 1..n, O_(j)) by sum[V]; with[(sum j in 1..n, I_(j)) <= (sum j in 1..n, m_(j) * (beta * X)) by sum[with[1 <= j by V; with[j <= n by V; with[(I_(j) <= m_(j) * Psi_(j)^2, Psi_(j)^2 <= beta * X, O_(j) <= m_(j) * U_(j)^2) by (logic, logic, logic); with[0 <= m_(j) by logic; with[m_(j) * Psi_(j)^2 <= m_(j) * (beta * X) by mono; V]]]]]]; with[(sum j in 1..n, m_(j) * (beta * X)) = beta * X * (sum j in 1..n, m_(j)) by sum; with[beta * X * (sum j in 1..n, m_(j)) = beta * X * M by eq; with[cF * (sum j in 1..n, I_(j)) <= cF * (beta * X * M) by mono; with[beta * M * (cF * X) <= beta * M * Z by mono; with[Z <= K by V[1 * hw1 | 1 * h_14]; with[beta * M * Z <= beta * M * K by mono; with[beta * M * Z <= beta * M * (Z + (sum j in 1..n, O_(j))) by mono; with[cF * (sum j in 1..n, I_(j)) <= beta * M * K by V[1 * hw11, 1 * hw12, 1 * hw14]; with[cF * (sum j in 1..n, I_(j)) <= beta * M * (Z + (sum j in 1..n, O_(j))) by V[1 * hw11, 1 * hw12, 1 * hw15]; with[(cF * (Z + (sum j in 1..n, O_(j))) <= (2 * cF + 2 * (beta * M)) * K, cF * K <= (2 * cF + 2 * (beta * M)) * (Z + (sum j in 1..n, O_(j)))) by lem:masses(core absorb)[n := n, d := cF, A := beta * M, B := beta * M, Z := Z, K := K, T := T, O := O, I := I]; (with[cF * (cF * X) <= cF * Z by mono; with[0 <= cF * (sum j in 1..n, O_(j)) by V; with[0 <= cF^2 * Z by V; with[(1 + cF) * (cF * (Z + (sum j in 1..n, O_(j)))) <= (1 + cF) * ((2 * cF + 2 * (beta * M)) * K) by mono; V[1 * hw19, 1 * hw20, 1 * hw21, 1 * hw22]]]]], with[(2 * cF + 2 * (beta * M)) * (Z + (sum j in 1..n, O_(j))) <= (2 * cF + 2 * (beta * M)) * (CF * X + (sum j in 1..n, O_(j))) by mono; with[CF * X + (sum j in 1..n, O_(j)) <= (CF + 1) * (X + (sum j in 1..n, O_(j))) by V; with[(2 * cF + 2 * (beta * M)) * (CF * X + (sum j in 1..n, O_(j))) <= (2 * cF + 2 * (beta * M)) * ((CF + 1) * (X + (sum j in 1..n, O_(j)))) by mono; V]]], sum[with[1 <= j by V; with[j <= n by V; with[(I_(j) <= m_(j) * Psi_(j)^2, Psi_(j)^2 <= beta * X, O_(j) <= m_(j) * U_(j)^2) by (logic, logic, logic); V]]]])]]]]]]]]]]]]]
  "core cells" (chain[cl * (sum j in 1..n, R_(j)^(eta_(j)) * e_(j) * V_(j)) = (sum j in 1..n, cl * (R_(j)^(eta_(j)) * e_(j) * V_(j))) by sum; <= (sum j in 1..n, 2^H * Y_(j)) by sum[with[1 <= j by V; with[j <= n by V; with[(eta_(j) <= H, cl * R_(j)^(eta_(j)) * e_(j) * V_(j) <= 2^(eta_(j)) * Y_(j), Y_(j) <= Cu * R_(j)^(eta_(j)) * e_(j) * W_(j)) by (logic, logic, logic); with[0 <= Y_(j) by logic; with[2^(eta_(j)) <= 2^H by mono; with[2^(eta_(j)) * Y_(j) <= 2^H * Y_(j) by mono; V]]]]]]]; = 2^H * (sum j in 1..n, Y_(j)) by sum], chain[(sum j in 1..n, Y_(j)) <= (sum j in 1..n, Cu * (R_(j)^(eta_(j)) * e_(j) * W_(j))) by sum[with[1 <= j by V; with[j <= n by V; with[(eta_(j) <= H, cl * R_(j)^(eta_(j)) * e_(j) * V_(j) <= 2^(eta_(j)) * Y_(j), Y_(j) <= Cu * R_(j)^(eta_(j)) * e_(j) * W_(j)) by (logic, logic, logic); V]]]]; = Cu * (sum j in 1..n, R_(j)^(eta_(j)) * e_(j) * W_(j)) by sum])
  "core localize" with[(sum v in 1..s, L_(v)) <= CS * (sum v in 1..s, (X_(v) + Y_(v))) by chain[(sum v in 1..s, L_(v)) <= (sum v in 1..s, CS * (X_(v) + Y_(v))) by sum[with[1 <= v by V; with[v <= s by V; with[(cS * (X_(v) + Y_(v)) <= L_(v), L_(v) <= CS * (X_(v) + Y_(v))) by (logic, logic); V]]]]; = CS * (sum v in 1..s, (X_(v) + Y_(v))) by sum]; with[cS * (sum v in 1..s, (X_(v) + Y_(v))) <= (sum v in 1..s, L_(v)) by chain[cS * (sum v in 1..s, (X_(v) + Y_(v))) = (sum v in 1..s, cS * (X_(v) + Y_(v))) by sum; <= (sum v in 1..s, L_(v)) by sum[with[1 <= v by V; with[v <= s by V; with[(cS * (X_(v) + Y_(v)) <= L_(v), L_(v) <= CS * (X_(v) + Y_(v))) by (logic, logic); V]]]]]; with[0 <= (sum v in 1..s, (X_(v) + Y_(v))) by sum[V]; with[0 <= (sum v in 1..s, L_(v)) by sum[V]; (with[cL * (sum v in 1..s, L_(v)) <= cL * (CS * (sum v in 1..s, (X_(v) + Y_(v)))) by mono; with[(1 + CS) * (cL * (Bb + (sum v in 1..s, (X_(v) + Y_(v))))) <= (1 + CS) * K by mono; with[0 <= cL * Bb by V; with[0 <= CS * (cL * Bb) by V; with[0 <= cL * (sum v in 1..s, (X_(v) + Y_(v))) by V; V[1 * hw15, 1 * hw16, 1 * hw18, 1 * hw19]]]]]], with[cS * K <= cS * (CL * (Bb + (sum v in 1..s, (X_(v) + Y_(v))))) by mono; with[CL * (cS * (sum v in 1..s, (X_(v) + Y_(v)))) <= CL * (sum v in 1..s, L_(v)) by mono; with[0 <= CL * Bb by V; with[0 <= CL * (cS * (sum v in 1..s, L_(v))) by V; V[1 * hw20, 1 * hw21, 1 * hw22, 1 * hw23]]]]])]]]]

-- The Cauchy--Schwarz inequality for sums, from a bound on each term: \((\sum_ir_i)^2\le\sum_if_i\sum_ig_i\) when
-- \(r_i^2\le f_ig_i\) for every \(i\); at \(r_i=L_iV_i\), \(f_i=L_i\), \(g_i=L_iV_i^2\) it is the inequality with the
-- weights \(L_i\).
cit fact:cauchybound [the Cauchy--Schwarz inequality for sums, from a bound on each term]
  mathlib: Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul (Mathlib.Algebra.Order.BigOperators.Ring.Finset)
  (1): n in NN, r_(0..n), f_(0..n), g_(0..n) in QQ>=0, (forall i in NN : i <= n => r_(i)^2 <= f_(i) * g_(i)) : (sum i in 0..n, r_(i))^2 <= (sum i in 0..n, f_(i)) * (sum i in 0..n, g_(i))
  fix (1) cauchybound.sums

-- The functional of de Boor and Fix. Let \(N_j\) be the B-splines of degree \(p\) on knots \(t_0\le t_1\le\dots\), with
-- \(N_j\) carried by \([t_j,t_{j+p+1}]\), and \(\psi_i(u)=\prod_{l=1}^p(u-t_{i+l})\). For \(\mu\) in a nonempty cell
-- \([t_c,t_{c+1})\) with \(i\le c\le i+p\), and a spline \(f\) of degree \(p\) on these knots, let
-- \(\Lambda_i(f)=\frac1{p!}\sum_{k=0}^p(-1)^k\psi_i^{(p-k)}(\mu)f^{(k)}(\mu)\), the derivatives being those of the piece
-- of \(f\) on that cell. Then \(f=\sum_j\Lambda_j(f)N_j\), and \(\Lambda_i(\sum_jb_jN_j)=b_i\) whatever the cell.
cit fact:dualfunctional [the functional of de Boor and Fix]
  doi: 10.1016/j.cma.2016.07.040
  stmt: Section 2.4, (20)--(23), of arXiv:1603.09660v2
  origin: ?{\text{cited: \cite[Section~2.4, (20)--(23)]{MarussigZechnerBeerFries2017}, numbered as in its arXiv version 1603.09660v2; the functional is that of de Boor and Fix (1973)}}

-- The stability of the B-spline basis under a law: the loss \(K\) of a spline of degree \(p\) and the squares \(B_i^2\)
-- of its coefficients weighted by the masses \(w_i\) of their windows compare, \(K\le\sum_iw_iB_i^2\le C\,K\), with
-- \(C\) free of the knots and of the coefficients; at the uniform law the bound from below is de Boor's theorem, in the
-- local form of \cite{PassenbrunnerShadrin2014}. The bound from above is the Gram matrix of a partition of unity
-- (above); the bound from below reads each coefficient as the blossom of one piece through the functional of
-- \cref{fact:dualfunctional}, with \(C\) from \(p\) and the doubling of the law (window, collect), and conversely the
-- comparison forces the law to be doubling (force, grow).
lemma lem:windows [the stability of the B-spline basis under a law]
  core above: N in NN, W in Forms(N, N), B, w in Point(N), K in QQ>=0, (forall i : forall j : W_(i)_(j) = W_(j)_(i)), (forall i : (sum j, W_(i)_(j)) <= w_(i)), K <= (sum i, B_(i) * (sum j, W_(i)_(j) * B_(j))) : K <= sum i, w_(i) * B_(i)^2
  fix core above windows.above
  neqfix core above windows.above.rows
  core mean: n in NN, L_(0..n), V_(0..n) in QQ>=0 : (sum s in 0..n, L_(s) * V_(s))^2 <= (sum s in 0..n, L_(s)) * (sum s in 0..n, L_(s) * V_(s)^2)
  fix core mean windows.mean
  core window: p in NN, d, gam in QQ>0, w, B, T in QQ>=0, m_(0..p) in QQ>0, L_(0..p), Q_(0..p) in QQ>=0, (forall s in NN : s <= p => w <= d * m_(s)), (sum s in 0..p, L_(s)) <= gam, B^2 <= gam * (sum s in 0..p, L_(s) * Q_(s) / m_(s)), (sum s in 0..p, Q_(s)) <= T : w * B^2 <= d * gam^2 * T
  fix core window windows.window
  neqfix core window windows.window.site
  core collect: N, p in NN, kap in QQ>0, K in QQ>=0, w_(1..N), B_(1..N) in QQ>=0, T_(1..p + N) in QQ>=0, (forall i in NN>=1 : i <= N => w_(i) * B_(i)^2 <= kap * (sum s in 0..p, T_(s + i))), (sum c in 1..p + N, T_(c)) <= K : (sum i in 1..N, w_(i) * B_(i)^2) <= (p + 1) * kap * K
  fix core collect windows.collect
  core power: eta in NN, a, b in QQ>=0, l, Th in QQ>0, 1 <= Th, b <= a : (sum k in 0..eta, binom(eta, k) * b^(max(eta - k, 0)) * (Th * l)^(k + 1) / (k + 1)) <= Th^(eta + 1) * (sum k in 0..eta, binom(eta, k) * a^(max(eta - k, 0)) * l^(k + 1) / (k + 1))
  fix core power windows.power
  neqfix core power windows.power.short
  neqfix core power windows.power.right
  core force: p in NN, c, I, J, Y in QQ>=0, 1 <= p, I + J <= (1 + c) * Y, Y <= (1 / (2 * (1 + c)))^(2 * p) * I + J : I <= 2 * c * J
  fix core force windows.force
  neqfix core force windows.force.steps
  core grow: n in NN, c in QQ>=0, M_(1..n + 1) in QQ>=0 : (forall j in NN>=1 : j <= n => M_(j + 1) <= (1 + 2 * c) * M_(j)) => M_(n + 1) <= (1 + 2 * c)^n * M_(1)
  fix core grow windows.grow
  origin: ?{\text{proved here; at the uniform law the bound from below is the theorem of de Boor in the local form stated in \cite{PassenbrunnerShadrin2014}}}

-- Above, \(2B_iB_j\le B_i^2+B_j^2\) at each entry of the symmetric Gram matrix; below, the window against the odd
-- parts of one cell, then each cell counted with its windows; the converse from one B-spline, then by induction.
proof lem:windows
  "core above" with[(sum i, (sum j, W_(i)_(j) * (2 * (B_(i) * B_(j))))) <= (sum i, (sum j, W_(i)_(j) * (B_(i)^2 + B_(j)^2))) by sum[sum[with[2 * (B_(i) * B_(j)) <= B_(i)^2 + B_(j)^2 by cases[B_(i) <= B_(j); V[hc1 * hc1]; V[hn1 * hn1]]; mono]]]; with[2 * (sum i, B_(i) * (sum j, W_(i)_(j) * B_(j))) = (sum i, 2 * B_(i) * (sum j, W_(i)_(j) * B_(j))) by sum[with[0 <= (sum j, W_(i)_(j) * B_(j)) by sum[V]; V[0]]]; with[(sum i, 2 * B_(i) * (sum j, W_(i)_(j) * B_(j))) = (sum i, (sum j, W_(i)_(j) * (2 * (B_(i) * B_(j))))) by sum[sum[V[0]]]; with[(sum i, (sum j, W_(i)_(j) * (B_(i)^2 + B_(j)^2))) = (sum i, (sum j, W_(i)_(j) * B_(i)^2)) + (sum i, (sum j, W_(i)_(j) * B_(j)^2)) by sum[sum[V[0]]]; with[(sum i, (sum j, W_(i)_(j) * B_(j)^2)) = (sum j, (sum i, W_(j)_(i) * B_(j)^2)) by sum[sum[V]]; with[(sum i, (sum j, W_(i)_(j) * B_(i)^2)) <= (sum i, w_(i) * B_(i)^2) by sum[with[(sum j, W_(i)_(j) * B_(i)^2) = (sum j, W_(i)_(j)) * B_(i)^2 by sum; with[(sum j, W_(i)_(j)) * B_(i)^2 <= w_(i) * B_(i)^2 by mono; V[1 * hw9, 1 * hw10]]]]; V[h_4, 1/2 * hw1, 1/2 * hw3, 1/2 * hw5, 1/2 * hw6, 1/2 * hw7, hw8]]]]]]]
  "core mean" with[forall i in NN : i <= n => (L_(i) * V_(i))^2 <= L_(i) * (L_(i) * V_(i)^2) by V[0]; fact:cauchybound(1)[n := n, r_(i) := L_(i) * V_(i), f := L, g_(i) := L_(i) * V_(i)^2]]
  "core window" with[(sum s in 0..p, w * (L_(s) * Q_(s) / m_(s))) <= (sum s in 0..p, d * gam * Q_(s)) by sum[with[s <= p by V; with[w <= d * m_(s) by logic; with[L_(s) <= (sum t in 0..p, L_(t)) by term[s]; with[L_(s) <= gam by V[h_7, hw4]; with[0 < m_(s) by logic; with[w * (L_(s) * Q_(s) / m_(s)) <= d * m_(s) * (L_(s) * Q_(s) / m_(s)) by mono; with[d * m_(s) * (L_(s) * Q_(s) / m_(s)) = d * L_(s) * Q_(s) by eq; with[d * L_(s) * Q_(s) <= d * gam * Q_(s) by mono; V]]]]]]]]]; with[(sum s in 0..p, w * (L_(s) * Q_(s) / m_(s))) = w * (sum s in 0..p, L_(s) * Q_(s) / m_(s)) by sum; with[(sum s in 0..p, d * gam * Q_(s)) = d * gam * (sum s in 0..p, Q_(s)) by sum; with[d * gam * (sum s in 0..p, Q_(s)) <= d * gam * T by mono; with[w * (sum s in 0..p, L_(s) * Q_(s) / m_(s)) <= d * gam * T by V[1 * hw1, 1 * hw11, 1 * hw12 | 1 * hw10]; with[gam * (w * (sum s in 0..p, L_(s) * Q_(s) / m_(s))) <= gam * (d * gam * T) by mono; with[w * B^2 <= w * (gam * (sum s in 0..p, L_(s) * Q_(s) / m_(s))) by mono; V[1 * hw14, 1 * hw15]]]]]]]]
  "core collect" with[(sum i in 1..N, w_(i) * B_(i)^2) <= (sum i in 1..N, kap * (sum s in 0..p, T_(s + i))) by sum[with[1 <= i by V; with[i <= N by V; logic]]]; with[(sum i in 1..N, kap * (sum s in 0..p, T_(s + i))) = kap * (sum i in 1..N, (sum s in 0..p, T_(s + i))) by sum; with[(sum i in 1..N, (sum s in 0..p, T_(s + i))) = (sum s in 0..p, (sum i in 1..N, T_(s + i))) by sum[V]; with[(sum s in 0..p, (sum i in 1..N, T_(s + i))) <= (sum s in 0..p, (sum c in 1..p + N, T_(c))) by sum[with[s <= p by V; with[s + N <= p + N by V[1 * hw7]; with[(sum i in 1..N, T_(s + i)) = (sum c in s + 1..s + N, T_(c)) by sum; with[(sum c in s + 1..s + N, T_(c)) <= (sum c in 1..p + N, T_(c)) by sum[V]; V[1 * hw9, 1 * hw10]]]]]]; with[0 <= (sum c in 1..p + N, T_(c)) by sum[V]; with[(sum s in 0..p, (sum c in 1..p + N, T_(c))) = (p + 1) * (sum c in 1..p + N, T_(c)) by sum; with[(p + 1) * (sum c in 1..p + N, T_(c)) <= (p + 1) * K by mono; with[(sum i in 1..N, (sum s in 0..p, T_(s + i))) <= (p + 1) * K by V[1 * hw5, 1 * hw6, 1 * hw12, 1 * hw13]; with[kap * (sum i in 1..N, (sum s in 0..p, T_(s + i))) <= kap * ((p + 1) * K) by mono; V[1 * hw1, 1 * hw4, 1 * hw15]]]]]]]]]]
  "core power" with[Th^(eta + 1) * (sum k in 0..eta, binom(eta, k) * a^(max(eta - k, 0)) * l^(k + 1) / (k + 1)) = (sum k in 0..eta, Th^(eta + 1) * (binom(eta, k) * a^(max(eta - k, 0)) * l^(k + 1) / (k + 1))) by sum; with[(sum k in 0..eta, binom(eta, k) * b^(max(eta - k, 0)) * (Th * l)^(k + 1) / (k + 1)) <= (sum k in 0..eta, Th^(eta + 1) * (binom(eta, k) * a^(max(eta - k, 0)) * l^(k + 1) / (k + 1))) by sum[with[k <= eta by V; with[b^(max(eta - k, 0)) <= a^(max(eta - k, 0)) by mono; with[Th^(k + 1) <= Th^(eta + 1) by mono; with[binom(eta, k) * b^(max(eta - k, 0)) * (Th * l)^(k + 1) / (k + 1) = binom(eta, k) * b^(max(eta - k, 0)) * (Th^(k + 1) * l^(k + 1)) / (k + 1) by eq; with[Th^(eta + 1) * (binom(eta, k) * a^(max(eta - k, 0)) * l^(k + 1) / (k + 1)) = binom(eta, k) * a^(max(eta - k, 0)) * (Th^(eta + 1) * l^(k + 1)) / (k + 1) by eq; with[binom(eta, k) * b^(max(eta - k, 0)) * (Th^(k + 1) * l^(k + 1)) / (k + 1) <= binom(eta, k) * a^(max(eta - k, 0)) * (Th^(eta + 1) * l^(k + 1)) / (k + 1) by mono; V]]]]]]]; V[1 * hw2 | 1 * hw1]]]
  "core force" with[0 < 1 / (2 * (1 + c)) by V; with[1 / (2 * (1 + c)) <= 1 by V; with[2 <= 2 * p by V[2 * h_5]; with[(1 / (2 * (1 + c)))^(2 * p) <= (1 / (2 * (1 + c)))^2 by mono; with[(1 + c) * (1 / (2 * (1 + c)))^2 = 1 / (4 * (1 + c)) by eq; with[1 / (4 * (1 + c)) <= 1 / 4 by V; with[(1 + c) * (1 / (2 * (1 + c)))^2 <= 1 / 4 by V; with[(1 + c) * (1 / (2 * (1 + c)))^(2 * p) * I <= (1 + c) * (1 / (2 * (1 + c)))^2 * I by mono; with[(1 + c) * (1 / (2 * (1 + c)))^2 * I <= 1 / 4 * I by mono; with[(1 + c) * Y <= (1 + c) * ((1 / (2 * (1 + c)))^(2 * p) * I + J) by mono; with[(1 + c) * ((1 / (2 * (1 + c)))^(2 * p) * I + J) = (1 + c) * (1 / (2 * (1 + c)))^(2 * p) * I + (1 + c) * J by eq; with[0 <= c * J by V; V]]]]]]]]]]]]
  "core grow" ind[n; V; with[forall j in NN : 1 <= j => j <= n => M_(j + 1) <= (1 + 2 * c) * M_(j) by with[j <= n + 1 by V[1 * hi4]; logic]; with[M_(n + 1) <= (1 + 2 * c)^n * M_(1) by logic; with[1 <= n + 1 by V; with[n + 1 <= n + 1 by V[0]; with[M_(n + 1 + 1) <= (1 + 2 * c) * M_(n + 1) by logic; with[0 <= 1 + 2 * c by V[2 * h_1]; with[(1 + 2 * c) * M_(n + 1) <= (1 + 2 * c) * ((1 + 2 * c)^n * M_(1)) by mono; with[(1 + 2 * c)^(n + 1) * M_(1) = (1 + 2 * c) * ((1 + 2 * c)^n * M_(1)) by eq; V[1 * hw6, 1 * hw8 | 1 * hw9]]]]]]]]]]
