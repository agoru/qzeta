-- Q++ 0.2
module glue
uses mean

subsection sec:glue Stars glued along their meetings

-- Each cell of a set is the centre of a star: its spokes are the cells it meets, by the symmetric table \(P\), and its outer spokes, of levels \(A_i\), actions \(B_i\) and number \(K_i\). The level string \(N\) and the action string \(\nu\) solve the two ties of a star at every cell, \(\sum_jP_{ij}N_j+A_i=b_iN_i\) and \(\sum_jP_{ij}\nu_j+B_i+2=b_i\nu_i+\sum_jP_{ij}+K_i\). At the price of each cell they tie as at a node (\cref{lem:node}) (star); added over the cells, the meetings cancel by the symmetry of the table, and the set ties as one star (set). The outer part of a cell, \(N_i(B_i+2)\) against \(\nu_iA_i+N_i(\sum_jP_{ij}+K_i)\), ties at every cell once it is on one side at every cell (flat), (flatdown), and it ties at every cell exactly when the set has one price on every meeting (price), (tied), by the mean tie (\cref{lem:mean}). With no outer spoke, the set has one price exactly when every cell meets two (closedprice), (closedtie).
lemma lem:glue [stars glued along their meetings]
  (star): n in NN>=1, P in Forms(n, n), b, N in Weight(n), nu, A, B, K in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) + 2 = b_(i) * nu_(i) + (sum j, P_(i)_(j)) + K_(i)) : forall i : N_(i) * (sum j, P_(i)_(j) * nu_(j)) + N_(i) * B_(i) + N_(i) + N_(i) = nu_(i) * (sum j, P_(i)_(j) * N_(j)) + nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i))
  fix (star) glue.star
  neqfix (star) glue.star.noaction
  (set): n in NN>=1, P in Forms(n, n), b, N in Weight(n), nu, A, B, K in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) + 2 = b_(i) * nu_(i) + (sum j, P_(i)_(j)) + K_(i)) : (sum i, (N_(i) * B_(i) + N_(i) + N_(i))) = sum i, (nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i)))
  fix (set) glue.set
  neqfix (set) glue.set.nosym
  (flat): n in NN>=1, P in Forms(n, n), b, N in Weight(n), nu, A, B, K in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) + 2 = b_(i) * nu_(i) + (sum j, P_(i)_(j)) + K_(i)), (forall i : N_(i) * B_(i) + N_(i) + N_(i) <= nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i))) : forall i : N_(i) * B_(i) + N_(i) + N_(i) = nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i))
  fix (flat) glue.flat
  neqfix (flat) glue.flat.noside
  (flatdown): n in NN>=1, P in Forms(n, n), b, N in Weight(n), nu, A, B, K in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) + 2 = b_(i) * nu_(i) + (sum j, P_(i)_(j)) + K_(i)), (forall i : nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i)) <= N_(i) * B_(i) + N_(i) + N_(i)) : forall i : N_(i) * B_(i) + N_(i) + N_(i) = nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i))
  fix (flatdown) glue.flatdown
  neqfix (flatdown) glue.flatdown.noside
  (price): n in NN>=1, P in Forms(n, n), b, N in Weight(n), nu, A, B, K in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) + 2 = b_(i) * nu_(i) + (sum j, P_(i)_(j)) + K_(i)), (forall i : N_(i) * B_(i) + N_(i) + N_(i) = nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i))) : forall i : forall j : P_(i)_(j) * N_(i) * nu_(j) = P_(i)_(j) * nu_(i) * N_(j)
  fix (price) glue.price
  neqfix (price) glue.price.notie
  (tied): n in NN>=1, P in Forms(n, n), b, N in Weight(n), nu, A, B, K in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) + 2 = b_(i) * nu_(i) + (sum j, P_(i)_(j)) + K_(i)), (forall i : forall j : P_(i)_(j) * N_(i) * nu_(j) = P_(i)_(j) * nu_(i) * N_(j)) : forall i : N_(i) * B_(i) + N_(i) + N_(i) = nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i))
  fix (tied) glue.tied
  neqfix (tied) glue.tied.noprice
  (closedprice): n in NN>=1, P in Forms(n, n), b, N in Weight(n), nu in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * N_(j)) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + 2 = b_(i) * nu_(i) + (sum j, P_(i)_(j))), (forall i : (sum j, P_(i)_(j)) = 2) : forall i : forall j : P_(i)_(j) * N_(i) * nu_(j) = P_(i)_(j) * nu_(i) * N_(j)
  fix (closedprice) glue.closedprice
  neqfix (closedprice) glue.closedprice.notwo
  (closedtie): n in NN>=1, P in Forms(n, n), b, N in Weight(n), nu in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * N_(j)) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + 2 = b_(i) * nu_(i) + (sum j, P_(i)_(j))), (forall i : forall j : P_(i)_(j) * N_(i) * nu_(j) = P_(i)_(j) * nu_(i) * N_(j)) : forall i : (sum j, P_(i)_(j)) = 2
  fix (closedtie) glue.closedtie
  neqfix (closedtie) glue.closedtie.noprice
  origin: ?{\text{form proved, the closure law of a set of cells, loops and shells alike: at each cell the two rows tie as at a node (\cref{lem:node}); added over the cells, the meetings cancel by the symmetry of the table; one side at every cell ties every cell by the termwise core of \cref{lem:selfdual}, and one price is the mean tie of \cref{lem:mean}; with no outer spoke the table is that of a fibre of a pencil, read as}\ P_{ij}=E_i\cdot E_j,\ b_i=-E_i^2,\ N_i\ \text{the multiplicity of}\ E_i\text{; there (set), (flat) and (flatdown) state}\ \sum_iN_i\deg_i=2\sum_iN_i\text{, that is}\ K\cdot F=0\text{, the fibres of arithmetic genus one \cite[Section~2.4]{Ciliberto2019}, \cite[Section~6.6]{SchuettShioda2009}, and are not stated apart; (closedprice) and (closedtie) are adjunction at a smooth rational component and the fibres whose table is a cycle, Kodaira's}\ I_r\ \text{with}\ r\ge2\text{, and III and IV, which have the tables of}\ I_2\ \text{and}\ I_3\ \text{\cite[Sections~4.1, 4.3 and 4.4]{SchuettShioda2009}}}

proof lem:glue
  (star) V[nu_(i) * h_2(i), N_(i) * h_3(i)]
  (set) with[forall k : N_(k) * (sum l, P_(k)_(l) * nu_(l)) + N_(k) * B_(k) + N_(k) + N_(k) = nu_(k) * (sum l, P_(k)_(l) * N_(l)) + nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)) by lem:glue(star)[n := n, P := P, b := b, N := N, nu := nu, A := A, B := B, K := K]; with[(sum k, (N_(k) * (sum l, P_(k)_(l) * nu_(l)) + N_(k) * B_(k) + N_(k) + N_(k))) = sum k, (nu_(k) * (sum l, P_(k)_(l) * N_(l)) + nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k))) by sum[V[1 * hw1(k)]]; with[(sum k, (N_(k) * (sum l, P_(k)_(l) * nu_(l)) + N_(k) * B_(k) + N_(k) + N_(k))) = (sum k, N_(k) * (sum l, P_(k)_(l) * nu_(l))) + (sum k, (N_(k) * B_(k) + N_(k) + N_(k))) by sum[V[0]]; with[(sum k, (nu_(k) * (sum l, P_(k)_(l) * N_(l)) + nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)))) = (sum k, nu_(k) * (sum l, P_(k)_(l) * N_(l))) + (sum k, (nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)))) by sum[V[0]]; with[(sum k, N_(k) * (sum l, P_(k)_(l) * nu_(l))) = (sum k, sum l, P_(k)_(l) * N_(k) * nu_(l)) by sum[sum[V]]; with[(sum k, sum l, P_(k)_(l) * N_(k) * nu_(l)) = (sum l, sum k, P_(l)_(k) * N_(k) * nu_(l)) by sum[sum[V[(N_(k) * nu_(l)) * h_1(k, l)]]]; with[(sum k, nu_(k) * (sum l, P_(k)_(l) * N_(l))) = (sum k, sum l, P_(k)_(l) * N_(l) * nu_(k)) by sum[sum[V]]; with[(sum k, N_(k) * (sum l, P_(k)_(l) * nu_(l))) = (sum k, nu_(k) * (sum l, P_(k)_(l) * N_(l))) by V[1 * hw5, 1 * hw6, 1 * hw7]; V[1 * hw2, 1 * hw3, 1 * hw4, 1 * hw8]]]]]]]]]
  (flat) with[(sum i, (N_(i) * B_(i) + N_(i) + N_(i))) = sum i, (nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i))) by lem:glue(set)[n := n, P := P, b := b, N := N, nu := nu, A := A, B := B, K := K]; with[exists a in Point(n) : forall k : a_(k) = N_(k) * B_(k) + N_(k) + N_(k) by take[a_(k) := N_(k) * B_(k) + N_(k) + N_(k); V]; with[exists c in Point(n) : forall k : c_(k) = nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)) by take[c_(k) := nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)); V]; logic[with[forall k : a_(k) = N_(k) * B_(k) + N_(k) + N_(k) by V; with[forall k : c_(k) = nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)) by V; with[(sum k, a_(k)) = sum k, (N_(k) * B_(k) + N_(k) + N_(k)) by sum[V[1 * hw4(k)]]; with[(sum k, c_(k)) = sum k, (nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k))) by sum[V[1 * hw5(k)]]; with[(sum k, c_(k)) = sum k, a_(k) by V[1 * hw7, 1 * hw1, 1 * hw6]; with[forall m : a_(m) <= c_(m) by logic[with[N_(m) * B_(m) + N_(m) + N_(m) <= nu_(m) * A_(m) + N_(m) * ((sum l, P_(m)_(l)) + K_(m)) by V[1 * h_4(m)]; with[a_(m) = N_(m) * B_(m) + N_(m) + N_(m) by V; with[c_(m) = nu_(m) * A_(m) + N_(m) * ((sum l, P_(m)_(l)) + K_(m)) by V; with[nu_(m) * A_(m) + N_(m) * ((sum l, P_(m)_(l)) + K_(m)) = c_(m) by V[1 * hw12]; V[1 * hw10, 1 * hw11, 1 * hw13]]]]]]; with[forall k : c_(k) = a_(k) by lem:selfdual(core termwise)[n := n, a := c, b := a]; V[1 * hw14(i), 1 * hw4(i), 1 * hw5(i)]]]]]]]]]]]]
  (flatdown) with[(sum i, (N_(i) * B_(i) + N_(i) + N_(i))) = sum i, (nu_(i) * A_(i) + N_(i) * ((sum j, P_(i)_(j)) + K_(i))) by lem:glue(set)[n := n, P := P, b := b, N := N, nu := nu, A := A, B := B, K := K]; with[exists a in Point(n) : forall k : a_(k) = N_(k) * B_(k) + N_(k) + N_(k) by take[a_(k) := N_(k) * B_(k) + N_(k) + N_(k); V]; with[exists c in Point(n) : forall k : c_(k) = nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)) by take[c_(k) := nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)); V]; logic[with[forall k : a_(k) = N_(k) * B_(k) + N_(k) + N_(k) by V; with[forall k : c_(k) = nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)) by V; with[(sum k, a_(k)) = sum k, (N_(k) * B_(k) + N_(k) + N_(k)) by sum[V[1 * hw4(k)]]; with[(sum k, c_(k)) = sum k, (nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k))) by sum[V[1 * hw5(k)]]; with[(sum k, a_(k)) = sum k, c_(k) by V[1 * hw6, 1 * hw1, 1 * hw7]; with[forall m : c_(m) <= a_(m) by logic[with[nu_(m) * A_(m) + N_(m) * ((sum l, P_(m)_(l)) + K_(m)) <= N_(m) * B_(m) + N_(m) + N_(m) by V[1 * h_4(m)]; with[a_(m) = N_(m) * B_(m) + N_(m) + N_(m) by V; with[c_(m) = nu_(m) * A_(m) + N_(m) * ((sum l, P_(m)_(l)) + K_(m)) by V; with[N_(m) * B_(m) + N_(m) + N_(m) = a_(m) by V[1 * hw11]; V[1 * hw10, 1 * hw13, 1 * hw12]]]]]]; with[forall k : a_(k) = c_(k) by lem:selfdual(core termwise)[n := n, a := a, b := c]; V[1 * hw14(i), 1 * hw4(i), 1 * hw5(i)]]]]]]]]]]]]
  (price) with[forall k : N_(k) * (sum l, P_(k)_(l) * nu_(l)) + N_(k) * B_(k) + N_(k) + N_(k) = nu_(k) * (sum l, P_(k)_(l) * N_(l)) + nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)) by lem:glue(star)[n := n, P := P, b := b, N := N, nu := nu, A := A, B := B, K := K]; with[forall k : N_(k) * (sum l, P_(k)_(l) * nu_(l)) = nu_(k) * (sum l, P_(k)_(l) * N_(l)) by logic[V[1 * hw1(k), 1 * h_4(k)]]; lem:mean(tie)[n := n, P := P, x := N, y := nu]]]
  (tied) with[forall k : N_(k) * (sum l, P_(k)_(l) * nu_(l)) + N_(k) * B_(k) + N_(k) + N_(k) = nu_(k) * (sum l, P_(k)_(l) * N_(l)) + nu_(k) * A_(k) + N_(k) * ((sum l, P_(k)_(l)) + K_(k)) by lem:glue(star)[n := n, P := P, b := b, N := N, nu := nu, A := A, B := B, K := K]; with[N_(i) * (sum l, P_(i)_(l) * nu_(l)) = sum l, P_(i)_(l) * N_(i) * nu_(l) by sum[V]; with[(sum l, P_(i)_(l) * N_(i) * nu_(l)) = sum l, P_(i)_(l) * nu_(i) * N_(l) by sum[V[1 * h_4(i, l)]]; with[nu_(i) * (sum l, P_(i)_(l) * N_(l)) = sum l, P_(i)_(l) * nu_(i) * N_(l) by sum[V]; V[1 * hw1(i), 1 * hw2, 1 * hw3, 1 * hw4]]]]]
  (closedprice) with[forall k : N_(k) * (sum l, P_(k)_(l) * nu_(l)) = nu_(k) * (sum l, P_(k)_(l) * N_(l)) by logic[V[nu_(k) * h_2(k), N_(k) * h_3(k), N_(k) * h_4(k)]]; lem:mean(tie)[n := n, P := P, x := N, y := nu]]
  (closedtie) with[N_(i) * (sum l, P_(i)_(l) * nu_(l)) = sum l, P_(i)_(l) * N_(i) * nu_(l) by sum[V]; with[(sum l, P_(i)_(l) * N_(i) * nu_(l)) = sum l, P_(i)_(l) * nu_(i) * N_(l) by sum[V[1 * h_4(i, l)]]; with[nu_(i) * (sum l, P_(i)_(l) * N_(l)) = sum l, P_(i)_(l) * nu_(i) * N_(l) by sum[V]; with[N_(i) * (sum l, P_(i)_(l) * nu_(l)) = nu_(i) * (sum l, P_(i)_(l) * N_(l)) by V[1 * hw1, 1 * hw2, 1 * hw3]; with[(sum j, P_(i)_(j)) * N_(i) = 2 * N_(i) by V[N_(i) * h_3(i), nu_(i) * h_2(i), 1 * hw4]; with[2 * N_(i) = (sum j, P_(i)_(j)) * N_(i) by V[1 * hw5]; cases[(sum j, P_(i)_(j)) < 2; with[(sum j, P_(i)_(j)) * N_(i) < 2 * N_(i) by V[N_(i) * hc1]; with[2 * N_(i) <= (sum j, P_(i)_(j)) * N_(i) by V[1 * hw6]; logic]]; cases[2 < (sum j, P_(i)_(j)); with[2 * N_(i) < (sum j, P_(i)_(j)) * N_(i) by V[N_(i) * hc2]; with[(sum j, P_(i)_(j)) * N_(i) <= 2 * N_(i) by V[1 * hw5]; logic]]; V[hn2], V[hn1]]]]]]]]]
