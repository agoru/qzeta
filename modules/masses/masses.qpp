  (two) with[1 <= y by V[h_12]; with[z + 3 <= y by V[h_12, tau * sigma * c * hp(N), sigma * c * hp(tau), c * hp(sigma), hp(c), b * tau * s * hp(a), tau * s * hp(b), s * hp(tau), hp(s), z * b * sigma * t * hp(a), z * sigma * t * hp(b), z * t * hp(sigma), z * hp(t)]; with[2 * 1 + 2 * z + 4 <= y^2 by V[(y + z + 3) * hw2]; with[ps = pN * psig + pN + psig by lem:mass(join)[x := s, u := N, v := sigma, y := y, px := ps, pu := pN, pv := psig]; with[pc = pa * pb + pa + pb by lem:mass(join)[x := c, u := a, v := b, y := y, px := pc, pu := pa, pv := pb]; with[pN = y^(2 * tau) * pt + ptau by lem:mass(shift)[x := t, u := N, v := tau, y := y, px := pt, pu := pN, pv := ptau]; with[y^X * (((pa + 2) * (pb * pN * psig * ptau)) + ((pb + 2) * (pa * pN * psig * ptau)) + z * ((ptau + 2) * (pa * pb * pN * psig))) = y^X * ((1 + z) * ((pN + 2) * (pa * pb * psig * ptau)) + 1 * ((psig + 2) * (pa * pb * pN * ptau))) by V[2 * h_13, 2 * y^X * pa * pb * ptau * hw4, 2 * y^X * pN * ptau * psig * hw5, 2 * z * y^X * pa * pb * psig * hw6]; with[((pa + 2) * (pb * pN * psig * ptau)) + ((pb + 2) * (pa * pN * psig * ptau)) + z * ((ptau + 2) * (pa * pb * pN * psig)) = (1 + z) * ((pN + 2) * (pa * pb * psig * ptau)) + 1 * ((psig + 2) * (pa * pb * pN * ptau)) by lem:mass(divide)[A := ((pa + 2) * (pb * pN * psig * ptau)) + ((pb + 2) * (pa * pN * psig * ptau)) + z * ((ptau + 2) * (pa * pb * pN * psig)), B := (1 + z) * ((pN + 2) * (pa * pb * psig * ptau)) + 1 * ((psig + 2) * (pa * pb * pN * ptau)), v := y^X]; cases[a <= b; with[tau + 1 <= N by V[hp(t) | 1 * h_11]; with[(1 = 1, z = 1, a = N, b = N, sigma = tau) by lem:omega(q3)[a := a, b := b, N := N, sigma := sigma, tau := tau, zB := 1, zT := z, y := y, pa := pa, pb := pb, pN := pN, psig := psig, ptau := ptau; (N + 1 <= tau or tau + 1 <= N) by logic]; with[z = 1 by logic; with[a = N by logic; with[b = N by logic; with[sigma = tau by logic; logic, logic, logic, logic]]]]]]; with[b <= a by V[hn1]; with[tau + 1 <= N by V[hp(t) | 1 * h_11]; with[(1 = 1, z = 1, b = N,