-- Three product terms on three blocks of counts: above an explicit point, a tie of one term with the sum of the other
-- two has exactly one member, \(z=1\), \(a=b=N\), \(\sigma=\tau\).
lemma lem:qthree [three terms on three blocks: the tie has one member]
  (one): N, tau, sigma, c, a, b, s, t, z, X in NN>=1, y, pN, ptau, psig, pc, pa, pb, ps, pt in QQ>0, pN + 1 = y^(2 * N), ptau + 1 = y^(2 * tau), psig + 1 = y^(2 * sigma), pc + 1 = y^(2 * c), pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), ps + 1 = y^(2 * s), pt + 1 = y^(2 * t), s = N + sigma, c = a + b, tau = N + t, N * tau * sigma * c + a * b * tau * s + z * (a * b * sigma * t) + 1 <= y, y^X * (pN * ptau * psig * pc) = y^X * (pa * pb * ptau * ps) + z * y^(X + 2 * N) * (pa * pb * psig * pt) : (z = 1, a = N, b = N, sigma = tau)
  fix (one) qthreeone
  (two): N, tau, sigma, c, a, b, s, t, z, X in NN>=1, y, pN, ptau, psig, pc, pa, pb, ps, pt in QQ>0, pN + 1 = y^(2 * N), ptau + 1 = y^(2 * tau), psig + 1 = y^(2 * sigma), pc + 1 = y^(2 * c), pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), ps + 1 = y^(2 * s), pt + 1 = y^(2 * t), s = N + sigma, c = a + b, N = t + tau, N * tau * sigma * c + a * b * tau * s + z * (a * b * sigma * t) + 1 <= y, y^X * (pa * pb * ptau * ps) = y^X * (pN * ptau * psig * pc) + z * y^(X + 2 * tau) * (pa * pb * psig * pt) : (z = 1, a = N, b = N, sigma = tau)
  fix (two) qthreetwo
  origin: ?{\text{elementary, proved here}}

