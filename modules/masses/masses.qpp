-- Q++ 0.2
module masses
uses onevar

subsection sec:masses Tops and masses above an explicit point

-- Top dominance: at \(t\ge C+1\) a top monomial outweighs a rest of at most \(C\) units at each lower exponent; the
-- geometric tie \(t^{J+1}=t+q\,(t+\dots+t^J)\) ties the two sides, with the margin \(t\).
lemma lem:topdom [top dominance: a top monomial outweighs a bounded rest below it]
  (1): J in NN>=1, C, q, t, c in QQ>0, t = q + 1, C <= q, 1 <= c : C * (sum i in 1..J, t^i) < c * t^(J + 1)
  fix (1) topdom
  neqfix (1) topdom.unbounded
  (total): e in NN>=1, C, t in QQ>0, C + 1 <= t : C * t^e < t^(e + 2)
  fix (total) topdomtotal
  neqfix (total) topdomtotal.light
  origin: ?{\text{elementary, proved here: one geometric tie}}

proof lem:topdom
  (1) with[t + t * (sum i in 1..J, t^i) = (sum i in 1..J, t^i) + t^(J + 1) by lem:qsum(shift)[M := J, t := t]; V[1 * hw1, (sum i in 1..J, t^i) * h_2, t^(J + 1) * h_3 | (sum i in 1..J, t^i) * h_1]]
  (total) with[t^(e + 2) = t^e * t^2 by eq; V[hw1, t^e * t * h_1, t^e * (C + 1) * h_1]]

-- The top and the total of a positive side, in steps of \(y^2\): they multiply and add, and the side with the larger
-- top is the larger side as soon as \(y^2\ge T+1\), an explicit point.
lemma lem:topped [the top of a positive side: its coefficient, its height and its total]
  (producttop): m, k in NN>=1, c, d, y, X, Y in QQ>0, c * y^m <= X, d * y^k <= Y : c * d * y^(m + k) <= X * Y
  fix (producttop) toppedproducttop
  (product): m, k in NN>=1, c, d, T, U, y, X, Y in QQ>0, 1 <= y, c <= T, d <= U, X + c * y^m <= c * y^(m + 2) + T * y^m, Y + d * y^k <= d * y^(k + 2) + U * y^k : X * Y + c * d * y^(m + k + 2) <= c * d * y^(m + k + 4) + T * U * y^(m + k + 2)
  fix (product) toppedproduct
  neqfix (product) toppedproduct.small
  (sum): m in NN>=1, c, d, T, U, y, X, Y in QQ>0, X + c * y^m <= c * y^(m + 2) + T * y^m, Y + d * y^m <= d * y^(m + 2) + U * y^m : X + Y + (c + d) * y^m <= (c + d) * y^(m + 2) + (T + U) * y^m
  fix (sum) toppedsum
  (below): m, k in NN>=1, d, U, y, Y in QQ>0, 1 <= y, k + 2 <= m, d <= U, Y + d * y^k <= d * y^(k + 2) + U * y^k : Y <= U * y^m
  fix (below) toppedbelow
  neqfix (below) toppedbelow.small
  (apart): m in NN>=1, c, e, T, y, L, R in QQ>0, L + c * y^m <= c * y^(m + 2) + T * y^m, e * y^(m + 2) <= R, c + 1 <= e, T + 1 <= y^2 : L < R
  fix (apart) toppedapart
  neqfix (apart) toppedapart.near
  (apartbelow): m in NN>=1, e, T, y, L, R in QQ>0, L <= T * y^m, e * y^(m + 2) <= R, 1 <= e, T + 1 <= y^2 : L < R
  fix (apartbelow) toppedapartbelow
  origin: ?{\text{elementary, proved here}}

proof lem:topped
  (producttop) chain[c * d * y^(m + k) = (c * y^m) * (d * y^k) by eq; <= X * Y by mono]
  (product) with[y^(m + k) <= y^(m + k + 2) by mono; V[Y * h_4, c * y^(m + 2) * h_5, y^m * h_2 * h_5, h_2 * h_3 * hw1]]
  (sum) V[h_1, h_2]
  (below) with[y^(k + 2) <= y^m by mono; with[y^k <= y^(k + 2) by mono; V[h_4, d * hw1, h_3 * hw1, h_3 * hw2]]]
  (apart) with[T < y^2 by V[h_4]; with[T * y^m < y^2 * y^m by mono; V[h_1, h_2, y^(m + 2) * h_3, hw2]]]
  (apartbelow) with[T < y^2 by V[h_4]; with[T * y^m < y^2 * y^m by mono; V[h_1, h_2, y^(m + 2) * h_3, hw2]]]

-- The mass of a count \(n\) is the cancellation \(p_n\) of the dual pair \((y^{2n},1)\), \(p_n+1=y^{2n}\). The ties of
-- a block of counts become ties of masses (join, shift, swap), and the same hold below \(y=1\) on the dual masses
-- (swapstar): each is \cref{lem:qnumber} in the frame \(e=1\) at the letters \(y^{2n}\).
lemma lem:mass [the masses of counts: their ties on a block]
  (divide): A, B, v in QQ>0, v * A = v * B : A = B
  fix (divide) massdivide
  (gap): d, x in NN>=1, y, u, v in QQ>0, 1 <= y, u + 1 = y^(2 * d), v + 1 = y^(2 * x), d + 1 <= x : y^2 * u <= v
  fix (gap) massgap
  (same): d, x in NN>=1, y, u, v in QQ>0, 1 <= y, u + 1 = y^(2 * d), v + 1 = y^(2 * x), d = x : u = v
  fix (same) masssame
  (unit): d in NN>=1, y, u in QQ>0, 1 <= y, u + 1 = y^(2 * d) : y^2 <= u + 1
  fix (unit) massunit
  (join): x, u, v in NN>=1, y, px, pu, pv in QQ>0, 1 <= y, px + 1 = y^(2 * x), pu + 1 = y^(2 * u), pv + 1 = y^(2 * v), x = u + v : px = pu * pv + pu + pv
  fix (join) massjoin
  (shift): x, u, v in NN>=1, y, px, pu, pv in QQ>0, 1 <= y, px + 1 = y^(2 * x), pu + 1 = y^(2 * u), pv + 1 = y^(2 * v), u = x + v : pu = y^(2 * v) * px + pv
  fix (shift) massshift
  (csum): x, u, v in NN>=1, y, px, pu, pv in QQ>0, 1 <= y, px + 1 = y^(2 * x), pu + 1 = y^(2 * u), pv + 1 = y^(2 * v), x = u + v : y^(u + v) * px = y^x * (pu * pv + pu + pv)
  fix (csum) masscsum
  (cdiff): x, u, v in NN>=1, y, px, pu, pv in QQ>0, 1 <= y, px + 1 = y^(2 * x), pu + 1 = y^(2 * u), pv + 1 = y^(2 * v), u = x + v : y^(u + v) * px + y^x * pv = y^x * pu
  fix (cdiff) masscdiff
  (swap): p, r, d in NN>=1, y, pp, pr, pd, ppr, ppd, pprd in QQ>0, pp + 1 = y^(2 * p), pr + 1 = y^(2 * r), pd + 1 = y^(2 * d), ppr + 1 = y^(2 * (p + r)), ppd + 1 = y^(2 * (p + d)), pprd + 1 = y^(2 * (p + r + d)) : ppr * ppd = pp * pprd + y^(2 * p) * (pr * pd)
  fix (swap) massswap
  (swapstar): p, r, d in NN>=1, y, pp, pr, pd, ppr, ppd, pprd in QQ>0, pp + y^(2 * p) = 1, pr + y^(2 * r) = 1, pd + y^(2 * d) = 1, ppr + y^(2 * (p + r)) = 1, ppd + y^(2 * (p + d)) = 1, pprd + y^(2 * (p + r + d)) = 1 : ppr * ppd = pp * pprd + y^(2 * p) * (pr * pd)
  fix (swapstar) massswapstar
  origin: ?{\text{elementary, proved here}}

-- Each row compares or ties the powers \(y^{2d}\) of the exponents by monotonicity, and closes by a certificate of
-- the ties \(p+1=y^{2d}\): equal exponents give equal masses (same), an exponent larger by at least one gives a mass
-- at least \(y^2\) times larger (gap), and exponents that add give masses that tie (join, shift).
proof lem:mass
  (divide) cases[A < B; with[v * A < v * B by V[v * hc1]; with[v * B <= v * A by V[| 1 * h_1]; logic]]; cases[B < A; with[v * B < v * A by V[v * hc2]; with[v * A <= v * B by V[h_1]; logic]]; V[hn2], V[hn1]]]
  (gap) with[2 * d + 2 <= 2 * x by V[2 * h_4]; with[y^(2 * d + 2) <= y^(2 * x) by mono; V[hw2, y^2 * h_2, (y + 1) * h_1 | 1 * h_3]]]
  (same) with[2 * d <= 2 * x by V[2 * h_4]; with[2 * x <= 2 * d by V[| 2 * h_4]; with[y^(2 * d) = y^(2 * x) by mono, mono; V[h_2, 1 * h_3, hw3]]]]
  (unit) with[2 <= 2 * d by V[2 * hp(d)]; with[y^2 <= y^(2 * d) by mono; V[hw2 | 1 * h_2]]]
  (join) with[2 * x <= 2 * u + 2 * v by V[2 * h_5]; with[2 * u + 2 * v <= 2 * x by V[| 2 * h_5]; with[y^(2 * x) = y^(2 * u + 2 * v) by mono, mono; with[px = pu + y^(2 * u) * pv by lem:qnumber(detached)[e := 1, T := y^(2 * u), U := y^(2 * v), u := pu, w := pv, v := px; pu * 1 + 1 = y^(2 * u) by V[1 * h_3]; pv * 1 + 1 = y^(2 * v) by V[1 * h_4]; px * 1 + 1 = y^(2 * u) * y^(2 * v) by V[1 * h_2, 1 * hw3]]; V[1 * hw4 | pv * h_3]]]]]
  (shift) with[2 * u <= 2 * x + 2 * v by V[2 * h_5]; with[2 * x + 2 * v <= 2 * u by V[| 2 * h_5]; with[y^(2 * u) = y^(2 * x + 2 * v) by mono, mono; with[pu = pv + y^(2 * v) * px by lem:qnumber(detached)[e := 1, T := y^(2 * v), U := y^(2 * x), u := pv, w := px, v := pu; pv * 1 + 1 = y^(2 * v) by V[1 * h_4]; px * 1 + 1 = y^(2 * x) by V[1 * h_2]; pu * 1 + 1 = y^(2 * v) * y^(2 * x) by V[1 * h_3, 1 * hw3]]; V[1 * hw4]]]]]
  (csum) with[px = pu * pv + pu + pv by lem:mass(join)[x := x, u := u, v := v, y := y, px := px, pu := pu, pv := pv]; with[u + v <= x by V[| 1 * h_5]; with[x <= u + v by V[h_5]; with[y^(u + v) = y^x by mono, mono; V[px * hw4, y^x * hw1]]]]]
  (cdiff) with[pu = y^(2 * v) * px + pv by lem:mass(shift)[x := x, u := u, v := v, y := y, px := px, pu := pu, pv := pv]; with[u + v <= x + 2 * v by V[h_5]; with[x + 2 * v <= u + v by V[| 1 * h_5]; with[y^(u + v) = y^(x + 2 * v) by mono, mono; V[px * hw4, y^x * hw1]]]]]
  (swap) with[ppr * ppd = pprd * pp + y^(2 * p) * pd * pr by lem:qnumber(product)[e := 1, T1 := y^(2 * p), T2 := y^(2 * r), T3 := y^(2 * d), A := pp, B := pr, C := pd, r := ppr, m1 := ppd, m := pprd; pp * 1 + 1 = y^(2 * p) by V[1 * h_1]; pr * 1 + 1 = y^(2 * r) by V[1 * h_2]; pd * 1 + 1 = y^(2 * d) by V[1 * h_3]; ppr * 1 + 1 = y^(2 * p) * y^(2 * r) by V[1 * h_4]; ppd * 1 + 1 = y^(2 * p) * y^(2 * d) by V[1 * h_5]; pprd * 1 + 1 = y^(2 * p) * y^(2 * r) * y^(2 * d) by V[1 * h_6]]; V[1 * hw1]]
  (swapstar) with[ppr * ppd = pprd * pp + y^(2 * p) * pd * pr by lem:qnumber(productstar)[e := 1, T1 := y^(2 * p), T2 := y^(2 * r), T3 := y^(2 * d), A := pp, B := pr, C := pd, r := ppr, m1 := ppd, m := pprd; pp * 1 + y^(2 * p) = 1 by V[1 * h_1]; pr * 1 + y^(2 * r) = 1 by V[1 * h_2]; pd * 1 + y^(2 * d) = 1 by V[1 * h_3]; ppr * 1 + y^(2 * p) * y^(2 * r) = 1 by V[1 * h_4]; ppd * 1 + y^(2 * p) * y^(2 * d) = 1 by V[1 * h_5]; pprd * 1 + y^(2 * p) * y^(2 * r) * y^(2 * d) = 1 by V[1 * h_6]]; V[1 * hw1]]

subsection sec:omega The omega tie of a cell

-- The omega of a mass is the pair \(\omega_x=(p_x+2:p_x)\). A tie of weighted omegas is written cross-multiplied, so no
-- quotient is taken, and above an explicit point each tie on a cell has one member or its two sides are apart.
lemma lem:omega [the omega tie of a cell: one member, or apart]
  (q3): a, b, N, sigma, tau, zB, zT in NN>=1, y, pa, pb, pN, psig, ptau in QQ>0, 1 <= y, 2 * zB + 2 * zT + 4 <= y^2, pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma), ptau + 1 = y^(2 * tau), a <= b, (N + 1 <= tau or tau + 1 <= N), ((pa + 2) * (pb * pN * psig * ptau)) + ((pb + 2) * (pa * pN * psig * ptau)) + zT * ((ptau + 2) * (pa * pb * pN * psig)) = (zB + zT) * ((pN + 2) * (pa * pb * psig * ptau)) + zB * ((psig + 2) * (pa * pb * pN * ptau)) : (zB = 1, zT = 1, a = N, b = N, sigma = tau)
  fix (q3) omegaq3
  (neg): a, b, N, sigma, tau, zB, zT in NN>=1, y, pa, pb, pN, psig, ptau in QQ>0, 1 <= y, 2 * zB + 2 * zT + 4 <= y^2, pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma), ptau + 1 = y^(2 * tau), b + 1 <= a, sigma + 1 <= N, (N + 1 <= tau or tau + 1 <= N) : ((pb + 2) * (pa * pN * psig * ptau)) + (zB + zT) * ((pN + 2) * (pa * pb * psig * ptau)) < ((pa + 2) * (pb * pN * psig * ptau)) + zB * ((psig + 2) * (pa * pb * pN * ptau)) + zT * ((ptau + 2) * (pa * pb * pN * psig)) or ((pa + 2) * (pb * pN * psig * ptau)) + zB * ((psig + 2) * (pa * pb * pN * ptau)) + zT * ((ptau + 2) * (pa * pb * pN * psig)) < ((pb + 2) * (pa * pN * psig * ptau)) + (zB + zT) * ((pN + 2) * (pa * pb * psig * ptau))
  fix (neg) omeganeg
  (pairsum): a, b, N, sigma, zB in NN>=1, y, pa, pb, pN, psig in QQ>0, 1 <= y, 2 * zB + 4 <= y^2, pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma), a <= b, N <= sigma, ((pa + 2) * (pb * pN * psig)) + ((pb + 2) * (pa * pN * psig)) = zB * ((pN + 2) * (pa * pb * psig)) + zB * ((psig + 2) * (pa * pb * pN)) : (zB = 1, a = N, b = sigma)
  fix (pairsum) omegapairsum
  (pairdiff): lu, hu, lv, hv, zB in NN>=1, y, plu, phu, plv, phv in QQ>0, 1 <= y, 2 * zB + 4 <= y^2, plu + 1 = y^(2 * lu), phu + 1 = y^(2 * hu), plv + 1 = y^(2 * lv), phv + 1 = y^(2 * hv), lu + 1 <= hu, lv + 1 <= hv, ((plu + 2) * (phu * plv * phv)) + zB * ((phv + 2) * (plu * phu * plv)) = ((phu + 2) * (plu * plv * phv)) + zB * ((plv + 2) * (plu * phu * phv)) : (zB = 1, lu = lv, hu = hv)
  fix (pairdiff) omegapairdiff
  (kp1): a, b, N, sigma, zB in NN>=1, y, pa, pb, pN, psig in QQ>0, 1 <= y, 2 * zB + 4 <= y^2, pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma) : zB * ((psig + 2) * (pa * pb * pN)) < ((pa + 2) * (pb * pN * psig)) + ((pb + 2) * (pa * pN * psig)) + zB * ((pN + 2) * (pa * pb * psig))
  fix (kp1) omegakp1
  (kp2): a, b, N, sigma, zB in NN>=1, y, pa, pb, pN, psig in QQ>0, 1 <= y, 2 * zB + 4 <= y^2, pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma) : ((pb + 2) * (pa * pN * psig)) < ((pa + 2) * (pb * pN * psig)) + zB * ((pN + 2) * (pa * pb * psig)) + zB * ((psig + 2) * (pa * pb * pN))
  fix (kp2) omegakp2
  (ka): a, b, N, sigma, tau, zB, zT in NN>=1, y, pa, pb, pN, psig, ptau in QQ>0, 1 <= y, 2 * zB + 2 * zT + 4 <= y^2, pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma), ptau + 1 = y^(2 * tau) : ((pa + 2) * (pb * pN * psig * ptau)) + ((pb + 2) * (pa * pN * psig * ptau)) < (zB + zT) * ((pN + 2) * (pa * pb * psig * ptau)) + zB * ((psig + 2) * (pa * pb * pN * ptau)) + zT * ((ptau + 2) * (pa * pb * pN * psig))
  fix (ka) omegaka
  (kb): a, b, N, sigma, tau, zB, zT in NN>=1, y, pa, pb, pN, psig, ptau in QQ>0, 1 <= y, 2 * zB + 2 * zT + 4 <= y^2, pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma), ptau + 1 = y^(2 * tau) : (zB + zT) * ((pN + 2) * (pa * pb * psig * ptau)) < ((pa + 2) * (pb * pN * psig * ptau)) + ((pb + 2) * (pa * pN * psig * ptau)) + zB * ((psig + 2) * (pa * pb * pN * ptau)) + zT * ((ptau + 2) * (pa * pb * pN * psig))
  fix (kb) omegakb
  (kd): a, b, N, sigma, tau, zB, zT in NN>=1, y, pa, pb, pN, psig, ptau in QQ>0, 1 <= y, 2 * zB + 2 * zT + 4 <= y^2, pa + 1 = y^(2 * a), pb + 1 = y^(2 * b), pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma), ptau + 1 = y^(2 * tau) : ((pa + 2) * (pb * pN * psig * ptau)) + zB * ((psig + 2) * (pa * pb * pN * ptau)) < ((pb + 2) * (pa * pN * psig * ptau)) + (zB + zT) * ((pN + 2) * (pa * pb * psig * ptau)) + zT * ((ptau + 2) * (pa * pb * pN * psig))
  fix (kd) omegakd
  (kup): N, sigma, tau, zB, zT in NN>=1, y, pN, psig, ptau in QQ>0, 1 <= y, 2 * zB + 2 * zT + 2 <= y^2, pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma), ptau + 1 = y^(2 * tau) : zB * ((psig + 2) * (pN * ptau)) < (zB + zT) * ((pN + 2) * (psig * ptau)) + zT * ((ptau + 2) * (pN * psig))
  fix (kup) omegakup
  (down): N, sigma, tau, zB, zT in NN>=1, y, pN, psig, ptau in QQ>0, 1 <= y, 2 * zB + 2 * zT + 2 <= y^2, pN + 1 = y^(2 * N), psig + 1 = y^(2 * sigma), ptau + 1 = y^(2 * tau), sigma + 1 <= N, N + 1 <= tau : (zB + zT) * ((pN + 2) * (psig * ptau)) < zB * ((psig + 2) * (pN * ptau)) + zT * ((ptau + 2) * (pN * psig))
  fix (down) omegadown
  origin: ?{\text{elementary, proved here}}

proof lem:omega
  (q3) with[1 <= y^2 by V[(y + 1) * h_1]; cases[2 <= zB; with[y^2 <= pa + 1 by lem:mass(unit)[d := a, y := y, u := pa]; with[y^2 <= pb + 1 by lem:mass(unit)[d := b, y := y, u := pb]; with[y^2 <= ptau + 1 by lem:mass(unit)[d := tau, y := y, u := ptau]; with[zB + zT + 3 + y^2 <= zB * y^2 + 1 by V[h_2, hc1 * hw1]; with[pa * pb * pN * psig * ptau <= 0 by V[(1/2) * h_10, pb * pN * psig * ptau * hw2, pa * pN * psig * ptau * hw3, zT * pa * pb * pN * psig * hw4, (zB + zT) * pa * pb * psig * ptau * hw1, zB * pa * pb * pN * ptau * hw1, pa * pb * pN * psig * ptau * hw5 | (1/2) * y^2 * h_10]; with[0 < pa * pb * pN * psig * ptau by V[0]; logic, logic, logic, logic, logic]]]]]]; with[1 = zB by V[hp(zB)], V[hn1]; cases[tau + 1 <= N; cases[a + 1 <= tau; cases[sigma + 1 <= a; with[sigma + 1 <= tau by V[hc4, hc3]; with[y^2 * psig <= ptau by lem:mass(gap)[d := sigma, x := tau, y := y, u := psig, v := ptau]; with[y^2 * psig <= pa by lem:mass(gap)[d := sigma, x := a, y := y, u := psig, v := pa]; with[sigma + 1 <= b by V[hc4, h_8]; with[y^2 * psig <= pb by lem:mass(gap)[d := sigma, x := b, y := y, u := psig, v := pb]; with[zT + 3 <= zB * y^2 by V[h_2, y^2 * hp(zB)]; with[pa * pb * pN * ptau <= 0 by V[y^2 * pa * pb * pN * psig * ptau * hw8, zT * pa * pb * pN * hw10, pb * pN * ptau * hw11, pa * pN * ptau * hw13, pa * pb * pN * ptau * hw14 | (1/2) * y^2 * h_10]; with[0 < pa * pb * pN * ptau by V[0]; logic, logic, logic, logic, logic]]]]]]]]; cases[a + 1 <= sigma; cases[a + 1 <= b; with[a + 1 <= N by V[hc3, hc2]; with[y^2 * pa <= pN by lem:mass(gap)[d := a, x := N, y := y, u := pa, v := pN]; with[y^2 * pa <= psig by lem:mass(gap)[d := a, x := sigma, y := y, u := pa, v := psig]; with[2 * zB + zT + 1 <= y^2 by V[h_2]; with[pb * pN * psig * ptau <= 0 by V[(1/2) * y^2 * h_10, (zB + zT) * pb * psig * ptau * hw18, zB * pb * pN * ptau * hw19, pb * pN * psig * ptau * hw20 | y^2 * pa * pb * pN * psig * ptau * hw8]; with[0 < pb * pN * psig * ptau by V[0]; logic, logic, logic, logic, logic]]]]]]; with[