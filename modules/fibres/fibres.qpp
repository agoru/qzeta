-- Q++ 0.2
module fibres
uses theory

subsection sec:fibres Short fibres

-- A member of degree one, \(X=Y+A\,t\), moves linearly along a fibre, so the points where its modulus is small lie in a
-- short interval and are few; from above, it grows at most linearly past a start.
lemma lem:fibre [a short fibre]
  core above: N, D in NN, a in QQ>0, e in QQ>=0, b, m in Exponent(1), f in Grid(1), (forall t, t2 in Exponent(1) : (forall i : t_(i) <= b_(i)), (forall i : t2_(i) <= b_(i)) => forall i : a * t_(i) <= a * t2_(i) + 2^N * (f(t) + f(t2))), (forall i : m_(i) <= b_(i)), f(m) <= e, 2 * e * 2^N <= a * D : forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), f(t) <= e => forall i : t_(i) <= m_(i) + D
  core below: N, D in NN, a in QQ>0, e in QQ>=0, b, m in Exponent(1), f in Grid(1), (forall t, t2 in Exponent(1) : (forall i : t_(i) <= b_(i)), (forall i : t2_(i) <= b_(i)) => forall i : a * t_(i) <= a * t2_(i) + 2^N * (f(t) + f(t2))), (forall i : m_(i) <= b_(i)), f(m) <= e, 2 * e * 2^N <= a * D : forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), f(t) <= e => forall i : m_(i) <= t_(i) + D
  core total: D in NN, b, c, m in Exponent(1), e in QQ>=0, f in Grid(1), (forall i : c_(i) = 2 * D), (forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), f(t) <= e => forall i : t_(i) <= m_(i) + D, m_(i) <= t_(i) + D) : forall u in Exponent(1) : (forall i : u_(i) <= b_(i)), f(u) <= e => exists v in Exponent(1) : (forall i : v_(i) <= c_(i)), (forall i : v_(i) + m_(i) = u_(i) + D)
  core injective: D in NN, m in Exponent(1) : forall u, w, v in Exponent(1) : (forall i : v_(i) + m_(i) = u_(i) + D), (forall i : v_(i) + m_(i) = w_(i) + D) => forall i : u_(i) = w_(i)
  core interval: D in NN, b, c, m in Exponent(1), e in QQ>=0, f in Grid(1), (forall i : c_(i) = 2 * D), (forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), f(t) <= e => forall i : t_(i) <= m_(i) + D, m_(i) <= t_(i) + D) : (sum t <= b, iverson(f(t) <= e)) <= sum v <= c, iverson(forall i : v_(i) <= c_(i))
  core start: N in NN, c in QQ>=0, b, m in Exponent(1), f in Grid(1), (forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), (forall i : m_(i) + 1 <= t_(i)) => forall i : 2^N * f(t) + c * m_(i) <= 2^N * f(m) + c * t_(i)), 2^N * f(m) <= c : forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), (forall i : m_(i) + 1 <= t_(i)) => forall i : 2^N * f(t) + 2 * c * m_(i) <= 2 * c * t_(i)
  fix core start fibrestart
  (1): N, D in NN, a in QQ>0, e in QQ>=0, b, m in Exponent(1), f in Grid(1), (forall t, t2 in Exponent(1) : (forall i : t_(i) <= b_(i)), (forall i : t2_(i) <= b_(i)) => forall i : a * t_(i) <= a * t2_(i) + 2^N * (f(t) + f(t2))), (forall i : m_(i) <= b_(i)), f(m) <= e, 2 * e * 2^N <= a * D : (sum t <= b, iverson(f(t) <= e)) <= 2 * D + 1
  fix (1) fibre
  origin: ?{\text{elementary, proved here; in one coordinate and from above, the case of}\ \cref{lem:chart}}

-- Each point \(t\) of the set \(f\le e\) lies within \(D\) of the point \(m\), on either side: the slope \(a\) of the
-- member bounds \(a\) times the gap of \(t\) and \(m\) by \(2^N(f(t)+f(m))\le2\cdot2^Ne\le aD\) (core above, core
-- below). The count \(v\) with \(v+m=t+D\) then lies in the box of side \(2D\) and determines \(t\), so the set has at
-- most \(2D+1\) points (core interval).
proof lem:fibre
  "core above" logic[with[a * t_(i) <= a * m_(i) + 2^N * (f(t) + f(m)) by logic; with[2^N * (f(t) + f(m)) <= 2^N * (2 * e) by mono; with[a * (t_(i) / 1) <= a * ((m_(i) + D) / 1) by V; with[t_(i) / 1 <= (m_(i) + D) / 1 by div[a]; V[1 * hw4]]]]]]
  "core below" logic[with[a * m_(i) <= a * t_(i) + 2^N * (f(m) + f(t)) by logic; with[2^N * (f(m) + f(t)) <= 2^N * (2 * e) by mono; with[a * (m_(i) / 1) <= a * ((t_(i) + D) / 1) by V[1 * h_5, 1 * hw1, 1 * hw2]; with[m_(i) / 1 <= (t_(i) + D) / 1 by div[a]; V[1 * hw4]]]]]]
  "core total" logic[with[forall i : u_(i) <= m_(i) + D, m_(i) <= u_(i) + D by (logic, logic); with[forall i : exists x in NN : x <= c_(i), x + m_(i) = u_(i) + D by logic[take[x := max(u_(i) + D - m_(i), 0); (V, V[0])]]; with[exists v in Exponent(1) : forall i : v_(i) <= c_(i), v_(i) + m_(i) = u_(i) + D by choice; logic[take[v := v; (logic, logic)]]]]]]
  "core injective" logic[V]
  "core interval" with[forall u in Exponent(1) : (forall i : u_(i) <= b_(i)), f(u) <= e => exists v in Exponent(1) : (forall i : v_(i) <= c_(i)), (forall i : v_(i) + m_(i) = u_(i) + D) by lem:fibre(core total)[D := D, b := b, c := c, m := m, e := e, f := f]; with[forall u, w, v in Exponent(1) : (forall i : v_(i) + m_(i) = u_(i) + D), (forall i : v_(i) + m_(i) = w_(i) + D) => forall i : u_(i) = w_(i) by lem:fibre(core injective)[D := D, m := m]; inj]]
  "core start" logic[with[2^N * f(t) + c * m_(i) <= 2^N * f(m) + c * t_(i) by logic; with[m_(i) + 1 <= t_(i) by logic; with[c * (m_(i) + 1) <= c * t_(i) by mono; V[h_3, hw1, hw3]]]]]
  (1) with[exists c in Exponent(1) : forall i : c_(i) = 2 * D by take[c_(i) := 2 * D; V]; with[forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), f(t) <= e => forall i : t_(i) <= m_(i) + D by lem:fibre(core above)[N := N, D := D, a := a, e := e, b := b, m := m, f := f]; with[forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), f(t) <= e => forall i : m_(i) <= t_(i) + D by lem:fibre(core below)[N := N, D := D, a := a, e := e, b := b, m := m, f := f]; with[forall t in Exponent(1) : (forall i : t_(i) <= b_(i)), f(t) <= e => forall i : t_(i) <= m_(i) + D, m_(i) <= t_(i) + D by (logic, logic); chain[(sum t <= b, iverson(f(t) <= e)) <= sum v <= c, iverson(forall i : v_(i) <= c_(i)) by lem:fibre(core interval)[D := D, b := b, c := c, m := m, e := e, f := f]; <= prod i, (c_(i) + 1) by box; = (2 * D + 1)^1 by sum[V]]]]]]

-- Differences on the grid play the part of derivatives: the chain of a member along one coordinate has the mean value
-- inequality (points) and the convexity of Thom's lemma \cite{CosteRoy1988}, in the form of
-- \cite[Theorem~3.2]{GonzalezVegaLombardiMahe1998}: where given differences keep their sides is a run (convexity). Each
-- step is a tie of positive masses.
type Line := NN -> QQ>=0
relation (P #chain M #floors a #top m #from k #depth N #on t #to u) := N, m, k, t, u in NN, P_(0..m), M_(0..m) in Line, a_(0..m) in QQ>=0, t <= u, (forall j in NN : j < m => forall x in NN : t <= x, x < u => 2^N * P_(j)(x + 1) + 2^N * M_(j)(x) + M_(j + 1)(x) = 2^N * P_(j)(x) + 2^N * M_(j)(x + 1) + P_(j + 1)(x)), ((forall x in NN : t <= x, x <= u => M_(m)(x) + a_(m) <= P_(m)(x)) or (forall x in NN : t <= x, x <= u => P_(m)(x) + a_(m) <= M_(m)(x))), (forall j in NN : k <= j, j < m => ((M_(j)(t) + a_(j) <= P_(j)(t), M_(j)(u) + a_(j) <= P_(j)(u)) or (P_(j)(t) + a_(j) <= M_(j)(t), P_(j)(u) + a_(j) <= M_(j)(u))))
lemma lem:chain [the chain of differences of a member]
  core tele: N, t, t2 in NN, a in QQ>=0, fP, fM, gP, gM in Line : t <= t2 => (forall x in NN : t <= x, x < t2 => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x), gM(x) + a <= gP(x)) => a * t2 + 2^N * fP(t) + 2^N * fM(t2) <= a * t + 2^N * fP(t2) + 2^N * fM(t)
  (points): N, t, t2 in NN, a in QQ>=0, fP, fM, gP, gM in Line, t <= t2, (forall x in NN : t <= x, x < t2 => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x)), (forall x in NN : t <= x, x < t2 => gM(x) + a <= gP(x)) : a * t2 + 2^N * fP(t) + 2^N * fM(t2) <= a * t + 2^N * fP(t2) + 2^N * fM(t)
  fix (points) chainpoints
  core keep: N, t, t2 in NN, a, b in QQ>=0, fP, fM, gP, gM in Line, t <= t2, (forall x in NN : t <= x, x < t2 => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x)), ((forall x in NN : t <= x, x <= t2 => gM(x) + b <= gP(x)) or (forall x in NN : t <= x, x <= t2 => gP(x) + b <= gM(x))), ((fM(t) + a <= fP(t), fM(t2) + a <= fP(t2)) or (fP(t) + a <= fM(t), fP(t2) + a <= fM(t2))) : ((forall x in NN : t <= x, x <= t2 => fM(x) + a <= fP(x)) or (forall x in NN : t <= x, x <= t2 => fP(x) + a <= fM(x)))
  core apart: N, t, t2 in NN, a in QQ>=0, fP, fM, gP, gM in Line, t <= t2, (forall x in NN : t <= x, x < t2 => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x)), ((forall x in NN : t <= x, x <= t2 => gM(x) + a <= gP(x)) or (forall x in NN : t <= x, x <= t2 => gP(x) + a <= gM(x))) : (a * t2 + 2^N * fP(t) + 2^N * fM(t2) <= a * t + 2^N * fP(t2) + 2^N * fM(t)) or (a * t2 + 2^N * fM(t) + 2^N * fP(t2) <= a * t + 2^N * fM(t2) + 2^N * fP(t))
  core ladder: N, m, k, t, t2, d in NN, YP_(0..m), YM_(0..m) in Line, a_(0..m) in QQ>=0, (YP #chain YM #floors a #top m #from k #depth N #on t #to t2) : forall j in NN : k <= j, j <= m, m <= j + d => ((forall x in NN : t <= x, x <= t2 => YM_(j)(x) + a_(j) <= YP_(j)(x)) or (forall x in NN : t <= x, x <= t2 => YP_(j)(x) + a_(j) <= YM_(j)(x)))
  (convexity): N, m, k, t, t2 in NN, YP_(0..m), YM_(0..m) in Line, a_(0..m) in QQ>=0, (YP #chain YM #floors a #top m #from k #depth N #on t #to t2) : forall j in NN : k <= j, j <= m => ((forall x in NN : t <= x, x <= t2 => YM_(j)(x) + a_(j) <= YP_(j)(x)) or (forall x in NN : t <= x, x <= t2 => YP_(j)(x) + a_(j) <= YM_(j)(x)))
  fix (convexity) chainconvexity
  (pivot): N, m, k, t, t2 in NN, YP_(0..m), YM_(0..m) in Line, a_(0..m) in QQ>=0, k + 1 <= m, (YP #chain YM #floors a #top m #from k + 1 #depth N #on t #to t2) : (a_(k + 1) * t2 + 2^N * YP_(k)(t) + 2^N * YM_(k)(t2) <= a_(k + 1) * t + 2^N * YP_(k)(t2) + 2^N * YM_(k)(t)) or (a_(k + 1) * t2 + 2^N * YM_(k)(t) + 2^N * YP_(k)(t2) <= a_(k + 1) * t + 2^N * YM_(k)(t2) + 2^N * YP_(k)(t))
  fix (pivot) chainpivot
  origin: ?{\text{elementary, proved here; with derivatives, (convexity) is the convexity statement of Thom's lemma \cite{CosteRoy1988}, not used in the proof}}

-- From the top member down: each member keeps its side and its floor on the run, and the next one rises between the two
-- ends.
proof lem:chain
  "core tele" ind[t2; logic[with[t = 0 by V; eq]]; logic[cases[t <= t2; with[forall x in NN : t <= x, x < t2 => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x), gM(x) + a <= gP(x) by (logic[with[x < t2 + 1 by V; logic]], logic[with[x < t2 + 1 by V; logic]]); with[a * t2 + 2^N * fP(t) + 2^N * fM(t2) <= a * t + 2^N * fP(t2) + 2^N * fM(t) by logic; with[t2 < t2 + 1 by V; with[(2^N * fP(t2 + 1) + 2^N * fM(t2) + gM(t2) = 2^N * fP(t2) + 2^N * fM(t2 + 1) + gP(t2), gM(t2) + a <= gP(t2)) by (logic, logic); V]]]]; with[t = t2 + 1 by V; eq]]]]
  (points) with[forall x in NN : t <= x, x < t2 => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x), gM(x) + a <= gP(x) by (logic, logic); with[t <= t2 => (forall x in NN : t <= x, x < t2 => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x), gM(x) + a <= gP(x)) => a * t2 + 2^N * fP(t) + 2^N * fM(t2) <= a * t + 2^N * fP(t2) + 2^N * fM(t) by lem:chain(core tele)[N := N, t := t, t2 := t2, a := a, fP := fP, fM := fM, gP := gP, gM := gM]; logic]]
  "core keep" cases[forall y in NN : t <= y, y <= t2 => gM(y) + b <= gP(y); cases[(fM(t) + a <= fP(t), fM(t2) + a <= fP(t2)); with[forall u in NN : t <= u, u <= t2 => fM(u) + a <= fP(u) by logic[with[forall x in NN : t <= x, x < u => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x) by logic[with[x < t2 by V; logic]]; with[forall x in NN : t <= x, x < u => gM(x) + b <= gP(x) by logic[with[x <= t2 by V; logic]]; with[b * u + 2^N * fP(t) + 2^N * fM(u) <= b * t + 2^N * fP(u) + 2^N * fM(t) by lem:chain(points)[N := N, t := t, t2 := u, a := b, fP := fP, fM := fM, gP := gP, gM := gM]; with[2^N * (fM(t) + a) <= 2^N * fP(t) by mono; with[b * t <= b * u by mono; with[2^N * ((fM(u) + a) / 1) <= 2^N * (fP(u) / 1) by V[1 * hw6, 1 * hw7, 1 * hw8]; with[(fM(u) + a) / 1 <= fP(u) / 1 by div[2^N]; V[1 * hw10]]]]]]]]]; logic]; with[(fP(t) + a <= fM(t), fP(t2) + a <= fM(t2)) by (logic, logic); with[forall u in NN : t <= u, u <= t2 => fP(u) + a <= fM(u) by logic[with[forall x in NN : u <= x, x < t2 => 2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x) by logic[with[t <= x by V; logic]]; with[forall x in NN : u <= x, x < t2 => gM(x) + b <= gP(x) by logic[with[t <= x by V; with[x <= t2 by V; logic]]]; with[b * t2 + 2^N * fP(u) + 2^N * fM(t2) <= b * u + 2^N * fP(t2) + 2^N * fM(u) by lem:chain(points)[N := N, t := u, t2 := t2, a := b, fP := fP, fM := fM, gP := gP, gM := gM]; with[2^N * (fP(t2) + a) <= 2^N * fM(t2) by mono; with[b * u <= b * t2 by mono; with[2^N * ((fP(u) + a) / 1) <= 2^N * (fM(u) / 1) by V[1 * hw18, 1 * hw19, 1 * hw20]; with[(fP(u) + a) / 1 <= fM(u) / 1 by div[2^N]; V[1 * hw22]]]]]]]]]; logic]]]; with[forall x in NN : t <= x, x <= t2 => gP(x) + b <= gM(x) by logic; cases[(fM(t) + a <= fP(t), fM(t2) + a <= fP(t2)); with[forall u in NN : t <= u, u <= t2 => fM(u) + a <= fP(u) by logic[with[forall x in NN : u <= x, x < t2 => 2^N * fM(x + 1) + 2^N * fP(x) + gP(x) = 2^N * fM(x) + 2^N * fP(x + 1) + gM(x) by logic[with[t <= x by V; with[2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x) by logic; V[1 * hw27]]]]; with[forall x in NN : u <= x, x < t2 => gP(x) + b <= gM(x) by logic[with[t <= x by V; with[x <= t2 by V; logic]]]; with[b * t2 + 2^N * fM(u) + 2^N * fP(t2) <= b * u + 2^N * fM(t2) + 2^N * fP(u) by lem:chain(points)[N := N, t := u, t2 := t2, a := b, fP := fM, fM := fP, gP := gM, gM := gP]; with[2^N * (fM(t2) + a) <= 2^N * fP(t2) by mono; with[b * u <= b * t2 by mono; with[2^N * ((fM(u) + a) / 1) <= 2^N * (fP(u) / 1) by V[1 * hw31, 1 * hw32, 1 * hw33]; with[(fM(u) + a) / 1 <= fP(u) / 1 by div[2^N]; V[1 * hw35]]]]]]]]]; logic]; with[(fP(t) + a <= fM(t), fP(t2) + a <= fM(t2)) by (logic, logic); with[forall u in NN : t <= u, u <= t2 => fP(u) + a <= fM(u) by logic[with[forall x in NN : t <= x, x < u => 2^N * fM(x + 1) + 2^N * fP(x) + gP(x) = 2^N * fM(x) + 2^N * fP(x + 1) + gM(x) by logic[with[x < t2 by V; with[2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x) by logic; V[1 * hw40]]]]; with[forall x in NN : t <= x, x < u => gP(x) + b <= gM(x) by logic[with[x <= t2 by V; logic]]; with[b * u + 2^N * fM(t) + 2^N * fP(u) <= b * t + 2^N * fM(u) + 2^N * fP(t) by lem:chain(points)[N := N, t := t, t2 := u, a := b, fP := fM, fM := fP, gP := gM, gM := gP]; with[2^N * (fP(t) + a) <= 2^N * fM(t) by mono; with[b * t <= b * u by mono; with[2^N * ((fP(u) + a) / 1) <= 2^N * (fM(u) / 1) by V[1 * hw43, 1 * hw44, 1 * hw45]; with[(fP(u) + a) / 1 <= fM(u) / 1 by div[2^N]; V[1 * hw47]]]]]]]]]; logic]]]]]
  "core ladder" ind[d; logic[with[j = m by V; logic]]; logic[cases[m <= j + d; logic; with[j < m by V[hn1]; with[k <= j + 1 by V; with[j + 1 <= m by V; with[m <= j + 1 + d by V; with[((forall x in NN : t <= x, x <= t2 => YM_(j + 1)(x) + a_(j + 1) <= YP_(j + 1)(x)) or (forall x in NN : t <= x, x <= t2 => YP_(j + 1)(x) + a_(j + 1) <= YM_(j + 1)(x))) by logic; with[forall x in NN : t <= x, x < t2 => 2^N * YP_(j)(x + 1) + 2^N * YM_(j)(x) + YM_(j + 1)(x) = 2^N * YP_(j)(x) + 2^N * YM_(j)(x + 1) + YP_(j + 1)(x) by logic; with[((YM_(j)(t) + a_(j) <= YP_(j)(t), YM_(j)(t2) + a_(j) <= YP_(j)(t2)) or (YP_(j)(t) + a_(j) <= YM_(j)(t), YP_(j)(t2) + a_(j) <= YM_(j)(t2))) by logic; lem:chain(core keep)[N := N, t := t, t2 := t2, a := a_(j), b := a_(j + 1), fP := YP_(j), fM := YM_(j), gP := YP_(j + 1), gM := YM_(j + 1)]]]]]]]]]]]
  (convexity) with[forall j in NN : k <= j, j <= m, m <= j + m => ((forall x in NN : t <= x, x <= t2 => YM_(j)(x) + a_(j) <= YP_(j)(x)) or (forall x in NN : t <= x, x <= t2 => YP_(j)(x) + a_(j) <= YM_(j)(x))) by lem:chain(core ladder)[N := N, m := m, k := k, t := t, t2 := t2, d := m, YP := YP, YM := YM, a := a]; logic[with[m <= j + m by V; logic]]]
  "core apart" cases[forall y in NN : t <= y, y <= t2 => gM(y) + a <= gP(y); with[forall x in NN : t <= x, x < t2 => gM(x) + a <= gP(x) by logic[with[x <= t2 by V; logic]]; with[a * t2 + 2^N * fP(t) + 2^N * fM(t2) <= a * t + 2^N * fP(t2) + 2^N * fM(t) by lem:chain(points)[N := N, t := t, t2 := t2, a := a, fP := fP, fM := fM, gP := gP, gM := gM]; logic]]; with[forall x in NN : t <= x, x <= t2 => gP(x) + a <= gM(x) by logic; with[forall x in NN : t <= x, x < t2 => 2^N * fM(x + 1) + 2^N * fP(x) + gP(x) = 2^N * fM(x) + 2^N * fP(x + 1) + gM(x) by logic[with[2^N * fP(x + 1) + 2^N * fM(x) + gM(x) = 2^N * fP(x) + 2^N * fM(x + 1) + gP(x) by logic; V[hw6]]]; with[forall x in NN : t <= x, x < t2 => gP(x) + a <= gM(x) by logic[with[x <= t2 by V; logic]]; with[a * t2 + 2^N * fM(t) + 2^N * fP(t2) <= a * t + 2^N * fM(t2) + 2^N * fP(t) by lem:chain(points)[N := N, t := t, t2 := t2, a := a, fP := fM, fM := fP, gP := gM, gM := gP]; logic]]]]]
  (pivot) with[forall j in NN : k + 1 <= j, j <= m => ((forall x in NN : t <= x, x <= t2 => YM_(j)(x) + a_(j) <= YP_(j)(x)) or (forall x in NN : t <= x, x <= t2 => YP_(j)(x) + a_(j) <= YM_(j)(x))) by lem:chain(convexity)[N := N, m := m, k := k + 1, t := t, t2 := t2, YP := YP, YM := YM, a := a]; with[k + 1 <= k + 1 by V[0]; with[((forall x in NN : t <= x, x <= t2 => YM_(k + 1)(x) + a_(k + 1) <= YP_(k + 1)(x)) or (forall x in NN : t <= x, x <= t2 => YP_(k + 1)(x) + a_(k + 1) <= YM_(k + 1)(x))) by logic; with[forall x in NN : t <= x, x < t2 => 2^N * YP_(k)(x + 1) + 2^N * YM_(k)(x) + YM_(k + 1)(x) = 2^N * YP_(k)(x) + 2^N * YM_(k)(x + 1) + YP_(k + 1)(x) by logic; lem:chain(core apart)[N := N, t := t, t2 := t2, a := a_(k + 1), fP := YP_(k), fM := YM_(k), gP := YP_(k + 1), gM := YM_(k + 1)]]]]]

-- Two lines, read as power series, tie below the order \(d\) and part there by \(c\): \(d\) is the valuation of their
-- difference and \(c\) its lowest coefficient, in the order of \(\Q[[r]]\) where \(r\) is below every positive
-- rational. Order and deficit are unique, multiply under products, add under sums unless they cancel, and at
-- \(r=2^{-N}\) give sizes (sizes).
relation (P #above Q #order d #by c) := d in NN, P, Q in Line, c in QQ>0, (forall x in NN : x < d => P(x) = Q(x)), P(d) = Q(d) + c
lemma lem:above [the order of a tie of two positive series]
  core order: d, e in NN, P, Q in Line, c, b in QQ>0, (P #above Q #order d #by c), (P #above Q #order e #by b) : d = e
  (unique): d, e in NN, P, Q in Line, c, b in QQ>0, (P #above Q #order d #by c), (P #above Q #order e #by b) : d = e, c = b
  fix (unique) aboveunique
  core opposite: d, e in NN, P, Q in Line, c, b in QQ>0, (P #above Q #order d #by c), (Q #above P #order e #by b) : c <= 0
  (side): d, e in NN, P, Q in Line, c, b in QQ>0, (P #above Q #order d #by c) : iverson((Q #above P #order e #by b)) = 0
  fix (side) aboveside
  core unit: d, D in NN : d <= D => (sum k in 0..D, iverson(k = d)) = 1
  (product): d1, d2 in NN, P1, Q1, P2, Q2, R, S in Line, c1, c2 in QQ>0, (P1 #above Q1 #order d1 #by c1), (P2 #above Q2 #order d2 #by c2), (forall x in NN : x <= d1 + d2 => R(x) = sum k in 0..x, (P1(k) * P2(max(x - k, 0)) + Q1(k) * Q2(max(x - k, 0)))), (forall x in NN : x <= d1 + d2 => S(x) = sum k in 0..x, (P1(k) * Q2(max(x - k, 0)) + Q1(k) * P2(max(x - k, 0)))) : (R #above S #order d1 + d2 #by c1 * c2)
  fix (product) aboveproduct
  core below: n, d in NN, P_(1..n), Q_(1..n), S, T in Line, (forall j in NN>=1 : j <= n => forall x in NN : x < d => P_(j)(x) = Q_(j)(x)), (forall x in NN : x <= d => S(x) = sum j in 1..n, P_(j)(x)), (forall x in NN : x <= d => T(x) = sum j in 1..n, Q_(j)(x)) : forall x in NN : x < d => S(x) = T(x)
  core at: n, d in NN, P_(1..n), Q_(1..n), S, T in Line, a_(1..n), b_(1..n) in QQ>=0, (forall j in NN>=1 : j <= n => P_(j)(d) + b_(j) = Q_(j)(d) + a_(j)), (forall x in NN : x <= d => S(x) = sum j in 1..n, P_(j)(x)), (forall x in NN : x <= d => T(x) = sum j in 1..n, Q_(j)(x)) : S(d) + (sum j in 1..n, b_(j)) = T(d) + (sum j in 1..n, a_(j))
  (sum): n, d in NN, P_(1..n), Q_(1..n), S, T in Line, a_(1..n), b_(1..n) in QQ>=0, c in QQ>0, (forall j in NN>=1 : j <= n => forall x in NN : x < d => P_(j)(x) = Q_(j)(x)), (forall j in NN>=1 : j <= n => P_(j)(d) + b_(j) = Q_(j)(d) + a_(j)), (forall x in NN : x <= d => S(x) = sum j in 1..n, P_(j)(x)), (forall x in NN : x <= d => T(x) = sum j in 1..n, Q_(j)(x)), (sum j in 1..n, a_(j)) = (sum j in 1..n, b_(j)) + c : (S #above T #order d #by c)
  fix (sum) abovesum
  neqfix (sum) abovesum.tie
  (cancel): n, d in NN, P_(1..n), Q_(1..n), S, T in Line, a_(1..n), b_(1..n) in QQ>=0, (forall j in NN>=1 : j <= n => forall x in NN : x < d => P_(j)(x) = Q_(j)(x)), (forall j in NN>=1 : j <= n => P_(j)(d) + b_(j) = Q_(j)(d) + a_(j)), (forall x in NN : x <= d => S(x) = sum j in 1..n, P_(j)(x)), (forall x in NN : x <= d => T(x) = sum j in 1..n, Q_(j)(x)), (sum j in 1..n, a_(j)) = (sum j in 1..n, b_(j)) : (forall x in NN : x < d => S(x) = T(x)), S(d) = T(d)
  fix (cancel) abovecancel
  (sizes): D, d, N in NN, P, Q in Line, c, r in QQ>0, A in QQ>=0, (P #above Q #order d #by c), d <= D, (sum x in 0..D, (P(x) + Q(x))) <= A, r * 2^N = 1, 2 * A <= c * 2^N : (sum x in 0..D, Q(x) * r^x) + c * r^d / 2 <= (sum x in 0..D, P(x) * r^x), (sum x in 0..D, P(x) * r^x) <= (sum x in 0..D, Q(x) * r^x) + 3 * c * r^d / 2
  fix (sizes) abovesizes
  neqfix (sizes) abovesizes.scale
  origin: ?{\text{elementary, proved here; (product) is the lowest term of a product of power series over a domain, written for couples of positive series, with the deficit and the side kept}}

-- Term by term: below the least order both tie, and at it one tie of positive sums decides.
proof lem:above
  "core order" with[forall x in NN : x < d => P(x) = Q(x) by logic; with[P(d) = Q(d) + c by V[1 * h_1_3]; with[forall x in NN : x < e => P(x) = Q(x) by logic; with[P(e) = Q(e) + b by V[1 * h_2_3]; with[d <= e by cases[e + 1 <= d; with[e < d by V; with[P(e) = Q(e) by hw1[x := e]; with[b <= 0 by V[1 * hw7 | 1 * hw4]; with[0 < b by V; logic]]]]; V]; with[e <= d by cases[d + 1 <= e; with[d < e by V; with[P(d) = Q(d) by hw3[x := d]; with[c <= 0 by V[1 * hw12 | 1 * hw2]; with[0 < c by V; logic]]]]; V]; V[1 * hw5], V[1 * hw10]]]]]]]
  (unique) with[d = e by lem:above(core order)[d := d, e := e, P := P, Q := Q, c := c, b := b]; with[P(d) = Q(d) + c by V[1 * h_1_3]; with[P(e) = Q(e) + b by V[1 * h_2_3]; with[P(d) = P(e) by eq[hw1]; with[Q(d) = Q(e) by eq[hw1]; (V[1 * hw1], V[1 * hw2, 1 * hw3, 1 * hw4, 1 * hw5])]]]]]
  "core opposite" with[forall x in NN : x < d => P(x) = Q(x) by logic; with[P(d) = Q(d) + c by V[1 * h_1_3]; with[forall x in NN : x < e => Q(x) = P(x) by logic; with[Q(e) = P(e) + b by V[1 * h_2_3]; cases[d + 1 <= e; with[d < e by V; with[Q(d) = P(d) by hw3[x := d]; V[| 1 * hw2, 1 * hw6]]]; cases[e + 1 <= d; with[e < d by V; with[P(e) = Q(e) by hw1[x := e]; with[b <= 0 by V[| 1 * hw4, 1 * hw8]; with[0 < b by V; logic]]]]; with[d = e by V, V; with[P(d) = P(e) by eq[hw11]; with[Q(d) = Q(e) by eq[hw11]; with[0 < b by V; V[1 * hw12, 1 * hw14 | 1 * hw2, 1 * hw4, 1 * hw13]]]]]]]]]]]
  (side) cases[(Q #above P #order e #by b); with[c <= 0 by lem:above(core opposite)[d := d, e := e, P := P, Q := Q, c := c, b := b]; with[0 < c by V; logic]]; V[0]]
  "core unit" ind[D; with[0 = d by V, V; with[(sum k in 0..0, iverson(k = d)) = iverson(0 = d) by sum; V[1 * hw2]]]; with[(sum k in 0..D + 1, iverson(k = d)) = (sum k in 0..D, iverson(k = d)) + iverson(D + 1 = d) by sum; cases[d <= D; with[(sum k in 0..D, iverson(k = d)) = 1 by logic; with[d < D + 1 by V; V[1 * hw3, 1 * hw4]]]; with[d = D + 1 by V, V; with[(sum k in 0..D, iverson(k = d)) = 0 by sum[with[k <= D by V; with[k + 1 <= d by V[1 * hw8 | 1 * hw6]; with[k < d by V; V[0]]]]]; with[D + 1 = d by V, V; V[1 * hw3, 1 * hw7]]]]]]]
  (product) with[forall x in NN : x < d1 => P1(x) = Q1(x) by logic; with[P1(d1) = Q1(d1) + c1 by V[1 * h_1_3]; with[forall x in NN : x < d2 => P2(x) = Q2(x) by logic; with[P2(d2) = Q2(d2) + c2 by V[1 * h_2_3]; unfold[(V, with[x <= d1 + d2 by V; with[x + 1 <= d1 + d2 by V; with[R(x) = (sum k in 0..x, (P1(k) * P2(max(x - k, 0)) + Q1(k) * Q2(max(x - k, 0)))) by h_3[x := x]; with[S(x) = (sum k in 0..x, (P1(k) * Q2(max(x - k, 0)) + Q1(k) * P2(max(x - k, 0)))) by h_4[x := x]; with[(sum k in 0..x, (P1(k) * P2(max(x - k, 0)) + Q1(k) * Q2(max(x - k, 0)))) = (sum k in 0..x, (P1(k) * Q2(max(x - k, 0)) + Q1(k) * P2(max(x - k, 0)))) by sum[cases[k + 1 <= d1; with[k < d1 by V; with[P1(k) = Q1(k) by hw1[x := k]; V[P2(max(x - k, 0)) * hw11, Q2(max(x - k, 0)) * hw11]]]; with[d1 <= k by V; with[max(x - k, 0) + 1 <= d2 by V[1 * hw6, 1 * hw12]; with[max(x - k, 0) < d2 by V[1 * hw13]; with[P2(max(x - k, 0)) = Q2(max(x - k, 0)) by hw3[x := max(x - k, 0)]; V[P1(k) * hw15, Q1(k) * hw15]]]]]]]; V[1 * hw7, 1 * hw8, 1 * hw9]]]]]], with[d1 + d2 <= d1 + d2 by V; with[R(d1 + d2) = (sum k in 0..d1 + d2, (P1(k) * P2(max(d1 + d2 - k, 0)) + Q1(k) * Q2(max(d1 + d2 - k, 0)))) by h_3[x := d1 + d2]; with[S(d1 + d2) = (sum k in 0..d1 + d2, (P1(k) * Q2(max(d1 + d2 - k, 0)) + Q1(k) * P2(max(d1 + d2 - k, 0)))) by h_4[x := d1 + d2]; with[(sum k in 0..d1 + d2, (P1(k) * P2(max(d1 + d2 - k, 0)) + Q1(k) * Q2(max(d1 + d2 - k, 0)))) = (sum k in 0..d1 + d2, (P1(k) * Q2(max(d1 + d2 - k, 0)) + Q1(k) * P2(max(d1 + d2 - k, 0)) + c1 * c2 * iverson(k = d1))) by sum[cases[k + 1 <= d1; with[k < d1 by V; with[P1(k) = Q1(k) by hw1[x := k]; V[P2(max(d1 + d2 - k, 0)) * hw21, Q2(max(d1 + d2 - k, 0)) * hw21]]]; cases[d1 + 1 <= k; with[d1 < k by V; with[d1 + 1 <= k by V; with[max(d1 + d2 - k, 0) + 1 <= d2 by V[1 * hw23]; with[max(d1 + d2 - k, 0) < d2 by V[1 * hw24]; with[P2(max(d1 + d2 - k, 0)) = Q2(max(d1 + d2 - k, 0)) by hw3[x := max(d1 + d2 - k, 0)]; V[P1(k) * hw26, Q1(k) * hw26]]]]]]; with[d1 <= k by V; with[k <= d1 by V; with[k = d1 by V, V; with[d1 <= d1 + d2 by V; with[max(d1 + d2 - d1, 0) = d2 by V[0]; with[P2(max(d1 + d2 - d1, 0)) = P2(d2) by eq[hw31]; with[Q2(max(d1 + d2 - d1, 0)) = Q2(d2) by eq[hw31]; V[P2(max(d1 + d2 - d1, 0)) * hw2, Q2(max(d1 + d2 - d1, 0)) * hw2, c1 * hw32, c1 * hw33, c1 * hw4]]]]]]]]]]]; with[(sum k in 0..d1 + d2, (P1(k) * Q2(max(d1 + d2 - k, 0)) + Q1(k) * P2(max(d1 + d2 - k, 0)) + c1 * c2 * iverson(k = d1))) = (sum k in 0..d1 + d2, (P1(k) * Q2(max(d1 + d2 - k, 0)) + Q1(k) * P2(max(d1 + d2 - k, 0)))) + (sum k in 0..d1 + d2, c1 * c2 * iverson(k = d1)) by sum[V]; with[(sum k in 0..d1 + d2, c1 * c2 * iverson(k = d1)) = c1 * c2 * (sum k in 0..d1 + d2, iverson(k = d1)) by sum; with[d1 <= d1 + d2 by V; with[d1 <= d1 + d2 => (sum k in 0..d1 + d2, iverson(k = d1)) = 1 by lem:above(core unit)[d := d1, D := d1 + d2]; with[(sum k in 0..d1 + d2, iverson(k = d1)) = 1 by logic; V[1 * hw17, 1 * hw18, 1 * hw19, 1 * hw34, 1 * hw35, (c1 * c2) * hw38]]]]]]]]]])]]]]]
  "core below" with[x <= d by V; with[S(x) = (sum j in 1..n, P_(j)(x)) by h_2[x := x]; with[T(x) = (sum j in 1..n, Q_(j)(x)) by h_3[x := x]; with[(sum j in 1..n, P_(j)(x)) = (sum j in 1..n, Q_(j)(x)) by sum[h_1[j := j, x := x]]; V[1 * hw2, 1 * hw3, 1 * hw4]]]]]
  "core at" with[d <= d by V; with[S(d) = (sum j in 1..n, P_(j)(d)) by h_4[x := d]; with[T(d) = (sum j in 1..n, Q_(j)(d)) by h_5[x := d]; with[(sum j in 1..n, (P_(j)(d) + b_(j))) = (sum j in 1..n, (Q_(j)(d) + a_(j))) by sum[V]; with[(sum j in 1..n, (P_(j)(d) + b_(j))) = (sum j in 1..n, P_(j)(d)) + (sum j in 1..n, b_(j)) by sum[V]; with[(sum j in 1..n, (Q_(j)(d) + a_(j))) = (sum j in 1..n, Q_(j)(d)) + (sum j in 1..n, a_(j)) by sum[V]; V[1 * hw2, 1 * hw3, 1 * hw4, 1 * hw5, 1 * hw6]]]]]]]
  (sum) unfold[(V, lem:above(core below)[n := n, d := d, P := P, Q := Q, S := S, T := T], with[S(d) + (sum j in 1..n, b_(j)) = T(d) + (sum j in 1..n, a_(j)) by lem:above(core at)[n := n, d := d, P := P, Q := Q, S := S, T := T, a := a, b := b]; V[1 * hw1, 1 * h_7]])]
  (cancel) (lem:above(core below)[n := n, d := d, P := P, Q := Q, S := S, T := T], with[S(d) + (sum j in 1..n, b_(j)) = T(d) + (sum j in 1..n, a_(j)) by lem:above(core at)[n := n, d := d, P := P, Q := Q, S := S, T := T, a := a, b := b]; V[1 * hw1, 1 * h_7]])
  (sizes) with[forall x in NN : x < d => P(x) = Q(x) by logic; with[P(d) = Q(d) + c by V[1 * h_2_3]; with[0 <= N by V; with[2^0 <= 2^N by mono; with[r <= 1 by V[1 * h_5, r * hw4]; with[2 * r * A <= c by V[r * h_6, c * h_5]; with[d <= D => (sum x in 0..D, iverson(x = d)) = 1 by lem:above(core unit)[d := d, D := D]; with[(sum x in 0..D, iverson(x = d)) = 1 by logic; with[(sum x in 0..D, (P(x) + Q(x)) * iverson(d < x)) <= (sum x in 0..D, (P(x) + Q(x))) by sum[cases[d < x; V[0]; V[0]]]; with[(sum x in 0..D, c * r^d * iverson(x = d)) = c * r^d * (sum x in 0..D, iverson(x = d)) by sum; with[(sum x in 0..D, r^(d + 1) * ((P(x) + Q(x)) * iverson(d < x))) = r^(d + 1) * (sum x in 0..D, (P(x) + Q(x)) * iverson(d < x)) by sum; with[(sum x in 0..D, (Q(x) * r^x + c * r^d * iverson(x = d))) = (sum x in 0..D, Q(x) * r^x) + (sum x in 0..D, c * r^d * iverson(x = d)) by sum[V]; with[c * r^d * (sum x in 0..D, iverson(x = d)) = c * r^d * 1 by eq[hw8]; (with[(sum x in 0..D, (Q(x) * r^x + c * r^d * iverson(x = d))) <= (sum x in 0..D, (P(x) * r^x + r^(d + 1) * ((P(x) + Q(x)) * iverson(d < x)))) by sum[cases[x + 1 <= d; with[x < d by V; with[x <= d by V; with[P(x) = Q(x) by hw1[x := x]; with[Q(x) <= P(x) by V[| 1 * hw17]; with[Q(x) * r^x <= P(x) * r^x by mono; V[1 * hw19]]]]]]; cases[d + 1 <= x; with[d < x by V; with[r^x <= r^(d + 1) by mono; with[Q(x) * r^x <= Q(x) * r^(d + 1) by mono; V[1 * hw22]]]]; with[d <= x by V; with[x <= d by V; with[x = d by V, V; with[d <= d by V; with[Q(d) + c <= P(d) by V[| 1 * hw2]; with[(Q(d) + c) * r^d <= (P(d)) * r^d by mono; V[1 * hw28]]]]]]]]]]; with[(sum x in 0..D, (P(x) * r^x + r^(d + 1) * ((P(x) + Q(x)) * iverson(d < x)))) = (sum x in 0..D, P(x) * r^x) + (sum x in 0..D, r^(d + 1) * ((P(x) + Q(x)) * iverson(d < x))) by sum[V]; V[1 * hw14, 1 * hw29, 1 * hw11, r^(d + 1) * hw9, r^(d + 1) * h_4, (1 / 2) * r^d * hw6 | 1 * hw12, 1 * hw10, 1 * hw13]]], with[(sum x in 0..D, P(x) * r^x) <= (sum x in 0..D, (Q(x) * r^x + c * r^d * iverson(x = d) + r^(d + 1) * ((P(x) + Q(x)) * iverson(d < x)))) by sum[cases[x + 1 <= d; with[x < d by V; with[x <= d by V; with[P(x) = Q(x) by hw1[x := x]; with[P(x) <= Q(x) by V[1 * hw33]; with[P(x) * r^x <= Q(x) * r^x by mono; V[1 * hw35]]]]]]; cases[d + 1 <= x; with[d < x by V; with[r^x <= r^(d + 1) by mono; with[P(x) * r^x <= P(x) * r^(d + 1) by mono; V[1 * hw38]]]]; with[d <= x by V; with[x <= d by V; with[x = d by V, V; with[d <= d by V; with[P(d) <= Q(d) + c by V[1 * hw2]; with[(P(d)) * r^d <= (Q(d) + c) * r^d by mono; V[1 * hw44]]]]]]]]]]; with[(sum x in 0..D, (Q(x) * r^x + c * r^d * iverson(x = d) + r^(d + 1) * ((P(x) + Q(x)) * iverson(d < x)))) = (sum x in 0..D, (Q(x) * r^x + c * r^d * iverson(x = d))) + (sum x in 0..D, r^(d + 1) * ((P(x) + Q(x)) * iverson(d < x))) by sum[V]; V[1 * hw30, 1 * hw45, 1 * hw12, 1 * hw10, 1 * hw13, 1 * hw11, r^(d + 1) * hw9, r^(d + 1) * h_4, (1 / 2) * r^d * hw6]]])]]]]]]]]]]]]]
