-- Q++ 0.2
module parity
uses theory

subsection sec:parity The even and the odd parts of a product of blocks

-- A tie \(E=O+X\) of three positive masses has an even part \(E\), an odd part \(O\) and a third part \(X\). Two ties multiply to a tie: the even parts pair with the even parts and the odd with the odd, the mixed pairs are odd, and the product of the third parts ties them (product). An attached block is the tie \(1=w+x\), so blocks assembled one at a time, \(E_{j+1}=E_j+O_jw_{j+1}\), \(O_{j+1}=O_j+E_jw_{j+1}\), \(X_{j+1}=X_jx_{j+1}\), tie at every length (tie). A product that starts at a wall \(E_1=O_1\), the fixed point of the swap of the even and the odd parts, stays at it at every weight, since each step commutes with the swap (wall).
lemma lem:parity [the even and the odd parts of a product of blocks]
  (product): E, O, X, F, P, Y in QQ>0, E = O + X, F = P + Y : E * F + O * P = E * P + O * F + X * Y
  fix (product) parity.product
  neqfix (product) parity.product.noleft
  neqfix (product) parity.product.noright
  core tie: n, N in NN>=1, x_(1..N), w_(1..N), E_(1..N), O_(1..N), X_(1..N) in QQ>0, (forall j in NN>=1 : j <= N => 1 = w_(j) + x_(j)), E_(1) = 1, O_(1) = w_(1), X_(1) = x_(1), (forall j in NN>=1 : j + 1 <= N => E_(j + 1) = E_(j) + O_(j) * w_(j + 1)), (forall j in NN>=1 : j + 1 <= N => O_(j + 1) = O_(j) + E_(j) * w_(j + 1)), (forall j in NN>=1 : j + 1 <= N => X_(j + 1) = X_(j) * x_(j + 1)) : n <= N => E_(n) = O_(n) + X_(n)
  (tie): N in NN>=1, x_(1..N), w_(1..N), E_(1..N), O_(1..N), X_(1..N) in QQ>0, (forall j in NN>=1 : j <= N => 1 = w_(j) + x_(j)), E_(1) = 1, O_(1) = w_(1), X_(1) = x_(1), (forall j in NN>=1 : j + 1 <= N => E_(j + 1) = E_(j) + O_(j) * w_(j + 1)), (forall j in NN>=1 : j + 1 <= N => O_(j + 1) = O_(j) + E_(j) * w_(j + 1)), (forall j in NN>=1 : j + 1 <= N => X_(j + 1) = X_(j) * x_(j + 1)) : E_(N) = O_(N) + X_(N)
  fix (tie) parity.tie
  neqfix (tie) parity.tie.nounit
  neqfix (tie) parity.tie.nostart
  neqfix (tie) parity.tie.noodd
  core wall: n, N in NN>=1, w_(1..N), E_(1..N), O_(1..N) in QQ>0, E_(1) = O_(1), (forall j in NN>=1 : j + 1 <= N => E_(j + 1) = E_(j) + O_(j) * w_(j + 1)), (forall j in NN>=1 : j + 1 <= N => O_(j + 1) = O_(j) + E_(j) * w_(j + 1)) : n <= N => E_(n) = O_(n)
  (wall): N in NN>=1, w_(1..N), E_(1..N), O_(1..N) in QQ>0, E_(1) = O_(1), (forall j in NN>=1 : j + 1 <= N => E_(j + 1) = E_(j) + O_(j) * w_(j + 1)), (forall j in NN>=1 : j + 1 <= N => O_(j + 1) = O_(j) + E_(j) * w_(j + 1)) : E_(N) = O_(N)
  fix (wall) parity.wall
  neqfix (wall) parity.wall.nowall
  neqfix (wall) parity.wall.noodd
  origin: ?{\text{form proved over Q: the product of two ties of positive masses, and its assembly over attached blocks; the expansion of}\ E_N,\ O_N\ \text{over the even and the odd subsets of the blocks is the expansion of a product of differences (Mathlib: Finset.prod\_sub)}}

-- (product) is the expansion of the two ties. Along the blocks, by induction on the length, each step is (product) with
-- the attached block \(1=w_{j+1}+x_{j+1}\), which keeps the tie (core tie); at a wall the even and the odd parts gain
-- the same mass \(E_jw_{j+1}=O_jw_{j+1}\) at every step (core wall).
proof lem:parity
  (product) eq
  "core tie" ind[n; with[1 = w_(1) + x_(1) by logic; V[1 * h_2, 1 * h_3, 1 * h_4, 1 * hw1]]; with[n <= N by V[1 * hi2]; with[E_(n) = O_(n) + X_(n) by logic; with[1 = w_(n + 1) + x_(n + 1) by logic; with[E_(n) * 1 + O_(n) * w_(n + 1) = E_(n) * w_(n + 1) + O_(n) * 1 + X_(n) * x_(n + 1) by lem:parity(product)[E := E_(n), O := O_(n), X := X_(n), F := 1, P := w_(n + 1), Y := x_(n + 1)]; with[E_(n + 1) = E_(n) + O_(n) * w_(n + 1) by logic; with[O_(n + 1) = O_(n) + E_(n) * w_(n + 1) by logic; with[X_(n + 1) = X_(n) * x_(n + 1) by logic; V[1 * hw5, 1 * hw6, 1 * hw7, 1 * hw8]]]]]]]]]
  (tie) with[N <= N by V; with[(N <= N => E_(N) = O_(N) + X_(N)) by lem:parity(core tie)[n := N, N := N, x := x, w := w, E := E, O := O, X := X]; logic]]
  "core wall" ind[n; V[1 * h_1]; with[n <= N by V[1 * hi2]; with[E_(n) = O_(n) by logic; with[E_(n + 1) = E_(n) + O_(n) * w_(n + 1) by logic; with[O_(n + 1) = O_(n) + E_(n) * w_(n + 1) by logic; V[1 * hw3, 1 * hw4, 1 * hw2, w_(n + 1) * hw2]]]]]]
  (wall) with[N <= N by V; with[(N <= N => E_(N) = O_(N)) by lem:parity(core wall)[n := N, N := N, w := w, E := E, O := O]; logic]]
