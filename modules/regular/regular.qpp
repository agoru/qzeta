  core countbelow: n, a, H, Lp, q, m, kappa in NN, B, E, R, c, w in Exponent(n), Pr in Chamber(n, n), pi in Point(n), lambda in QQ>=0, (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i), Pr.N_(iota)_(i) = 0), (forall iota : Pr.op_(iota) = 0, Pr.om_(iota) = a + H), (forall iota : Pr.epsP_(iota) = 0, Pr.epsM_(iota) = w_(iota)), (forall iota : pi_(iota) = 1 / E_(iota)), (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), (forall X : E_(X) * R_(X) = q * w_(X)), Lp = q * m, (forall X : a + H + m * R_(X) <= B_(X)), lambda = (sum iota, w_(iota) / E_(iota)), lambda * Lp < kappa + 1 : 1 / 2^(kappa + n * (a + H)) <= (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X)))
  core span: n in NN, E in Exponent(n), Pr in Chamber(n, n), pi in Point(n), (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pr.N_(iota)_(i) = 0), (forall iota : pi_(iota) = 1 / E_(iota)), (forall X : 1 <= E_(X)) : forall j : exists yP, yM in Point(n) : (forall iota : pi_(iota) + pi_(iota) = 0 => yP_(iota) + yM_(iota) = 0), (forall x in Exponent(n) : x_(j) + (sum iota, yP_(iota) * (sum i, Pr.N_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, Pr.P_(iota)_(i) * x_(i))) = (sum iota, yP_(iota) * (sum i, Pr.P_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, Pr.N_(iota)_(i) * x_(i))))
  core face: n in NN, E in Exponent(n), Pr in Chamber(n, n), pi in Point(n), R in IntForms(1, n), (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pr.N_(iota)_(i) = 0), (forall iota : pi_(iota) = 1 / E_(iota)), (forall X : 1 <= E_(X)) : forall vP, vM in Point(n) : (forall iota : 0 < pi_(iota) => (sum i, Pr.P_(iota)_(i) * vP_(i)) + (sum i, Pr.N_(iota)_(i) * vM_(i)) = (sum i, Pr.N_(iota)_(i) * vP_(i)) + (sum i, Pr.P_(iota)_(i) * vM_(i))) => exists zP, zM in Point(1) : (sum l, zP_(l)) = (sum l, zM_(l)), (forall i : vP_(i) + (sum l, zM_(l) * R_(l)_(i)) = vM_(i) + (sum l, zP_(l) * R_(l)_(i)))
  core slope: n, q in NN, E in Exponent(n), R in IntForms(1, n), Pr in Chamber(n, n), (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pr.N_(iota)_(i) = 0), (forall iota : Pr.epsP_(iota) = 0), (forall iota : Pr.epsM_(iota) = 1), (forall l : forall j : E_(j) * R_(l)_(j) = q) : forall l : forall iota : (sum i, Pr.P_(iota)_(i) * R_(l)_(i)) + q * Pr.epsP_(iota) = (sum i, Pr.N_(iota)_(i) * R_(l)_(i)) + q * Pr.epsM_(iota)
  core base: n, A in NN, E, u0 in Exponent(n), Pr in Chamber(n, n), (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pr.N_(iota)_(i) = 0), (forall iota : Pr.op_(iota) = 0), (forall iota : Pr.om_(iota) = A), (forall X : 1 <= E_(X)), (forall X : u0_(X) = A) : forall iota : (sum i, Pr.P_(iota)_(i) * u0_(i)) + Pr.op_(iota) >= (sum i, Pr.N_(iota)_(i) * u0_(i)) + Pr.om_(iota)
  core vertex: r in NN, R in IntForms(1, r) : forall zP, zM in Point(1) : (forall i : (sum l, zP_(l) * R_(l)_(i)) = sum l, zM_(l) * R_(l)_(i)), (sum l, zP_(l)) = (sum l, zM_(l)) => forall l : zP_(l) = zM_(l)
  (above): n, r, L, a, kappa, O, K in NN, b in Exponent(n), B, E in Exponent(r), T in IntForms(n, r), G in Grid(n), Y in Moduli(n, r), S in Sizes(n, r), Ch in Chart(n), Q in QQ>0, (Y #sizes S #cap B #box b), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(r) : Y(u) = y => forall X : Q * y_(X)^(E_(X)) <= G(u)), 1 <= Q * 2^a, (forall X : 1 <= E_(X)), (forall X : L + 1 <= E_(X) * B_(X) + E_(X) + a), (Ch #carries G #join T #sizes S #cap B #level L #box b), (forall X : 1 <= sum j, T_(j)_(X)), kappa <= (sum iota, 1 / E_(iota)) * L, (sum iota, 1 / E_(iota) * (E_(iota) + a)) * (1 + (sum X, E_(X))) <= O, 2^O * (1 + O + (sum X, E_(X)))^r * (prod i in 1..r, i) * 2^(r + 1) <= K : (sum u <= b, iverson(G(u) <= 1 / 2^L)) <= 3^n * 2^(n * Ch.N) * K / 2^kappa
  fix (above) regularabove
  fix (above) regularchain
  fix (above) regularspline
  (below): n, r, a, H, L, Lp, q, m, kappa in NN, b, B, E, R, o in Exponent(n), T in IntForms(n, r), G in Grid(n), S, M in Sizes(n, n), Ch in Chart(n), Q in QQ>0, (Ch.F #sizes S #cap B #box b), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(n) : Ch.F(u) = y, (forall i : 0 < y_(i)) => G(u) <= Q * (sum X, prod j, y_(j)^(E_(j) * T_(j)_(X)))), Q <= 2^a, r <= 2^H, L <= Lp, (Ch #windows M #box b), (forall j : 1 <= E_(j)), (forall X : (sum j, T_(j)_(X)) = 1), (forall j : E_(j) * R_(j) = q * (sum X, T_(j)_(X))), Lp = q * m, (forall j : a + H + m * R_(j) <= B_(j)), (forall j : B_(j) + 1 <= Ch.N), (forall j : E_(j) * o_(j) <= a + H + (sum X, T_(j)_(X)) * Lp), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall z in Exponent(n) : M(u) = z => forall j : z_(j) * 2^(o_(j)) + 2^(Ch.N) <= b_(j) * 2^(o_(j))), (sum iota, (sum X, T_(iota)_(X)) / E_(iota)) * Lp < kappa + 1 : (1 / 2)^n * 2^(n * Ch.N) / 2^(kappa + n * (a + H)) <= (sum u <= b, iverson(G(u) <= 1 / 2^L))
  fix (below) regularbelow
  (pair): n, Lz, a, h, A in NN, q in NN>=1, K in Potential(n), rho in Weight(n), E, c in Exponent(n), R in IntForms(1, n), Pr, Pru in Chamber(n, n), C, Ci in QQ>0, (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pr.N_(iota)_(i) = 0), (forall iota : Pr.epsP_(iota) = 0), (forall iota : Pr.epsM_(iota) = 1), (forall iota : forall i : Pru.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pru.N_(iota)_(i) = 0), (forall iota : Pru.op_(iota) = 0), (forall iota : Pru.om_(iota) = A), (forall iota : Pru.epsP_(iota) = 0), (forall iota : Pru.epsM_(iota) = 1), (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), (forall l : forall j : E_(j) * R_(l)_(j) = q), (K #counted Pr #content c #by C #from Lz #depth a #plus h #box rho), (K #countedin Pru #content c #by Ci #from Lz #depth a #plus h #box rho), 1 <= Lz, (forall i : A + (sum l, R_(l)_(i)) + 1 <= h), (forall i : (sum l, R_(l)_(i)) <= a) : exists cp in QQ>0 : exists Cp in QQ>0 : (K #points (sum iota, 1 / E_(iota)) #multiplicity 1 #box rho #between cp #and Cp #from Lz #depth a #plus h)
  (chamber): n in NN, q in NN>=1, E, c in Exponent(n), R in IntForms(1, n), Pr in Chamber(n, n), (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pr.N_(iota)_(i) = 0), (forall iota : Pr.epsP_(iota) = 0), (forall iota : Pr.epsM_(iota) = 1), (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), (forall l : forall j : E_(j) * R_(l)_(j) = q) : (Pr #pair (sum iota, 1 / E_(iota)) #multiplicity 1 #content c)
  core tieline: prog(v_y, v_x, xi, c_y, c_x in QQ>=0, v_x = v_y, v_y <= xi, 2 * xi >= 1, 4 * v_y >= 1, c_y >= v_y, c_x >= v_x, c_x >= xi : c_y + c_x) = (3 / 4, 1)
  fix core tieline tieline.tie
  core tielinefirst: prog(v_y, v_x, xi, c_y, c_x in QQ>=0, xi = v_y, v_y <= v_x, 2 * xi >= 1, 4 * v_y >= 1, c_y >= v_y, c_x >= v_x, c_x >= xi : c_y + c_x) = (1, 1)
  fix core tielinefirst tieline.first
  core tielinesecond: prog(v_y, v_x, xi, c_y, c_x in QQ>=0, xi = v_x, v_x <= v_y, 2 * xi >= 1, 4 * v_y >= 1, c_y >= v_y, c_x >= v_x, c_x >= xi : c_y + c_x) = (1, 1)
  fix core tielinesecond tieline.second
  core twopivotswith: prog(v_x, v_y, v_t, xi_1, xi_2, e, c_x, c_y, c_t in QQ>=0, v_y = v_x, v_x <= e, v_t = v_x, v_x <= xi_1, v_t = v_y, v_y <= xi_2, xi_1 = xi_2, xi_1 <= e, c_x >= v_x, c_y >= v_y, c_y >= e, c_t >= v_t, c_t >= xi_1, c_t >= xi_2, 2 * xi_1 >= 1, 2 * xi_2 >= 1 : c_x + c_y + c_t) = (1, 1)
  fix core twopivotswith twopivots.with
  core twopivotswithout: prog(v_x, v_y, v_t, xi_1, xi_2, c_x, c_y, c_t in QQ>=0, v_t = v_x, v_x <= xi_1, v_t = v_y, v_y <= xi_2, c_x >= v_x, c_y >= v_y, c_t >= v_t, c_t >= xi_1, c_t >= xi_2, 2 * xi_1 >= 1, 2 * xi_2 >= 1 : c_x + c_y + c_t) = (1 / 2, 1)
  fix core twopivotswithout twopivots.without
  core cluster: kp, d, j in QQ>=0 : 1 + (1 + kp) * (d + 1) + kp * j = (d + 2 + kp * (j + 1)) + kp * d, 1 + (1 + kp) * (d + 1) = (d + 2) + kp * (d + 1)
  fix core cluster cluster.core
  core orbit: delta, c, h in QQ>0, k, j in NN : (delta / (2 * h))^k * (c * h / 2)^(k + j) = (delta / 2)^k * (c / 2)^(k + j) * h^j
  fix core orbit orbit.core
  core fullbranch: k, l in NN : 2 * (k + 1) + l * (k + 2) * (k + 1) + (k + 2) = (2 + 2 * (l + 1) * k + l * k^2) + (l + 1) * (k + 2)
  fix core fullbranch fullbranch.tie
  core fullshallow: k in NN, L in NN>=2, 1 <= k : 2 + 2 * L * k + L * k^2 < 2 * (k + 1)^L + k^2
  fix core fullshallow fullbranch.core
  core sawtooth: y in QQ>=0, l, L in NN : (y <= 1 / 2 => 2 * (y + 1) = 2 + 4 * max(y - 1 / 2, 0) + 2 * y), (1 / 2 <= y, y <= 1 => 2 * (y + 1) = 2 + 4 * max(y - 1 / 2, 0) + max(2 - 2 * y, 0)), 4 * (2^l / 2) * (2^L / 2^l) = 2^(L + 1), 6 * L + 1 = (3 * L + 1) + 3 * L, (L = 1 => 3 * L + 1 = 2 * 2^L), (2 <= L => 3 * L + 1 < 2 * 2^L)
  fix core sawtooth ex.sawtooth.check
  origin: ?{\text{cited: the value}\ \lambda=\sum_X1/E_X\ \text{of the program}\ P=\mathrm{diag}(E)\ \text{is the reciprocal of the Newton distance of the ideal of the powers}\ y_X^{E_X}\ \text{over the reals \cite[Theorem~1.3 with Proposition~4.12]{Lin2017}, and at}\ E=2\ \text{its Newton floor \cite[Lemmas~5.3 and 5.4 with Remark~(1)]{DenefHoornaert2001} at}\ p=2;\ \text{proved here: the counts from above and from below, with their certificates as formulas in}\ E,\ \text{and the counts}\ D=r+e\ \text{of the parameters, the rank and the zero directions of its instances}}

proof lem:regular
