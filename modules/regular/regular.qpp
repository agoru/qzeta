-- Q++ 0.2
module regular
uses pair, table

subsection sec:regular The regular row

-- The regular row: \(r\) members whose powers \(y_X^{E_X}\), \(E_X\ge1\), bound the model on both sides. Its program is
-- \(\mathrm{diag}(E)\), with the prices \(1/E_X\) and the value \(\lambda=\sum_X1/E_X\); every certificate is a formula
-- in \(E\), and the loss has the pair \((\sum_X1/E_X,1)\), at \(E=2\) the pair \((n/2,1)\) of a nondegenerate quadratic
-- on its chart.
lemma lem:regular [the regular row]
  core prices: r in NN, E, w, c in Exponent(r), Pr in Chamber(r, r), pi in Point(r), lambda in QQ>=0, (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i), Pr.N_(iota)_(i) = 0), (forall iota : Pr.epsP_(iota) = 0, Pr.epsM_(iota) = w_(iota)), (forall iota : pi_(iota) = 1 / E_(iota)), (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), lambda = (sum iota, w_(iota) / E_(iota)) : (pi #prices Pr #content c #value lambda)
  core above: n, r, L, a in NN, b in Exponent(n), B, E, c in Exponent(r), T in IntForms(n, r), G in Grid(n), Y in Moduli(n, r), S in Sizes(n, r), Ch in Chart(n), Q in QQ>0, (Y #sizes S #cap B #box b), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(r) : Y(u) = y => forall X : Q * y_(X)^(E_(X)) <= G(u)), 1 <= Q * 2^a, (forall X : 1 <= E_(X)), (forall X : L + 1 <= E_(X) * B_(X) + E_(X) + a), (Ch #carries G #join T #sizes S #cap B #level L #box b), (forall X : 1 <= sum j, T_(j)_(X)), Pr in Chamber(r, r), (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i), Pr.N_(iota)_(i) = 0), (forall iota : Pr.op_(iota) = E_(iota) + a, Pr.om_(iota) = 1), (forall iota : Pr.epsP_(iota) = 0, Pr.epsM_(iota) = 1), (forall X : c_(X) = 1) : (sum u <= b, iverson(G(u) <= 1 / 2^L)) <= 3^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X)))
  core countdiag: n, L, O, K, T, kappa in NN, b, E, w, c in Exponent(n), Pr in Chamber(n, n), (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i), Pr.N_(iota)_(i) = 0), (forall iota : Pr.epsP_(iota) = 0, Pr.epsM_(iota) = w_(iota)), (forall X : 1 <= E_(X)), (forall X : E_(X) <= T), (forall X : c_(X) = 1), kappa <= (sum iota, w_(iota) / E_(iota)) * L, (sum iota, 1 / E_(iota) * Pr.op_(iota)) * (1 + T) <= O, 2^O * (T + O + 1)^n * (prod i in 1..n, i) * 2^(n + 1) <= K : (sum u <= b, iverson((u #feasible Pr #level L)) / 2^(sum i, c_(i) * u_(i))) <= K / 2^kappa
  core countabove: r, a, L, kappa, O, K in NN, b, E, c in Exponent(r), Pr in Chamber(r, r), pi in Point(r), (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i), Pr.N_(iota)_(i) = 0), (forall iota : Pr.op_(iota) = E_(iota) + a, Pr.om_(iota) = 1), (forall iota : Pr.epsP_(iota) = 0, Pr.epsM_(iota) = 1), (forall iota : pi_(iota) = 1 / E_(iota)), (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), kappa <= (sum iota, 1 / E_(iota)) * L, (sum iota, 1 / E_(iota) * (E_(iota) + a)) * (1 + (sum X, E_(X))) <= O, 2^O * (1 + O + (sum X, E_(X)))^r * (prod i in 1..r, i) * 2^(r + 1) <= K : (sum s <= b, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) <= K / 2^kappa
