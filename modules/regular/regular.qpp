  (edgeBz) with[(sum j in 1..L, (c_(j) * x + v_(j))) >= (sum j in 1..L, p_(j)) by sum[V]; with[(sum j in 1..L, (c_(j) * x + v_(j))) = (sum j in 1..L, c_(j) * x) + (sum j in 1..L, v_(j)) by sum; with[(sum j in 1..L, c_(j) * x) = (sum j in 1..L, c_(j)) * x by sum; with[0 <= (sum h in 1..R, u_(h)) by sum[V]; with[(sum j in 1..L, p_(j)) = (sum j in 1..L, (c_(j) * x + v_(j))) by (V[1 * hw1], V[1 * h_9, 1 * hw2, 1 * hw3, sigma * h_2, 1 * hw4 | x * h_6]); with[(sum h in 1..R, u_(h)) = 0 by (V[1 * h_9, 1 * hw1, 1 * hw2, 1 * hw3, sigma * h_2 | x * h_6], V[1 * hw4]); with[1 <= L by V[1 * hp_k, 1 * h_5]; with[forall i in NN>=1 : i <= L => 2 * p_(i) <= c_(i) * x + v_(i) + p_(i) by with[2 * p_(i) <= c_(i) * x + v_(i) + p_(i) by V[1 * h_8(i)]; logic]; with[(sum i in 1..L, 2 * p_(i)) = 2 * (sum i in 1..L, p_(i)) by sum; with[(sum i in 1..L, (c_(i) * x + v_(i) + p_(i))) = (sum i in 1..L, (c_(i) * x + v_(i))) + (sum i in 1..L, p_(i)) by sum; with[(sum i in 1..L, 2 * p_(i)) = (sum i in 1..L, (c_(i) * x + v_(i) + p_(i))) by V[1 * hw10, 1 * hw5 | 1 * hw11]; with[forall i in NN>=1 : i <= L => 2 * p_(i) = c_(i) * x + v_(i) + p_(i) by fact:termtie[N := L, a_(i) := 2 * p_(i), b_(i) := c_(i) * x + v_(i) + p_(i)]; with[c_(k) * x + v_(k) = p_(k) by V[| 1 * hw13(k)]; with[forall i in NN>=1 : i <= L => 0 <= v_(i) by V[1 * h_3(i)]; with[c_(k) * x <= c_(k) * xL by V[1 * hw14, 1 * hw15(k) | 1 * h_7]; with[x <= xL by div[c_(k); V[1 * hw16]]; (V[| 1 * hw13(j)], with[u_(h) <= (sum h in 1..R, u_(h)) by term[h]; (V[1 * hw18, 1 * hw6], V[1 * h_4(h)])], V[1 * hw17])]]]]]]]]]]]]]]]]
  (wallB) with[(sum j in 1..L, p_(j)) = (sum j in 1..L, (c_(j) * xL + q_(j))) by sum[V]; with[(sum j in 1..L, (c_(j) * xL + q_(j))) = (sum j in 1..L, c_(j) * xL) + (sum j in 1..L, q_(j)) by sum; with[(sum j in 1..L, c_(j) * xL) = (sum j in 1..L, c_(j)) * xL by sum; V[xL * h_3, xL * h_4 | 1 * hw1, 1 * hw2, 1 * hw3, xs * h_4]]]]
  (pairA) face[with[n * x + (sum j in 1..L, v_(j)) + w + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j)) + s * pn by lem:capped(valueA); V[1 * hw1, 1 * h_6]]; x := xb, v_(j) := r_(j) by V[1 * hp(xb)], V[1 * h_1(j)], V[1 * h_5(j)], V[1 * h_4], with[n * xb + (sum j in 1..L, r_(j)) = (sum j in 1..L, p_(j)) + s * pn by lem:capped(pointA); V[1 * hw2, 1 * h_6]]; cn * x = pn, w = 0, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0) by lem:capped(onlyA)[n := n; n * x + (sum j in 1..L, v_(j)) + w + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) + s * pn by V[1 * h_13, 1 * h_6]]]
  (pairB) face[with[n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j)) + sigma * xs by lem:capped(valueB); V[1 * hw1, 1 * h_4]]; x := xs, v_(j) := r_(j) by V[1 * hp(xs)], V[1 * h_1(j)], V[1 * h_3(j)], V, with[n * xs + (sum j in 1..L, r_(j)) = (sum j in 1..L, p_(j)) + sigma * xs by lem:capped(pointB); V[1 * hw2, 1 * h_4]]; x = xs, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0) by lem:capped(onlyB)[n := n; n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) + sigma * xs by V[1 * h_10, 1 * h_4]]]
  (pairBz) face[with[n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j)) by lem:capped(valueBz); V[1 * hw1, 1 * h_3]]; v_(j) := p_(j) by V, V, V[1 * h_3]; x = 0, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0) by lem:capped(onlyBz)[n := n; n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) by V[1 * h_8, 1 * h_3]]]
  (pairAw) face[with[n * x + (sum j in 1..L, v_(j)) + w + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j)) + 0 * pn by lem:capped(valueA)[s := 0, t := 1; n = (sum j in 1..L, c_(j)) + 0 * cn by V[1 * h_4]; 0 + 1 = 1 by V]; V[1 * hw1, 1 * h_10]]; x := xb, v_(j) := r_(j) by V[1 * hp(xb)], V[1 * h_1(j)], V[1 * h_8(j)], V[1 * h_5], with[n * xb + (sum j in 1..L, r_(j)) = (sum j in 1..L, p_(j)) + 0 * xb by lem:capped(pointB)[sigma := 0, xs := xb; n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_4]]; V[1 * hw2, 1 * h_10]]; x := xL, v_(j) := q_(j) by V[1 * hp(xL)], V[1 * h_2(j)], V[1 * h_9(j)], V[cn * h_6, 1 * h_5], with[n * xL + (sum j in 1..L, q_(j)) = (sum j in 1..L, p_(j)) + 0 * xL by lem:capped(pointB)[sigma := 0, xs := xL, r_(j) := q_(j); n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_4]]; V[1 * hw3, 1 * h_10]]; (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), w = 0, (forall h in NN>=1 : h <= R => u_(h) = 0) by with[((forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), w = 0, (forall h in NN>=1 : h <= R => u_(h) = 0), pn <= cn * x, x <= xL) by lem:capped(edgeA)[n := n; n * x + (sum j in 1..L, v_(j)) + w + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) by V[1 * h_17, 1 * h_10]]; logic, logic, logic]; V[1 * h_6]]
  (pairBw) face[with[n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j)) + 0 * xs by lem:capped(valueB)[sigma := 0; n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_4]]; V[1 * hw1, 1 * h_9]]; x := xs, v_(j) := r_(j) by V[1 * hp(xs)], V[1 * h_1(j)], V[1 * h_7(j)], V, with[n * xs + (sum j in 1..L, r_(j)) = (sum j in 1..L, p_(j)) + 0 * xs by lem:capped(pointB)[sigma := 0; n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_4]]; V[1 * hw2, 1 * h_9]]; x := xL, v_(j) := q_(j) by V[1 * hp(xL)], V[1 * h_2(j)], V[1 * h_8(j)], V[1 * h_5], with[n * xL + (sum j in 1..L, q_(j)) = (sum j in 1..L, p_(j)) + 0 * xL by lem:capped(pointB)[sigma := 0, xs := xL, r_(j) := q_(j); n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_4]]; V[1 * hw3, 1 * h_9]]; (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0) by with[((forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0), xs <= x, x <= xL) by lem:capped(edgeB)[sigma := 0; n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_4]; n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) + 0 * xs by V[1 * h_15, 1 * h_9]]; logic, logic]; V[1 * h_5]]
  (pairBzw) face[with[n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j)) by lem:capped(valueBz)[sigma := 0; n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_3]]; V[1 * hw1, 1 * h_6]]; v_(j) := p_(j) by V, V, V[1 * h_6]; x := xL, v_(j) := q_(j) by V[1 * hp(xL)], V[1 * h_1(j)], V[1 * h_5(j)], with[n * xL + (sum j in 1..L, q_(j)) = (sum j in 1..L, p_(j)) + 0 * xL by lem:capped(pointB)[sigma := 0, xs := xL, r_(j) := q_(j); n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_3]]; V[1 * hw2, 1 * h_6]]; (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0) by with[((forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0), x <= xL) by lem:capped(edgeBz)[sigma := 0; n = (sum j in 1..L, c_(j)) + 0 by V[1 * h_3]; n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) by V[1 * h_11, 1 * h_6]]; logic, logic]; V[1 * hp(xL)]]

-- A binomial member \(Z=x_p^d-a\,x^e\), \(d=k+1\), under a loss at least \(q_0Z^2\): the readout replaces \(x_p\) by
-- the cancellation \(F=|Z|/x_p^k\), so that the sublevel points are counted by its sizes. With \(e_q\) the largest
-- exponent, the chamber \(ke_q\le k+1\) has the value \(\frac12\) and the chamber \(ke_q\ge k+2\) the value
-- \(\frac1{2d}+\frac1{2e_q}\); in each the prices, the multiplicity and the cover are formulas in \(k\), \(e_q\) and
-- the gaps \(\delta_Z=e_q-e_Z\).
lemma lem:binomial [a binomial member]
  core step: k in NN, x, z, h in QQ>=0, x = z + h : z^(k + 1) + x^k * h <= x^(k + 1)
  core rowa: n, k, N, L, A in NN, q0 in QQ>0, s, B in Exponent(n), x, y in Point(n), g, Zv in QQ>=0, (forall i : B_(i) = N), L <= 2 * N, g <= 1 / 2^L, q0 * Zv^2 <= g, 1 <= q0 * 2^A, (y #sized s #cap B) : forall p : ((x_(p)^(k + 1) <= Zv, y_(p) = x_(p)) or (Zv < x_(p)^(k + 1), y_(p) * x_(p)^k = Zv)) => L + 1 <= 2 * (k + 1) * s_(p) + 2 * (k + 1) + A
  core prodpow: r, k in NN, e in Exponent(r), f in Point(r) : (prod i, (f_(i)^(e_(i)))^k) = (prod i, f_(i)^(e_(i)))^k
  core powcongr: k in NN, u, v in QQ>=0, u = v : u^k = v^k
  core powzero: j in NN, u in QQ>=0, j = 0 : u^j = 1
  core low: k in NN, q0 in QQ>0, yp, xp, Zv, m in QQ>=0, ((xp^(k + 1) <= Zv, yp = xp) or (Zv < xp^(k + 1), yp * xp^k = Zv)), (Zv + m = xp^(k + 1) or Zv + xp^(k + 1) = m) : q0^(k + 1) * yp^(2 * (k + 1)) * (m^k)^2 <= 2^(2 * k) * (q0 * Zv^2)^(k + 1)
  core uncapped: r, N in NN, y in Point(r), s, B in Exponent(r), (forall i : B_(i) = N), (y #sized s #cap B) : forall X : s_(X) != N => 1 / 2^(s_(X) + 1) < y_(X)
  core prodsplit: r, k in NN, e in Exponent(r), x, y in Point(r) : forall p : e_(p) = 0 => (forall i : i < p => y_(i) = x_(i)) => (forall i : p < i => y_(i) = x_(i)) => (prod X, y_(X)^(2 * (k + 1) * iverson(X = p) + 2 * k * e_(X))) = y_(p)^(2 * (k + 1)) * (prod X, x_(X)^(e_(X)))^(2 * k)
  core sizedbp: r, c in NN, y in Point(r), s, B, T, Bp in Exponent(r), (forall X : Bp_(X) = s_(X) + c * T_(X)), (forall X : 1 <= T_(X) => 1 / 2^(s_(X) + 1) < y_(X)), (y #sized s #cap B) : (y #sized s #cap Bp)
  core rowb: r, k, N, L, A, beta in NN, a, q0 in QQ>0, e, s, B in Exponent(r), x, y in Point(r), g, Zv in QQ>=0, (forall i : B_(i) = N), L <= 2 * N, g <= 1 / 2^L, q0 * Zv^2 <= g, 1 <= q0 * 2^A, 1 <= a * 2^beta, (y #sized s #cap B) : forall p : e_(p) = 0 => (forall i : i < p => y_(i) = x_(i)) => (forall i : p < i => y_(i) = x_(i)) => ((x_(p)^(k + 1) <= Zv, y_(p) = x_(p)) or (Zv < x_(p)^(k + 1), y_(p) * x_(p)^k = Zv)) => (Zv + a * (prod Z, x_(Z)^(e_(Z))) = x_(p)^(k + 1) or Zv + x_(p)^(k + 1) = a * (prod Z, x_(Z)^(e_(Z)))) => (k + 1) * L + 1 <= 2 * (k + 1) * s_(p) + 2 * k * (sum Z, e_(Z) * s_(Z)) + 2 * (k + 1) + 2 * k * (sum Z, e_(Z)) + (k + 1) * A + 2 * k * beta + 2 * k
  core idx: r in NN, y in Point(r) : forall j : forall p : j <= p => p <= j => y_(j) = y_(p)
  core idxn: r in NN, u in Exponent(r) : forall j : forall p : j <= p => p <= j => u_(j) = u_(p)
  core quotient: k in NN, x, z, Zu, Zw, m, mw, Fu, Fw in QQ>=0, (Zu + m = x^(k + 1) or Zu + x^(k + 1) = m), (Zw + mw = z^(k + 1) or Zw + z^(k + 1) = mw), m = mw, Fu * x^k = Zu, Fw * z^k = Zw, Zu < x^(k + 1) : x <= z + Fu + Fw
  core cancel: N in NN, x, z in QQ>=0, 2^N * x = 2^N * z : x = z
  core twoq: k, N, uj, wj in NN, o, x, z, Zu, Zw, m, mw, Fu, Fw in QQ>=0, 2^N * x = uj + o, 2^N * z = wj + o, (Zu + m = x^(k + 1) or Zu + x^(k + 1) = m), (Zw + mw = z^(k + 1) or Zw + z^(k + 1) = mw), m = mw, Fu * x^k = Zu, Fw * z^k = Zw, Zu < x^(k + 1) : uj <= wj + 2^N * (Fu + Fw)
  core prodagree: r in NN, e in Exponent(r), x, y in Point(r) : forall p : e_(p) = 0 => (forall i : i < p => y_(i) = x_(i)) => (forall i : p < i => y_(i) = x_(i)) => (prod X, y_(X)^(e_(X))) = prod X, x_(X)^(e_(X))
  core mulcongr: c, u, v in QQ>=0, u = v : c * u = c * v
  core natcast: u, w in NN, o in QQ>=0, u = w : u + o = w + o
  core branchq: k, N, L, up in NN, o, g, Zv, xp, yp in QQ>=0, 2^N * xp = up + o, g + 2 * iverson(((up + o) / 2^N)^(k + 1) <= Zv) <= 1 / 2^L, ((xp^(k + 1) <= Zv, yp = xp) or (Zv < xp^(k + 1), yp * xp^k = Zv)) : Zv < xp^(k + 1), yp * xp^k = Zv
  core branchx: k, N, L, up in NN, o, g, Zv, xp, yp in QQ>=0, 2^N * xp = up + o, g + 2 * iverson(Zv < ((up + o) / 2^N)^(k + 1)) <= 1 / 2^L, ((xp^(k + 1) <= Zv, yp = xp) or (Zv < xp^(k + 1), yp * xp^k = Zv)) : xp^(k + 1) <= Zv, yp = xp
  core chartq: n, k, N, L in NN, a in QQ>0, o in QQ>=0, e, b in Exponent(n), G, Zf in Grid(n), Xm, Y in Moduli(n, n), S in Sizes(n, n), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall x in Point(n) : Xm(u) = x => forall i : 2^N * x_(i) = u_(i) + o) : forall p : e_(p) = 0 => (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall x in Point(n) : Xm(u) = x => (Zf(u) + a * (prod Z, x_(Z)^(e_(Z))) = x_(p)^(k + 1) or Zf(u) + x_(p)^(k + 1) = a * (prod Z, x_(Z)^(e_(Z))))) => (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall x in Point(n) : Xm(u) = x => forall y in Point(n) : Y(u) = y => (forall i : i < p => y_(i) = x_(i)), (forall i : p < i => y_(i) = x_(i)), ((x_(p)^(k + 1) <= Zf(u), y_(p) = x_(p)) or (Zf(u) < x_(p)^(k + 1), y_(p) * x_(p)^k = Zf(u)))) => forall j : forall u, w in Exponent(n) : (forall i : iverson(i = p) < iverson(j = p) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) + 2 * iverson(((u_(p) + o) / 2^N)^(k + 1) <= Zf(u)) <= 1 / 2^L, G(w) + 2 * iverson(((w_(p) + o) / 2^N)^(k + 1) <= Zf(w)) <= 1 / 2^L => forall s in Exponent(n) : S(u) = s, S(w) = s => forall y in Point(n) : Y(u) = y => forall z in Point(n) : Y(w) = z => u_(j) <= w_(j) + 2^N * (y_(j) + z_(j))
