-- A tie of two sums of masses whose terms are bounded one way is a tie term by term: if \(a_i\le b_i\) for
-- \(1\le i\le N\) and \(\sum_ia_i=\sum_ib_i\), then \(a_i=b_i\) for every \(i\).
cit fact:termtie [a tie of sums bounded term by term]
  mathlib: Finset.sum_eq_sum_iff_of_le (Mathlib.Algebra.Order.BigOperators.Group.Finset)
  core: N in NN>=1, a_(1..N), b_(1..N) in QQ>0, (forall i in NN>=1 : i <= N => a_(i) <= b_(i)), (sum i in 1..N, a_(i)) = (sum i in 1..N, b_(i)) : forall i in NN>=1 : i <= N => a_(i) = b_(i)
  fix core termtie.core
  neqfix core termtie.untied
  neqfix core termtie.unbounded


-- The program of a cluster with a cap, one row \(c_jx+v_j\ge p_j\) per form, is a fractional knapsack: the forms are
-- taken in order until the content is spent, the next one in a fraction (A) or up to the cap (B). Off the walls the
-- value \(l\) is attained at one point and the pair is \((l,1)\); on a wall the points of the value are the edge
-- between two explicit ends and the pair is \((l,2)\).
lemma lem:capped [the program of a cluster with a cap]
  (valueA): L, R in NN, n, cn, pn in QQ>0, s, t in QQ>=0, c_(1..L), p_(1..L) in QQ>0, x, w in QQ>=0, v_(1..L), u_(1..R) in QQ>=0, n = (sum j in 1..L, c_(j)) + s * cn, s + t = 1, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) >= p_(j)), cn * x + w >= pn : n * x + (sum j in 1..L, v_(j)) + w + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j)) + s * pn
  fix (valueA) capped.valueA
  (valueB): L, R in NN, n, xs in QQ>0, sigma in QQ>=0, c_(1..L), p_(1..L) in QQ>0, x in QQ>=0, v_(1..L), u_(1..R) in QQ>=0, n = (sum j in 1..L, c_(j)) + sigma, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) >= p_(j)), x >= xs : n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j)) + sigma * xs
  fix (valueB) capped.valueB
  (valueBz): L, R in NN, n in QQ>0, sigma in QQ>=0, c_(1..L), p_(1..L) in QQ>0, x in QQ>=0, v_(1..L), u_(1..R) in QQ>=0, n = (sum j in 1..L, c_(j)) + sigma, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) >= p_(j)) : n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) >= (sum j in 1..L, p_(j))
  fix (valueBz) capped.valueBz
  (pointA): L in NN, n, cn, pn, xb in QQ>0, s in QQ>=0, c_(1..L), p_(1..L) in QQ>0, r_(1..L) in QQ>=0, n = (sum j in 1..L, c_(j)) + s * cn, pn = cn * xb, (forall j in NN>=1 : j <= L => p_(j) = c_(j) * xb + r_(j)) : n * xb + (sum j in 1..L, r_(j)) = (sum j in 1..L, p_(j)) + s * pn
  fix (pointA) capped.pointA
  (pointB): L in NN, n in QQ>0, xs, sigma in QQ>=0, c_(1..L), p_(1..L) in QQ>0, r_(1..L) in QQ>=0, n = (sum j in 1..L, c_(j)) + sigma, (forall j in NN>=1 : j <= L => p_(j) = c_(j) * xs + r_(j)) : n * xs + (sum j in 1..L, r_(j)) = (sum j in 1..L, p_(j)) + sigma * xs
  fix (pointB) capped.pointB
  fix (pointB) capped.pointBwall
  fix (pointB) capped.pointBzero
  fix (pointB) capped.gmunit.tie
  fix (pointB) capped.silentpair.tie
  (tie): L in NN, n, cn, pn, xb, xL in QQ>0, c_(1..L), p_(1..L) in QQ>0, r_(1..L), q_(1..L) in QQ>=0, n = (sum j in 1..L, c_(j)), pn = cn * xb, xb < xL, (forall j in NN>=1 : j <= L => p_(j) = c_(j) * xb + r_(j)), (forall j in NN>=1 : j <= L => p_(j) = c_(j) * xL + q_(j)) : n * xb + (sum j in 1..L, r_(j)) = (sum j in 1..L, p_(j)), n * xL + (sum j in 1..L, q_(j)) = (sum j in 1..L, p_(j)), cn * xL > pn
  fix (tie) capped.tie
  (onlyA): L, R in NN, n, cn, pn, s, t in QQ>0, c_(1..L), p_(1..L) in QQ>0, x, w in QQ>=0, v_(1..L), u_(1..R) in QQ>=0, n = (sum j in 1..L, c_(j)) + s * cn, s + t = 1, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) >= p_(j)), cn * x + w >= pn, n * x + (sum j in 1..L, v_(j)) + w + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) + s * pn : cn * x = pn, w = 0, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0)
  fix (onlyA) capped.onlyA
  fix (onlyA) capped.gmunit.above
  fix (onlyA) capped.silentpair.above
  (edgeA): L, R in NN, k in NN>=1, n, cn, pn, xL in QQ>0, c_(1..L), p_(1..L) in QQ>0, x, w in QQ>=0, v_(1..L), u_(1..R) in QQ>=0, k <= L, n = (sum j in 1..L, c_(j)), c_(k) * xL = p_(k), (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) >= p_(j)), cn * x + w >= pn, n * x + (sum j in 1..L, v_(j)) + w + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) : (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), w = 0, (forall h in NN>=1 : h <= R => u_(h) = 0), pn <= cn * x, x <= xL
  fix (edgeA) capped.edgeA
  (onlyB): L, R in NN, n, xs, sigma in QQ>0, c_(1..L), p_(1..L) in QQ>0, x in QQ>=0, v_(1..L), u_(1..R) in QQ>=0, n = (sum j in 1..L, c_(j)) + sigma, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) >= p_(j)), x >= xs, n * x + (sum j in 1..L, v_(j)) + (sum h in 1..R, u_(h)) = (sum j in 1..L, p_(j)) + sigma * xs : x = xs, (forall j in NN>=1 : j <= L => c_(j) * x + v_(j) = p_(j)), (forall h in NN>=1 : h <= R => u_(h) = 0)
  fix (onlyB) capped.onlyB
  fix (onlyB) capped.capfive.above
  fix (onlyB) capped.lsrungprog.model
