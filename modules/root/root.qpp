  "core pivotsRead" chain[(sum a, (sum b, Q_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) * (sum c, D_(a)_(c) * x_(c))) = (sum a, (sum b, Q_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a)) * (sum c, D_(a)_(c) * x_(c)))) by eq; = (sum b, (sum a, Q_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a)) * (sum c, D_(a)_(c) * x_(c)))) by eq; = (sum b, (sum a, Q_(i)_(b) * ((sum d, R_(b)_(d) * nuD_(d)_(a)) * (sum c, D_(a)_(c) * x_(c))))) by eq; = (sum b, Q_(i)_(b) * (sum a, (sum d, R_(b)_(d) * nuD_(d)_(a)) * (sum c, D_(a)_(c) * x_(c)))) by eq; = (sum b, Q_(i)_(b) * (sum a, (sum d, R_(b)_(d) * nuD_(d)_(a) * (sum c, D_(a)_(c) * x_(c))))) by eq; = (sum b, Q_(i)_(b) * (sum d, (sum a, R_(b)_(d) * nuD_(d)_(a) * (sum c, D_(a)_(c) * x_(c))))) by eq; = (sum b, Q_(i)_(b) * (sum d, (sum a, R_(b)_(d) * (nuD_(d)_(a) * (sum c, D_(a)_(c) * x_(c)))))) by eq; = (sum b, Q_(i)_(b) * (sum d, R_(b)_(d) * (sum a, nuD_(d)_(a) * (sum c, D_(a)_(c) * x_(c))))) by eq; = (sum b, Q_(i)_(b) * (sum d, R_(b)_(d) * x_(d))) by eq]
  "core pivotsInject" with[forall i : forall x in Exponent(n) : (sum a, (sum b, nuP_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) * (sum c, D_(a)_(c) * x_(c))) = (sum b, nuP_(i)_(b) * (sum d, R_(b)_(d) * x_(d))) by lem:count(core pivotsRead)[n := n, D := D, R := R, nuD := nuD, Q := nuP]; with[forall i : forall x in Exponent(n) : (sum a, (sum b, nuM_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) * (sum c, D_(a)_(c) * x_(c))) = (sum b, nuM_(i)_(b) * (sum d, R_(b)_(d) * x_(d))) by lem:count(core pivotsRead)[n := n, D := D, R := R, nuD := nuD, Q := nuM]; chain[x_(i) + (sum a, nuM_(i)_(a) * (sum b, (D_(a)_(b) + R_(a)_(b)) * x_(b))) = x_(i) + (sum a, nuM_(i)_(a) * (sum b, (D_(a)_(b) * x_(b) + R_(a)_(b) * x_(b)))) by eq; = x_(i) + (sum a, nuM_(i)_(a) * ((sum b, D_(a)_(b) * x_(b)) + (sum b, R_(a)_(b) * x_(b)))) by eq; = x_(i) + (sum a, (nuM_(i)_(a) * (sum b, D_(a)_(b) * x_(b)) + nuM_(i)_(a) * (sum b, R_(a)_(b) * x_(b)))) by eq; = x_(i) + ((sum a, nuM_(i)_(a) * (sum b, D_(a)_(b) * x_(b))) + (sum a, nuM_(i)_(a) * (sum b, R_(a)_(b) * x_(b)))) by eq; = x_(i) + ((sum a, (sum b, nuP_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) * (sum c, D_(a)_(c) * x_(c))) + (sum a, nuM_(i)_(a) * (sum b, R_(a)_(b) * x_(b)))) by eq; = x_(i) + ((sum b, nuP_(i)_(b) * (sum d, R_(b)_(d) * x_(d))) + (sum a, nuM_(i)_(a) * (sum b, R_(a)_(b) * x_(b)))) by eq; = x_(i) + (sum b, nuM_(i)_(b) * (sum d, R_(b)_(d) * x_(d))) + (sum a, nuP_(i)_(a) * (sum b, R_(a)_(b) * x_(b))) by eq; = x_(i) + (sum a, (sum b, nuM_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) * (sum c, D_(a)_(c) * x_(c))) + (sum a, nuP_(i)_(a) * (sum b, R_(a)_(b) * x_(b))) by eq; = (sum a, nuD_(i)_(a) * (sum c, D_(a)_(c) * x_(c))) + (sum a, (sum b, nuM_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) * (sum c, D_(a)_(c) * x_(c))) + (sum a, nuP_(i)_(a) * (sum b, R_(a)_(b) * x_(b))) by eq; = (sum a, (nuD_(i)_(a) * (sum c, D_(a)_(c) * x_(c)) + (sum b, nuM_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) * (sum c, D_(a)_(c) * x_(c)))) + (sum a, nuP_(i)_(a) * (sum b, R_