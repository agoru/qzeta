  "core simplexPoints" logic[with[(sum i, P_(iota)_(i) * u_(i)) = (sum i, P_(iota)_(i) * u0_(i)) + sum l, x_(l) * (sum i, P_(iota)_(i) * R_(l)_(i)) by lem:count(core combination)[n := n, r := r, a := P_(iota), u0 := u0, u := u, R := R, x := x]; with[(sum i, N_(iota)_(i) * u_(i)) = (sum i, N_(iota)_(i) * u0_(i)) + sum l, x_(l) * (sum i, N_(iota)_(i) * R_(l)_(i)) by lem:count(core combination)[n := n, r := r, a := N_(iota), u0 := u0, u := u, R := R, x := x]; with[forall l : x_(l) * ((sum i, P_(iota)_(i) * R_(l)_(i)) + q * epsP_(iota)) >= x_(l) * ((sum i, N_(iota)_(i) * R_(l)_(i)) + q * epsM_(iota)) by logic[mono]; with[(sum l, x_(l) * ((sum i, P_(iota)_(i) * R_(l)_(i)) + q * epsP_(iota))) >= sum l, x_(l) * ((sum i, N_(iota)_(i) * R_(l)_(i)) + q * epsM_(iota)) by sum[V[1 * hw3(l)]]; with[(sum l, x_(l) * ((sum i, P_(iota)_(i) * R_(l)_(i)) + q * epsP_(iota))) = (sum l, x_(l) * (sum i, P_(iota)_(i) * R_(l)_(i))) + (sum l, q * epsP_(iota) * x_(l)) by sum[V]; with[(sum l, x_(l) * ((sum i, N_(iota)_(i) * R_(l)_(i)) + q * epsM_(iota))) = (sum l, x_(l) * (sum i, N_(iota)_(i) * R_(l)_(i))) + (sum l, q * epsM_(iota) * x_(l)) by sum[V]; with[q * epsP_(iota) * (sum l, x_(l)) = sum l, q * epsP_(iota) * x_(l) by sum[V]; with[q * epsM_(iota) * (sum l, x_(l)) = sum l, q * epsM_(iota) * x_(l) by sum[V]; with[q * epsP_(iota) * (sum l, x_(l)) = q * epsP_(iota) * m by eq; with[q * epsM_(iota) * (sum l, x_(l)) = q * epsM_(iota) * m by eq; with[epsP_(iota) * L = epsP_(iota) * (q * m) by eq; with[epsM_(iota) * L = epsM_(iota) * (q * m) by eq; V]]]]]]]]]]]]]
