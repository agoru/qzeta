-- Q++ 0.2
module root
uses theory

subsection sec:root The certificate and the count

-- A feasible point that is strict at every index.
cit fact:strict [a point strict at every index]
  (1): n in NN, P in Forms(n, n) : exists z in Point(n) : (forall i : (sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j)), (forall i : (sum j, P_(j)_(i) * z_(j)) < z_(i) + sum j, P_(i)_(j) * z_(j))
  doi: 10.1515/9781400881987-002
  stmt: Theorem 5
  fix (1) strict
  origin: ?{\text{cited: \cite[Theorem~5]{Tucker1956}, at the skew-symmetric matrix}\ P-P^{\mathsf T}\text{; the source takes real entries and notes that the rational field, or any ordered field, serves equally well}}

-- A square table of positive forms is a program that is its own dual: a feasible point ties every row of its support
-- (complementary slackness), and a point strict outside its support, which Tucker's theorem gives \cref{fact:strict},
-- fixes one partition of the indices, the optimal partition.
lemma lem:selfdual [a table of forms and its transpose]
  core diagonal: n in NN, P in Forms(n, n), z in Point(n) : (sum i, z_(i) * (sum j, P_(i)_(j) * z_(j))) = sum j, z_(j) * (sum i, P_(i)_(j) * z_(i))
  core termwise: n in NN, a, b in Point(n), (forall i : b_(i) <= a_(i)), (sum i, a_(i)) = sum i, b_(i) : forall i : a_(i) = b_(i)
  core ties: n in NN, P in Forms(n, n), z in Point(n), (forall i : (sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j)) : forall i : z_(i) * (sum j, P_(i)_(j) * z_(j)) = z_(i) * (sum j, P_(j)_(i) * z_(j))
  (1): n in NN, P in Forms(n, n), z in Point(n), (forall i : (sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j)) : forall i : z_(i) * (sum j, P_(i)_(j) * z_(j)) = z_(i) * (sum j, P_(j)_(i) * z_(j))
  fix (1) selfdual
  (2): n in NN, P in Forms(n, n), z in Point(n), (forall i : (sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j)) : forall i : 0 < z_(i) => (sum j, P_(i)_(j) * z_(j)) = sum j, P_(j)_(i) * z_(j)
  fix (2) selfdualstrict
  (3): n in NN, P in Forms(n, n) : exists z in Point(n) : (forall i : (sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j)), (forall i : 0 < z_(i) => (sum j, P_(i)_(j) * z_(j)) = sum j, P_(j)_(i) * z_(j)), (forall i : z_(i) = 0 => (sum j, P_(j)_(i) * z_(j)) < sum j, P_(i)_(j) * z_(j))
  fix (3) partition
  (support): n in NN, P in Forms(n, n), z, w in Point(n), (forall i : (sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j)), (forall i : (sum j, P_(i)_(j) * w_(j)) >= sum j, P_(j)_(i) * w_(j)), (forall i : w_(i) = 0 => (sum j, P_(j)_(i) * w_(j)) < sum j, P_(i)_(j) * w_(j)) : forall i : 0 < z_(i) => 0 < w_(i)
  fix (support) support
  (unique): n in NN, P in Forms(n, n), z, w in Point(n), (forall i : (sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j)), (forall i : z_(i) = 0 => (sum j, P_(j)_(i) * z_(j)) < sum j, P_(i)_(j) * z_(j)), (forall i : (sum j, P_(i)_(j) * w_(j)) >= sum j, P_(j)_(i) * w_(j)), (forall i : w_(i) = 0 => (sum j, P_(j)_(i) * w_(j)) < sum j, P_(i)_(j) * w_(j)) : (forall i : 0 < z_(i) => 0 < w_(i)), (forall i : 0 < w_(i) => 0 < z_(i))
  fix (unique) unique
  origin: ?{\text{form proved: complementary slackness, as a tie of positive sums that is dominated term by term; the statements are classical, and the partition of (3) is that of \cite[Theorems~5 and~7]{Tucker1956}; (support) and (unique), that this partition is the same at every point strict outside its support (the optimal partition of a linear program), form proved by (2) at the sum of two feasible points}}

-- Read by rows and by columns, \(\sum_iz_i\sum_jP_{ij}z_j\) is one sum. At a feasible point each of its terms is at
-- least the term of the transpose, and two sums that tie, one dominated term by term, tie term by term (core ties):
-- this is (1), and (2) divides by \(z_i>0\). The point of \cref{fact:strict} gives (3), and (support) and (unique)
-- apply (2) at the sum of two feasible points.
proof lem:selfdual
  "core diagonal" chain[(sum i, z_(i) * (sum j, P_(i)_(j) * z_(j))) = sum i, sum j, z_(i) * (P_(i)_(j) * z_(j)) by sum[sum[V]]; = sum j, sum i, z_(i) * (P_(i)_(j) * z_(j)) by sum[V]; = sum j, z_(j) * (sum i, P_(i)_(j) * z_(i)) by sum[sum[V[0]]]]
  "core termwise" with[exists s in Point(n) : forall i : a_(i) = b_(i) + s_(i) by take[s_(i) := max(a_(i) - b_(i), 0); V[0]]; logic[with[(sum i, a_(i)) = (sum i, b_(i)) + sum i, s_(i) by chain[(sum i, a_(i)) = sum i, (b_(i) + s_(i)) by sum[V]; = (sum i, b_(i)) + sum i, s_(i) by sum[V]]; with[(sum i, s_(i)) = 0 by V[1 * h_2, 1 * hw2]; with[s_(i) <= sum l, s_(l) by term[i]; with[a_(i) = b_(i) + s_(i) by logic; V]]]]]]
  "core ties" with[exists A in Point(n) : forall i : A_(i) = z_(i) * (sum j, P_(i)_(j) * z_(j)) by take[A_(i) := z_(i) * (sum j, P_(i)_(j) * z_(j)); V]; with[exists B in Point(n) : forall i : B_(i) = z_(i) * (sum j, P_(j)_(i) * z_(j)) by take[B_(i) := z_(i) * (sum j, P_(j)_(i) * z_(j)); V]; logic[with[forall l : B_(l) <= A_(l) by logic[with[z_(l) * (sum j, P_(j)_(l) * z_(j)) <= z_(l) * (sum j, P_(l)_(j) * z_(j)) by mono; V]]; with[(sum i, A_(i)) = sum i, B_(i) by chain[(sum i, A_(i)) = sum i, z_(i) * (sum j, P_(i)_(j) * z_(j)) by sum[V]; = sum i, z_(i) * (sum j, P_(j)_(i) * z_(j)) by lem:selfdual(core diagonal)[n := n, P := P, z := z]; = sum i, B_(i) by sum[V]]; with[forall i : A_(i) = B_(i) by lem:selfdual(core termwise)[n := n, a := A, b := B]; with[A_(i) = z_(i) * (sum j, P_(i)_(j) * z_(j)) by logic; with[B_(i) = z_(i) * (sum j, P_(j)_(i) * z_(j)) by logic; with[A_(i) = B_(i) by logic; V[1 * hw10, 1 * hw11, 1 * hw12]]]]]]]]]]
  (1) lem:selfdual(core ties)[n := n, P := P, z := z]
  (2) with[z_(i) * (sum j, P_(i)_(j) * z_(j)) = z_(i) * (sum j, P_(j)_(i) * z_(j)) by lem:selfdual(1)[n := n, P := P, z := z]; logic[cases[(sum j, P_(i)_(j) * z_(j)) <= sum j, P_(j)_(i) * z_(j); V; with[z_(i) * (sum j, P_(j)_(i) * z_(j)) < z_(i) * (sum j, P_(i)_(j) * z_(j)) by mono; V]]]]
  (3) with[exists z in Point(n) : (forall i : (sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j)), (forall i : (sum j, P_(j)_(i) * z_(j)) < z_(i) + sum j, P_(i)_(j) * z_(j)) by fact:strict(1)[n := n, P := P]; logic[take[z := z; (logic, lem:selfdual(2)[n := n, P := P, z := z], logic[V])]]]
  (support) with[exists s in Point(n) : forall j : s_(j) = z_(j) + w_(j) by take[s_(j) := z_(j) + w_(j); V]; with[forall l : (sum j, P_(l)_(j) * s_(j)) = (sum j, P_(l)_(j) * z_(j)) + sum j, P_(l)_(j) * w_(j) by logic[chain[(sum j, P_(l)_(j) * s_(j)) = sum j, (P_(l)_(j) * z_(j) + P_(l)_(j) * w_(j)) by sum[with[s_(j) = z_(j) + w_(j) by logic; V]]; = (sum j, P_(l)_(j) * z_(j)) + sum j, P_(l)_(j) * w_(j) by sum[V]]]; with[forall l : (sum j, P_(j)_(l) * s_(j)) = (sum j, P_(j)_(l) * z_(j)) + sum j, P_(j)_(l) * w_(j) by logic[chain[(sum j, P_(j)_(l) * s_(j)) = sum j, (P_(j)_(l) * z_(j) + P_(j)_(l) * w_(j)) by sum[with[s_(j) = z_(j) + w_(j) by logic; V]]; = (sum j, P_(j)_(l) * z_(j)) + sum j, P_(j)_(l) * w_(j) by sum[V]]]; with[forall i : (sum j, P_(i)_(j) * s_(j)) >= sum j, P_(j)_(i) * s_(j) by logic[with[(sum j, P_(i)_(j) * s_(j)) = (sum j, P_(i)_(j) * z_(j)) + sum j, P_(i)_(j) * w_(j) by logic; with[(sum j, P_(j)_(i) * s_(j)) = (sum j, P_(j)_(i) * z_(j)) + sum j, P_(j)_(i) * w_(j) by logic; with[(sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j) by logic; with[(sum j, P_(i)_(j) * w_(j)) >= sum j, P_(j)_(i) * w_(j) by logic; V[1 * h_1(i_2), 1 * h_2(i_2), 1 * hw6(i_2) | 1 * hw2(i_2)]]]]]]; with[forall i : 0 < s_(i) => (sum j, P_(i)_(j) * s_(j)) = sum j, P_(j)_(i) * s_(j) by lem:selfdual(2)[n := n, P := P, z := s]; logic[with[s_(i) = z_(i) + w_(i) by logic; with[0 < s_(i) by V[1 * hi1 | 1 * hw16]; with[(sum j, P_(i)_(j) * s_(j)) = sum j, P_(j)_(i) * s_(j) by logic; with[(sum j, P_(i)_(j) * s_(j)) = (sum j, P_(i)_(j) * z_(j)) + sum j, P_(i)_(j) * w_(j) by logic; with[(sum j, P_(j)_(i) * s_(j)) = (sum j, P_(j)_(i) * z_(j)) + sum j, P_(j)_(i) * w_(j) by logic; with[(sum j, P_(i)_(j) * z_(j)) >= sum j, P_(j)_(i) * z_(j) by logic; with[(sum j, P_(i)_(j) * w_(j)) >= sum j, P_(j)_(i) * w_(j) by logic; with[(sum j, P_(i)_(j) * w_(j)) = sum j, P_(j)_(i) * w_(j) by V; cases[0 < w_(i); V[1 * hc1]; with[w_(i) = 0 by V; with[(sum j, P_(j)_(i) * w_(j)) < sum j, P_(i)_(j) * w_(j) by logic; V]]]]]]]]]]]]]]]]]
  (unique) (lem:selfdual(support)[n := n, P := P, z := z, w := w], lem:selfdual(support)[n := n, P := P, z := w, w := z])

-- Rank and nullity over \(\Q\): rows that span \(\Q^m\) contain a basis that extends a basis of the rows priced by
-- \(\pi\), with at most \(d\) rows outside them when their kernel lies in the directions of \(d+1\) points; its inverse
-- is a balance.
cit fact:basis [rank and nullity, on a basis of rows]
  mathlib: LinearMap.finrank_range_add_finrank_ker (Mathlib.LinearAlgebra.FiniteDimensional.Lemmas)
  core: m, k, r, d in NN, P, N in IntForms(k, m), pi, rho in Point(k), W in IntForms(r, m), r = d + 1, (forall j : exists yP, yM in Point(k) : (forall iota : pi_(iota) + rho_(iota) = 0 => yP_(iota) + yM_(iota) = 0), (forall x in Exponent(m) : x_(j) + (sum iota, yP_(iota) * (sum i, N_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, P_(iota)_(i) * x_(i))) = (sum iota, yP_(iota) * (sum i, P_(iota)_(i) * x_(i))) + (sum iota, yM_(iota) * (sum i, N_(iota)_(i) * x_(i))))), (forall vP, vM in Point(m) : (forall iota : 0 < pi_(iota) => (sum i, P_(iota)_(i) * vP_(i)) + (sum i, N_(iota)_(i) * vM_(i)) = (sum i, N_(iota)_(i) * vP_(i)) + (sum i, P_(iota)_(i) * vM_(i))) => exists zP, zM in Point(r) : (sum l, zP_(l)) = (sum l, zM_(l)), (forall i : vP_(i) + (sum l, zM_(l) * W_(l)_(i)) = vM_(i) + (sum l, zP_(l) * W_(l)_(i)))) : exists zeta in IntForms(m, k) : exists h in Exponent(m) : exists nuP, nuM in Forms(m, m) : (forall alpha : (sum iota, zeta_(alpha)_(iota)) = 1), (forall alpha : h_(alpha) <= 1), (forall alpha : forall iota : 0 < zeta_(alpha)_(iota), h_(alpha) = 0 => 0 < pi_(iota)), (forall alpha : forall iota : 0 < zeta_(alpha)_(iota), h_(alpha) = 1 => 0 < rho_(iota)), (sum alpha, h_(alpha)) <= d, (forall i : forall x in Exponent(m) : x_(i) + (sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * x_(j))) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * x_(j))))) = sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * x_(j))) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * x_(j)))))

-- Barycentric coordinates over \(\Q\): affinely independent points have affine coordinate functions, each a balance.
cit fact:dual [barycentric coordinates of affinely independent points]
  mathlib: Matrix.mulVec_surjective_iff_rank_eq_card (Mathlib.LinearAlgebra.Matrix.Rank)
  core: m, r in NN, R in IntForms(r, m), (forall zP, zM in Point(r) : (forall i : (sum l, zP_(l) * R_(l)_(i)) = sum l, zM_(l) * R_(l)_(i)), (sum l, zP_(l)) = (sum l, zM_(l)) => forall l : zP_(l) = zM_(l)) : exists psiP, psiM in Forms(r, m) : exists gP, gM in Point(r) : forall kk : forall z in Exponent(r) : (sum l, z_(l) * ((sum i, psiP_(kk)_(i) * R_(l)_(i)) + gP_(kk))) = (sum l, z_(l) * ((sum i, psiM_(kk)_(i) * R_(l)_(i)) + gM_(kk))) + z_(kk)

cit fact:floor [the floor of a mass]
  mathlib: Nat.floor_le, Nat.lt_floor_add_one (Mathlib.Data.Rat.Floor)
  core: x in QQ>=0 : exists k in NN : k <= x, x < k + 1

-- A nonsingular M-matrix \(\mathrm{diag}(d)-R\), with a point strict at every row, has an inverse of positive forms,
-- written as a tie of positive sums.
cit fact:mmatrix [a positive inverse from a strict readout]
  (1): n in NN, d, xh in Point(n), R in Forms(n, n), (forall a : (sum b, R_(a)_(b) * xh_(b)) < d_(a) * xh_(a)) : exists nu in Forms(n, n) : forall i : forall c : nu_(i)_(c) * d_(c) = iverson(i = c) + (sum b, nu_(i)_(b) * R_(b)_(c))
  doi: 10.21136/cmj.1962.100526
  stmt: Theorem (4,3)
  fix (1) mmatrix
  origin: ?{\text{cited: \cite[Theorem~(4,3), $1^\circ\Rightarrow11^\circ$]{FiedlerPtak1962}, at the matrix}\ \mathrm{diag}(d)-R\ \text{of the class}\ \mathbf Z\text{, its inverse written entrywise as a tie of positive sums,}\ \nu\,\mathrm{diag}(d)=I+\nu R\text{, since a left inverse of a square table is its inverse; the source takes real entries, and at rational entries the inverse is rational}}

-- Weak duality as a tie of positive forms: prices that tie the forms bound the content at every feasible point
-- (weak). The weighted count of the lattice points near the least value is bounded from above by two
-- price vectors (above) and from below by the points of the optimal face (below); the two bounds meet at the power
-- \(L^d\) of the dimension of that face (face).
lemma lem:count [a weighted count of lattice points]
  (weak): k, n in NN, P, N in Forms(k, n), y, b in Point(k), c, v in Point(n), (forall i : c_(i) + (sum iota, y_(iota) * N_(iota)_(i)) = sum iota, y_(iota) * P_(iota)_(i)), (forall iota : (sum i, P_(iota)_(i) * v_(i)) >= (sum i, N_(iota)_(i) * v_(i)) + b_(iota)) : (sum i, c_(i) * v_(i)) >= sum iota, y_(iota) * b_(iota)
  fix (weak) progcert
  core geometric: k, J in NN : (sum j in 0..J, (j + 1)^k / 2^j) <= (prod i in 1..k, i) * 2^(k + 1)
  fix core geometric geometric
  core scale: g, X, Y in NN, X = Y : g * X = g * Y
  core rationalScale: a in QQ>=0, X, Y in NN, X = Y : a * X = a * Y
  core rowCap: n, k, L, s, O, M, gamma, kappa in NN, P, N in IntForms(k, n), op, om, epsP, epsM, zeta, sig in Exponent(k), c, u in Exponent(n), mu in Point(k), lambda in QQ>=0, (forall iota : zeta_(iota) <= mu_(iota)), (forall i : M * c_(i) + (sum iota, mu_(iota) * N_(iota)_(i)) = sum iota, mu_(iota) * P_(iota)_(i)), (sum iota, mu_(iota) * op_(iota)) <= O + (sum iota, mu_(iota) * om_(iota)), M * lambda + (sum iota, mu_(iota) * epsP_(iota)) <= (sum iota, mu_(iota) * epsM_(iota)) + gamma, (forall iota : (sum i, P_(iota)_(i) * u_(i)) + op_(iota) + epsP_(iota) * L = (sum i, N_(iota)_(i) * u_(i)) + om_(iota) + epsM_(iota) * L + sig_(iota)), (sum i, c_(i) * u_(i)) <= kappa + s, kappa <= lambda * L : (sum iota, zeta_(iota) * sig_(iota)) <= M * s + gamma * L + O
  core inject: n, k in NN, P, N in IntForms(k, n), zeta in IntForms(n, k), nuP, nuM in Forms(n, n), b in Exponent(n), (forall i : forall x in Exponent(n) : x_(i) + (sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * x_(j))) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * x_(j))))) = sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * x_(j))) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * x_(j))))) : forall u, w in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), (forall alpha : (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * u_(j))) + (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * w_(j))) = (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * w_(j))) + (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * u_(j)))) => forall i : u_(i) = w_(i)
  core basisSum: n, k in NN, zeta in IntForms(n, k), mu in Forms(n, n), X in IntForms(k, n), c in Exponent(n), pm in Point(k), (forall iota : pm_(iota) = sum alpha, zeta_(alpha)_(iota) * (sum i, c_(i) * mu_(i)_(alpha))) : forall j : (sum i, c_(i) * (sum alpha, mu_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * X_(iota)_(j)))) = sum iota, pm_(iota) * X_(iota)_(j)
  core basisPrices: k, n in NN, P, N in IntForms(k, n), zeta in IntForms(n, k), nuP, nuM in Forms(n, n), c in Exponent(n), pi, piP, piM in Point(k), (forall i : forall x in Exponent(n) : x_(i) + (sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * x_(j))) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * x_(j))))) = sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * x_(j))) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * x_(j))))), (forall iota : piP_(iota) = sum alpha, zeta_(alpha)_(iota) * (sum i, c_(i) * nuP_(i)_(alpha))), (forall iota : piM_(iota) = sum alpha, zeta_(alpha)_(iota) * (sum i, c_(i) * nuM_(i)_(alpha))), (forall iota : pi_(iota) + piM_(iota) = piP_(iota)) : forall j : c_(j) + (sum iota, pi_(iota) * N_(iota)_(j)) = sum iota, pi_(iota) * P_(iota)_(j)
  fix core basisPrices basisprices
  neqfix core basisPrices basisprices.noinject
  core basisDirections: k, n, q in NN, P, N in IntForms(k, n), zeta in IntForms(n, k), nuP, nuM in Forms(n, n), e in Exponent(k), RP, RM in Point(n), (forall alpha : forall y in Exponent(n) : y_(alpha) + (sum iota, zeta_(alpha)_(iota) * (sum j, (N_(iota)_(j) * (sum i, nuP_(j)_(i) * y_(i)) + P_(iota)_(j) * (sum i, nuM_(j)_(i) * y_(i))))) = sum iota, zeta_(alpha)_(iota) * (sum j, (P_(iota)_(j) * (sum i, nuP_(j)_(i) * y_(i)) + N_(iota)_(j) * (sum i, nuM_(j)_(i) * y_(i))))), (forall j : RP_(j) = q * (sum i, nuP_(j)_(i) * (sum iota, zeta_(i)_(iota) * e_(iota)))), (forall j : RM_(j) = q * (sum i, nuM_(j)_(i) * (sum iota, zeta_(i)_(iota) * e_(iota)))) : forall alpha : (sum iota, zeta_(alpha)_(iota) * (sum j, (P_(iota)_(j) * RP_(j) + N_(iota)_(j) * RM_(j)))) = q * (sum iota, zeta_(alpha)_(iota) * e_(iota)) + (sum iota, zeta_(alpha)_(iota) * (sum j, (N_(iota)_(j) * RP_(j) + P_(iota)_(j) * RM_(j))))
  fix core basisDirections basisdirections
  core pivotsRead: n in NN, D, R, nuD, Q in Forms(n, n), (forall i : forall x in Exponent(n) : (sum a, nuD_(i)_(a) * (sum b, D_(a)_(b) * x_(b))) = x_(i)) : forall i : forall x in Exponent(n) : (sum a, (sum b, Q_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) * (sum c, D_(a)_(c) * x_(c))) = sum b, Q_(i)_(b) * (sum d, R_(b)_(d) * x_(d))
  core pivotsInject: n in NN, D, R, nuD, nuP, nuM in Forms(n, n), (forall i : forall x in Exponent(n) : (sum a, nuD_(i)_(a) * (sum b, D_(a)_(b) * x_(b))) = x_(i)), (forall i : forall a : nuP_(i)_(a) = nuD_(i)_(a) + (sum b, nuM_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a)))), (forall i : forall a : nuM_(i)_(a) = sum b, nuP_(i)_(b) * (sum d, R_(b)_(d) * nuD_(d)_(a))) : forall i : forall x in Exponent(n) : x_(i) + (sum a, nuM_(i)_(a) * (sum b, (D_(a)_(b) + R_(a)_(b)) * x_(b))) = sum a, nuP_(i)_(a) * (sum b, (D_(a)_(b) + R_(a)_(b)) * x_(b))
