_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j))) + c_(i) * (sum alpha, nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j))))) by eq; = (sum i, c_(i) * iverson(i = j)) + (sum i, c_(i) * ((sum alpha, nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j))) + (sum alpha, nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j))))) by eq; = (sum i, c_(i) * iverson(i = j)) + (sum i, c_(i) * (sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j)) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j))))) by eq; = (sum i, (c_(i) * iverson(i = j) + c_(i) * (sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j)) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j)))))) by eq; = (sum i, c_(i) * (iverson(i = j) + (sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j)) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j)))))) by eq; = (sum i, c_(i) * (sum alpha, (nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j)) + nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j))))) by eq; = (sum i, c_(i) * ((sum alpha, nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j))) + (sum alpha, nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j))))) by eq; = (sum i, (c_(i) * (sum alpha, nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j))) + c_(i) * (sum alpha, nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j))))) by eq; = (sum i, c_(i) * (sum alpha, nuP_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * P_(iota)_(j)))) + (sum i, c_(i) * (sum alpha, nuM_(i)_(alpha) * (sum iota, zeta_(alpha)_(iota) * N_(iota)_(j)))) by eq; = (sum iota, piP_(iota) * P_(iota)_(j)) + (sum iota, piM_(iota) * N_(iota)_(j)) by eq]; with[(sum iota, piP_(iota) * N_(iota)_(j)) = (sum iota, pi_(iota) * N_(iota)_(j)) + (sum iota, piM_(iota) * N_(iota)_(j)) by chain[(sum iota, piP_(iota) * N_(iota)_(j)) = (sum iota, (pi_(iota) + piM_(iota)) * N_(iota)_(j)) by eq; = (sum iota, (pi_(iota) * N_(iota)_(j) + piM_(iota) * N_(iota)_(j))) by eq; = (sum iota, pi_(iota) * N_(iota)_(j)) + (sum iota, piM_(iota) * N_(iota)_(j)) by eq]; with[(sum iota, piP_(iota) * P_(iota)_(j)) = (sum iota, pi_(iota) * P_(iota)_(j)) + (sum iota, piM_(iota) * P_(iota)_(j)) by chain[(sum iota, piP_(iota) * P_(iota)_(j)) = (sum iota, (pi_(iota) + piM_(iota)) * P_(iota)_(j)) by eq; = (sum iota, (pi_(iota) * P_(iota)_(j) + piM_(iota) * P_(iota)_(j))) by eq; = (sum iota, pi_(iota) * P_(iota)_(j)) + (sum iota, piM_(iota) * P_(iota)_(j)) by eq]; V[1 * hw6, 1 * hw19, 1 * hw23]]]]]]]]]
  "core basisDirections" with[(sum t, zeta_(alpha)_(t) * e_(t)) + (sum iota, zeta_(alpha)_(iota) * (sum j, (N_(iota)_(j) * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))) + P_(iota)_(j) * (sum i, nuM_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t)))))) = sum iota, zeta_(alpha)_(iota) * (sum j, (P_(iota)_(j) * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))) + N_(iota)_(j) * (sum i, nuM_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))))) by h_1(alpha)[y_(i) := (sum t, zeta_(i)_(t) * e_(t))]; chain[(sum iota, zeta_(alpha)_(iota) * (sum j, (P_(iota)_(j) * RP_(j) + N_(iota)_(j) * RM_(j)))) = (sum iota, zeta_(alpha)_(iota) * (sum j, (P_(iota)_(j) * (q * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t)))) + N_(iota)_(j) * (q * (sum i, nuM_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))))))) by eq; = (sum iota, zeta_(alpha)_(iota) * (sum j, q * (P_(iota)_(j) * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))) + N_(iota)_(j) * (sum i, nuM_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t)))))) by eq; = (sum iota, zeta_(alpha)_(iota) * (q * (sum j, (P_(iota)_(j) * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))) + N_(iota)_(j) * (sum i, nuM_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))))))) by eq; = (sum iota, q * (zeta_(alpha)_(iota) * (sum j, (P_(iota)_(j) * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))) + N_(iota)_(j) * (sum i, nuM_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))))))) by eq; = q * (sum iota, zeta_(alpha)_(iota) * (sum j, (P_(iota)_(j) * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))) + N_(iota)_(j) * (sum i, nuM_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t)))))) by eq; = q * ((sum t, zeta_(alpha)_(t) * e_(t)) + (sum iota, zeta_(alpha)_(iota) * (sum j, (N_(iota)_(j) * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))) + P_(iota)_(j) * (sum i, nuM_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))))))) by eq; = q * (sum t, zeta_(alpha)_(t) * e_(t)) + q * (sum iota, zeta_(alpha)_(iota) * (sum j, (N_(iota)_(j) * (sum i, nuP_(j)_(i) * (sum t, zeta_(i)_(t) * e_(t))) + P_(iota)_(j) * (sum i, nuM_(j)_(