-- Q++ 0.2
module charts
uses root

subsection sec:charts The classes of a chart

-- Let \(K\) be a potential in \(n\) variables, a map from the points to \(\Q_{\ge0}\), and \(\rho\) a box. A point of depth
-- \(N\) is a point of the dyadic grid of depth \(N\), and a sublevel point at the level \(L\) is one where \(K\) is at
-- most the level halved \(L\) times. The potential has the pair \((\lambda,m)\) on the box, with \(\lambda\) in
-- \(\Q_{\ge0}\) and \(m\ge1\) a count, when at every level \(L\) from some level on, and every depth \(N\) from some
-- multiple of \(L\) on, the number of its sublevel points of depth \(N\) in the box is, up to constants, \(L^{m-1}\)
-- times the number of all the points of depth \(N\) in the box, halved \(\lfloor\lambda L\rfloor\) times: from below,
-- from above, or both. A chamber of the potential with a certificate, prices of value \(\lambda\) and a least face of
-- dimension \(m-1\), has the value \((\lambda,m)\); the pair is read on that value.
definition def:pair [the pair on points]
  origin: ?{\text{the definition of the pair, read at the archimedean place by the counts of sublevel points}}

-- A chart: one member of degree one per coordinate, ordered by levels, each read only at lower levels. The class of a
-- size vector is the set of counted points with those sizes.
type Sizes(n, r) := Exponent(n) -> Exponent(r)
type Moduli(n, r) := Exponent(n) -> Point(r)

-- A class of a chart is counted level by level: from above its points differ by a bounded amount in each coordinate
-- (above), from below it contains a box of windows (below), so it holds about \(2^{nN-c\cdot s}\) points.
lemma lem:chart [the classes of a chart]
  core residue: x, y, v, D in NN, (exists q in NN : x = q * (D + 1) + v), (exists q in NN : y = q * (D + 1) + v), x <= y + D, y <= x + D : x = y
  core lex: k, n in NN, D, lam, v, u, w in Exponent(n), (forall j : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)) => u_(j) <= w_(j) + D_(j), w_(j) <= u_(j) + D_(j)), (forall j : exists q in NN : u_(j) = q * (D_(j) + 1) + v_(j)), (forall j : exists q in NN : w_(j) = q * (D_(j) + 1) + v_(j)) : forall j : lam_(j) <= k => u_(j) = w_(j)
  core divide: x, D in NN : exists v in NN : v <= D, exists q in NN : x = q * (D + 1) + v
  core lexcount: n, r in NN, b, D, lam in Exponent(n), G in Grid(n), S in Sizes(n, r), e in QQ>=0 : forall s in Exponent(r) : (forall j : forall u, w in Exponent(n) : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= e, G(w) <= e, S(u) = s, S(w) = s => u_(j) <= w_(j) + D_(j), w_(j) <= u_(j) + D_(j)) => (sum u <= b, iverson(G(u) <= e, S(u) = s)) <= prod j, (D_(j) + 1)
  core pivotstep: N, x, x2, D, t in NN, a in QQ>0, y, z in QQ>=0, a * x <= a * x2 + 2^N * (y + z), y <= 1 / 2^t, z <= 1 / 2^t, 2 * 2^N <= a * D * 2^t : x <= x2 + D
  core level: n in NN, lam in Exponent(n) : forall j : lam_(j) <= sum i, lam_(i)
  core power: n, N in NN, D, t in Exponent(n), K in QQ>0, (forall j : (D_(j) + 1) * 2^(t_(j)) <= K * 2^N) : (prod j, (D_(j) + 1)) * 2^(sum j, t_(j)) <= K^n * 2^(n * N)
  core powerBelow: n, N in NN, W, t in Exponent(n), K in QQ>0, (forall j : K * 2^N <= (W_(j) + 1) * 2^(t_(j))) : K^n * 2^(n * N) <= (prod j, (W_(j) + 1)) * 2^(sum j, t_(j))
  core build: n, k in NN, lam, b, o, W, v in Exponent(n), M in Sizes(n, n), (forall j : forall u, w in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)) => forall y in Exponent(n) : M(u) = y => forall z in Exponent(n) : M(w) = z => y_(j) = z_(j)), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : lam_(i) < lam_(j) => y_(i) + o_(i) <= u_(i), u_(i) <= y_(i) + o_(i) + W_(i)) => y_(j) + o_(j) + W_(j) <= b_(j)), (forall i : v_(i) <= W_(i)) : exists u in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall y in Exponent(n) : M(u) = y => forall j : lam_(j) <= k => u_(j) = y_(j) + o_(j) + v_(j))
  core windows: n, r in NN, lam, b, o, W in Exponent(n), M in Sizes(n, n), G in Grid(n), S in Sizes(n, r), e in QQ>=0, (forall j : forall u, w in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)) => forall y in Exponent(n) : M(u) = y => forall z in Exponent(n) : M(w) = z => y_(j) = z_(j)), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : lam_(i) < lam_(j) => y_(i) + o_(i) <= u_(i), u_(i) <= y_(i) + o_(i) + W_(i)) => y_(j) + o_(j) + W_(j) <= b_(j)) : forall s in Exponent(r) : (forall u, v in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : v_(i) <= W_(i)) => forall y in Exponent(n) : M(u) = y, (forall j : u_(j) = y_(j) + o_(j) + v_(j)) => G(u) <= e, S(u) = s) => (prod j, (W_(j) + 1)) <= sum u <= b, iverson(G(u) <= e, S(u) = s)
  (above): n, r, N in NN, lam, b, t, D in Exponent(n), B, c in Exponent(r), G in Grid(n), F in Moduli(n, n), S in Sizes(n, r), e in QQ>=0, a, K in QQ>0, (forall j : 2 * 2^N <= a * D_(j) * 2^(t_(j))), (forall j : (D_(j) + 1) * 2^(t_(j)) <= K * 2^N) : forall s in Exponent(r) : (forall X : s_(X) <= B_(X)), (sum X, c_(X) * s_(X)) <= sum j, t_(j), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e, S(u) = s => forall y in Point(n) : F(u) = y => forall j : y_(j) <= 1 / 2^(t_(j))), (forall j : forall u, w in Exponent(n) : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= e, G(w) <= e, S(u) = s, S(w) = s => forall y in Point(n) : F(u) = y => forall z in Point(n) : F(w) = z => a * u_(j) <= a * w_(j) + 2^N * (y_(j) + z_(j))) => (sum u <= b, iverson(G(u) <= e, S(u) = s)) <= K^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X))
  fix (above) chartabove
  (below): n, r, N in NN, lam, b, t, o, W in Exponent(n), B, c in Exponent(r), M in Sizes(n, n), G in Grid(n), S in Sizes(n, r), e in QQ>=0, K in QQ>0, (forall j : forall u, w in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)) => forall y in Exponent(n) : M(u) = y => forall z in Exponent(n) : M(w) = z => y_(j) = z_(j)), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : lam_(i) < lam_(j) => y_(i) + o_(i) <= u_(i), u_(i) <= y_(i) + o_(i) + W_(i)) => y_(j) + o_(j) + W_(j) <= b_(j)), (forall j : K * 2^N <= (W_(j) + 1) * 2^(t_(j))) : forall s in Exponent(r) : (forall X : s_(X) <= B_(X)), (sum j, t_(j)) <= sum X, c_(X) * s_(X), (forall u, v in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : v_(i) <= W_(i)) => forall y in Exponent(n) : M(u) = y, (forall j : u_(j) = y_(j) + o_(j) + v_(j)) => G(u) <= e, S(u) = s) => K^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) <= sum u <= b, iverson(G(u) <= e, S(u) = s)
  fix (below) chartbelow
  origin: ?{\text{elementary, proved here: the classes of a chart, from above by residues and from below by windows}}

-- (above): two points of a class that agree below the level of \(j\) differ by at most \(D_j\) in the coordinate \(j\),
-- since the member of that level has the slope \(a\) and a small modulus at both (core pivotstep); points with the same
-- residues modulo \(D_j+1\) then agree level by level, so the class has at most \(\prod_j(D_j+1)\) points (core
-- lexcount). (below): each choice of windows \(v_j\le W_j\) builds a point of the class level by level, and distinct
-- choices give distinct points (core windows). (core power) and (core powerBelow) compare the products with
-- \(K^n2^{nN}\).
proof lem:chart
  "core residue" logic[cases[q <= q_2; cases[q_2 <= q; V; V]; V]]
  "core lex" ind[k; logic[with[forall i : lam_(i) < lam_(j) => u_(i) = w_(i) by logic[V]; with[(u_(j) <= w_(j) + D_(j), w_(j) <= u_(j) + D_(j)) by (logic, logic); lem:chart(core residue)[x := u_(j), y := w_(j), v := v_(j), D := D_(j)]]]]; logic[with[forall i : lam_(i) < lam_(j) => u_(i) = w_(i) by logic[V]; with[(u_(j) <= w_(j) + D_(j), w_(j) <= u_(j) + D_(j)) by (logic, logic); lem:chart(core residue)[x := u_(j), y := w_(j), v := v_(j), D := D_(j)]]]]]
  "core divide" with[exists q in NN : q <= x / (D + 1), x / (D + 1) < q + 1 by fact:floor(core)[x := x / (D + 1)]; logic[with[q * (D + 1) <= x by V; with[x < q * (D + 1) + D + 1 by V; take[v := max(x - q * (D + 1), 0); (V[hw3], take[q := q; V[0]])]]]]]
  "core lexcount" with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e, S(u) = s => exists v in Exponent(n) : (forall i : v_(i) <= D_(i)), (forall j : exists q in NN : u_(j) = q * (D_(j) + 1) + v_(j)) by logic[with[forall j : exists x in NN : x <= D_(j), exists q in NN : u_(j) = q * (D_(j) + 1) + x by logic[lem:chart(core divide)[x := u_(j), D := D_(j)]]; with[exists v in Exponent(n) : forall j : v_(j) <= D_(j), exists q in NN : u_(j) = q * (D_(j) + 1) + v_(j) by choice; logic[take[v := v; (logic, logic)]]]]]; with[forall u, w, v in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e, S(u) = s, (forall i : w_(i) <= b_(i)), G(w) <= e, S(w) = s, (forall i : v_(i) <= D_(i)), (forall j : exists q in NN : u_(j) = q * (D_(j) + 1) + v_(j)), (forall j : exists q in NN : w_(j) = q * (D_(j) + 1) + v_(j)) => forall i : u_(i) = w_(i) by logic[with[forall j : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)) => u_(j) <= w_(j) + D_(j), w_(j) <= u_(j) + D_(j) by (logic, logic); with[lam_(i) <= lam_(i) by V[0]; with[forall j : lam_(j) <= lam_(i) => u_(j) = w_(j) by lem:chart(core lex)[k := lam_(i), n := n, D := D, lam := lam, v := v, u := u, w := w]; logic]]]]; chain[(sum u <= b, iverson(G(u) <= e, S(u) = s)) <= sum v <= D, iverson(forall i : v_(i) <= D_(i)) by inj; <= prod j, (D_(j) + 1) by box]]]
  "core pivotstep" with[2^N * (y + z) <= 2^N * (2 / 2^t) by mono; with[2^N * (2 / 2^t) <= a * D by V; with[a * (x / 1) <= a * ((x2 + D) / 1) by V; with[x / 1 <= (x2 + D) / 1 by div[a]; V[1 * hw4]]]]]
  "core level" logic[term[j]]
  "core power" with[exists kk in Point(n) : forall j : kk_(j) = K * 2^N by take[kk_(j) := K * 2^N; V]; logic[with[(prod j, ((D_(j) + 1) * 2^(t_(j)))) = (prod j, (D_(j) + 1)) * (prod j, 2^(t_(j))) by sum; with[(prod j, 2^(t_(j))) = 2^(sum j, t_(j)) by sum; with[(prod j, (D_(j) + 1)) * (prod j, 2^(t_(j))) = (prod j, (D_(j) + 1)) * 2^(sum j, t_(j)) by mono, mono; with[forall j : (D_(j) + 1) * 2^(t_(j)) <= kk_(j) by logic[V]; with[(prod j, ((D_(j) + 1) * 2^(t_(j)))) <= prod j, kk_(j) by sum[V]; with[(K * 2^N)^n = prod j, kk_(j) by sum[V]; with[(K * 2^N)^n = K^n * 2^(n * N) by V; V]]]]]]]]]
  "core powerBelow" with[exists kk in Point(n) : forall j : kk_(j) = K * 2^N by take[kk_(j) := K * 2^N; V]; logic[with[(prod j, ((W_(j) + 1) * 2^(t_(j)))) = (prod j, (W_(j) + 1)) * (prod j, 2^(t_(j))) by sum; with[(prod j, 2^(t_(j))) = 2^(sum j, t_(j)) by sum; with[(prod j, (W_(j) + 1)) * (prod j, 2^(t_(j))) = (prod j, (W_(j) + 1)) * 2^(sum j, t_(j)) by mono, mono; with[forall j : kk_(j) <= (W_(j) + 1) * 2^(t_(j)) by logic[V]; with[(prod j, kk_(j)) <= prod j, ((W_(j) + 1) * 2^(t_(j))) by sum[V]; with[(K * 2^N)^n = prod j, kk_(j) by sum[V]; with[(K * 2^N)^n = K^n * 2^(n * N) by V; V]]]]]]]]]
  "core build" ind[k; with[exists z0 in Exponent(n) : forall i : z0_(i) = 0 by take[z0_(i) := 0; V]; logic[with[forall i : z0_(i) <= b_(i) by logic[V]; with[exists y0 in Exponent(n) : M(z0) = y0 by take[y0 := M(z0); V]; logic[with[forall j : lam_(j) <= 0 => y0_(j) + o_(j) + W_(j) <= b_(j) by logic[with[forall i : lam_(i) < lam_(j) => y0_(i) + o_(i) <= z0_(i), z0_(i) <= y0_(i) + o_(i) + W_(i) by (V, V); logic]]; with[forall i : exists x in NN : x <= b_(i), (lam_(i) <= 0 => x = y0_(i) + o_(i) + v_(i)), (0 < lam_(i) => x = 0) by logic[cases[lam_(i) <= 0; take[x := y0_(i) + o_(i) + v_(i); (with[y0_(i) + o_(i) + W_(i) <= b_(i) by logic; V[1 * h_3(i), 1 * hw7]], logic, logic[V])]; take[x := 0; (V, logic[V], logic)]]]; with[exists w in Exponent(n) : forall i : w_(i) <= b_(i), (lam_(i) <= 0 => w_(i) = y0_(i) + o_(i) + v_(i)), (0 < lam_(i) => w_(i) = 0) by choice; logic[with[forall i : w_(i) <= b_(i) by logic; take[u := w; (logic, logic[with[forall i : lam_(i) < lam_(j) => w_(i) = z0_(i) by logic[V]; with[y_(j) = y0_(j) by logic; with[w_(j) = y0_(j) + o_(j) + v_(j) by logic; V[hw11, hw12]]]]])]]]]]]]]]]]; logic[with[exists y1 in Exponent(n) : M(u) = y1 by take[y1 := M(u); V]; logic[with[forall j : lam_(j) = k + 1 => y1_(j) + o_(j) + W_(j) <= b_(j) by logic[with[forall i : lam_(i) < lam_(j) => y1_(i) + o_(i) <= u_(i), u_(i) <= y1_(i) + o_(i) + W_(i) by with[lam_(i) <= k by V[hi10, hi11]; with[u_(i) = y1_(i) + o_(i) + v_(i) by logic; (V[| 1 * hw17], V[1 * h_3(i), 1 * hw17])]]; logic]]; with[forall i : exists x in NN : x <= b_(i), (lam_(i) <= k => x = u_(i)), (lam_(i) = k + 1 => x = y1_(i) + o_(i) + v_(i)), (k + 1 < lam_(i) => x = u_(i)) by logic[cases[lam_(i) = k + 1; take[x := y1_(i) + o_(i) + v_(i); (with[y1_(i) + o_(i) + W_(i) <= b_(i) by logic; V[1 * h_3(i), 1 * hw19]], logic[V], logic, logic[V])]; take[x := u_(i); (logic, logic, logic, logic)]]]; with[exists w in Exponent(n) : forall i : w_(i) <= b_(i), (lam_(i) <= k => w_(i) = u_(i)), (lam_(i) = k + 1 => w_(i) = y1_(i) + o_(i) + v_(i)), (k + 1 < lam_(i) => w_(i) = u_(i)) by choice; logic[with[forall i : w_(i) <= b_(i) by logic; take[u := w; (logic, logic[with[forall i : lam_(i) < lam_(j) => w_(i) = u_(i) by logic[V]; with[y_(j) = y1_(j) by logic; cases[lam_(j) <= k; with[w_(j) = u_(j) by logic; with[u_(j) = y1_(j) + o_(j) + v_(j) by logic; V[1 * hw23, 1 * hw24, 1 * hw25]]]; with[lam_(j) = k + 1 by V; with[w_(j) = y1_(j) + o_(j) + v_(j) by logic; V[1 * hw23, 1 * hw27]]]]]]])]]]]]]]]]]
  "core windows" logic[with[forall v in Exponent(n) : (forall i : v_(i) <= W_(i)) => exists u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e, S(u) = s, (forall y in Exponent(n) : M(u) = y => forall j : u_(j) = y_(j) + o_(j) + v_(j)) by logic[with[exists u in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall y in Exponent(n) : M(u) = y => forall j : lam_(j) <= sum i, lam_(i) => u_(j) = y_(j) + o_(j) + v_(j)) by lem:chart(core build)[n := n, k := (sum i, lam_(i)), lam := lam, b := b, o := o, W := W, v := v, M := M]; with[forall j : lam_(j) <= sum i, lam_(i) by lem:chart(core level)[n := n, lam := lam]; logic[with[exists y in Exponent(n) : M(u) = y by take[y := M(u); V]; logic[with[forall j : u_(j) = y_(j) + o_(j) + v_(j) by logic; take[u := u; (logic, logic, logic, logic)]]]]]]]]; with[forall v, v2, u in Exponent(n) : (forall i : v_(i) <= W_(i)), (forall y in Exponent(n) : M(u) = y => forall j : u_(j) = y_(j) + o_(j) + v_(j)), (forall i : v2_(i) <= W_(i)), (forall y in Exponent(n) : M(u) = y => forall j : u_(j) = y_(j) + o_(j) + v2_(j)) => forall i : v_(i) = v2_(i) by logic[with[exists y in Exponent(n) : M(u) = y by take[y := M(u); V]; logic[with[u_(i) = y_(i) + o_(i) + v_(i) by logic; with[u_(i) = y_(i) + o_(i) + v2_(i) by logic; V[hw8, hw9]]]]]]; chain[(prod j, (W_(j) + 1)) <= sum v <= W, iverson(forall i : v_(i) <= W_(i)) by box[logic]; <= sum u <= b, iverson(G(u) <= e, S(u) = s) by inj]]]]
  (above) logic[with[forall j : forall u, w in Exponent(n) : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= e, G(w) <= e, S(u) = s, S(w) = s => u_(j) <= w_(j) + D_(j) by logic[with[exists y in Point(n) : F(u) = y by take[y := F(u); V]; with[exists z in Point(n) : F(w) = z by take[z := F(w); V]; logic[with[a * u_(j) <= a * w_(j) + 2^N * (y_(j) + z_(j)) by logic; with[y_(j) <= 1 / 2^(t_(j)) by logic; with[z_(j) <= 1 / 2^(t_(j)) by logic; with[2 * 2^N <= a * D_(j) * 2^(t_(j)) by logic; lem:chart(core pivotstep)[N := N, x := u_(j), x2 := w_(j), D := D_(j), t := t_(j), a := a, y := y_(j), z := z_(j)]]]]]]]]]; with[forall j : forall u, w in Exponent(n) : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= e, G(w) <= e, S(u) = s, S(w) = s => u_(j) <= w_(j) + D_(j), w_(j) <= u_(j) + D_(j) by (logic, logic[with[forall i : lam_(i) < lam_(j) => w_(i) = u_(i) by logic[V]; logic]]); with[forall s2 in Exponent(r) : (forall j : forall u, w in Exponent(n) : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= e, G(w) <= e, S(u) = s2, S(w) = s2 => u_(j) <= w_(j) + D_(j), w_(j) <= u_(j) + D_(j)) => (sum u <= b, iverson(G(u) <= e, S(u) = s2)) <= prod j, (D_(j) + 1) by lem:chart(core lexcount)[n := n, r := r, b := b, D := D, lam := lam, G := G, S := S, e := e]; with[(sum u <= b, iverson(G(u) <= e, S(u) = s)) <= prod j, (D_(j) + 1) by logic; with[(prod j, (D_(j) + 1)) * 2^(sum j, t_(j)) <= K^n * 2^(n * N) by lem:chart(core power)[n := n, N := N, D := D, t := t, K := K]; with[2^(sum X, c_(X) * s_(X)) <= 2^(sum j, t_(j)) by mono; with[(sum u <= b, iverson(G(u) <= e, S(u) = s)) * 2^(sum X, c_(X) * s_(X)) <= (prod j, (D_(j) + 1)) * 2^(sum j, t_(j)) by mono; with[2^(sum X, c_(X) * s_(X)) * (sum u <= b, iverson(G(u) <= e, S(u) = s)) <= 2^(sum X, c_(X) * s_(X)) * (K^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X))) by V; div[2^(sum X, c_(X) * s_(X))]]]]]]]]]]
  (below) logic[with[forall s2 in Exponent(r) : (forall u, v in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : v_(i) <= W_(i)) => forall y in Exponent(n) : M(u) = y, (forall j : u_(j) = y_(j) + o_(j) + v_(j)) => G(u) <= e, S(u) = s2) => (prod j, (W_(j) + 1)) <= sum u <= b, iverson(G(u) <= e, S(u) = s2) by lem:chart(core windows)[n := n, r := r, lam := lam, b := b, o := o, W := W, M := M, G := G, S := S, e := e]; with[(prod j, (W_(j) + 1)) <= sum u <= b, iverson(G(u) <= e, S(u) = s) by logic; with[K^n * 2^(n * N) <= (prod j, (W_(j) + 1)) * 2^(sum j, t_(j)) by lem:chart(core powerBelow)[n := n, N := N, W := W, t := t, K := K]; with[2^(sum j, t_(j)) <= 2^(sum X, c_(X) * s_(X)) by mono; with[(prod j, (W_(j) + 1)) * 2^(sum j, t_(j)) <= (sum u <= b, iverson(G(u) <= e, S(u) = s)) * 2^(sum X, c_(X) * s_(X)) by mono; with[2^(sum X, c_(X) * s_(X)) * (K^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X))) <= 2^(sum X, c_(X) * s_(X)) * (sum u <= b, iverson(G(u) <= e, S(u) = s)) by V; div[2^(sum X, c_(X) * s_(X))]]]]]]]]

subsection sec:separation Points told apart by levels

-- Levels tell points apart: if one combination per scale ties at two points, the points agree, level by level.
lemma lem:separation [points told apart by levels]
  core exchange: n, k in NN, z in Exponent(k), Q in IntForms(k, n), x in Exponent(n) : (sum iota, z_(iota) * (sum j, Q_(iota)_(j) * x_(j))) = sum j, (sum iota, z_(iota) * Q_(iota)_(j)) * x_(j)
  core pivot: n in NN, A, B, u, w, lam, d in Exponent(n), (sum l, A_(l) * u_(l)) + (sum l, B_(l) * w_(l)) = (sum l, A_(l) * w_(l)) + (sum l, B_(l) * u_(l)) : forall j : 1 <= d_(j), (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : lam_(j) <= lam_(i) => A_(i) = d_(i) * iverson(j = i) + B_(i)) => u_(j) = w_(j)
  core separate: n, k in NN, P, N in IntForms(k, n), zeta in IntForms(n, k), lam, d, u, w in Exponent(n), (forall alpha : 1 <= d_(alpha)), (forall alpha : forall i : lam_(alpha) <= lam_(i) => (sum iota, zeta_(alpha)_(iota) * P_(iota)_(i)) = d_(i) * iverson(alpha = i) + (sum iota, zeta_(alpha)_(iota) * N_(iota)_(i))), (forall alpha : (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * u_(j))) + (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * w_(j))) = (sum iota, zeta_(alpha)_(iota) * (sum j, P_(iota)_(j) * w_(j))) + (sum iota, zeta_(alpha)_(iota) * (sum j, N_(iota)_(j) * u_(j)))) : forall i : u_(i) = w_(i)
  fix core separate levelsep
  neqfix core separate levelsep.nolevels
  core levelsAbove: n, L, O, K, T, kappa in NN, Pr in Chamber(n, n), pi in Point(n), zeta in IntForms(n, n), lam, d, c, b in Exponent(n), lambda in QQ>=0, (pi #prices Pr #content c #value lambda), (forall iota : 1 <= T * pi_(iota)), (sum iota, pi_(iota) * Pr.op_(iota)) <= O, T * (sum iota, pi_(iota) * Pr.op_(iota)) <= O, (forall alpha : forall iota : zeta_(alpha)_(iota) <= 1), (forall alpha : 1 <= d_(alpha)), (forall alpha : forall i : lam_(alpha) <= lam_(i) => (sum iota, zeta_(alpha)_(iota) * Pr.P_(iota)_(i)) = d_(i) * iverson(alpha = i) + (sum iota, zeta_(alpha)_(iota) * Pr.N_(iota)_(i))), 2^O * (T + O + 1)^n * (prod i in 1..n, i) * 2^(n + 1) <= K, kappa <= lambda * L : (sum u <= b, iverson((u #feasible Pr #level L)) / 2^(sum i, c_(i) * u_(i))) <= K / 2^kappa
  fix core levelsAbove levelsabove
  core levelsDiag: n, L, O, K, T, kappa in NN, Pr in Chamber(n, n), pi in Point(n), lam, d, c, b in Exponent(n), lambda in QQ>=0, (pi #prices Pr #content c #value lambda), (forall iota : 1 <= T * pi_(iota)), (sum iota, pi_(iota) * Pr.op_(iota)) <= O, T * (sum iota, pi_(iota) * Pr.op_(iota)) <= O, (forall alpha : 1 <= d_(alpha)), (forall alpha : forall i : lam_(alpha) <= lam_(i) => Pr.P_(alpha)_(i) = d_(i) * iverson(alpha = i) + Pr.N_(alpha)_(i)), 2^O * (T + O + 1)^n * (prod i in 1..n, i) * 2^(n + 1) <= K, kappa <= lambda * L : (sum u <= b, iverson((u #feasible Pr #level L)) / 2^(sum i, c_(i) * u_(i))) <= K / 2^kappa
  origin: ?{\text{elementary, proved here level by level through}\ \cref{lem:chart}\text{, with no determinant; that a block triangular system with units on its diagonal blocks is injective is standard (Mathlib: Matrix.BlockTriangular.det, Matrix.mulVec\_injective\_iff\_isUnit)}}

proof lem:separation
  "core exchange" chain[(sum iota, z_(iota) * (sum j, Q_(iota)_(j) * x_(j))) = sum iota, sum j, z_(iota) * Q_(iota)_(j) * x_(j) by sum[sum[V]]; = sum j, sum iota, z_(iota) * Q_(iota)_(j) * x_(j) by sum[V]; = sum j, (sum iota, z_(iota) * Q_(iota)_(j)) * x_(j) by sum[sum[V]]]
  "core pivot" logic[with[forall l : (A_(l) * u_(l) + B_(l) * w_(l)) + iverson(j = l) * (d_(l) * w_(l)) = (A_(l) * w_(l) + B_(l) * u_(l)) + iverson(j = l) * (d_(l) * u_(l)) by logic[cases[lam_(l) < lam_(j); with[u_(l) = w_(l) by logic; V[A_(l) * hw2, B_(l) * hw2, (iverson(j = l) * d_(l)) * hw2]]; with[A_(l) = d_(l) * iverson(j = l) + B_(l) by logic; V[u_(l) * hw3, w_(l) * hw3]]]]; with[(sum l, ((A_(l) * u_(l) + B_(l) * w_(l)) + iverson(j = l) * (d_(l) * w_(l)))) = sum l, ((A_(l) * w_(l) + B_(l) * u_(l)) + iverson(j = l) * (d_(l) * u_(l))) by sum[V]; with[(sum l, ((A_(l) * u_(l) + B_(l) * w_(l)) + iverson(j = l) * (d_(l) * w_(l)))) = (sum l, (A_(l) * u_(l) + B_(l) * w_(l))) + (sum l, iverson(j = l) * (d_(l) * w_(l))) by sum; with[(sum l, ((A_(l) * w_(l) + B_(l) * u_(l)) + iverson(j = l) * (d_(l) * u_(l)))) = (sum l, (A_(l) * w_(l) + B_(l) * u_(l))) + (sum l, iverson(j = l) * (d_(l) * u_(l))) by sum; with[(sum l, (A_(l) * u_(l) + B_(l) * w_(l))) = (sum l, A_(l) * u_(l)) + (sum l, B_(l) * w_(l)) by sum; with[(sum l, (A_(l) * w_(l) + B_(l) * u_(l))) = (sum l, A_(l) * w_(l)) + (sum l, B_(l) * u_(l)) by sum; with[(sum l, iverson(j = l) * (d_(l) * w_(l))) = d_(j) * w_(j) by sum; with[(sum l, iverson(j = l) * (d_(l) * u_(l))) = d_(j) * u_(j) by sum; with[(sum l, (A_(l) * u_(l) + B_(l) * w_(l))) + (sum l, iverson(j = l) * (d_(l) * w_(l))) = (sum l, (A_(l) * w_(l) + B_(l) * u_(l))) + (sum l, iverson(j = l) * (d_(l) * u_(l))) by V[1 * hw4, 1 * hw5, 1 * hw6]; with[(sum l, (A_(l) * u_(l) + B_(l) * w_(l))) + d_(j) * w_(j) = (sum l, (A_(l) * w_(l) + B_(l) * u_(l))) + d_(j) * u_(j) by V[1 * hw11, 1 * hw9, 1 * hw10]; with[(sum l, (A_(l) * u_(l) + B_(l) * w_(l))) = (sum l, (A_(l) * w_(l) + B_(l) * u_(l))) by V[1 * hw7, 1 * hw8, 1 * h_1]; with[d_(j) * w_(j) = d_(j) * u_(j) by V[1 * hw12, 1 * hw13]; cases[u_(j) <= w_(j); cases[w_(j) <= u_(j); V[1 * hc2], V[1 * hc3]; with[d_(j) * (u_(j) + 1) <= d_(j) * w_(j) by V[d_(j) * hn3]; with[d_(j) < 1 by V[1 * hw15, 1 * hw14]; logic]]]; with[d_(j) * (w_(j) + 1) <= d_(j) * u_(j) by V[d_(j) * hn2]; with[d_(j) < 1 by V[1 * hw17 | 1 * hw14]; logic]]]]]]]]]]]]]]]]
  "core separate" logic[with[forall j : (forall l : lam_(l) < lam_(j) => u_(l) = w_(l)) => u_(j) = w_(j) by logic[with[exists A in Exponent(n) : forall l : A_(l) = sum iota, zeta_(j)_(iota) * P_(iota)_(l) by take[A_(l) := (sum iota, zeta_(j)_(iota) * P_(iota)_(l)); V]; with[exists B in Exponent(n) : forall l : B_(l) = sum iota, zeta_(j)_(iota) * N_(iota)_(l) by take[B_(l) := (sum iota, zeta_(j)_(iota) * N_(iota)_(l)); V]; logic[with[(sum iota, zeta_(j)_(iota) * (sum l, P_(iota)_(l) * u_(l))) = sum l, A_(l) * u_(l) by chain[(sum iota, zeta_(j)_(iota) * (sum l, P_(iota)_(l) * u_(l))) = sum l, (sum iota, zeta_(j)_(iota) * P_(iota)_(l)) * u_(l) by lem:separation(core exchange)[n := n, k := k, z := zeta_(j), Q := P, x := u]; = sum l, A_(l) * u_(l) by sum[V]]; with[(sum iota, zeta_(j)_(iota) * (sum l, N_(iota)_(l) * w_(l))) = sum l, B_(l) * w_(l) by chain[(sum iota, zeta_(j)_(iota) * (sum l, N_(iota)_(l) * w_(l))) = sum l, (sum iota, zeta_(j)_(iota) * N_(iota)_(l)) * w_(l) by lem:separation(core exchange)[n := n, k := k, z := zeta_(j), Q := N, x := w]; = sum l, B_(l) * w_(l) by sum[V]]; with[(sum iota, zeta_(j)_(iota) * (sum l, P_(iota)_(l) * w_(l))) = sum l, A_(l) * w_(l) by chain[(sum iota, zeta_(j)_(iota) * (sum l, P_(iota)_(l) * w_(l))) = sum l, (sum iota, zeta_(j)_(iota) * P_(iota)_(l)) * w_(l) by lem:separation(core exchange)[n := n, k := k, z := zeta_(j), Q := P, x := w]; = sum l, A_(l) * w_(l) by sum[V]]; with[(sum iota, zeta_(j)_(iota) * (sum l, N_(iota)_(l) * u_(l))) = sum l, B_(l) * u_(l) by chain[(sum iota, zeta_(j)_(iota) * (sum l, N_(iota)_(l) * u_(l))) = sum l, (sum iota, zeta_(j)_(iota) * N_(iota)_(l)) * u_(l) by lem:separation(core exchange)[n := n, k := k, z := zeta_(j), Q := N, x := u]; = sum l, B_(l) * u_(l) by sum[V]]; with[(sum l, A_(l) * u_(l)) + (sum l, B_(l) * w_(l)) = (sum iota, zeta_(j)_(iota) * (sum l, P_(iota)_(l) * u_(l))) + (sum iota, zeta_(j)_(iota) * (sum l, N_(iota)_(l) * w_(l))) by V[1 * hw4, 1 * hw7]; with[(sum iota, zeta_(j)_(iota) * (sum l, P_(iota)_(l) * w_(l))) + (sum iota, zeta_(j)_(iota) * (sum l, N_(iota)_(l) * u_(l))) = (sum l, A_(l) * w_(l)) + (sum l, B_(l) * u_(l)) by V[1 * hw10, 1 * hw13]; with[(sum l, A_(l) * u_(l)) + (sum l, B_(l) * w_(l)) = (sum l, A_(l) * w_(l)) + (sum l, B_(l) * u_(l)) by V[1 * hw16, 1 * h_3(j), 1 * hw17]; with[forall l : lam_(j) <= lam_(l) => A_(l) = d_(l) * iverson(j = l) + B_(l) by logic[with[A_(l) = sum iota, zeta_(j)_(iota) * P_(iota)_(l) by logic; with[B_(l) = sum iota, zeta_(j)_(iota) * N_(iota)_(l) by logic; with[(sum iota, zeta_(j)_(iota) * P_(iota)_(l)) = d_(l) * iverson(j = l) + (sum iota, zeta_(j)_(iota) * N_(iota)_(l)) by logic; V[1 * hw20, 1 * hw21, 1 * hw22]]]]]; with[forall p : 1 <= d_(p), (forall l : lam_(l) < lam_(p) => u_(l) = w_(l)), (forall l : lam_(p) <= lam_(l) => A_(l) = d_(l) * iverson(p = l) + B_(l)) => u_(p) = w_(p) by lem:separation(core pivot)[n := n, A := A, B := B, u := u, w := w, lam := lam, d := d]; logic]]]]]]]]]]]]]; with[forall j : (forall l : lam_(l) < lam_(j) => u_(l) = w_(l)) => u_(j) <= w_(j) + 0, w_(j) <= u_(j) + 0 by (logic[with[u_(j) = w_(j) by logic; V[1 * hw25]]], logic[with[u_(j) = w_(j) by logic; V[| 1 * hw26]]]); with[forall j : exists q in NN : u_(j) = q * (0 + 1) + 0 by logic[take[q := u_(j); V[0]]]; with[forall j : exists q in NN : w_(j) = q * (0 + 1) + 0 by logic[take[q := w_(j); V[0]]]; with[forall j : lam_(j) <= (sum l, lam_(l)) => u_(j) = w_(j) by lem:chart(core lex)[k := (sum l, lam_(l)), n := n, D_(l) := 0, lam := lam, v_(l) := 0, u := u, w := w]; with[forall j : lam_(j) <= sum l, lam_(l) by lem:chart(core level)[n := n, lam := lam]; logic]]]]]]]
  "core levelsAbove" with[forall u, w in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), (forall alpha : (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.P_(iota)_(j) * u_(j))) + (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.N_(iota)_(j) * w_(j))) = (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.P_(iota)_(j) * w_(j))) + (sum iota, zeta_(alpha)_(iota) * (sum j, Pr.N_(iota)_(j) * u_(j)))) => forall i : u_(i) = w_(i) by logic[lem:separation(core separate)[n := n, k := n, P := Pr.P, N := Pr.N, zeta := zeta, lam := lam, d := d, u := u, w := w]]; lem:count(core vertexAbove)[n := n, L := L, O := O, K := K, T := T, kappa := kappa, Pr := Pr, pi := pi, zeta := zeta, c := c, b := b, lambda := lambda]]
  "core levelsDiag" with[exists Z in IntForms(n, n) : forall alpha : forall iota : Z_(alpha)_(iota) = 1 * iverson(alpha = iota) by take[Z_(alpha)_(iota) := 1 * iverson(alpha = iota); V]; with[forall alpha : forall iota : Z_(alpha)_(iota) <= 1 by logic[with[Z_(alpha)_(iota) = 1 * iverson(alpha = iota) by logic; cases[alpha = iota; V[1 * hw3]; V[1 * hw3]]]]; with[forall alpha : forall i : lam_(alpha) <= lam_(i) => (sum iota, Z_(alpha)_(iota) * Pr.P_(iota)_(i)) = d_(i) * iverson(alpha = i) + (sum iota, Z_(alpha)_(iota) * Pr.N_(iota)_(i)) by logic[with[forall beta : (sum iota, Z_(beta)_(iota) * Pr.P_(iota)_(i)) = Pr.P_(beta)_(i) by lem:count(core diagonal)[n := n, Z := Z, y_(iota) := Pr.P_(iota)_(i)]; with[forall beta : (sum iota, Z_(beta)_(iota) * Pr.N_(iota)_(i)) = Pr.N_(beta)_(i) by lem:count(core diagonal)[n := n, Z := Z, y_(iota) := Pr.N_(iota)_(i)]; with[(sum iota, Z_(alpha)_(iota) * Pr.P_(iota)_(i)) = Pr.P_(alpha)_(i) by logic; with[(sum iota, Z_(alpha)_(iota) * Pr.N_(iota)_(i)) = Pr.N_(alpha)_(i) by logic; with[Pr.P_(alpha)_(i) = d_(i) * iverson(alpha = i) + Pr.N_(alpha)_(i) by logic; V[1 * hw7, 1 * hw8, 1 * hw9]]]]]]]; lem:separation(core levelsAbove)[n := n, L := L, O := O, K := K, T := T, kappa := kappa, Pr := Pr, pi := pi, zeta := Z, lam := lam, d := d, c := c, b := b, lambda := lambda]]]]
