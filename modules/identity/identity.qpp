-- Q++ 0.2
module identity
uses regular

subsection sec:identity The identity chart

word idmod(n, N in NN) : Moduli(n, n)
define idmod(n, N)(u)_(j) := u_(j) / 2^N
word idsize(B in Exponent(n), N in NN) : Sizes(n, n)
define idsize(B, N)(u)_(j) := sum k in 1..B_(j), iverson(u_(j) * 2^k <= 2^N)
word idgrid(K in Potential(n), N in NN) : Grid(n)
define idgrid(K, N)(u) := K(idmod(n, N)(u))
word idwin(n in NN) : Sizes(n, n)
define idwin(n)(u)_(j) := 0

-- At depth \(N\) the identity chart reads a grid point \(u\) as \(x=u/2^N\), with the dyadic sizes of its coordinates,
-- zero slopes and zero windows, each given by a formula. On the unit box the terms of a loss give its count from above
-- and from below by \cref{thm:pair}, and between diagonal terms the loss has the pair \((\sum_X1/E_X,1)\) of
-- \cref{lem:regular}(pair).
lemma lem:identity [the identity chart]
  core dyadcap: N, B, x in NN : (sum k in 1..B, iverson(x * 2^k <= 2^N)) <= B
  fix core dyadcap identity.dyadic
  core dyadtop: N, B, x in NN : forall s in NN : s = (sum k in 1..B, iverson(x * 2^k <= 2^N)) => (B <= s or 2^N < x * 2^(s + 1))
  fix core dyadtop identity.dyadic
  core dyadsize: N, B, x in NN, x <= 2^N : forall s in NN : s = (sum k in 1..B, iverson(x * 2^k <= 2^N)) => x * 2^s <= 2^N
  fix core dyadsize identity.dyadic
  core quotabove: N, s in NN, u, y in QQ>=0, 2^N * y = u, u * 2^s <= 2^N : y <= 1 / 2^s
  core quotbelow: N, s in NN, u, y in QQ>=0, 2^N * y = u, 2^N < u * 2^(s + 1) : 1 / 2^(s + 1) < y
  core pointread: n, N in NN, u in Exponent(n), v, w in Point(n), (forall j : 2^N * v_(j) = u_(j)), (forall j : 2^N * w_(j) = u_(j)) : forall j : v_(j) = w_(j)
  core unitread: N in NN, u, y in QQ>=0, 2^N * y = u, u <= 2^N : y <= 1
  core sizes: n, N in NN, Y in Moduli(n, n), S in Sizes(n, n), B, b in Exponent(n), (forall i : b_(i) <= 2^N), (forall u in Exponent(n) : forall y in Point(n) : Y(u) = y => forall j : 2^N * y_(j) = u_(j)), (forall u in Exponent(n) : forall s in Exponent(n) : S(u) = s => forall j : s_(j) = sum k in 1..B_(j), iverson(u_(j) * 2^k <= 2^N)) : (Y #sizes S #cap B #box b)
  core chart: n, N in NN : exists Ch in Chart(n) : (forall i : Ch.lam_(i) = 0), Ch.N = N, (forall u in Exponent(n) : forall x in Point(n) : Ch.F(u) = x => forall j : 2^(Ch.N) * x_(j) = u_(j))
  core depth: n, N, M, L in NN, K in Potential(n), b in Exponent(n), M = N : (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= (sum u <= b, iverson((u #sublevel K #depth M #level L)))
  core above: n, k, L, N in NN, K in Potential(n), Te in Terms(k, n), b, B, c in Exponent(n), Pr in Chamber(k, n), (forall i : b_(i) <= 2^N), (forall X : B_(X) <= N), (forall x in Point(n) : (forall i : x_(i) <= 1) => forall kappa : Te.q_(kappa) * (prod X, x_(X)^(Te.E_(kappa)_(X))) <= K(x)), (forall kappa : exists X : 1 <= Te.E_(kappa)_(X)), (forall kappa : 1 <= Te.q_(kappa) * 2^(Te.A_(kappa))), (forall kappa : forall X : 1 <= Te.E_(kappa)_(X) => L + 1 <= Te.E_(kappa)_(X) * B_(X) + (sum Z, Te.E_(kappa)_(Z)) + Te.A_(kappa)), (forall kappa : forall i : Pr.P_(kappa)_(i) = Te.E_(kappa)_(i), Pr.N_(kappa)_(i) = 0), (forall kappa : Pr.op_(kappa) = (sum X, Te.E_(kappa)_(X)) + Te.A_(kappa), Pr.om_(kappa) = 1), (forall kappa : Pr.epsP_(kappa) = 0, Pr.epsM_(kappa) = 1), (forall X : c_(X) = 1) : (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= 3^n * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X)))
  core round: x, y in NN, x <= y, y < x + 1 : x = y
  (counted): n, k, Lz, a, h in NN, K in Potential(n), Te in Terms(k, n), c in Exponent(n), Pr in Chamber(k, n), rho in Weight(n), 1 <= a, (forall i : rho_(i) <= 1), (forall x in Point(n) : (forall i : x_(i) <= 1) => forall kappa : Te.q_(kappa) * (prod X, x_(X)^(Te.E_(kappa)_(X))) <= K(x)), (forall kappa : exists X : 1 <= Te.E_(kappa)_(X)), (forall kappa : 1 <= Te.q_(kappa) * 2^(Te.A_(kappa))), (forall kappa : forall i : Pr.P_(kappa)_(i) = Te.E_(kappa)_(i), Pr.N_(kappa)_(i) = 0), (forall kappa : Pr.op_(kappa) = (sum X, Te.E_(kappa)_(X)) + Te.A_(kappa), Pr.om_(kappa) = 1), (forall kappa : Pr.epsP_(kappa) = 0, Pr.epsM_(kappa) = 1), (forall X : c_(X) = 1) : (K #counted Pr #content c #by 3^n #from Lz #depth a #plus h #box rho)
  core below: n, k, L, Lp, H, N in NN, K in Potential(n), Te in Terms(k, n), b, B, c in Exponent(n), Pr in Chamber(k, n), (forall i : b_(i) = 2^N), (forall X : B_(X) + 1 <= N), L <= Lp, k <= 2^H, (forall x in Point(n) : (forall i : x_(i) <= 1), (forall X : 0 < x_(X)) => K(x) <= sum kappa, Te.q_(kappa) * (prod X, x_(X)^(Te.E_(kappa)_(X)))), (forall kappa : Te.q_(kappa) <= 2^(Te.A_(kappa))), (forall kappa : forall i : Pr.P_(kappa)_(i) = Te.E_(kappa)_(i), Pr.N_(kappa)_(i) = 0), (forall kappa : Pr.op_(kappa) = 0, Pr.om_(kappa) = Te.A_(kappa) + H), (forall kappa : Pr.epsP_(kappa) = 0, Pr.epsM_(kappa) = 1), (forall j : 1 <= c_(j)) : (1 / 2)^n * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X))) <= sum u <= b, iverson((u #sublevel K #depth N #level L))
  (countedin): n, k, Lz, a, h, H in NN, K in Potential(n), Te in Terms(k, n), c in Exponent(n), Pr in Chamber(k, n), rho in Weight(n), (forall i : rho_(i) = 1), k <= 2^H, (forall x in Point(n) : (forall i : x_(i) <= 1), (forall X : 0 < x_(X)) => K(x) <= sum kappa, Te.q_(kappa) * (prod X, x_(X)^(Te.E_(kappa)_(X)))), (forall kappa : Te.q_(kappa) <= 2^(Te.A_(kappa))), (forall kappa : forall i : Pr.P_(kappa)_(i) = Te.E_(kappa)_(i), Pr.N_(kappa)_(i) = 0), (forall kappa : Pr.op_(kappa) = 0, Pr.om_(kappa) = Te.A_(kappa) + H), (forall kappa : Pr.epsP_(kappa) = 0, Pr.epsM_(kappa) = 1), (forall j : 1 <= c_(j)) : (K #countedin Pr #content c #by (1 / 2)^n #from Lz #depth a #plus h #box rho)
  core diagonal: n, Lz, a, h, a0, H in NN, K in Potential(n), rho in Weight(n), E, c in Exponent(n), Q1, Q2 in QQ>0, (forall i : rho_(i) = 1), (forall x in Point(n) : (forall i : x_(i) <= 1) => forall X : Q1 * x_(X)^(E_(X)) <= K(x)), (forall x in Point(n) : (forall i : x_(i) <= 1), (forall X : 0 < x_(X)) => K(x) <= Q2 * (sum X, x_(X)^(E_(X)))), 1 <= Q1 * 2^a0, Q2 <= 2^a0, n <= 2^H, (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), 1 <= a : exists Pr, Pru in Chamber(n, n) : (forall iota : forall i : Pr.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pr.N_(iota)_(i) = 0), (forall iota : Pr.epsP_(iota) = 0), (forall iota : Pr.epsM_(iota) = 1), (forall iota : forall i : Pru.P_(iota)_(i) = E_(i) * iverson(iota = i)), (forall iota : forall i : Pru.N_(iota)_(i) = 0), (forall iota : Pru.op_(iota) = 0), (forall iota : Pru.om_(iota) = a0 + H), (forall iota : Pru.epsP_(iota) = 0), (forall iota : Pru.epsM_(iota) = 1), (K #counted Pr #content c #by 3^n #from Lz #depth a #plus h #box rho), (K #countedin Pru #content c #by (1 / 2)^n #from Lz #depth a #plus h #box rho)
  (points): n, Lz, a, h, a0, H in NN, q in NN>=1, K in Potential(n), rho in Weight(n), E, c in Exponent(n), R in IntForms(1, n), Q1, Q2 in QQ>0, (forall i : rho_(i) = 1), (forall x in Point(n) : (forall i : x_(i) <= 1) => forall X : Q1 * x_(X)^(E_(X)) <= K(x)), (forall x in Point(n) : (forall i : x_(i) <= 1), (forall X : 0 < x_(X)) => K(x) <= Q2 * (sum X, x_(X)^(E_(X)))), 1 <= Q1 * 2^a0, Q2 <= 2^a0, n <= 2^H, (forall X : 1 <= E_(X)), (forall X : c_(X) = 1), (forall l : forall j : E_(j) * R_(l)_(j) = q), 1 <= a, 1 <= Lz, (forall i : a0 + H + (sum l, R_(l)_(i)) + 1 <= h), (forall i : (sum l, R_(l)_(i)) <= a) : exists cp in QQ>0 : exists Cp in QQ>0 : (K #points (sum iota, 1 / E_(iota)) #multiplicity 1 #box rho #between cp #and Cp #from Lz #depth a #plus h)
  origin: ?{\text{elementary, proved here; the pair is that of}\ \cref{lem:regular}\text{(pair) at the identity chart}}

proof lem:identity
  "core dyadcap" ind[B; V; with[(sum k in 1..B + 1, iverson(x * 2^k <= 2^N)) = (sum k in 1..B, iverson(x * 2^k <= 2^N)) + iverson(x * 2^(B + 1) <= 2^N) by sum; with[(sum k in 1..B, iverson(x * 2^k <= 2^N)) <= B by logic; with[iverson(x * 2^(B + 1) <= 2^N) <= 1 by V; V[1 * hw1, 1 * hw2, 1 * hw3]]]]]
  "core dyadtop" ind[B; with[0 <= s by V; logic]; with[exists f in NN : f = (sum k in 1..B, iverson(x * 2^k <= 2^N)) by take[f := (sum k in 1..B, iverson(x * 2^k <= 2^N)); V]; with[f = (sum k in 1..B, iverson(x * 2^k <= 2^N)) by logic; with[(sum k in 1..B + 1, iverson(x * 2^k <= 2^N)) = (sum k in 1..B, iverson(x * 2^k <= 2^N)) + iverson(x * 2^(B + 1) <= 2^N) by sum; with[(B <= f or 2^N < x * 2^(f + 1)) by logic; with[(sum k in 1..B, iverson(x * 2^k <= 2^N)) <= B by lem:identity(core dyadcap)[N := N, B := B, x := x]; with[f <= B by V[1 * hw3, 1 * hw6]; cases[B <= f; with[f = B by V, V; cases[x * 2^(B + 1) <= 2^N; with[B + 1 <= s by V[1 * hw3 | 1 * hi2, 1 * hw4, 1 * hw8]; logic]; with[s = B by V[1 * hw3 | 1 * hi2, 1 * hw4, 1 * hw8]; logic]]]; with[2^N < x * 2^(f + 1) by logic; with[f + 1 <= B + 1 by V[1 * hw7]; with[2^(f + 1) <= 2^(B + 1) by mono; with[x * 2^(f + 1) <= x * 2^(B + 1) by mono; with[2^N < x * 2^(B + 1) by V[1 * hw11, 1 * hw14]; with[s = f by V[1 * hi2, 1 * hw4, 1 * hw3]; logic]]]]]]]]]]]]]]
  "core dyadsize" ind[B; with[(sum k in 1..0, iverson(x * 2^k <= 2^N)) = 0 by V; with[s = 0 by V[1 * hi1, 1 * hw1]; V[1 * h_1]]]; with[exists f in NN : f = (sum k in 1..B, iverson(x * 2^k <= 2^N)) by take[f := (sum k in 1..B, iverson(x * 2^k <= 2^N)); V]; with[f = (sum k in 1..B, iverson(x * 2^k <= 2^N)) by logic; with[(sum k in 1..B + 1, iverson(x * 2^k <= 2^N)) = (sum k in 1..B, iverson(x * 2^k <= 2^N)) + iverson(x * 2^(B + 1) <= 2^N) by sum; with[x * 2^f <= 2^N by logic; with[(sum k in 1..B, iverson(x * 2^k <= 2^N)) <= B by lem:identity(core dyadcap)[N := N, B := B, x := x]; with[f <= B by V[1 * hw4, 1 * hw7]; cases[x * 2^(B + 1) <= 2^N; with[f + 1 <= B + 1 by V[1 * hw8]; with[2^(f + 1) <= 2^(B + 1) by mono; with[x * 2^(f + 1) <= x * 2^(B + 1) by mono; with[s = f + 1 by V[1 * hi2, 1 * hw5, 1 * hw4]; V[1 * hw11, 1 * hc1]]]]]; with[s = f by V[1 * hi2, 1 * hw5, 1 * hw4]; V[1 * hw6]]]]]]]]]]
  "core quotabove" with[2^N * (2^s * y) <= 2^N * 1 by V[2^s * h_3, 1 * h_4]; with[2^s * y <= 1 by div[2^N]; with[2^s * y <= 2^s * (1 / 2^s) by chain[2^s * y <= 1 by V; = 2^s * (1 / 2^s) by V]; div[2^s]]]]
  "core quotbelow" with[2^N * 1 < 2^N * (2^(s + 1) * y) by V[1 * h_4 | 2^(s + 1) * h_3]; with[1 < 2^(s + 1) * y by div[2^N]; with[2^(s + 1) * (1 / 2^(s + 1)) < 2^(s + 1) * y by chain[2^(s + 1) * (1 / 2^(s + 1)) = 1 by V; < 2^(s + 1) * y by V]; div[2^(s + 1)]]]]
  "core pointread" with[forall i : 2^N * v_(i) = 2^N * w_(i) by logic[V[1 * h_1(i), 1 * h_2(i)]]; logic[div[2^N]]]
  "core unitread" with[2^N * y <= 2^N * 1 by V[1 * h_3, 1 * h_4]; div[2^N]]
  "core sizes" ((logic[with[s_(X) = (sum k in 1..B_(X), iverson(u_(X) * 2^k <= 2^N)) by logic; with[(sum k in 1..B_(X), iverson(u_(X) * 2^k <= 2^N)) <= B_(X) by lem:identity(core dyadcap)[N := N, B := B_(X), x := u_(X)]; V[1 * hw1, 1 * hw2]]]], logic[with[s_(X) = (sum k in 1..B_(X), iverson(u_(X) * 2^k <= 2^N)) by logic; with[u_(X) <= 2^N by V[1 * hi1(X), 1 * h_1(X)]; with[u_(X) * 2^(s_(X)) <= 2^N by lem:identity(core dyadsize)[N := N, B := B_(X), x := u_(X)]; with[2^N * y_(X) = u_(X) by logic; lem:identity(core quotabove)[N := N, s := s_(X), u := u_(X), y := y_(X)]]]]]], logic[with[s_(X) = (sum k in 1..B_(X), iverson(u_(X) * 2^k <= 2^N)) by logic; with[(sum k in 1..B_(X), iverson(u_(X) * 2^k <= 2^N)) <= B_(X) by lem:identity(core dyadcap)[N := N, B := B_(X), x := u_(X)]; with[s_(X) <= B_(X) by V[1 * hw7, 1 * hw8]; with[(B_(X) <= s_(X) or 2^N < u_(X) * 2^(s_(X) + 1)) by lem:identity(core dyadtop)[N := N, B := B_(X), x := u_(X)]; with[2^N * y_(X) = u_(X) by logic; cases[B_(X) <= s_(X); with[s_(X) = B_(X) by V, V; logic]; with[2^N < u_(X) * 2^(s_(X) + 1) by logic; with[1 / 2^(s_(X) + 1) < y_(X) by lem:identity(core quotbelow)[N := N, s := s_(X), u := u_(X), y := y_(X)]; logic]]]]]]]]]))
  "core chart" take[Ch.lam_(i) := 0, Ch.F := idmod(n, N), Ch.N := N; (V, V, logic[with[idmod(n, N)(u)_(j) = u_(j) / 2^N by V; chain[2^N * x_(j) = 2^N * idmod(n, N)(u)_(j) by eq; = 2^N * (u_(j) / 2^N) by mono, mono; = u_(j) by V]]])]
  "core depth" sum[cases[(u #sublevel K #depth N #level L); with[(u #sublevel K #depth N #level L) => exists w in Point(n) : (forall i : 2^N * w_(i) = u_(i)), K(w) <= 1 / 2^L by unfold[logic]; logic[with[forall i : 2^M * w_(i) = u_(i) by logic[chain[2^M * w_(i) = 2^N * w_(i) by eq; = u_(i) by V]]; take[w := w; (logic[V], V)]]]]; logic]]
