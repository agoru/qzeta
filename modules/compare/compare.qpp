-- Q++ 0.2
module compare
uses sizes, charts

subsection sec:compare The rows of a comparison

-- Members read on a box by their sizes, capped at \(B\); a potential is at least each of its terms (atleast), or at most
-- their sum (atmost).
relation (Y #sizes S #cap B #box b) := n, r in NN, Y in Moduli(n, r), S in Sizes(n, r), B in Exponent(r), b in Exponent(n), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(r) : Y(u) = y => forall s in Exponent(r) : S(u) = s => (y #sized s #cap B))
type Terms(k, r) := {q in Point(k), E in IntForms(k, r), A in Exponent(k)}
relation (G #atleast Te #moduli Y #box b) := n, r, k in NN, G in Grid(n), Te in Terms(k, r), Y in Moduli(n, r), b in Exponent(n), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(r) : Y(u) = y => forall kappa : Te.q_(kappa) * (prod X, y_(X)^(Te.E_(kappa)_(X))) <= G(u)), (forall kappa : exists X : 1 <= Te.E_(kappa)_(X)), (forall kappa : 1 <= Te.q_(kappa) * 2^(Te.A_(kappa)))
relation (G #atmost Te #moduli Y #box b) := n, r, k in NN, G in Grid(n), Te in Terms(k, r), Y in Moduli(n, r), b in Exponent(n), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(r) : Y(u) = y, (forall X : 0 < y_(X)) => G(u) <= sum kappa, Te.q_(kappa) * (prod X, y_(X)^(Te.E_(kappa)_(X)))), (forall kappa : Te.q_(kappa) <= 2^(Te.A_(kappa)))

-- A potential compared with a positive sum of monomials in the moduli gives the rows of its chamber: a counted point has
-- sizes on the side of each row (above), and a point whose sizes clear every row is counted (below).
lemma lem:compare [the rows of a comparison]
  core unit: s in NN, y in QQ>=0, 1 / 2^(s + 1) < y : 1 < y * 2^(s + 1)
  core lift: d, E in NN, t in QQ>=0, d <= 1, (1 <= E => 1 <= t) : t^(E * d) <= t^E
  core term: L, m, a in NN, c, t in QQ>=0, 1 <= c * 2^a, 1 < t, c * ((1 / 2)^m * t) <= 1 / 2^L : L + 1 <= m + a
  core single: r in NN, E, s in Exponent(r) : forall X : E_(X) * s_(X) <= sum Z, E_(Z) * s_(Z)
  core point: r, L, a in NN, B, E, s in Exponent(r), y in Point(r), c, g, e in QQ>=0, (exists X0 : 1 <= E_(X0)), (forall X : 1 <= E_(X) => L + 1 <= E_(X) * B_(X) + (sum Z, E_(Z)) + a), 1 <= c * 2^a, e <= 1 / 2^L, c * (prod X, y_(X)^(E_(X))) <= g, g <= e, (y #sized s #cap B) : L + 1 <= (sum X, E_(X) * (s_(X) + 1)) + a
  fix core point comparepoint
  (above): n, r, k, L in NN, b in Exponent(n), B in Exponent(r), G in Grid(n), Y in Moduli(n, r), S in Sizes(n, r), Te in Terms(k, r), e in QQ>=0, (Y #sizes S #cap B #box b), (G #atleast Te #moduli Y #box b), (forall kappa : forall X : 1 <= Te.E_(kappa)_(X) => L + 1 <= Te.E_(kappa)_(X) * B_(X) + (sum Z, Te.E_(kappa)_(Z)) + Te.A_(kappa)), e <= 1 / 2^L : forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e => forall s in Exponent(r) : S(u) = s => forall kappa : L + 1 <= (sum X, Te.E_(kappa)_(X) * (s_(X) + 1)) + Te.A_(kappa)
  fix (above) compareabove
  core down: E, s in NN, y in QQ>=0, y <= 1 / 2^s : y^E <= (1 / 2)^(E * s)
  core power: E, A, d in NN, w, y in QQ>=0, w <= 2^A * y^d : w^E <= 2^(A * E) * y^(d * E)
  core termup: r, A in NN, d, E, D in Exponent(r), w, y in Point(r), q, p in QQ>=0, (forall X : w_(X) <= 2^A * y_(X)^(d_(X))), (forall X : D_(X) = d_(X) * E_(X)), p = q * 2^(A * (sum X, E_(X))) : q * (prod X, w_(X)^(E_(X))) <= p * prod X, y_(X)^(D_(X))
  core mass: a, b, m in NN, q, p in QQ>=0, q <= 2^a, p = q * 2^m, b = a + m : p <= 2^b
  core dominate: n, r, k, A in NN, b in Exponent(n), d in Exponent(r), G in Grid(n), Y, F in Moduli(n, r), Te, Tf in Terms(k, r), (G #atmost Te #moduli Y #box b), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(r) : Y(u) = y => forall z in Point(r) : F(u) = z, (forall X : 0 < z_(X)) => forall X : 0 < y_(X), y_(X) <= 2^A * z_(X)^(d_(X))), (forall kappa : forall X : Tf.E_(kappa)_(X) = d_(X) * Te.E_(kappa)_(X)), (forall kappa : Tf.q_(kappa) = Te.q_(kappa) * 2^(A * (sum X, Te.E_(kappa)_(X)))), (forall kappa : Tf.A_(kappa) = Te.A_(kappa) + A * (sum X, Te.E_(kappa)_(X))) : (G #atmost Tf #moduli F #box b)
  fix core dominate comparedominate
  core termdown: m, A, L, h in NN, c, p in QQ>=0, c <= 2^A, p <= (1 / 2)^m, L + A + h <= m : c * p <= (1 / 2)^(L + h)
  core pointdown: r, k, L, h in NN, A in Exponent(k), E in IntForms(k, r), s, B in Exponent(r), y in Point(r), q in Point(k), g, e in QQ>=0, k <= 2^h, (forall kappa : q_(kappa) <= 2^(A_(kappa))), 1 / 2^L <= e, g <= sum kappa, q_(kappa) * (prod X, y_(X)^(E_(kappa)_(X))), (y #sized s #cap B), (forall kappa : L + A_(kappa) + h <= sum X, E_(kappa)_(X) * s_(X)) : g <= e
  (below): n, r, k, L, h in NN, b in Exponent(n), B in Exponent(r), G in Grid(n), Y in Moduli(n, r), S in Sizes(n, r), Te in Terms(k, r), e in QQ>=0, (Y #sizes S #cap B #box b), (G #atmost Te #moduli Y #box b), k <= 2^h, 1 / 2^L <= e : forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(r) : Y(u) = y, (forall X : 0 < y_(X)) => forall s in Exponent(r) : S(u) = s, (forall kappa : L + Te.A_(kappa) + h <= sum X, Te.E_(kappa)_(X) * s_(X)) => G(u) <= e
  fix (below) comparebelow
  origin: ?{\text{proved here: the rows of a comparison of a potential with its terms, at the sizes of the moduli}}

-- (above): at a counted point each term is at most the potential, so at most \(1/2^L\), while it exceeds \(1/2^A\)
-- times the halved dyadic bounds of its moduli raised to their exponents; the row follows (core point), and a capped
-- size is covered by the hypothesis on \(B\). (below): when the sizes clear every row, each term is at most
-- \(1/2^{L+h}\), and at most \(2^h\) terms sum to at most \(1/2^L\) (core pointdown).
proof lem:compare
  "core unit" with[1 / 2^(s + 1) * 2^(s + 1) = 1 by eq; with[1 / 2^(s + 1) * 2^(s + 1) < y * 2^(s + 1) by mono; V]]
  "core lift" cases[1 <= E; with[1 <= t by logic; with[E * d <= E by V[E * h_2]; mono]]; with[E = 0 by V; eq]]
  "core term" cases[L + 1 <= m + a; V[1 * hc1]; with[m + a <= L by V; with[1 / 2^L <= 1 / 2^(m + a) by lem:rules(core weigh)[K := L, l := m + a]; with[c * (1 / 2)^m = c * 2^a * (1 / 2^(m + a)) by eq; with[0 < 1 / 2^(m + a) by V; with[1 / 2^(m + a) <= c * 2^a * (1 / 2^(m + a)) by V; with[0 < c * (1 / 2)^m by V; with[c * (1 / 2)^m * 1 < c * (1 / 2)^m * t by mono; V]]]]]]]]
  "core single" logic[term[X]]
  "core point" cases[exists X1 : 1 <= E_(X1), s_(X1) = B_(X1); logic[with[L + 1 <= E_(X1) * B_(X1) + (sum Z, E_(Z)) + a by logic; with[E_(X1) * s_(X1) <= sum Z, E_(Z) * s_(Z) by lem:compare(core single)[r := r, E := E, s := s]; with[(sum X, E_(X) * (s_(X) + 1)) = (sum X, E_(X) * s_(X)) + (sum X, E_(X)) by sum; V]]]]; with[forall X : 1 <= E_(X) => 1 / 2^(s_(X) + 1) < y_(X) by logic; with[forall X : 1 <= E_(X) => 1 <= y_(X) * 2^(s_(X) + 1) by logic[with[1 < y_(X) * 2^(s_(X) + 1) by lem:compare(core unit)[s := s_(X), y := y_(X)]; V[1 * hw6]]]; logic[with[1 < y_(X0) * 2^(s_(X0) + 1) by lem:compare(core unit)[s := s_(X0), y := y_(X0)]; with[(y_(X0) * 2^(s_(X0) + 1))^1 <= (y_(X0) * 2^(s_(X0) + 1))^(E_(X0)) by mono; with[(prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X) * iverson(X = X0))) = (y_(X0) * 2^(s_(X0) + 1))^(E_(X0)) by sum; with[(prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X) * iverson(X = X0))) <= prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X)) by sum[lem:compare(core lift)[d := iverson(X = X0), E := E_(X), t := y_(X) * 2^(s_(X) + 1); iverson(X = X0) <= 1 by cases V]]; with[(prod X, y_(X)^(E_(X))) = (1 / 2)^(sum X, E_(X) * (s_(X) + 1)) * (prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X))) by chain[(prod X, y_(X)^(E_(X))) = prod X, (1 / 2)^(E_(X) * (s_(X) + 1)) * (y_(X) * 2^(s_(X) + 1))^(E_(X)) by sum[eq]; = (prod X, (1 / 2)^(E_(X) * (s_(X) + 1))) * (prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X))) by sum; = (1 / 2)^(sum X, E_(X) * (s_(X) + 1)) * (prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X))) by with[(prod X, (1 / 2)^(E_(X) * (s_(X) + 1))) = (1 / 2)^(sum X, E_(X) * (s_(X) + 1)) by sum; V]]; with[c * ((1 / 2)^(sum X, E_(X) * (s_(X) + 1)) * (prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X)))) <= c * (prod X, y_(X)^(E_(X))) by mono; with[c * ((1 / 2)^(sum X, E_(X) * (s_(X) + 1)) * (prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X)))) <= 1 / 2^L by V; with[1 < prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X)) by V; lem:compare(core term)[L := L, m := (sum X, E_(X) * (s_(X) + 1)), a := a, c := c, t := (prod X, (y_(X) * 2^(s_(X) + 1))^(E_(X)))]]]]]]]]]]]]]
  (above) logic[with[exists y in Point(r) : Y(u) = y by take[y := Y(u); V]; logic[lem:compare(core point)[r := r, L := L, a := Te.A_(kappa), B := B, E := Te.E_(kappa), s := s, y := y, c := Te.q_(kappa), g := G(u), e := e]]]]
  "core down" with[(1 / 2)^(E * s) = (1 / 2^s)^E by eq; with[y^E <= (1 / 2^s)^E by mono; V[1 * hw2 | 1 * hw1]]]
  "core power" with[w^E <= (2^A * y^d)^E by mono; with[(2^A * y^d)^E = 2^(A * E) * y^(d * E) by eq; V[1 * hw1, 1 * hw2]]]
  "core termup" with[(prod X, w_(X)^(E_(X))) <= (prod X, 2^(A * E_(X)) * y_(X)^(d_(X) * E_(X))) by sum[lem:compare(core power)[E := E_(X), A := A, d := d_(X), w := w_(X), y := y_(X)]]; with[(prod X, 2^(A * E_(X)) * y_(X)^(d_(X) * E_(X))) = (prod X, 2^(A * E_(X))) * (prod X, y_(X)^(d_(X) * E_(X))) by sum; with[(prod X, w_(X)^(E_(X))) <= (prod X, 2^(A * E_(X))) * (prod X, y_(X)^(d_(X) * E_(X))) by V; with[(prod X, y_(X)^(D_(X))) = (prod X, y_(X)^(d_(X) * E_(X))) by sum[V]; with[(prod X, 2^(A * E_(X))) = 2^(sum X, A * E_(X)) by sum; with[(sum X, A * E_(X)) = A * (sum X, E_(X)) by sum; with[2^(sum X, A * E_(X)) <= 2^(A * (sum X, E_(X))) by V; with[(prod X, 2^(A * E_(X))) <= 2^(A * (sum X, E_(X))) by V[1 * hw5, 1 * hw7]; chain[q * (prod X, w_(X)^(E_(X))) <= q * ((prod X, 2^(A * E_(X))) * (prod X, y_(X)^(d_(X) * E_(X)))) by mono; <= q * (2^(A * (sum X, E_(X))) * (prod X, y_(X)^(d_(X) * E_(X)))) by mono; = (q * 2^(A * (sum X, E_(X)))) * (prod X, y_(X)^(d_(X) * E_(X))) by eq; <= p * (prod X, y_(X)^(d_(X) * E_(X))) by mono; = p * (prod X, y_(X)^(D_(X))) by V]]]]]]]]]
  "core mass" with[q * 2^m <= 2^a * 2^m by mono; chain[p <= 2^a * 2^m by V[1 * h_4, 1 * hw1]; = 2^(a + m) by eq; <= 2^b by V]]
  "core dominate" (logic[with[exists w in Point(r) : Y(u) = w by take[w := Y(u); V]; logic[with[forall X : 0 < w_(X) by logic; with[G(u) <= sum kappa, Te.q_(kappa) * (prod X, w_(X)^(Te.E_(kappa)_(X))) by logic; with[forall X : w_(X) <= 2^A * y_(X)^(d_(X)) by logic; with[(sum kappa, Te.q_(kappa) * (prod X, w_(X)^(Te.E_(kappa)_(X)))) <= sum kappa, Tf.q_(kappa) * (prod X, y_(X)^(Tf.E_(kappa)_(X))) by sum[with[forall X : Tf.E_(kappa)_(X) = d_(X) * Te.E_(kappa)_(X) by logic; with[Tf.q_(kappa) = Te.q_(kappa) * 2^(A * (sum X, Te.E_(kappa)_(X))) by logic; lem:compare(core termup)[r := r, A := A, d := d, E := Te.E_(kappa), D := Tf.E_(kappa), w := w, y := y, q := Te.q_(kappa), p := Tf.q_(kappa)]]]]; V[1 * hw3, 1 * hw5]]]]]]]], logic[with[Te.q_(kappa) <= 2^(Te.A_(kappa)) by logic; with[Tf.q_(kappa) = Te.q_(kappa) * 2^(A * (sum X, Te.E_(kappa)_(X))) by logic; with[Tf.A_(kappa) = Te.A_(kappa) + A * (sum X, Te.E_(kappa)_(X)) by logic; lem:compare(core mass)[a := Te.A_(kappa), b := Tf.A_(kappa), m := A * (sum X, Te.E_(kappa)_(X)), q := Te.q_(kappa), p := Tf.q_(kappa)]]]]])
  "core termdown" with[1 / 2^m <= 1 / 2^(L + A + h) by lem:rules(core weigh)[K := m, l := L + A + h]; with[(1 / 2)^m = 1 / 2^m by eq; with[c * p <= 2^A * (1 / 2^(L + A + h)) by mono; with[2^A * (1 / 2^(L + A + h)) = (1 / 2)^(L + h) by eq; V]]]]
  "core pointdown" with[forall X : y_(X) <= 1 / 2^(s_(X)) by logic; with[forall kappa : q_(kappa) * (prod X, y_(X)^(E_(kappa)_(X))) <= (1 / 2)^(L + h) by logic[with[(prod X, y_(X)^(E_(kappa)_(X))) <= (1 / 2)^(sum X, E_(kappa)_(X) * s_(X)) by chain[(prod X, y_(X)^(E_(kappa)_(X))) <= prod X, (1 / 2)^(E_(kappa)_(X) * s_(X)) by sum[lem:compare(core down)[E := E_(kappa)_(X), s := s_(X), y := y_(X)]]; = (1 / 2)^(sum X, E_(kappa)_(X) * s_(X)) by sum]; with[q_(kappa) <= 2^(A_(kappa)) by logic; with[L + A_(kappa) + h <= sum X, E_(kappa)_(X) * s_(X) by logic; lem:compare(core termdown)[m := (sum X, E_(kappa)_(X) * s_(X)), A := A_(kappa), L := L, h := h, c := q_(kappa), p := (prod X, y_(X)^(E_(kappa)_(X)))]]]]]; with[exists m in Point(k) : forall kappa : m_(kappa) = q_(kappa) * (prod X, y_(X)^(E_(kappa)_(X))) by take[m_(kappa) := q_(kappa) * (prod X, y_(X)^(E_(kappa)_(X))); V]; logic[with[forall kappa : q_(kappa) * (prod X, y_(X)^(E_(kappa)_(X))) = m_(kappa) by logic[V]; with[forall kappa : m_(kappa) <= (1 / 2)^(L + h) by logic[V]; with[g <= sum kappa, m_(kappa) by with[(sum kappa, q_(kappa) * (prod X, y_(X)^(E_(kappa)_(X)))) = sum kappa, m_(kappa) by sum[V]; V[1 * h_6, 1 * hw12]]; with[g <= k * (1 / 2)^(L + h) by lem:rules(several)[r := k, M := g, D := (1 / 2)^(L + h), m := m]; with[k * (1 / 2)^(L + h) <= 2^h * (1 / 2)^(L + h) by mono; with[2^h * (1 / 2)^(L + h) = 1 / 2^L by eq; V]]]]]]]]]]
  (below) logic[lem:compare(core pointdown)[r := r, k := k, L := L, h := h, A := Te.A, E := Te.E, s := s, B := B, y := y, q := Te.q, g := G(u), e := e]]
