-- Q++ 0.2
module cover
uses pivots

subsection sec:cover The pair of a cover

-- Charts that cover a potential up to a factor \(2^D\) carry their counts to it, and a chart at another pair is read at the
-- pair of the cover across a gap.
theorem thm:cover [the pair of a cover]
  core read: n, Lz, a, h, L, N, kappa in NN, lambda in QQ>=0, m in NN>=1, K in Potential(n), rho in Weight(n), C in QQ>0, b in Exponent(n), (K #outer lambda #multiplicity m #box rho #at C #from Lz #depth a #plus h), L >= Lz, N >= a * L + h, kappa <= lambda * L, lambda * L < kappa + 1, (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1) : L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C * L^m * 2^(n * N)
  core readin: n, Lz, a, h, L, N, kappa in NN, lambda in QQ>=0, m in NN>=1, K in Potential(n), rho in Weight(n), c in QQ>0, b in Exponent(n), (K #inner lambda #multiplicity m #box rho #at c #from Lz #depth a #plus h), L >= Lz, N >= a * L + h, kappa <= lambda * L, lambda * L < kappa + 1, (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1) : c * L^m * 2^(n * N) <= L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L)))
  core union: n, N, L, Lp, D, P in NN, rho in Weight(n), b in Exponent(n), K in Potential(n), Kc_(1..P) in Potential(n), L = Lp + D, (forall i : b_(i) <= 2^N * rho_(i)), (forall w in Point(n) : (forall i : w_(i) <= rho_(i)) => exists j in NN>=1 : j <= P, Kc_(j)(w) <= 2^D * K(w)) : (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= sum p in 1..P, sum u <= b, iverson((u #sublevel Kc_(p) #depth N #level Lp))
  core sub: n, N, L, Lp, D in NN, rho in Weight(n), b in Exponent(n), K, Ku in Potential(n), Lp = L + D, (forall i : b_(i) <= 2^N * rho_(i)), (forall w in Point(n) : (forall i : w_(i) <= rho_(i)) => K(w) <= 2^D * Ku(w)) : (sum u <= b, iverson((u #sublevel Ku #depth N #level Lp))) <= sum u <= b, iverson((u #sublevel K #depth N #level L))
  core ratio: a, b in QQ>0, m in NN>=1, b <= a : a * b^m <= b * a^m
  core lower: L, Lp, D, kappa, kp, E, F in NN, m in NN>=1, S, Cc in QQ>=0, L = Lp + D, 1 <= Lp, kappa <= kp + E, Lp * 2^kp * S <= Cc * Lp^m * 2^F : L * 2^kappa * S <= 2^E * Cc * L^m * 2^F
  fix core lower coverlower
  core raise: L, Lp, D, kappa, kp, E, F in NN, m in NN>=1, Su, S, c, cu in QQ>=0, Lp = L + D, kp <= kappa + E, Su <= S, 2^E * c <= cu, cu * Lp^m * 2^F <= Lp * 2^kp * Su : c * L^m * 2^F <= L * 2^kappa * S
  fix core raise coverraise
  core shift: L, kappa, k2 in NN, q in NN>=1, lambda, lambda2 in QQ>=0, lambda + 1 / q <= lambda2, kappa <= lambda * L, lambda2 * L < k2 + 1 : exists t in NN : kappa + t = k2, L < q * (t + 1)
  fix core shift covershift
  core decay: L, t, m in NN, q in NN>=1, L < q * (t + 1) : L^m / 2^t <= q^m * (prod i in 1..m, i) * 2^(m + 1)
  fix core decay coverdecay
  core same: L, m, m2, kappa, E in NN, S, C2 in QQ>=0, m2 <= m, L * 2^kappa * S <= C2 * L^m2 * 2^E : L * 2^kappa * S <= C2 * L^m * 2^E
  core lift: L, t, kappa, k2, m, m2, E in NN, q in NN>=1, S, C2 in QQ>=0, kappa + t = k2, L < q * (t + 1), L * 2^k2 * S <= C2 * L^m2 * 2^E : L * 2^kappa * S <= C2 * q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) * L^m * 2^E
  fix core lift coverlift
  core outlevel: n, P, D, E, Lc, a, h, L, Lp, N, kappa, kp in NN, lambda in QQ>=0, m in NN>=1, K in Potential(n), Kc_(1..P) in Potential(n), rho in Weight(n), C in QQ>0, Cc_(1..P) in QQ>0, b in Exponent(n), (forall w in Point(n) : (forall i : w_(i) <= rho_(i)) => exists j in NN>=1 : j <= P, Kc_(j)(w) <= 2^D * K(w)), (forall j in NN>=1 : j <= P => (Kc_(j) #outer lambda #multiplicity m #box rho #at Cc_(j) #from Lc #depth a #plus h)), L = Lp + D, Lp >= Lc, 1 <= Lp, N >= a * Lp + h, kp <= lambda * Lp, lambda * Lp < kp + 1, kappa <= kp + E, (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1), 2^E * (sum p in 1..P, Cc_(p)) <= C : L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C * L^m * 2^(n * N)
  (same): n, Lz, a, h in NN, lambda in QQ>=0, m, m2 in NN>=1, K in Potential(n), rho in Weight(n), C, C2 in QQ>0, (K #outer lambda #multiplicity m2 #box rho #at C2 #from Lz #depth a #plus h), m2 <= m, C2 <= C : (K #outer lambda #multiplicity m #box rho #at C #from Lz #depth a #plus h)
  (gap): n, Lz, a, h in NN, lambda, lambda2 in QQ>=0, m, m2, q in NN>=1, K in Potential(n), rho in Weight(n), C, C2 in QQ>0, (K #outer lambda2 #multiplicity m2 #box rho #at C2 #from Lz #depth a #plus h), lambda + 1 / q <= lambda2, C2 * q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) <= C : (K #outer lambda #multiplicity m #box rho #at C #from Lz #depth a #plus h)
  (outer): n, P, D, E, Lz, Lc, a, h in NN, lambda in QQ>=0, m in NN>=1, K in Potential(n), Kc_(1..P) in Potential(n), rho in Weight(n), C in QQ>0, Cc_(1..P) in QQ>0, (forall w in Point(n) : (forall i : w_(i) <= rho_(i)) => exists j in NN>=1 : j <= P, Kc_(j)(w) <= 2^D * K(w)), (forall j in NN>=1 : j <= P => (Kc_(j) #outer lambda #multiplicity m #box rho #at Cc_(j) #from Lc #depth a #plus h)), Lc + D + 1 <= Lz, lambda * D <= E, 2^E * (sum p in 1..P, Cc_(p)) <= C : (K #outer lambda #multiplicity m #box rho #at C #from Lz #depth a #plus h)
  (inner): n, D, E, Lz, a, h, hu in NN, lambda in QQ>=0, m in NN>=1, K, Ku in Potential(n), rho in Weight(n), c, cu in QQ>0, (forall w in Point(n) : (forall i : w_(i) <= rho_(i)) => K(w) <= 2^D * Ku(w)), (Ku #inner lambda #multiplicity m #box rho #at cu #from Lz #depth a #plus hu), hu + a * D <= h, lambda * D <= E, 2^E * c <= cu : (K #inner lambda #multiplicity m #box rho #at c #from Lz #depth a #plus h)
  (points): n, P, D, E, Du, Eu, Lz, Lc, a, h, hu in NN, lambda in QQ>=0, m in NN>=1, K, Ku in Potential(n), Kc_(1..P) in Potential(n), rho in Weight(n), c, C, cu in QQ>0, Cc_(1..P) in QQ>0, (forall w in Point(n) : (forall i : w_(i) <= rho_(i)) => exists j in NN>=1 : j <= P, Kc_(j)(w) <= 2^D * K(w)), (forall j in NN>=1 : j <= P => (Kc_(j) #outer lambda #multiplicity m #box rho #at Cc_(j) #from Lc #depth a #plus h)), Lc + D + 1 <= Lz, lambda * D <= E, 2^E * (sum p in 1..P, Cc_(p)) <= C, (forall w in Point(n) : (forall i : w_(i) <= rho_(i)) => K(w) <= 2^Du * Ku(w)), (Ku #inner lambda #multiplicity m #box rho #at cu #from Lz #depth a #plus hu), hu + a * Du <= h, lambda * Du <= Eu, 2^Eu * c <= cu : (K #points lambda #multiplicity m #box rho #between c #and C #from Lz #depth a #plus h)
  origin: ?{\text{cited: the pair over a compact set is the least of the pairs at its points, through a finite subcover and a partition of unity \cite[Proposition~2.5 and its proof]{Lin2017}, and comparable functions have one pair \cite[Proposition~3.4 and Corollary~3.5]{Lin2017}; proved here: the counts of the points of the grid from above and from below, with their constants, at a given pair}}

-- (outer): a point of level \(L=L'+D\) for \(K\) is a point of level \(L'\) for a chart of the cover, so the counts of
-- the charts add up, at the factor \(2^{E}\) of the shift of level (core outlevel). (inner): \(K\le2^{D}K_u\) puts
-- every point of level \(L+D\) for \(K_u\) among the points of level \(L\) for \(K\) (core sub, core raise). (gap): at
-- a value \(\lambda_2\ge\lambda+1/q\) the extra power \(2^{t}\), with \(L<q(t+1)\), absorbs every power of \(L\) (core
-- shift, core lift); (same): a bound at a smaller multiplicity holds at a larger one. The pair over the box is the
-- least of the pairs at its points, through a finite subcover and a partition of unity
-- \cite[Proposition~2.5 and its proof]{Lin2017}, and comparable functions have one pair
-- \cite[Proposition~3.4 and Corollary~3.5]{Lin2017}; the rows above give the counts of the points of the grid from
-- above and from below, with their constants, at a given pair.
proof thm:cover
  "core read" with[L >= Lz by V[1 * h_3]; logic]
  "core readin" with[L >= Lz by V[1 * h_3]; logic]
  "core union" chain[(sum u <= b, iverson((u #sublevel K #depth N #level L))) <= (sum u <= b, sum p in 1..P, iverson((u #sublevel Kc_(p) #depth N #level Lp))) by sum[cases[(u #sublevel K #depth N #level L); with[(u #sublevel K #depth N #level L) => exists w in Point(n) : (forall i : 2^N * w_(i) = u_(i)), K(w) <= 1 / 2^L by unfold[logic]; logic[with[forall i : 2^N * w_(i) <= 2^N * rho_(i) by V; with[forall i : w_(i) <= rho_(i) by V; with[exists j in NN>=1 : j <= P, Kc_(j)(w) <= 2^D * K(w) by logic; with[1 / 2^Lp = 2^D / 2^L by lem:count(core mass)[l := Lp, O := D, m := L]; with[2^D * K(w) <= 2^D * (1 / 2^L) by mono; with[Kc_(j)(w) <= 1 / 2^Lp by V; with[(u #sublevel Kc_(j) #depth N #level Lp) by unfold[take[w := w; (logic, V)]]; chain[iverson((u #sublevel K #depth N #level L)) <= iverson((u #sublevel Kc_(j) #depth N #level Lp)) by logic; <= sum p in 1..P, iverson((u #sublevel Kc_(p) #depth N #level Lp)) by term[j]]]]]]]]]]]; chain[iverson((u #sublevel K #depth N #level L)) <= iverson(1 <= 0) by logic; = 0 by V[0]; <= sum p in 1..P, iverson((u #sublevel Kc_(p) #depth N #level Lp)) by sum[V[0]]]]]; = (sum p in 1..P, sum u <= b, iverson((u #sublevel Kc_(p) #depth N #level Lp))) by sum]
  "core sub" sum[cases[(u #sublevel Ku #depth N #level Lp); with[(u #sublevel Ku #depth N #level Lp) => exists w in Point(n) : (forall i : 2^N * w_(i) = u_(i)), Ku(w) <= 1 / 2^Lp by unfold[logic]; logic[with[forall i : 2^N * w_(i) <= 2^N * rho_(i) by V; with[forall i : w_(i) <= rho_(i) by V; with[K(w) <= 2^D * Ku(w) by logic; with[1 / 2^L = 2^D / 2^Lp by lem:count(core mass)[l := L, O := D, m := Lp]; with[2^D * Ku(w) <= 2^D * (1 / 2^Lp) by mono; with[K(w) <= 1 / 2^L by V; with[(u #sublevel K #depth N #level L) by unfold[take[w := w; (logic, V)]]; logic]]]]]]]]]; logic]]
  "core ratio" ind[m; with[a * b^1 = b * a^1 by eq; V[1 * hw1]]; chain[a * b^(m + 1) = b * (a * b^m) by eq; <= b * (b * a^m) by mono; <= a * (b * a^m) by mono; = b * a^(m + 1) by eq]]
  "core lower" with[Lp <= L by V[| 1 * h_3]; with[0 < Lp by V[1 * h_4]; with[0 < L by V[1 * h_4, 1 * hw1]; with[L * Lp^m <= Lp * L^m by thm:cover(core ratio)[a := L, b := Lp, m := m]; with[2^kappa <= 2^(kp + E) by mono; with[2^(kp + E) = 2^E * 2^kp by eq; with[Lp * (L * 2^kappa * S) <= Lp * (2^E * Cc * L^m * 2^F) by chain[Lp * (L * 2^kappa * S) <= Lp * (L * (2^E * 2^kp) * S) by mono; = 2^E * L * (Lp * 2^kp * S) by V; <= 2^E * L * (Cc * Lp^m * 2^F) by mono; = 2^E * Cc * 2^F * (L * Lp^m) by V; <= 2^E * Cc * 2^F * (Lp * L^m) by mono; = Lp * (2^E * Cc * L^m * 2^F) by V]; div[Lp; V[1 * hw7]]]]]]]]]
  "core raise" cases[L = 0; with[L <= 1 by V[1 * hc1]; with[L^m <= L^1 by mono; with[c * L^m * 2^F <= c * L^1 * 2^F by mono; with[c * L^1 * 2^F = 0 by eq; with[0 <= L * 2^kappa * S by V; V[1 * hw3, 1 * hw4, 1 * hw5]]]]]]; with[1 <= L by V[1 * hn1]; with[0 < L by V[1 * hw6]; with[0 < Lp by V[1 * hw7 | 1 * h_5]; with[L <= Lp by V[| 1 * h_5]; with[Lp * L^m <= L * Lp^m by thm:cover(core ratio)[a := Lp, b := L, m := m]; with[2^kp <= 2^(kappa + E) by mono; with[2^(kappa + E) = 2^E * 2^kappa by eq; with[Lp * (c * L^m * 2^F) <= Lp * (L * 2^kappa * S) by chain[Lp * (c * L^m * 2^F) = c * 2^F * (Lp * L^m) by V; <= c * 2^F * (L * Lp^m) by mono; = L * ((2^E * c) * Lp^m * 2^F) / 2^E by V; <= L * (cu * Lp^m * 2^F) / 2^E by mono; <= L * (Lp * 2^kp * Su) / 2^E by mono; <= L * (Lp * (2^E * 2^kappa) * Su) / 2^E by mono; = Lp * (L * 2^kappa * Su) by V; <= Lp * (L * 2^kappa * S) by mono]; div[Lp; V[1 * hw13]]]]]]]]]]]
  "core shift" with[q * (lambda + 1 / q) <= q * lambda2 by mono; with[q * (lambda + 1 / q) = q * lambda + 1 by V; with[(q * lambda + 1) * L <= (q * lambda2) * L by mono; with[q * kappa <= q * (lambda * L) by mono; with[q * (lambda2 * L) < q * (k2 + 1) by mono; with[L + q * kappa < q * k2 + q by V[1 * hw3, 1 * hw4, 1 * hw5]; with[kappa <= k2 by V; with[exists t in NN : kappa + t = k2 by take[t := max(k2 - kappa, 0); V[0]]; with[q * k2 = q * kappa + q * t by eq; take[t := t; (V, V[1 * hw6, 1 * hw9])]]]]]]]]]]
  "core decay" with[(sum j in 0..t, (j + 1)^m / 2^j) <= (prod i in 1..m, i) * 2^(m + 1) by lem:count(core geometric)[k := m, J := t]; with[(t + 1)^m / 2^t <= sum j in 0..t, (j + 1)^m / 2^j by term[t]; chain[L^m / 2^t <= (q * (t + 1))^m / 2^t by mono; = q^m * ((t + 1)^m / 2^t) by V; <= q^m * (sum j in 0..t, (j + 1)^m / 2^j) by mono; <= q^m * ((prod i in 1..m, i) * 2^(m + 1)) by mono; = q^m * (prod i in 1..m, i) * 2^(m + 1) by V]]]
  "core same" cases[L = 0; with[L * 2^kappa * S = 0 by eq; with[0 <= C2 * L^m * 2^E by V; V[1 * hw1, 1 * hw2]]]; with[1 <= L by V[1 * hn1]; with[L^m2 <= L^m by mono; chain[L * 2^kappa * S <= C2 * L^m2 * 2^E by V[1 * h_4]; <= C2 * L^m * 2^E by mono]]]]
  "core lift" with[L^m2 / 2^t <= q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) by thm:cover(core decay)[L := L, t := t, m := m2, q := q]; with[0 <= q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) by V; cases[L = 0; with[L * 2^kappa * S = 0 by eq; with[0 <= C2 * q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) * L^m * 2^E by V; V[1 * hw3, 1 * hw4]]]; with[1 <= L by V[1 * hn1]; with[1^m <= L^m by mono; with[1^m = 1 by V; with[0 <= C2 * q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) * 2^E by V; chain[L * 2^kappa * S = (L * 2^k2 * S) / 2^t by eq; <= (C2 * L^m2 * 2^E) / 2^t by mono; = C2 * (L^m2 / 2^t) * 2^E by V; <= C2 * (q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1)) * 2^E by mono; <= C2 * q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) * L^m * 2^E by V]]]]]]]]
  "core outlevel" with[forall i : b_(i) <= 2^N * rho_(i) by logic; with[(sum u <= b, iverson((u #sublevel K #depth N #level L))) <= sum p in 1..P, sum u <= b, iverson((u #sublevel Kc_(p) #depth N #level Lp)) by thm:cover(core union)[n := n, N := N, L := L, Lp := Lp, D := D, P := P, rho := rho, b := b, K := K, Kc_(p)(w) := Kc_(p)(w)]; with[(sum p in 1..P, L * 2^kappa * (sum u <= b, iverson((u #sublevel Kc_(p) #depth N #level Lp)))) <= sum p in 1..P, 2^E * Cc_(p) * L^m * 2^(n * N) by sum[with[Lp * 2^kp * (sum u <= b, iverson((u #sublevel Kc_(p) #depth N #level Lp))) <= Cc_(p) * Lp^m * 2^(n * N) by thm:cover(core read)[n := n, Lz := Lc, a := a, h := h, L := Lp, N := N, kappa := kp, lambda := lambda, m := m, K := Kc_(p), rho := rho, C := Cc_(p), b := b]; thm:cover(core lower)[L := L, Lp := Lp, D := D, kappa := kappa, kp := kp, E := E, F := n * N, m := m, S := (sum u <= b, iverson((u #sublevel Kc_(p) #depth N #level Lp))), Cc := Cc_(p)]]]; chain[L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= L * 2^kappa * (sum p in 1..P, sum u <= b, iverson((u #sublevel Kc_(p) #depth N #level Lp))) by mono; = sum p in 1..P, L * 2^kappa * (sum u <= b, iverson((u #sublevel Kc_(p) #depth N #level Lp))) by sum; <= sum p in 1..P, 2^E * Cc_(p) * L^m * 2^(n * N) by V[1 * hw3]; = (2^E * L^m * 2^(n * N)) * (sum p in 1..P, Cc_(p)) by sum; = (2^E * (sum p in 1..P, Cc_(p))) * (L^m * 2^(n * N)) by V; <= C * (L^m * 2^(n * N)) by mono; = C * L^m * 2^(n * N) by V]]]]
  (same) (logic[with[L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C2 * L^m2 * 2^(n * N) by thm:cover(core read)[n := n, Lz := Lz, a := a, h := h, L := L, N := N, kappa := kappa, lambda := lambda, m := m2, K := K, rho := rho, C := C2, b := b]; with[L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C2 * L^m * 2^(n * N) by thm:cover(core same)[L := L, m := m, m2 := m2, kappa := kappa, E := n * N, S := (sum u <= b, iverson((u #sublevel K #depth N #level L))), C2 := C2]; with[C2 * L^m * 2^(n * N) <= C * L^m * 2^(n * N) by mono; V[1 * hw2, 1 * hw3]]]]])
  (gap) (logic[with[exists k2 in NN : k2 <= lambda2 * L, lambda2 * L < k2 + 1 by fact:floor(core)[x := lambda2 * L]; with[exists t in NN : kappa + t = k2, L < q * (t + 1) by thm:cover(core shift)[L := L, kappa := kappa, k2 := k2, q := q, lambda := lambda, lambda2 := lambda2]; with[L * 2^k2 * (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C2 * L^m2 * 2^(n * N) by thm:cover(core read)[n := n, Lz := Lz, a := a, h := h, L := L, N := N, kappa := k2, lambda := lambda2, m := m2, K := K, rho := rho, C := C2, b := b]; with[L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C2 * q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) * L^m * 2^(n * N) by thm:cover(core lift)[L := L, t := t, kappa := kappa, k2 := k2, m := m, m2 := m2, E := n * N, q := q, S := (sum u <= b, iverson((u #sublevel K #depth N #level L))), C2 := C2]; with[C2 * q^m2 * (prod i in 1..m2, i) * 2^(m2 + 1) * L^m * 2^(n * N) <= C * L^m * 2^(n * N) by mono; V[1 * hw4, 1 * hw5]]]]]]])
  (outer) (logic[with[Lz <= L by logic; with[D + 1 < L + 1 by V[1 * h_4, 1 * hw1]; with[1 <= D + 1 by V[0]; with[1 <= L + 1 by V[0]; with[exists g in NN>=1 : D + 1 + g = L + 1 by fact:gap(core)[u := D + 1, v := L + 1]; logic[with[D + 1 + g = L + 1 by logic; with[exists Lp in NN : L = Lp + D by take[Lp := g; V[1 * hw6]]; with[exists kp in NN : kp <= lambda * Lp, lambda * Lp < kp + 1 by fact:floor(core)[x := lambda * Lp]; with[lambda * (Lp + D) = lambda * Lp + lambda * D by eq; with[kappa <= kp + E by V; with[Lp >= Lc by V; with[1 <= Lp by V; with[a * Lp <= a * (Lp + D) by mono; with[N >= a * Lp + h by V; thm:cover(core outlevel)[n := n, P := P, D := D, E := E, Lc := Lc, a := a, h := h, L := Lp + D, Lp := Lp, N := N, kappa := kappa, kp := kp, lambda := lambda, m := m, K := K, Kc_(p)(w) := Kc_(p)(w), rho := rho, C := C, Cc_(p) := Cc_(p), b := b; Lp + D = Lp + D by V[0]]]]]]]]]]]]]]]]]])
  (inner) (logic[with[exists Lp in NN : Lp = L + D by take[Lp := L + D; V[0]]; with[exists kp in NN : kp <= lambda * Lp, lambda * Lp < kp + 1 by fact:floor(core)[x := lambda * Lp]; with[lambda * Lp = lambda * L + lambda * D by eq; with[kp <= kappa + E by V; with[Lp >= Lz by V; with[a * Lp = a * L + a * D by eq; with[N >= a * Lp + hu by V; with[forall i : b_(i) <= 2^N * rho_(i) by logic; with[cu * Lp^m * 2^(n * N) <= Lp * 2^kp * (sum u <= b, iverson((u #sublevel Ku #depth N #level Lp))) by thm:cover(core readin)[n := n, Lz := Lz, a := a, h := hu, L := Lp, N := N, kappa := kp, lambda := lambda, m := m, K := Ku, rho := rho, c := cu, b := b]; with[(sum u <= b, iverson((u #sublevel Ku #depth N #level Lp))) <= sum u <= b, iverson((u #sublevel K #depth N #level L)) by thm:cover(core sub)[n := n, N := N, L := L, Lp := Lp, D := D, rho := rho, b := b, K := K, Ku := Ku]; thm:cover(core raise)[L := L, Lp := Lp, D := D, kappa := kappa, kp := kp, E := E, F := n * N, m := m, Su := (sum u <= b, iverson((u #sublevel Ku #depth N #level Lp))), S := (sum u <= b, iverson((u #sublevel K #depth N #level L))), c := c, cu := cu]]]]]]]]]]]])
  (points) thm:cover(inner)[n := n, D := Du, E := Eu, Lz := Lz, a := a, h := h, hu := hu, lambda := lambda, m := m, K := K, Ku := Ku, rho := rho, c := c, cu := cu], thm:cover(outer)[n := n, P := P, D := D, E := E, Lz := Lz, Lc := Lc, a := a, h := h, lambda := lambda, m := m, K := K, Kc_(p)(w) := Kc_(p)(w), rho := rho, C := C, Cc_(p) := Cc_(p)]
