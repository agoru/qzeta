-- Q++ 0.2
module loop
uses string, glue, onevar

subsection sec:loop A closed chain

-- A string of a chain of weights \(b_j\) is a row of masses tied cell by cell, \(x_j+x_{j+2}=b_jx_{j+1}\). Two strings of one chain cross alike at every cell (cross), so the cross product, \(x_jy_{j+1}\) against \(y_jx_{j+1}\), moves by one mass \(D\) along the chain (oneway). Each mass of a string is read on its first two by the determinants of the chain from its first cell and from its second, \(x_{n+2}+e_nx_1=d_{n+1}x_2\) (pair). When a positive string comes back to its first two masses, the chain is closed and its determinants tie with two, \(d_{M+2}=e_M+2\) (trace). Read from its meetings, the closed chain of \(n\) cells is the table \(P_{ij}\) that counts the edges from cell \(i\) to cell \(j\) both ways: it is symmetric and every cell meets two (core sym, core degree). The mean laws then hold on the chain with the degree two, and at its prices the glue laws; fed at one cell, the chain has one price (fed): the cells with no spoke tie term by term and the fed cell ties by the sum of the set.
lemma lem:loop [a closed chain]
  (cross): N in NN>=1, b_(1..N) in QQ>0, x_(1..N + 2) in QQ>0, y_(1..N + 2) in QQ>=0, (forall j in NN>=1 : j <= N => x_(j) + x_(j + 2) = b_(j) * x_(j + 1)), (forall j in NN>=1 : j <= N => y_(j) + y_(j + 2) = b_(j) * y_(j + 1)) : forall j in NN>=1 : j <= N => x_(j) * y_(j + 1) + y_(j + 1) * x_(j + 2) = y_(j) * x_(j + 1) + x_(j + 1) * y_(j + 2)
  fix (cross) loop.cross
  neqfix (cross) loop.cross.norow
  core way: n, N in NN>=1, x_(1..N + 2) in QQ>0, y_(1..N + 2) in QQ>=0, D in QQ>=0, (forall j in NN>=1 : j <= N => x_(j) * y_(j + 1) + y_(j + 1) * x_(j + 2) = y_(j) * x_(j + 1) + x_(j + 1) * y_(j + 2)), x_(1) * y_(2) = y_(1) * x_(2) + D : n <= N + 1 => x_(n) * y_(n + 1) = y_(n) * x_(n + 1) + D
  (oneway): N in NN>=1, x_(1..N + 2) in QQ>0, y_(1..N + 2) in QQ>=0, D in QQ>=0, (forall j in NN>=1 : j <= N => x_(j) * y_(j + 1) + y_(j + 1) * x_(j + 2) = y_(j) * x_(j + 1) + x_(j + 1) * y_(j + 2)), x_(1) * y_(2) = y_(1) * x_(2) + D : forall j in NN>=1 : j <= N + 1 => x_(j) * y_(j + 1) = y_(j) * x_(j + 1) + D
  fix (oneway) loop.oneway
  neqfix (oneway) loop.oneway.nomove
  core pair: n, N in NN>=1, b_(1..N) in QQ>0, x_(1..N + 2) in QQ>0, d_(1..N + 1) in QQ>0, e_(1..N) in QQ>0, d_(1) = 1, d_(2) = b_(1), e_(1) = 1, e_(2) = b_(2), (forall j in NN>=1 : j <= N => x_(j) + x_(j + 2) = b_(j) * x_(j + 1)), (forall j in NN>=1 : j + 1 <= N => d_(j) + d_(j + 2) = b_(j + 1) * d_(j + 1)), (forall j in NN>=1 : j + 2 <= N => e_(j) + e_(j + 2) = b_(j + 2) * e_(j + 1)) : n + 1 <= N => (x_(n + 2) + e_(n) * x_(1) = d_(n + 1) * x_(2), x_(n + 1 + 2) + e_(n + 1) * x_(1) = d_(n + 1 + 1) * x_(2))
  (pair): N in NN>=1, b_(1..N) in QQ>0, x_(1..N + 2) in QQ>0, d_(1..N + 1) in QQ>0, e_(1..N) in QQ>0, d_(1) = 1, d_(2) = b_(1), e_(1) = 1, e_(2) = b_(2), (forall j in NN>=1 : j <= N => x_(j) + x_(j + 2) = b_(j) * x_(j + 1)), (forall j in NN>=1 : j + 1 <= N => d_(j) + d_(j + 2) = b_(j + 1) * d_(j + 1)), (forall j in NN>=1 : j + 2 <= N => e_(j) + e_(j + 2) = b_(j + 2) * e_(j + 1)) : forall n in NN>=1 : n + 1 <= N => x_(n + 2) + e_(n) * x_(1) = d_(n + 1) * x_(2)
  fix (pair) loop.pair
  neqfix (pair) loop.pair.nostart
  (trace): M in NN>=1, b_(1..M + 1) in QQ>0, x_(1..M + 3) in QQ>0, d_(1..M + 2) in QQ>0, e_(1..M + 1) in QQ>0, d_(1) = 1, d_(2) = b_(1), e_(1) = 1, e_(2) = b_(2), (forall j in NN>=1 : j <= M + 1 => x_(j) + x_(j + 2) = b_(j) * x_(j + 1)), (forall j in NN>=1 : j + 1 <= M + 1 => d_(j) + d_(j + 2) = b_(j + 1) * d_(j + 1)), (forall j in NN>=1 : j + 2 <= M + 1 => e_(j) + e_(j + 2) = b_(j + 2) * e_(j + 1)), x_(M + 2) = x_(1), x_(M + 3) = x_(2) : d_(M + 2) = e_(M) + 2
  fix (trace) loop.trace
  neqfix (trace) loop.trace.noclose
  core sym: n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)) : forall i : forall j : P_(i)_(j) = P_(j)_(i)
  core degree: n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)) : forall i : (sum j, P_(i)_(j)) = 2
  (one): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, x in Weight(n), y in Point(n), (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (forall i : (sum j, P_(i)_(j) * y_(j)) = b_(i) * y_(i)) : forall i : forall j : P_(i)_(j) * x_(i) * y_(j) = P_(i)_(j) * y_(i) * x_(j)
  fix (one) loop.one
  neqfix (one) loop.one.nostring
  (flat): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, x in Weight(n), (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (forall i : 2 <= b_(i)) : forall i : b_(i) = 2
  fix (flat) loop.flat
  neqfix (flat) loop.flat.nostring
  (flatdown): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, x in Weight(n), (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (forall i : b_(i) <= 2) : forall i : b_(i) = 2
  fix (flatdown) loop.flatdown
  neqfix (flatdown) loop.flatdown.nostring
  (form): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, x in Weight(n), u in Point(n), (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)) : (sum i, sum j, P_(i)_(j) * u_(i) * u_(j)) <= (sum i, b_(i) * u_(i)^2)
  fix (form) loop.form
  neqfix (form) loop.form.nostring
  (null): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, x in Weight(n), u in Point(n), (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (sum i, sum j, P_(i)_(j) * u_(i) * u_(j)) = (sum i, b_(i) * u_(i)^2) : forall i : forall j : P_(i)_(j) * x_(j) * u_(i) = P_(i)_(j) * x_(i) * u_(j)
  fix (null) loop.null
  neqfix (null) loop.null.notie
  (price): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, N in Weight(n), nu, A, B, K in Point(n), (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) = b_(i) * nu_(i) + K_(i)), (forall i : N_(i) * B_(i) <= nu_(i) * A_(i) + N_(i) * K_(i)) : forall i : forall j : P_(i)_(j) * N_(i) * nu_(j) = P_(i)_(j) * nu_(i) * N_(j)
  fix (price) loop.price
  neqfix (price) loop.price.notie
  (pricedown): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, N in Weight(n), nu, A, B, K in Point(n), (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) = b_(i) * nu_(i) + K_(i)), (forall i : nu_(i) * A_(i) + N_(i) * K_(i) <= N_(i) * B_(i)) : forall i : forall j : P_(i)_(j) * N_(i) * nu_(j) = P_(i)_(j) * nu_(i) * N_(j)
  fix (pricedown) loop.pricedown
  neqfix (pricedown) loop.pricedown.notie
  (tied): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, N in Weight(n), nu, A, B, K in Point(n), (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) = b_(i) * nu_(i) + K_(i)), (forall i : forall j : P_(i)_(j) * N_(i) * nu_(j) = P_(i)_(j) * nu_(i) * N_(j)) : forall i : N_(i) * B_(i) = nu_(i) * A_(i) + N_(i) * K_(i)
  fix (tied) loop.tied
  neqfix (tied) loop.tied.noprice
  (fed): n in NN>=1, P in Forms(n, n), e_(1..n) in NN>=1, f_(1..n) in NN>=1, b, N in Weight(n), nu, A, B, K in Point(n), S in NN>=1, c_(1..S) in NN>=1, a_(1..S) in QQ>0, d_(1..S) in QQ>0, w_(1..S) in QQ>0, (forall m in NN>=1 : m <= n => e_(m) = m), (forall m in NN>=1 : m < n => f_(m) = m + 1), (forall m in NN>=1 : m = n => f_(m) = 1), (forall i : forall j : P_(i)_(j) = (sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)), (forall i : (sum j, P_(i)_(j) * N_(j)) + A_(i) = b_(i) * N_(i)), (forall i : (sum j, P_(i)_(j) * nu_(j)) + B_(i) = b_(i) * nu_(i) + K_(i)), (forall s in NN>=1 : s <= S => c_(s) = 1), (forall j : A_(j) = (sum s in 1..S : c_(s) = j, a_(s))), (forall j : B_(j) = (sum s in 1..S : c_(s) = j, d_(s))), (forall j : K_(j) = (sum s in 1..S : c_(s) = j, w_(s))) : forall i : forall j : P_(i)_(j) * N_(i) * nu_(j) = P_(i)_(j) * nu_(i) * N_(j)
  fix (fed) loop.fed
  neqfix (fed) loop.fed.notfed
  origin: ?{\text{form proved: the two rows of masses cross alike cell by cell, so their cross product moves by one mass along the chain; with (cross), (edge) of \cref{lem:string} is the case}\ x=c,\ y=(0,d_1,\dots,d_{N+1}),\ D=c_1\text{, and (share) of \cref{lem:string} is that case read in the quotients}\ y_j/x_j\ \text{and added up; (cross) and (pair) hold on every string, and (trace) is (pair) at the cell where the chain comes back, the first mass cancelled; read from its meetings, the closed chain is a table of \cref{lem:mean} and \cref{lem:glue}, symmetric with every degree two, so that (one), (flat), (flatdown), (form), (null) are those of \cref{lem:mean} and (price), (pricedown), (tied) those of \cref{lem:glue} at it, and (fed) is (set) of \cref{lem:glue} split at the fed cell and then (price) of \cref{lem:glue}}}

proof lem:loop
  (cross) with[x_(j) + x_(j + 2) = b_(j) * x_(j + 1) by logic; with[y_(j) + y_(j + 2) = b_(j) * y_(j + 1) by logic; V[y_(j + 1) * hw1, x_(j + 1) * hw2]]]
  "core way" ind[n; V[1 * h_4]; with[n <= N by V[1 * hi2]; with[n <= N + 1 by V[1 * hi2]; with[x_(n) * y_(n + 1) = y_(n) * x_(n + 1) + D by logic; with[x_(n) * y_(n + 1) + y_(n + 1) * x_(n + 1 + 1) = y_(n) * x_(n + 1) + x_(n + 1) * y_(n + 1 + 1) by logic; V[1 * hw4, 1 * hw3]]]]]]
  (oneway) with[(j <= N + 1 => x_(j) * y_(j + 1) = y_(j) * x_(j + 1) + D) by lem:loop(core way)[n := j, N := N, x := x, y := y, D := D]; logic]
  "core pair" ind[n; with[1 <= N by V[1 * hi1]; with[x_(1) + x_(1 + 2) = b_(1) * x_(2) by logic; with[d_(1 + 1) = b_(1) by V[1 * h_2]; (V[1 * hw2, x_(1) * h_3, x_(2) * hw3], with[x_(1 + 1) + x_(1 + 1 + 2) = b_(1 + 1) * x_(1 + 1 + 1) by logic; with[d_(1) + d_(1 + 2) = b_(1 + 1) * d_(1 + 1) by logic; with[1 = d_(1) by V[1 * h_1]; with[d_(1 + 1 + 1) + 1 = b_(1 + 1) * b_(1) by V[1 * hw5, 1 * hw6, b_(1 + 1) * hw3]; with[b_(1 + 1) * b_(1) = d_(1 + 1 + 1) + 1 by V[1 * hw7]; with[e_(1 + 1) = b_(1 + 1) by V[1 * h_4]; V[1 * hw4, b_(1 + 1) * hw2, x_(1) * hw9, x_(2) * hw8]]]]]]])]]]; with[n + 1 <= N by V[1 * hi2]; with[x_(n + 2) + e_(n) * x_(1) = d_(n + 1) * x_(2) by logic; with[x_(n + 1 + 2) + e_(n + 1) * x_(1) = d_(n + 1 + 1) * x_(2) by logic; with[x_(n + 2) + x_(n + 1 + 1 + 2) = b_(n + 2) * x_(n + 1 + 2) by logic; with[d_(n + 1) + d_(n + 1 + 1 + 1) = b_(n + 2) * d_(n + 1 + 1) by logic; with[1 <= n + 2 by V; with[n + 2 <= N by V[1 * hi2]; with[e_(n) + e_(n + 1 + 1) = b_(n + 2) * e_(n + 1) by logic; with[x_(n + 2) + x_(n + 1 + 1 + 2) + (e_(n) + e_(n + 1 + 1)) * x_(1) = b_(n + 2) * d_(n + 1 + 1) * x_(2) by V[1 * hw13, x_(1) * hw17, b_(n + 2) * hw12]; (V[1 * hw12], V[1 * hw18, 1 * hw11, x_(2) * hw14])]]]]]]]]]]
  (pair) with[(n + 1 <= N => (x_(n + 2) + e_(n) * x_(1) = d_(n + 1) * x_(2), x_(n + 1 + 2) + e_(n + 1) * x_(1) = d_(n + 1 + 1) * x_(2))) by lem:loop(core pair)[n := n, N := N, b := b, x := x, d := d, e := e]; logic]
  (trace) with[1 <= M + 1 by V; with[M + 1 <= M + 1 by V; with[(M + 1 <= M + 1 => (x_(M + 2) + e_(M) * x_(1) = d_(M + 1) * x_(2), x_(M + 1 + 2) + e_(M + 1) * x_(1) = d_(M + 1 + 1) * x_(2))) by lem:loop(core pair)[n := M, N := M + 1, b := b, x := x, d := d, e := e]; with[x_(M + 2) + e_(M) * x_(1) = d_(M + 1) * x_(2) by logic; with[(M + 1 <= M + 1 => d_(M + 1 + 1) * x_(M + 1 + 1) = d_(M + 1) * x_(M + 1 + 2) + x_(1)) by lem:string(core edge)[n := M + 1, N := M + 1, b := b, c := x, d := d]; with[d_(M + 2) * x_(M + 2) = d_(M + 1) * x_(M + 3) + x_(1) by logic; with[d_(M + 2) * x_(1) = d_(M + 1) * x_(2) + x_(1) by V[1 * hw6, d_(M + 2) * h_8, d_(M + 1) * h_9]; with[x_(1) + e_(M) * x_(1) = d_(M + 1) * x_(2) by V[1 * hw4, 1 * h_8]; with[d_(M + 2) * x_(1) = (e_(M) + 2) * x_(1) by V[1 * hw7, 1 * hw8]; with[(e_(M) + 2) * x_(1) = d_(M + 2) * x_(1) by V[1 * hw9]; cases[d_(M + 2) < e_(M) + 2; with[d_(M + 2) * x_(1) < (e_(M) + 2) * x_(1) by V[x_(1) * hc1]; with[(e_(M) + 2) * x_(1) <= d_(M + 2) * x_(1) by V[1 * hw10]; logic]]; cases[e_(M) + 2 < d_(M + 2); with[(e_(M) + 2) * x_(1) < d_(M + 2) * x_(1) by V[x_(1) * hc2]; with[d_(M + 2) * x_(1) <= (e_(M) + 2) * x_(1) by V[1 * hw9]; logic]]; V[hn2], V[hn1]]]]]]]]]]]]]
  "core sym" V[1 * h_4(i, j), 1 * h_4(j, i)]
  "core degree" with[(sum j, P_(i)_(j)) = sum j, ((sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1)) by sum[logic]; with[(sum j, ((sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum m in 1..n : e_(m) = j, f_(m) = i, 1))) = (sum j, sum m in 1..n : e_(m) = i, f_(m) = j, 1) + (sum j, sum m in 1..n : e_(m) = j, f_(m) = i, 1) by sum[V[0]]; with[(sum j, sum m in 1..n : e_(m) = i, f_(m) = j, 1) = sum m in 1..n : e_(m) = i, (sum j : f_(m) = j, 1) by sum; with[(sum m in 1..n : e_(m) = i, (sum j : f_(m) = j, 1)) = (sum m in 1..n : e_(m) = i, m < n, (sum j : f_(m) = j, 1)) + (sum m in 1..n : e_(m) = i, m = n, (sum j : f_(m) = j, 1)) by trichotomy; with[(sum m in 1..n : e_(m) = i, m < n, (sum j : f_(m) = j, 1)) = sum m in 1..n : e_(m) = i, m < n, 1 by sum[with[f_(m) = m + 1 by logic; with[m + 1 <= n by V; with[f_(m) <= n by V[1 * hw6, 1 * hw7]; sum]]]]; with[(sum m in 1..n : e_(m) = i, m = n, (sum j : f_(m) = j, 1)) = sum m in 1..n : e_(m) = i, m = n, 1 by sum[with[f_(m) = 1 by logic; with[f_(m) <= n by V[1 * hw10, 1 * hp(n)]; sum]]]; with[(sum m in 1..n : e_(m) = i, 1) = (sum m in 1..n : e_(m) = i, m < n, 1) + (sum m in 1..n : e_(m) = i, m = n, 1) by trichotomy; with[(sum m in 1..n : e_(m) = i, 1) = sum m in 1..n : m = i, 1 by same[h_1]; with[(sum m in 1..n : m = i, 1) = 1 by sum; with[(sum j, sum m in 1..n : e_(m) = j, f_(m) = i, 1) = (sum j, sum m in 1..n : f_(m) = i, e_(m) = j, 1) by sum[same]; with[(sum j, sum m in 1..n : f_(m) = i, e_(m) = j, 1) = sum m in 1..n : f_(m) = i, (sum j : e_(m) = j, 1) by sum; with[(sum m in 1..n : f_(m) = i, (sum j : e_(m) = j, 1)) = sum m in 1..n : f_(m) = i, 1 by sum[with[m <= n by V; with[e_(m) <= n by V[1 * h_1_m, 1 * hw18]; sum]]]; with[(sum m in 1..n : f_(m) = i, 1) = 1 by cases[1 < i; with[1 <= i by logic; with[exists k in NN>=1 : 1 + k = i by fact:gap(core)[u := 1, v := i]; with[1 + k = i by logic; with[(sum m in 1..n : f_(m) = i, 1) = sum m in 1..n : f_(m) = i, m < n, 1 by trichotomy[with[f_(m) = 1 by 