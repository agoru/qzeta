  "core step" (with[2 * b + i <= l by V[1 * hi1]; with[2 * b + 1 + i <= l by V[1 * hi1]; with[(sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, i)) = (sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, i)) by logic; with[(sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, i)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, i)) by logic; with[(sum m in 0..D, P_(m) * d_(m)^((2 * b) + 1) * binom(m, i)) + c * (sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, i)) + i * (sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, i)) + (i + 1) * (sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, i + 1)) = (sum m in 0..D, Q_(m) * d_(m)^((2 * b) + 1) * binom(m, i)) + c * (sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, i)) + i * (sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, i)) + (i + 1) * (sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, i + 1)) by lem:moments(core tie)[D := D, i := i, a := 2 * b, c := c, p := p, q := q, P := P, Q := Q, d := d]; V]]]]], with[2 * (b + 1) + i <= l by V[1 * hi2]; with[2 * b + 1 + i <= l by V[1 * hi2]; with[(sum m in 0..D, p_(m) * d_(m)^(2 * (b + 1)) * binom(m, i)) = (sum m in 0..D, q_(m) * d_(m)^(2 * (b + 1)) * binom(m, i)) by logic; with[(sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, i)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, i)) by logic; with[(sum m in 0..D, p_(m) * d_(m)^((2 * b + 1) + 1) * binom(m, i)) = (sum m in 0..D, p_(m) * d_(m)^(2 * (b + 1)) * binom(m, i)) by sum[V]; with[(sum m in 0..D, q_(m) * d_(m)^((2 * b + 1) + 1) * binom(m, i)) = (sum m in 0..D, q_(m) * d_(m)^(2 * (b + 1)) * binom(m, i)) by sum[V]; with[(sum m in 0..D, p_(m) * d_(m)^((2 * b + 1) + 1) * binom(m, i)) + c * (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, i)) + i * (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, i)) + (i + 1) * (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, i + 1)) = (sum m in 0..D, q_(m) * d_(m)^((2 * b + 1) + 1) * binom(m, i)) + c * (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, i)) + i * (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, i)) + (i + 1) * (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, i + 1)) by lem:moments(core tie)[D := D, i := i, a := 2 * b + 1, c := c, p := P, q := Q, P := p, Q := q, d := d]; V]]]]]]])
  "core forms" with[((forall m in NN : m <= D => P_(m) * d_(m) + m * q_(m) + c * p_(m) = Q_(m) * d_(m) + m * p_(m) + c * q_(m)), (forall m in NN : m <= D => p_(m) * d_(m) + m * Q_(m) + c * P_(m) = q_(m) * d_(m) + m * P_(m) + c * Q_(m))) by lem:moments(core nodes)[D := D, c := c, p := p, q := q, P := P, Q := Q, d := d]; ind[k; (with[2 * b <= l by V[1 * hi1]; with[(sum m in 0..D, p_(m) * d_(m)^(2 * b)) = (sum m in 0..D, q_(m) * d_(m)^(2 * b)) by logic; with[(sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, 0)) = (sum m in 0..D, p_(m) * d_(m)^(2 * b)) by sum[V]; with[(sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, 0)) = (sum m in 0..D, q_(m) * d_(m)^(2 * b)) by sum[V]; V[1 * hw3, 1 * hw4, 1 * hw5]]]]], with[2 * b + 1 <= l by V[1 * hi2]; with[(sum m in 0..D, P_(m) * d_(m)^(2 * b + 1)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1)) by logic; with[(sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, 0)) = (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1)) by sum[V]; with[(sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, 0)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1)) by sum[V]; V[hw7, hw8, hw9]]]]]); lem:moments(core step)[D := D, i := k, l := l, c := c, p := p, q := q, P := P, Q := Q, d := d]]]
  (1) with[((forall b in NN : 2 * b + i <= l => (sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, i)) = (sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, i))), (forall b in NN : 2 * b + 1 + i <= l => (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, i)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, i)))) by lem:moments(core forms)[D := D, l := l, k := i, c := c, p := p, q := q, P := P, Q := Q, d := d]; with[2 * 0 + i <= l by V[1 * hi1]; with[(sum m in 0..D, p_(m) * d_(m)^(2 * 0) * binom(m, i)) = (sum m in 0..D, q_(m) * d_(m)^(2 * 0) * binom(m, i)) by logic; with[(sum m in 0..D, p_(m) * binom(m, i)) = (sum m in 0..D, p_(m) * d_(m)^(2 * 0) * binom(m, i)) by sum[V]; with[(sum m in 0..D, q_(m) * binom(m, i)) = (sum m in 0..D, q_(m) * d_(m)^(2 * 0) * binom(m, i)) by sum[V]; V[1 * hw3, 1 * hw4, 1 * hw5]]]]]]

-- The levels of a divided difference bound its gaps: on nodes with gaps \(e_j\) and total \(D\), the level \(T_j\) of a
-- piece is the size of the divided difference of the step there, and levels between \(t\) and \(s\) give every gap
-- \(tD\le C(v+2)^vse_r\) (gap). Its rows come from the recurrence of divided differences \cite[Section~5]{deBoor2005},
-- read in sizes on the grid of windows, where Pascal's rule bounds each level by binomial coefficients (grid, rec), and
-- the levels of given knots obey it (knots). That the levels of a witness are these is not typed here.
lemma lem:levels [the gaps from the levels]
  core up: k, ca, cb in NN, e, D, Da, Db in QQ>0, Ts, To, Tas, Tao, Tbs, Tbo in QQ>=0, ca + Tao * e * Da^k <= Tas * e * Da^k, cb + Tbo * e * Db^k <= Tbs * e * Db^k, Da <= D, Db <= D, Ts * D + Tao + Tbo = To * D + Tas + Tbs : ca + cb + To * e * D^(k + 1) <= Ts * e * D^(k + 1)
  fix core up levels.up
  neqfix core up levels.up.far
  core down: k, ca, cb in NN, e, D, Da, Db in QQ>0, Ts, To, Tas, Tao, Tbs, Tbo in QQ>=0, Tao <= Tas, Tbo <= Tbs, Tas * e^k * Da <= ca + Tao * e^k * Da, Tbs * e^k * Db <= cb + Tbo * e^k * Db, e <= Da, e <= Db, Ts * D + Tao + Tbo = To * D + Tas + Tbs : Ts * e^(k + 1) * D <= ca + cb + To * e^(k + 1) * D
  fix core down levels.down
  neqfix core down levels.down.near
  core window: k, c, ca, cb in NN, e in QQ>0, D, Da, Db, Ts, To, Tas, Tao, Tbs, Tbo in QQ>=0, c = ca + cb, e <= Da, e <= Db, Da <= D, Db <= D, D * Ts + Tao + Tbo = D * To + Tas + Tbs, ca + Tao * e * Da^k <= Tas * e * Da^k, Tas * e^k * Da <= ca + Tao * e^k * Da, cb + Tbo * e * Db^k <= Tbs * e * Db^k, Tbs * e^k * Db <= cb + Tbo * e^k * Db : (e <= D, c + To * e * D^(k + 1) <= Ts * e * D^(k + 1), Ts * e^(k + 1) * D <= c + To * e^(k + 1) * D)
  fix core window levels.window
  neqfix core window levels.window.far
  core edge: k, c, ca in NN, e in QQ>0, D, Da, Ts, To, Tas, Tao in QQ>=0, c = ca, e <= Da, Da <= D, D * Ts + Tao = D * To + Tas, ca + Tao * e * Da^k <= Tas * e * Da^k, Tas * e^k * Da <= ca + Tao * e^k * Da : (e <= D, c + To * e * D^(k + 1) <= Ts * e * D^(k + 1), Ts * e^(k + 1) * D <= c + To * e^(k + 1) * D)
  fix core edge levels.edge
  neqfix core edge levels.edge.far
  core restore: m, t, s, M, K, e, D in QQ>0, eps in QQ>=0, m <= t + eps, s <= M + eps, t * D <= K * s * e : m * D <= K * (M + eps) * e + eps * D
  fix core restore levels.restore
  neqfix core restore levels.restore.top
  core rstar: n in NN, m, K, e in QQ>0, eps in QQ>=0, m <= 1, n * eps <= m, m <= K * (1 + eps) * e + eps : n * m <= (n + 1) * K * e + m
  fix core rstar levels.rstar
  neqfix core rstar levels.rstar.eps
  core node: x, y, z, u in QQ>=0, s, dl, dr, K, K1, l, R, R1 in QQ>0, K * dl = K1, R * dr = R1, x * (K1 * l * R1) = u, u = y * (K * l * R1), u = z * (K1 * l * R), s = dl + dr : s * x = y + z
  fix core node levels.node
  neqfix core node levels.node.sum
  core end: x, y, u in QQ>=0, s, K, K1, l, R in QQ>0, K * s = K1, x * (K1 * l * R) = u, u = y * (K * l * R) : s * x = y
  fix core end levels.end
  neqfix core end levels.end.size
  core rec: a, q in NN, L_(1..a + 1), r_(1..q + 1) in QQ>0, u_(0..q + 1) in QQ>=0 : ((sum j in 1..a + 1, L_(j)) + (sum j in 1..q + 1, r_(j))) * (sum m in 0..q + 1, u_(m) / ((prod k in 1..a + 1, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..q + 1, (sum j in m + 1..g, r_(j))))) = (sum m in 0..q + 1, u_(m) / ((prod k in 1..a, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..q + 1, (sum j in m + 1..g, r_(j))))) + (sum m in 0..q, u_(m) / ((prod k in 1..a + 1, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..q, (sum j in m + 1..g, r_(j)))))
  fix core rec levels.rec
  core recedge: a in NN, L_(1..a + 1), r_(1..1) in QQ>0, u_(0..1) in QQ>=0 : (sum j in 1..a + 1, L_(j)) * (sum m in 0..0, u_(m) / ((prod k in 1..a + 1, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..0, (sum j in m + 1..g, r_(j))))) = (sum m in 0..0, u_(m) / ((prod k in 1..a, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..0, (sum j in m + 1..g, r_(j)))))
  fix core recedge levels.recedge
  core sides: P, Q, N in NN, W_(0..P), S_(0..P), O_(0..P) in Line, (forall p in NN : p <= P => forall q in NN : q <= Q => 0 < W_(p)(q)), O_(0)(0) <= S_(0)(0), (forall q in NN : q < Q => W_(0)(q + 1) * S_(0)(q + 1) + O_(0)(q) = W_(0)(q + 1) * O_(0)(q + 1) + S_(0)(q)), (forall p in NN : p < P => W_(p + 1)(0) * S_(p + 1)(0) = S_(p)(0)), (forall p in NN : p < P => W_(p + 1)(0) * O_(p + 1)(0) = O_(p)(0)), (forall p in NN : p < P => forall q in NN : q < Q => W_(p + 1)(q + 1) * S_(p + 1)(q + 1) = S_(p)(q + 1) + S_(p + 1)(q)), (forall p in NN : p < P => forall q in NN : q < Q => W_(p + 1)(q + 1) * O_(p + 1)(q + 1) = O_(p)(q + 1) + O_(p + 1)(q)) : forall p in NN : forall q in NN : p + q = N => p <= P => q <= Q => O_(p)(q) <= S_(p)(q)
  fix core sides levels.sides
  neqfix core sides levels.sides.base
  (gap): v, C in NN, t, s, D in QQ>0, e_(1..v + 2), T_(1..v + 2) in QQ>0, c_(1..v + 2) in NN>=1, D = (sum j in 1..v + 2, e_(j)), C = (sum j in 1..v + 2, c_(j)), (forall j in NN>=1 : j <= v + 2 => t <= T_(j), T_(j) <= s), (forall j in NN>=1 : j <= v + 2 => c_(j) <= T_(j) * e_(j) * D^(v + 1)), (forall j in NN>=1 : j <= v + 2 => T_(j) * e_(j)^(v + 1) * D <= c_(j)), r in NN>=1, r <= v + 2 : t * D <= C * (v + 2)^v * s * e_(r)
  fix (gap) levels.gap
  neqfix (gap) levels.gap.upper
  (grid): P, Q, N in NN, e in QQ>0, W_(0..P), S_(0..P), O_(0..P) in Line, W_(0)(0) = e, S_(0)(0) * e = 1 + O_(0)(0) * e, (forall p in NN : p < P => forall q in NN : q <= Q => W_(p)(q) <= W_(p + 1)(q)), (forall p in NN : p <= P => forall q in NN : q < Q => W_(p)(q) <= W_(p)(q + 1)), (forall p in NN : p < P => W_(p + 1)(0) * S_(p + 1)(0) + O_(p)(0) = W_(p + 1)(0) * O_(p + 1)(0) + S_(p)(0)), (forall q in NN : q < Q => W_(0)(q + 1) * S_(0)(q + 1) + O_(0)(q) = W_(0)(q + 1) * O_(0)(q + 1) + S_(0)(q)), (forall p in NN : p < P => forall q in NN : q < Q => W_(p + 1)(q + 1) * S_(p + 1)(q + 1) + O_(p)(q + 1) + O_(p + 1)(q) = W_(p + 1)(q + 1) * O_(p + 1)(q + 1) + S_(p)(q + 1) + S_(p + 1)(q)) : forall p in NN : forall q in NN : p + q = N => p <= P => q <= Q => (e <= W_(p)(q), binom(N, p) + O_(p)(q) * e * W_(p)(q)^N <= S_(p)(q) * e * W_(p)(q)^N, S_(p)(q) * e^N * W_(p)(q) <= binom(N, p) + O_(p)(q) * e^N * W_(p)(q))
  fix (grid) levels.grid
  neqfix (grid) levels.grid.mono
  neqfix (grid) levels.grid.base
  core recfam: P, Q in NN, L_(1..P + 1), r_(1..Q) in QQ>0, u_(0..Q) in QQ>=0, U_(0..P + 1) in Line, (forall b in NN : b <= P + 1 => forall c in NN : c <= Q => U_(b)(c) = (sum m in 0..c, u_(m) / ((prod k in 1..b, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..c, (sum j in m + 1..g, r_(j)))))) : forall a in NN : a <= P => forall q in NN : q < Q => ((sum j in 1..a + 1, L_(j)) + (sum j in 1..q + 1, r_(j))) * U_(a + 1)(q + 1) = U_(a)(q + 1) + U_(a + 1)(q)
  core edgefam: P, Q in NN, L_(1..P + 1), r_(1..Q) in QQ>0, u_(0..Q) in QQ>=0, U_(0..P + 1) in Line, (forall b in NN : b <= P + 1 => forall c in NN : c <= Q => U_(b)(c) = (sum m in 0..c, u_(m) / ((prod k in 1..b, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..c, (sum j in m + 1..g, r_(j)))))) : forall a in NN : a <= P => (sum j in 1..a + 1, L_(j)) * U_(a + 1)(0) = U_(a)(0)
  core knots: P, Q, N in NN, L_(1..P + 1), r_(1..Q) in QQ>0, s_(0..Q), t_(0..Q) in QQ>=0, Ms_(0..P + 1), Mt_(0..P + 1) in Line, s_(0) = 1, t_(0) = 0, (forall m in NN : m < Q => s_(m) = t_(m + 1)), (forall m in NN : m < Q => t_(m) = s_(m + 1)), (forall b in NN : b <= P + 1 => forall c in NN : c <= Q => Ms_(b)(c) = (sum m in 0..c, s_(m) / ((prod k in 1..b, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..c, (sum j in m + 1..g, r_(j)))))), (forall b in NN : b <= P + 1 => forall c in NN : c <= Q => Mt_(b)(c) = (sum m in 0..c, t_(m) / ((prod k in 1..b, ((sum j in 1..k, L_(j)) + (sum j in 1..m, r_(j)))) * (prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..c, (sum j in m + 1..g, r_(j)))))) : forall p in NN : forall q in NN : p + q = N => p <= P => q <= Q => (Mt_(p + 1)(q) <= Ms_(p + 1)(q), binom(N, p) + Mt_(p + 1)(q) * L_(1) * ((sum j in 1..p + 1, L_(j)) + (sum j in 1..q, r_(j)))^N <= Ms_(p + 1)(q) * L_(1) * ((sum j in 1..p + 1, L_(j)) + (sum j in 1..q, r_(j)))^N, Ms_(p + 1)(q) * L_(1)^N * ((sum j in 1..p + 1, L_(j)) + (sum j in 1..q, r_(j))) <= binom(N, p) + Mt_(p + 1)(q) * L_(1)^N * ((sum j in 1..p + 1, L_(j)) + (sum j in 1..q, r_(j))))
