-- Q++ 0.2
module sidesrows
uses cells

subsection sec:sidesrows The sides

  -- Each row of the sides is one test space. Its forms at the nodes vanish at distinct positions iff the partial sums
  -- of the masses change side as the space requires; where they cannot, a separating member (\cref{lem:sides}) is the
  -- certificate.

type Length(n) := (QQ>0)^n

-- Colliding kinks of order one: the test space is the moments \(0\) and \(1\) and the atom of order one at each site,
-- and its forms vanish iff each site interval ties the gaps on the side of \(P\) against those on the side of \(N\).
-- With both sides present the lengths \(\ell_i=t\sum_jq_j\) and \(\ell'_j=t\sum_ip_i\) tie the interval; with one side
-- only, the step on the interval separates.
lemma lem:colliding [colliding kinks of order one]
  (exist): a, b in NN, p in Point(a), q in Point(b), t in QQ>0, sp, sq in QQ>=0, sp = sum i, p_(i), sq = sum j, q_(j) : (sum i, p_(i) * (t * sq)) = sum j, q_(j) * (t * sp)
  fix (exist) colliding
  (one): a in NN, p in Point(a), l in Length(a), m in QQ>0, (forall i : m <= l_(i)), 0 < sum i, p_(i) : 0 < sum i, p_(i) * l_(i)
  fix (one) collidingone
  origin: ?{\text{elementary, proved here}}

-- The lengths are the certificate; the factor free of the index leaves each sum.
proof lem:colliding
  (exist) with[(sum i, p_(i) * (t * sq)) = (t * sq) * (sum i, p_(i)) by sum[V[0]]; with[(t * sq) * (sum i, p_(i)) = (t * sq) * sp by V[sq * t * h_3]; with[(sum j, q_(j) * (t * sp)) = (t * sp) * (sum j, q_(j)) by sum[V[0]]; with[(t * sp) * (sum j, q_(j)) = (t * sp) * sq by V; V[1 * hw1, 1 * hw2, 1 * hw3, 1 * hw4]]]]]
  (one) with[(sum i, p_(i) * l_(i)) >= sum i, p_(i) * m by sum[with[0 <= p_(i) by V; V]]; with[(sum i, p_(i) * m) = m * (sum i, p_(i)) by sum[V[0]]; with[0 < m * (sum i, p_(i)) by V; V[1 * hw1, 1 * hw4 | 1 * hw3]]]]

-- The binomial weights \(\binom lk\) at the nodes \(0,\dots,l\), split by the parity of \(k\), tie at every power
-- below \(l\): the forward difference of order \(l\) of a power below \(l\) vanishes.
cit fact:fwddiff [the forward difference of a power]
  mathlib: fwdDiff_iter_pow_eq_zero_of_lt (Mathlib.Algebra.Group.ForwardDiff)
  core: l, i in NN, y in QQ>=0, i < l : (sum j in 0..l, binom(l, 2 * j) * (y + 2 * j)^i) = (sum j in 0..l, binom(l, 2 * j + 1) * (y + 2 * j + 1)^i)

-- The bound half of the sides, from Descartes' rule of signs: weights \(A_m\) whose forms \(\sum_mA_m\binom mi\) vanish
-- for \(i\le l\) give \(Q(w)=\sum_mA_mw^m\) a zero of order \(l+1\) at \(1\), hence at least \(l+1\) changes of side.
-- The binomial weights \(\binom lk\) split by parity attain the bound (\cref{fact:fwddiff}).
cit fact:descartes [the rule of signs at a zero at 1]
  mathlib: Polynomial.roots_countP_pos_le_signVariations (Mathlib.Algebra.Polynomial.RuleOfSigns)
  (1): D, l, s in NN, AP_(0..D), AN_(0..D) in QQ>=0, rho_(0..D) in NN, (forall i in NN : i <= l => (sum m in 0..D, AP_(m) * binom(m, i)) = (sum m in 0..D, AN_(m) * binom(m, i))), (exists m in NN : m <= D, 0 < AP_(m) + AN_(m)), (forall m in NN : m <= D => forall n in NN : n <= D => (m <= n => rho_(m) <= rho_(n))), (forall m in NN : m <= D => rho_(m) <= s), (forall m in NN : m <= D => forall n in NN : n <= D => (rho_(m) = rho_(n) => AP_(m) * AN_(n) = 0)) : l + 1 <= s

-- Pascal's rule, the absorption identity, and the hockey stick: the binomial coefficients of order \(i\) up to \(j\)
-- sum to the one of order \(i+1\) at \(j+1\).
cit fact:pascal [Pascal's rule]
  mathlib: Nat.choose_succ_succ' (Mathlib.Data.Nat.Choose.Basic)
  (1): n, k in NN : binom(n + 1, k + 1) = binom(n, k) + binom(n, k + 1)
  fix (1) pascal.rule

cit fact:absorb [the absorption identity]
  mathlib: Nat.add_one_mul_choose_eq (Mathlib.Data.Nat.Choose.Basic)
  (1): n, k in NN : (n + 1) * binom(n, k) = binom(n + 1, k + 1) * (k + 1)
  fix (1) absorb.rule

cit fact:hockey [the hockey-stick identity]
  mathlib: Nat.sum_Icc_choose (Mathlib.Data.Nat.Choose.Sum)
  (1): D, j, i in NN, j <= D : (sum m in 0..D, iverson(m <= j) * binom(m, i)) = binom(j + 1, i + 1)
  fix (1) hockey.stick

-- The divided difference of a constant vanishes: on nodes \(0,\dots,n+1\), the weight of the node \(m\) is the product
-- \(\ell(m)\varrho(m)\) of its distances to the nodes on its left and on its right, and masses that tie on each pair of
-- neighbours have equal weighted sums. It is the coefficient of \(X^{n+1}\) in the interpolant of \(1\) (Lagrange's
-- formula), read with the sides of the weights.
cit fact:lagrange [the divided difference of a constant]
  mathlib: Lagrange.coeff_eq_sum (Mathlib.LinearAlgebra.Lagrange)
  (tie): n in NN, r_(1..n + 1) in QQ>0, x_(0..n + 1), y_(0..n + 1) in QQ>=0, (forall m in NN : m <= n => x_(m) + x_(m + 1) = y_(m) + y_(m + 1)) : (sum m in 0..n + 1, x_(m) / ((prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..n + 1, (sum j in m + 1..g, r_(j))))) = (sum m in 0..n + 1, y_(m) / ((prod g in 1..m, (sum j in g..m, r_(j))) * (prod g in m + 1..n + 1, (sum j in m + 1..g, r_(j)))))
  fix (tie) lagrange.tie

-- The tails \(U_m=A_m+\dots+A_D\) of weights \(A\): the form of order \(i\) of the tails is the sum of the forms of
-- orders \(i\) and \(i+1\) of the weights (the two sums exchanged, the hockey stick, Pascal's rule).
lemma lem:tails [the forms of the tails]
  (1): D, i in NN, A_(0..D) in QQ>=0 : (sum m in 0..D, binom(m, i) * (sum j in 0..D, iverson(m <= j) * A_(j))) = (sum j in 0..D, A_(j) * binom(j, i)) + (sum j in 0..D, A_(j) * binom(j, i + 1))
  fix (1) tails.forms
  origin: ?{\text{elementary, proved here: the two sums exchanged, then \cref{fact:hockey} and \cref{fact:pascal}}}

proof lem:tails
  (1) with[(sum m in 0..D, binom(m, i) * (sum j in 0..D, iverson(m <= j) * A_(j))) = (sum m in 0..D, (sum j in 0..D, binom(m, i) * iverson(m <= j) * A_(j))) by sum[sum[V[0]]]; with[(sum m in 0..D, (sum j in 0..D, binom(m, i) * iverson(m <= j) * A_(j))) = (sum j in 0..D, (sum m in 0..D, binom(m, i) * iverson(m <= j) * A_(j))) by sum[V]; with[(sum j in 0..D, (sum m in 0..D, binom(m, i) * iverson(m <= j) * A_(j))) = (sum j in 0..D, (A_(j) * binom(j, i) + A_(j) * binom(j, i + 1))) by sum[with[(sum m in 0..D, iverson(m <= j) * binom(m, i)) = binom(j + 1, i + 1) by fact:hockey(1)[D := D, j := j, i := i; j <= D by V]; with[binom(j + 1, i + 1) = binom(j, i) + binom(j, i + 1) by fact:pascal(1)[n := j, k := i]; with[(sum m in 0..D, binom(m, i) * iverson(m <= j) * A_(j)) = A_(j) * (sum m in 0..D, iverson(m <= j) * binom(m, i)) by sum[V[0]]; V]]]]; with[(sum j in 0..D, (A_(j) * binom(j, i) + A_(j) * binom(j, i + 1))) = (sum j in 0..D, A_(j) * binom(j, i)) + (sum j in 0..D, A_(j) * binom(j, i + 1)) by sum[V]; V[1 * hw1, 1 * hw2, 1 * hw3, 1 * hw7]]]]]

-- The tails change side. If the forms of the weights of orders \(0\) to \(l+1\) tie, so do the forms of their tails
-- of orders \(0\) to \(l\) (\cref{lem:tails}), and the tails change side at least \(l+1\) times
-- (\cref{fact:descartes}). A tail is given by the masses \(U^+_m\), \(U^-_m\) of its two sides, tied to the tails of the
-- two sides of the weights.
lemma lem:sums [the tails change side]
  (1): D, l, s in NN, p_(0..D), q_(0..D), u_(0..D), w_(0..D) in QQ>=0, rho_(0..D) in NN, (forall i in NN : i <= l + 1 => (sum m in 0..D, p_(m) * binom(m, i)) = (sum m in 0..D, q_(m) * binom(m, i))), (forall m in NN : m <= D => u_(m) + (sum j in 0..D, iverson(m <= j) * q_(j)) = w_(m) + (sum j in 0..D, iverson(m <= j) * p_(j))), (exists m in NN : m <= D, 0 < u_(m) + w_(m)), (forall m in NN : m <= D => forall n in NN : n <= D => (m <= n => rho_(m) <= rho_(n))), (forall m in NN : m <= D => rho_(m) <= s), (forall m in NN : m <= D => forall n in NN : n <= D => (rho_(m) = rho_(n) => u_(m) * w_(n) = 0)) : l + 1 <= s
  fix (1) sums.tails
  fix (1) sums.lagrange
  origin: ?{\text{elementary, proved here from \cref{lem:tails} and \cref{fact:descartes}}}

proof lem:sums
  (1) with[forall i in NN : i <= l => (sum m in 0..D, u_(m) * binom(m, i)) = (sum m in 0..D, w_(m) * binom(m, i)) by with[(sum m in 0..D, u_(m) * binom(m, i)) + (sum m in 0..D, binom(m, i) * (sum j in 0..D, iverson(m <= j) * q_(j))) = (sum m in 0..D, w_(m) * binom(m, i)) + (sum m in 0..D, binom(m, i) * (sum j in 0..D, iverson(m <= j) * p_(j))) by sum[V[binom(m, i) * h_6_m]]; with[(sum m in 0..D, binom(m, i) * (sum j in 0..D, iverson(m <= j) * q_(j))) = (sum j in 0..D, q_(j) * binom(j, i)) + (sum j in 0..D, q_(j) * binom(j, i + 1)) by lem:tails(1)[D := D, i := i, A := q]; with[(sum m in 0..D, binom(m, i) * (sum j in 0..D, iverson(m <= j) * p_(j))) = (sum j in 0..D, p_(j) * binom(j, i)) + (sum j in 0..D, p_(j) * binom(j, i + 1)) by lem:tails(1)[D := D, i := i, A := p]; with[i <= l + 1 by V[1 * hi1]; with[i + 1 <= l + 1 by V[1 * hi1]; with[(sum m in 0..D, p_(m) * binom(m, i)) = (sum m in 0..D, q_(m) * binom(m, i)) by logic; with[(sum m in 0..D, p_(m) * binom(m, i + 1)) = (sum m in 0..D, q_(m) * binom(m, i + 1)) by logic; V]]]]]]]; fact:descartes(1)[D := D, l := l, s := s, AP := u, AN := w, rho := rho]]

-- The moments and the forms, about a centre \(c\): if the moments of two families of weights tie about \(c\) up to the
-- order \(l\), their forms \(\sum_mp_m\binom mi\) tie for \(i\le l\). The two ties are carried together from \(i\) to
-- \(i+1\) by the absorption identity and Pascal's rule (\cref{fact:absorb}, \cref{fact:pascal}), each step cancelling
-- two ties; at \(c=0\) the moments are \(\sum_mp_mm^a\).
lemma lem:moments [moments and forms]
  core weighted: m, i in NN, y, z, c, c1, c2 in QQ>=0, z = y * m, (m + 1) * c = c2 * (i + 1), c2 = c + c1 : z * c = i * (y * c) + (i + 1) * (y * c1)
  core shift: D, i, a in NN, w_(0..D), d_(0..D) in QQ>=0 : (sum m in 0..D, m * (w_(m) * d_(m)^a) * binom(m, i)) = i * (sum m in 0..D, w_(m) * d_(m)^a * binom(m, i)) + (i + 1) * (sum m in 0..D, w_(m) * d_(m)^a * binom(m, i + 1))
  core node: m in NN, c, d, p, q, P, Q in QQ>=0, (m < c => m + d = c, P = q, Q = p), (c <= m => c + d = m, P = p, Q = q) : P * d + m * q + c * p = Q * d + m * p + c * q
  core nodeO: m in NN, c, d, p, q, P, Q in QQ>=0, (m < c => m + d = c, P = q, Q = p), (c <= m => c + d = m, P = p, Q = q) : p * d + m * Q + c * P = q * d + m * P + c * Q
  core nodes: D in NN, c in QQ>=0, p_(0..D), q_(0..D), P_(0..D), Q_(0..D), d_(0..D) in QQ>=0, (forall m in NN : m <= D => (m < c => m + d_(m) = c, P_(m) = q_(m), Q_(m) = p_(m))), (forall m in NN : m <= D => (c <= m => c + d_(m) = m, P_(m) = p_(m), Q_(m) = q_(m))) : (forall m in NN : m <= D => P_(m) * d_(m) + m * q_(m) + c * p_(m) = Q_(m) * d_(m) + m * p_(m) + c * q_(m)), (forall m in NN : m <= D => p_(m) * d_(m) + m * Q_(m) + c * P_(m) = q_(m) * d_(m) + m * P_(m) + c * Q_(m))
  core power: m in NN, c, d, p, q, P, Q, t, b in QQ>=0, P * d + m * q + c * p = Q * d + m * p + c * q : P * (d * t) * b + m * (q * t) * b + c * (p * t) * b = Q * (d * t) * b + m * (p * t) * b + c * (q * t) * b
  core tie: D, i, a in NN, c in QQ>=0, p_(0..D), q_(0..D), P_(0..D), Q_(0..D), d_(0..D) in QQ>=0, (forall m in NN : m <= D => P_(m) * d_(m) + m * q_(m) + c * p_(m) = Q_(m) * d_(m) + m * p_(m) + c * q_(m)) : (sum m in 0..D, P_(m) * d_(m)^(a + 1) * binom(m, i)) + c * (sum m in 0..D, p_(m) * d_(m)^a * binom(m, i)) + i * (sum m in 0..D, q_(m) * d_(m)^a * binom(m, i)) + (i + 1) * (sum m in 0..D, q_(m) * d_(m)^a * binom(m, i + 1)) = (sum m in 0..D, Q_(m) * d_(m)^(a + 1) * binom(m, i)) + c * (sum m in 0..D, q_(m) * d_(m)^a * binom(m, i)) + i * (sum m in 0..D, p_(m) * d_(m)^a * binom(m, i)) + (i + 1) * (sum m in 0..D, p_(m) * d_(m)^a * binom(m, i + 1))
  core step: D, i, l in NN, c in QQ>=0, p_(0..D), q_(0..D), P_(0..D), Q_(0..D), d_(0..D) in QQ>=0, (forall m in NN : m <= D => P_(m) * d_(m) + m * q_(m) + c * p_(m) = Q_(m) * d_(m) + m * p_(m) + c * q_(m)), (forall m in NN : m <= D => p_(m) * d_(m) + m * Q_(m) + c * P_(m) = q_(m) * d_(m) + m * P_(m) + c * Q_(m)), (forall b in NN : 2 * b + i <= l => (sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, i)) = (sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, i))), (forall b in NN : 2 * b + 1 + i <= l => (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, i)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, i))) : (forall b in NN : 2 * b + (i + 1) <= l => (sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, (i + 1))) = (sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, (i + 1)))), (forall b in NN : 2 * b + 1 + (i + 1) <= l => (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, (i + 1))) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, (i + 1))))
  core forms: D, l, k in NN, c in QQ>=0, p_(0..D), q_(0..D), P_(0..D), Q_(0..D), d_(0..D) in QQ>=0, (forall m in NN : m <= D => (m < c => m + d_(m) = c, P_(m) = q_(m), Q_(m) = p_(m))), (forall m in NN : m <= D => (c <= m => c + d_(m) = m, P_(m) = p_(m), Q_(m) = q_(m))), (forall b in NN : 2 * b <= l => (sum m in 0..D, p_(m) * d_(m)^(2 * b)) = (sum m in 0..D, q_(m) * d_(m)^(2 * b))), (forall b in NN : 2 * b + 1 <= l => (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1))) : (forall b in NN : 2 * b + k <= l => (sum m in 0..D, p_(m) * d_(m)^(2 * b) * binom(m, k)) = (sum m in 0..D, q_(m) * d_(m)^(2 * b) * binom(m, k))), (forall b in NN : 2 * b + 1 + k <= l => (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1) * binom(m, k)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1) * binom(m, k)))
  (1): D, l in NN, c in QQ>=0, p_(0..D), q_(0..D), P_(0..D), Q_(0..D), d_(0..D) in QQ>=0, (forall m in NN : m <= D => (m < c => m + d_(m) = c, P_(m) = q_(m), Q_(m) = p_(m))), (forall m in NN : m <= D => (c <= m => c + d_(m) = m, P_(m) = p_(m), Q_(m) = q_(m))), (forall b in NN : 2 * b <= l => (sum m in 0..D, p_(m) * d_(m)^(2 * b)) = (sum m in 0..D, q_(m) * d_(m)^(2 * b))), (forall b in NN : 2 * b + 1 <= l => (sum m in 0..D, P_(m) * d_(m)^(2 * b + 1)) = (sum m in 0..D, Q_(m) * d_(m)^(2 * b + 1))) : forall i in NN : i <= l => (sum m in 0..D, p_(m) * binom(m, i)) = (sum m in 0..D, q_(m) * binom(m, i))
  fix (1) moments.forms
  fix (1) moments.centre
  origin: ?{\text{classical: the powers are positive combinations of the binomial coefficients,}\ m^a=\sum_iS(a,i)\,i!\binom mi\ \text{with the Stirling numbers of the second kind \cite[Section~1.9]{Stanley2012}; the inverse change writes}\ \binom mi\ \text{with the Stirling numbers of the first kind, of both signs, so here the ties are carried positively, two at each step; about a centre the odd moments read the side of each node}}

proof lem:moments
  "core weighted" V[c * h_6, y * h_7, y * (i + 1) * h_8]
  "core shift" with[(sum m in 0..D, m * (w_(m) * d_(m)^a) * binom(m, i)) = (sum m in 0..D, (i * (w_(m) * d_(m)^a * binom(m, i)) + (i + 1) * (w_(m) * d_(m)^a * binom(m, i + 1)))) by sum[with[(m + 1) * binom(m, i) = binom(m + 1, i + 1) * (i + 1) by fact:absorb(1)[n := m, k := i]; with[binom(m + 1, i + 1) = binom(m, i) + binom(m, i + 1) by fact:pascal(1)[n := m, k := i]; lem:moments(core weighted)[m := m, i := i, y := w_(m) * d_(m)^a, z := m * (w_(m) * d_(m)^a), c := binom(m, i), c1 := binom(m, i + 1), c2 := binom(m + 1, i + 1); m * (w_(m) * d_(m)^a) = w_(m) * d_(m)^a * m by V[0]; (m + 1) * binom(m, i) = binom(m + 1, i + 1) * (i + 1) by V; binom(m + 1, i + 1) = binom(m, i) + binom(m, i + 1) by V]]]]; with[(sum m in 0..D, (i * (w_(m) * d_(m)^a * binom(m, i)) + (i + 1) * (w_(m) * d_(m)^a * binom(m, i + 1)))) = (sum m in 0..D, i * (w_(m) * d_(m)^a * binom(m, i))) + (sum m in 0..D, (i + 1) * (w_(m) * d_(m)^a * binom(m, i + 1))) by sum[V]; with[(sum m in 0..D, i * (w_(m) * d_(m)^a * binom(m, i))) = i * (sum m in 0..D, w_(m) * d_(m)^a * binom(m, i)) by sum[V]; with[(sum m in 0..D, (i + 1) * (w_(m) * d_(m)^a * binom(m, i + 1))) = (i + 1) * (sum m in 0..D, w_(m) * d_(m)^a * binom(m, i + 1)) by sum[V]; V[1 * hw1, 1 * hw4, 1 * hw5, 1 * hw6]]]]]
  "core node" cases[c <= m; with[(c + d = m, P = p, Q = q) by (logic, logic, logic); V]; with[(m + d = c, P = q, Q = p) by (logic, logic, logic); V]]
  "core nodeO" cases[c <= m; with[(c + d = m, P = p, Q = q) by (logic, logic, logic); V]; with[(m + d = c, P = q, Q = p) by (logic, logic, logic); V]]
  "core nodes" (lem:moments(core node)[m := m, c := c, d := d_(m), p := p_(m), q := q_(m), P := P_(m), Q := Q_(m); (m < c => m + d_(m) = c, P_(m) = q_(m), Q_(m) = p_(m)) by (logic, logic, logic); (c <= m => c + d_(m) = m, P_(m) = p_(m), Q_(m) = q_(m)) by (logic, logic, logic)], lem:moments(core nodeO)[m := m, c := c, d := d_(m), p := p_(m), q := q_(m), P := P_(m), Q := Q_(m); (m < c => m + d_(m) = c, P_(m) = q_(m), Q_(m) = p_(m)) by (logic, logic, logic); (c <= m => c + d_(m) = m, P_(m) = p_(m), Q_(m) = q_(m)) by (logic, logic, logic)])
  "core power" V[t * b * h_9]
  "core tie" with[(sum m in 0..D, (P_(m) * (d_(m) * d_(m)^a) * binom(m, i) + m * (q_(m) * d_(m)^a) * binom(m, i) + c * (p_(m) * d_(m)^a) * binom(m, i))) = (sum m in 0..D, (Q_(m) * (d_(m) * d_(m)^a) * binom(m, i) + m * (p_(m) * d_(m)^a) * binom(m, i) + c * (q_(m) * d_(m)^a) * binom(m, i))) by sum[lem:moments(core power)[m := m, c := c, d := d_(m), p := p_(m), q := q_(m), P := P_(m), Q := Q_(m), t := d_(m)^a, b := binom(m, i); P_(m) * d_(m) + m * q_(m) + c * p_(m) = Q_(m) * d_(m) + m * p_(m) + c * q_(m) by logic]]; with[(sum m in 0..D, (P_(m) * (d_(m) * d_(m)^a) * binom(m, i) + m * (q_(m) * d_(m)^a) * binom(m, i) + c * (p_(m) * d_(m)^a) * binom(m, i))) = (sum m in 0..D, (P_(m) * (d_(m) * d_(m)^a) * binom(m, i) + m * (q_(m) * d_(m)^a) * binom(m, i))) + (sum m in 0..D, c * (p_(m) * d_(m)^a) * binom(m, i)) by sum[V]; with[(sum m in 0..D, (P_(m) * (d_(m) * d_(m)^a) * binom(m, i) + m * (q_(m) * d_(m)^a) * binom(m, i))) = (sum m in 0..D, P_(m) * (d_(m) * d_(m)^a) * binom(m, i)) + (sum m in 0..D, m * (q_(m) * d_(m)^a) * binom(m, i)) by sum[V]; with[(sum m in 0..D, (Q_(m) * (d_(m) * d_(m)^a) * binom(m, i) + m * (p_(m) * d_(m)^a) * binom(m, i) + c * (q_(m) * d_(m)^a) * binom(m, i))) = (sum m in 0..D, (Q_(m) * (d_(m) * d_(m)^a) * binom(m, i) + m * (p_(m) * d_(m)^a) * binom(m, i))) + (sum m in 0..D, c * (q_(m) * d_(m)^a) * binom(m, i)) by sum[V]; with[(sum m in 0..D, (Q_(m) * (d_(m) * d_(m)^a) * binom(m, i) + m * (p_(m) * d_(m)^a) * binom(m, i))) = (sum m in 0..D, Q_(m) * (d_(m) * d_(m)^a) * binom(m, i)) + (sum m in 0..D, m * (p_(m) * d_(m)^a) * binom(m, i)) by sum[V]; with[(sum m in 0..D, P_(m) * (d_(m) * d_(m)^a) * binom(m, i)) = (sum m in 0..D, P_(m) * d_(m)^(a + 1) * binom(m, i)) by sum[V]; with[(sum m in 0..D, Q_(m) * (d_(m) * d_(m)^a) * binom(m, i)) = (sum m in 0..D, Q_(m) * d_(m)^(a + 1) * binom(m, i)) by sum[V]; with[(sum m in 0..D, c * (p_(m) * d_(m)^a) * binom(m, i)) = c * (sum m in 0..D, p_(m) * d_(m)^a * binom(m, i)) by sum[V[0]]; with[(sum m in 0..D, c * (q_(m) * d_