-- Q++ 0.2
module pivots
uses fibres, compare

subsection sec:pivots The count on a chart

-- A chart with its levels, its moduli and its depth (\cref{lem:chart}): it carries the counted points (carries) and has
-- windows past its starts (windows).
type Chart(n) := {lam in Exponent(n), F in Moduli(n, n), N in NN}
relation (Ch #carries G #join T #sizes S #cap B #level L #box b) := n, r, L in NN, Ch in Chart(n), G in Grid(n), T in IntForms(n, r), S in Sizes(n, r), B in Exponent(r), b in Exponent(n), (forall j : (sum X, T_(j)_(X) * B_(X)) <= Ch.N), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L => forall s in Exponent(r) : S(u) = s => forall x in Point(n) : Ch.F(u) = x => forall j : x_(j) <= 1 / 2^(sum X, T_(j)_(X) * s_(X))), (forall j : forall u, w in Exponent(n) : (forall i : Ch.lam_(i) < Ch.lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= 1 / 2^L, G(w) <= 1 / 2^L => forall s in Exponent(r) : S(u) = s, S(w) = s => forall x in Point(n) : Ch.F(u) = x => forall z in Point(n) : Ch.F(w) = z => u_(j) <= w_(j) + 2^(Ch.N) * (x_(j) + z_(j)))
relation (Ch #windows M #box b) := n in NN, Ch in Chart(n), M in Sizes(n, n), b in Exponent(n), (forall j : forall u, w in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), (forall i : Ch.lam_(i) < Ch.lam_(j) => u_(i) = w_(i)) => forall y in Exponent(n) : M(u) = y => forall z in Exponent(n) : M(w) = z => y_(j) = z_(j)), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(n) : Ch.F(u) = y => forall z in Exponent(n) : M(u) = z => forall j : z_(j) <= u_(j) => 2^(Ch.N) * y_(j) + z_(j) = u_(j))

cit fact:boxsplit [the box of a join, the product of its two boxes]
  mathlib: Finset.sum_product (Mathlib.Algebra.BigOperators.Group.Finset.Sigma)
  core: n, n' in NN, b in Exponent(n), c in Exponent(n'), G in Grid(n + n') : (sum z <= join(b, c), G(z)) = sum w <= c, sum u <= b, G(join(u, w))

-- The count on a chart is, up to constants, the weighted count \(\sum_{s\le B}[s\ \text{feasible}]\,2^{-c\cdot s}\) of
-- the size vectors of its chamber: each class is counted by \cref{lem:chart}, and the classes are disjoint.
theorem thm:pivots [the count on a chart]
  core weight: n, r, N in NN, b in Exponent(n), B in Exponent(r), G in Grid(n), S in Sizes(n, r), e, C in QQ>=0, w in Grid(r), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e => forall s in Exponent(r) : S(u) = s => forall X : s_(X) <= B_(X)), (forall s in Exponent(r) : (forall X : s_(X) <= B_(X)) => (sum u <= b, iverson(G(u) <= e, S(u) = s)) <= C * 2^(n * N) * w(s)) : (sum u <= b, iverson(G(u) <= e)) <= C * 2^(n * N) * (sum s <= B, w(s))
  fix core weight weight
  core cover: n, r, P, N in NN, b in Exponent(n), B in Exponent(r), G in Grid(n), S in Sizes(n, r), e, C in QQ>=0, W_(1..P) in Grid(r), U_(1..P) in QQ>=0, (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e => forall s in Exponent(r) : S(u) = s => forall X : s_(X) <= B_(X)), (forall s in Exponent(r) : (forall X : s_(X) <= B_(X)) => (sum u <= b, iverson(G(u) <= e, S(u) = s)) <= C * 2^(n * N) * (sum p in 1..P, W_(p)(s))), (forall p in NN>=1 : p <= P => (sum s <= B, W_(p)(s)) <= U_(p)) : (sum u <= b, iverson(G(u) <= e)) <= C * 2^(n * N) * (sum p in 1..P, U_(p))
  fix core cover cover
  core split: n1, n2 in NN, b1 in Exponent(n1), b2 in Exponent(n2), f in Grid(n1), g in Grid(n2) : (sum u <= b1, f(u)) * (sum w <= b2, g(w)) = sum w <= b2, sum u <= b1, f(u) * g(w)
  core product: n1, n2, L, d1, d2, k1, k2 in NN, b1 in Exponent(n1), b2 in Exponent(n2), f in Grid(n1), g in Grid(n2), K1, K2 in QQ>=0, (sum u <= b1, f(u)) <= K1 * L^d1 / 2^k1, (sum w <= b2, g(w)) <= K2 * L^d2 / 2^k2 : (sum w <= b2, sum u <= b1, f(u) * g(w)) <= K1 * K2 * L^(d1 + d2) / 2^(k1 + k2)
  fix core product product
  core productin: n1, n2, L, d1, d2, k1, k2 in NN, b1 in Exponent(n1), b2 in Exponent(n2), f in Grid(n1), g in Grid(n2), K1, K2 in QQ>=0, K1 * L^d1 / 2^k1 <= (sum u <= b1, f(u)), K2 * L^d2 / 2^k2 <= (sum w <= b2, g(w)) : K1 * K2 * L^(d1 + d2) / 2^(k1 + k2) <= sum w <= b2, sum u <= b1, f(u) * g(w)
  fix core productin productin
  core out: n, r, k, L, N in NN, b in Exponent(n), B, c in Exponent(r), G in Grid(n), S in Sizes(n, r), e, C in QQ>=0, Pr in Chamber(k, r), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e => forall s in Exponent(r) : S(u) = s => (forall X : s_(X) <= B_(X)), (s #feasible Pr #level L)), (forall s in Exponent(r) : (forall X : s_(X) <= B_(X)) => (sum u <= b, iverson(G(u) <= e, S(u) = s)) <= C * 2^(n * N) / 2^(sum X, c_(X) * s_(X))) : (sum u <= b, iverson(G(u) <= e)) <= C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X)))
  fix core out out
  core in: n, r, k, L, N in NN, b in Exponent(n), B, c in Exponent(r), G in Grid(n), S in Sizes(n, r), e, C in QQ>=0, Pr in Chamber(k, r), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e => forall s in Exponent(r) : S(u) = s => forall X : s_(X) <= B_(X)), (forall s in Exponent(r) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level L) => C * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) <= sum u <= b, iverson(G(u) <= e, S(u) = s)) : C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) <= sum u <= b, iverson(G(u) <= e)
  core dyadic: N, t, p in NN, 2^N = 2^t * 2^p : 2 * 2^N <= 1 * (2 * 2^p) * 2^t, (2 * 2^p + 1) * 2^t <= 3 * 2^N
  core capped: r in NN, y in Point(r), s, B in Exponent(r), (y #sized s #cap B) : forall X : s_(X) <= B_(X)
  core classabove: n, r, N, L in NN, b, lam in Exponent(n), B, c in Exponent(r), T in IntForms(n, r), G in Grid(n), F in Moduli(n, n), S in Sizes(n, r), (forall j : (sum X, T_(j)_(X) * B_(X)) <= N), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L => forall s in Exponent(r) : S(u) = s => forall x in Point(n) : F(u) = x => forall j : x_(j) <= 1 / 2^(sum X, T_(j)_(X) * s_(X))), (forall j : forall u, w in Exponent(n) : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= 1 / 2^L, G(w) <= 1 / 2^L => forall s in Exponent(r) : S(u) = s, S(w) = s => forall x in Point(n) : F(u) = x => forall z in Point(n) : F(w) = z => u_(j) <= w_(j) + 2^N * (x_(j) + z_(j))), (forall X : c_(X) <= sum j, T_(j)_(X)) : forall s in Exponent(r) : (forall X : s_(X) <= B_(X)) => (sum u <= b, iverson(G(u) <= 1 / 2^L, S(u) = s)) <= 3^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X))
  core half: N, s, W in NN, 2^N = 2 * 2^s * (W + 1) : 1 / 2 * 2^N <= (W + 1) * 2^s
  core winlow: N, s, W, y, x in NN, 2^N = 2 * 2^s * (W + 1), y + (W + 2) <= x : y * 2^(s + 1) + 2^N < x * 2^(s + 1)
  core winup: N, s, W, y, x in NN, 2^N = 2 * 2^s * (W + 1), x <= y + (W + 2) + W : x * 2^s <= y * 2^s + 2^N
  core winend: N, s, W, y, b in NN, 2^N = 2 * 2^s * (W + 1), y * 2^s + 2^N <= b * 2^s : y + (W + 2) + W <= b
  core unique: r in NN, y in Point(r), s, s2, B in Exponent(r), (forall X : s_(X) <= B_(X)), (forall X : 1 / 2^(s_(X) + 1) < y_(X), y_(X) <= 1 / 2^(s_(X))), (y #sized s2 #cap B) : forall X : s2_(X) = s_(X)
  core classbelow: n, k, N, L, Lp, H in NN, b, B, c, lam in Exponent(n), G in Grid(n), F in Moduli(n, n), S, M in Sizes(n, n), Te in Terms(k, n), (F #sizes S #cap B #box b), (G #atmost Te #moduli F #box b), k <= 2^H, L <= Lp, (forall j : forall u, w in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)) => forall y in Exponent(n) : M(u) = y => forall z in Exponent(n) : M(w) = z => y_(j) = z_(j)), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(n) : F(u) = y => forall z in Exponent(n) : M(u) = z => forall j : z_(j) <= u_(j) => 2^N * y_(j) + z_(j) = u_(j)), (forall j : 1 <= c_(j)) : forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (forall kappa : Lp + Te.A_(kappa) + H <= sum X, Te.E_(kappa)_(X) * s_(X)), (forall j : s_(j) + 1 <= N), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : lam_(i) < lam_(j) => y_(i) * 2^(s_(i) + 1) + 2^N < u_(i) * 2^(s_(i) + 1), u_(i) * 2^(s_(i)) <= y_(i) * 2^(s_(i)) + 2^N) => y_(j) * 2^(s_(j)) + 2^N <= b_(j) * 2^(s_(j))) => (1 / 2)^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) <= sum u <= b, iverson(G(u) <= 1 / 2^L, S(u) = s)
  core classfeasible: n, k, m, N, L, Lp, H in NN, b, B, c, lam in Exponent(n), G in Grid(n), F in Moduli(n, n), S, M in Sizes(n, n), Te in Terms(k, n), Pr in Chamber(m, n), (F #sizes S #cap B #box b), (G #atmost Te #moduli F #box b), k <= 2^H, L <= Lp, (forall j : forall u, w in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)) => forall y in Exponent(n) : M(u) = y => forall z in Exponent(n) : M(w) = z => y_(j) = z_(j)), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(n) : F(u) = y => forall z in Exponent(n) : M(u) = z => forall j : z_(j) <= u_(j) => 2^N * y_(j) + z_(j) = u_(j)), (forall j : 1 <= c_(j)), (forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => forall kappa : Lp + Te.A_(kappa) + H <= sum X, Te.E_(kappa)_(X) * s_(X)), (forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => (forall j : s_(j) + 1 <= N), forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : lam_(i) < lam_(j) => y_(i) * 2^(s_(i) + 1) + 2^N < u_(i) * 2^(s_(i) + 1), u_(i) * 2^(s_(i)) <= y_(i) * 2^(s_(i)) + 2^N) => y_(j) * 2^(s_(j)) + 2^N <= b_(j) * 2^(s_(j))) : forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => (1 / 2)^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) <= sum u <= b, iverson(G(u) <= 1 / 2^L, S(u) = s)
  (above): n, r, k, m, L in NN, b in Exponent(n), B, c in Exponent(r), T in IntForms(n, r), G in Grid(n), Y in Moduli(n, r), S in Sizes(n, r), Te in Terms(k, r), Ch in Chart(n), Pr in Chamber(m, r), (Y #sizes S #cap B #box b), (G #atleast Te #moduli Y #box b), (forall kappa : forall X : 1 <= Te.E_(kappa)_(X) => L + 1 <= Te.E_(kappa)_(X) * B_(X) + (sum Z, Te.E_(kappa)_(Z)) + Te.A_(kappa)), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall s in Exponent(r) : S(u) = s, (forall kappa : L + 1 <= (sum X, Te.E_(kappa)_(X) * (s_(X) + 1)) + Te.A_(kappa)) => (s #feasible Pr #level L)), (Ch #carries G #join T #sizes S #cap B #level L #box b), (forall X : c_(X) <= sum j, T_(j)_(X)) : (sum u <= b, iverson(G(u) <= 1 / 2^L)) <= 3^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X)))
  fix (above) pivots
  (below): n, k, m, L, Lp, H in NN, b, B, c in Exponent(n), G in Grid(n), S, M in Sizes(n, n), Te in Terms(k, n), Ch in Chart(n), Pr in Chamber(m, n), (Ch.F #sizes S #cap B #box b), (G #atmost Te #moduli Ch.F #box b), k <= 2^H, L <= Lp, (Ch #windows M #box b), (forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => forall kappa : Lp + Te.A_(kappa) + H <= sum X, Te.E_(kappa)_(X) * s_(X)), (forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => (forall j : s_(j) + 1 <= Ch.N), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : Ch.lam_(i) < Ch.lam_(j) => y_(i) * 2^(s_(i) + 1) + 2^(Ch.N) < u_(i) * 2^(s_(i) + 1), u_(i) * 2^(s_(i)) <= y_(i) * 2^(s_(i)) + 2^(Ch.N)) => y_(j) * 2^(s_(j)) + 2^(Ch.N) <= b_(j) * 2^(s_(j)))), (forall j : 1 <= c_(j)) : (1 / 2)^n * 2^(n * Ch.N) * (sum s <= B, iverson((s #feasible Pr #level Lp)) / 2^(sum X, c_(X) * s_(X))) <= sum u <= b, iverson(G(u) <= 1 / 2^L)
  fix (below) pivotsin
  origin: ?{\text{proved here: the count on a chart from its terms, through}\ \cref{lem:compare,lem:chart}}

-- (above): a counted point has its sizes in the chamber by the rows of \cref{lem:compare}(above), and each class of
-- sizes is counted by \cref{lem:chart}(above) on the carried chart (core classabove); the classes are disjoint, so the
-- count is at most a constant times the weighted count of the feasible sizes (core out). (below): feasible sizes clear
-- the rows of \cref{lem:compare}(below), the windows of the chart give each class its points by \cref{lem:chart}(below)
-- (core classfeasible), and the classes add up to the bound from below (core in).
proof thm:pivots
  "core weight" with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e => forall s in Exponent(r) : S(u) = s => forall X : s_(X) <= B_(X) by logic; chain[(sum u <= b, iverson(G(u) <= e)) = sum s <= B, sum u <= b, iverson(G(u) <= e, S(u) = s) by fibres; <= sum s <= B, C * 2^(n * N) * w(s) by sum[logic]; = C * 2^(n * N) * (sum s <= B, w(s)) by sum]]
  "core cover" with[(sum s <= B, (sum p in 1..P, W_(p)(s))) = sum p in 1..P, sum s <= B, W_(p)(s) by sum; with[(sum p in 1..P, sum s <= B, W_(p)(s)) <= sum p in 1..P, U_(p) by sum[logic]; with[(sum s <= B, (sum p in 1..P, W_(p)(s))) <= sum p in 1..P, U_(p) by V[1 * hw1, 1 * hw2]; chain[(sum u <= b, iverson(G(u) <= e)) <= C * 2^(n * N) * (sum s <= B, (sum p in 1..P, W_(p)(s))) by thm:pivots(core weight)[n := n, r := r, N := N, b := b, B := B, G := G, S := S, e := e, C := C, w(s) := (sum p in 1..P, W_(p)(s))]; <= C * 2^(n * N) * (sum p in 1..P, U_(p)) by mono]]]]
  "core split" sum[sum[V]]
  "core product" with[(sum u <= b1, f(u)) * (sum w <= b2, g(w)) = sum w <= b2, sum u <= b1, f(u) * g(w) by thm:pivots(core split)[n1 := n1, n2 := n2, b1 := b1, b2 := b2, f := f, g := g]; with[(sum u <= b1, f(u)) * (sum w <= b2, g(w)) <= (K1 * L^d1 / 2^k1) * (K2 * L^d2 / 2^k2) by mono; with[(K1 * L^d1 / 2^k1) * (K2 * L^d2 / 2^k2) = K1 * K2 * L^(d1 + d2) / 2^(k1 + k2) by eq; V]]]
  "core productin" with[(sum u <= b1, f(u)) * (sum w <= b2, g(w)) = sum w <= b2, sum u <= b1, f(u) * g(w) by thm:pivots(core split)[n1 := n1, n2 := n2, b1 := b1, b2 := b2, f := f, g := g]; with[(K1 * L^d1 / 2^k1) * (K2 * L^d2 / 2^k2) <= (sum u <= b1, f(u)) * (sum w <= b2, g(w)) by mono; with[(K1 * L^d1 / 2^k1) * (K2 * L^d2 / 2^k2) = K1 * K2 * L^(d1 + d2) / 2^(k1 + k2) by eq; V]]]
  "core out" with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e => forall s in Exponent(r) : S(u) = s => forall X : s_(X) <= B_(X) by logic; with[forall s in Exponent(r) : (forall X : s_(X) <= B_(X)) => (sum u <= b, iverson(G(u) <= e, S(u) = s)) <= C * 2^(n * N) * (iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) by with[(sum u <= b, iverson(G(u) <= e, S(u) = s)) <= C * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) by logic; chain[(sum u <= b, iverson(G(u) <= e, S(u) = s)) <= sum u <= b, iverson((s #feasible Pr #level L), G(u) <= e, S(u) = s) by sum[logic]; = iverson((s #feasible Pr #level L)) * (sum u <= b, iverson(G(u) <= e, S(u) = s)) by sum[cases V]; <= iverson((s #feasible Pr #level L)) * (C * 2^(n * N) / 2^(sum X, c_(X) * s_(X))) by mono; = C * 2^(n * N) * (iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) by V[0]]]; thm:pivots(core weight)[n := n, r := r, N := N, b := b, B := B, G := G, S := S, e := e, C := C, w(s) := iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))]]]
  "core in" with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= e => forall s in Exponent(r) : S(u) = s => forall X : s_(X) <= B_(X) by logic; with[(sum u <= b, iverson(G(u) <= e)) = sum s <= B, sum u <= b, iverson(G(u) <= e, S(u) = s) by fibres; chain[C * 2^(n * N) * (sum s <= B, iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) = sum s <= B, C * 2^(n * N) * (iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) by sum; <= sum s <= B, sum u <= b, iverson(G(u) <= e, S(u) = s) by sum[chain[C * 2^(n * N) * (iverson((s #feasible Pr #level L)) / 2^(sum X, c_(X) * s_(X))) = iverson((s #feasible Pr #level L)) * (C * 2^(n * N) / 2^(sum X, c_(X) * s_(X))) by V[0]; <= sum u <= b, iverson(G(u) <= e, S(u) = s) by cases[(s #feasible Pr #level L); with[C * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) <= sum u <= b, iverson(G(u) <= e, S(u) = s) by logic; V]; with[0 <= sum u <= b, iverson(G(u) <= e, S(u) = s) by sum[V[0]]; V]]]]; = sum u <= b, iverson(G(u) <= e) by V[1 * hw2]]]]
  "core dyadic" with[1 <= 2^p by V; with[2^t * 1 <= 2^t * 2^p by mono; (V[2 * h_1], V[1 * hw2 | 3 * h_1])]]
  "core capped" logic
  "core classabove" logic[with[forall j : (sum X, T_(j)_(X) * s_(X)) <= N by logic[with[(sum X, T_(j)_(X) * s_(X)) <= sum X, T_(j)_(X) * B_(X) by sum[with[s_(X) <= B_(X) by logic; mono]]; V[1 * h_1(j), 1 * hw2]]]; with[forall j : exists p in NN : N = (sum X, T_(j)_(X) * s_(X)) + p by logic[take[p := max(N - (sum X, T_(j)_(X) * s_(X)), 0); V[0]]]; with[exists P in Exponent(n) : forall j : N = (sum X, T_(j)_(X) * s_(X)) + P_(j) by choice; logic[with[forall j : 2 * 2^N <= 1 * (2 * 2^(P_(j))) * 2^(sum X, T_(j)_(X) * s_(X)) by logic[with[N = (sum X, T_(j)_(X) * s_(X)) + P_(j) by logic; with[2^N = 2^(sum X, T_(j)_(X) * s_(X)) * 2^(P_(j)) by eq; thm:pivots(core dyadic)[N := N, t := (sum X, T_(j)_(X) * s_(X)), p := P_(j)]]]]; with[forall j : (2 * 2^(P_(j)) + 1) * 2^(sum X, T_(j)_(X) * s_(X)) <= 3 * 2^N by logic[with[N = (sum X, T_(j)_(X) * s_(X)) + P_(j) by logic; with[2^N = 2^(sum X, T_(j)_(X) * s_(X)) * 2^(P_(j)) by eq; thm:pivots(core dyadic)[N := N, t := (sum X, T_(j)_(X) * s_(X)), p := P_(j)]]]]; with[(sum X, c_(X) * s_(X)) <= sum j, sum X, T_(j)_(X) * s_(X) by chain[(sum X, c_(X) * s_(X)) <= sum X, (sum j, T_(j)_(X)) * s_(X) by sum[mono]; = sum X, sum j, T_(j)_(X) * s_(X) by sum[sum[V]]; = sum j, sum X, T_(j)_(X) * s_(X) by sum[V]]; with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L, S(u) = s => forall y in Point(n) : F(u) = y => forall j : y_(j) <= 1 / 2^(sum X, T_(j)_(X) * s_(X)) by logic; with[forall j : forall u, w in Exponent(n) : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= 1 / 2^L, G(w) <= 1 / 2^L, S(u) = s, S(w) = s => forall y in Point(n) : F(u) = y => forall z in Point(n) : F(w) = z => 1 * u_(j) <= 1 * w_(j) + 2^N * (y_(j) + z_(j)) by logic[with[u_(j) <= w_(j) + 2^N * (y_(j) + z_(j)) by logic; V[hw18]]]; with[((forall X : s_(X) <= B_(X)), (sum X, c_(X) * s_(X)) <= sum j, sum X, T_(j)_(X) * s_(X), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L, S(u) = s => forall y in Point(n) : F(u) = y => forall j : y_(j) <= 1 / 2^(sum X, T_(j)_(X) * s_(X))), (forall j : forall u, w in Exponent(n) : (forall i : lam_(i) < lam_(j) => u_(i) = w_(i)), (forall i : u_(i) <= b_(i)), (forall i : w_(i) <= b_(i)), G(u) <= 1 / 2^L, G(w) <= 1 / 2^L, S(u) = s, S(w) = s => forall y in Point(n) : F(u) = y => forall z in Point(n) : F(w) = z => 1 * u_(j) <= 1 * w_(j) + 2^N * (y_(j) + z_(j)))) => (sum u <= b, iverson(G(u) <= 1 / 2^L, S(u) = s)) <= 3^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) by lem:chart(above)[n := n, r := r, N := N, lam := lam, b := b, t_(j) := (sum X, T_(j)_(X) * s_(X)), D_(j) := 2 * 2^(P_(j)), B := B, c := c, G := G, F := F, S := S, e := 1 / 2^L, a := 1, K := 3]; logic]]]]]]]]]]]
  "core half" V[1/2 * h_1]
  "core winlow" with[y * 2^(s + 1) = 2 * 2^s * y by eq; with[x * 2^(s + 1) = 2 * 2^s * x by eq; with[1 <= 2^s by V; with[2 * 2^s * (y + (W + 2)) <= 2 * 2^s * x by mono; V[1 * h_1, 1 * hw1, 1 * hw2, 2 * hw3, 1 * hw4]]]]]
  "core winup" with[x * 2^s <= (y + (W + 2) + W) * 2^s by mono; V[1 * hw1 | 1 * h_1]]
  "core winend" cases[y + (W + 2) + W <= b; V[1 * hc1]; with[b + 1 <= y + (W + 2) + W by V; with[(b + 1) * 2^s <= (y + (W + 2) + W) * 2^s by mono; with[1 <= 2^s by V; V]]]]
  "core unique" with[1 / 2^(s_(X) + 1) < y_(X) by logic; with[y_(X) <= 1 / 2^(s_(X)) by logic; cases[s2_(X) + 1 <= s_(X); with[1 / 2^(s_(X)) <= 1 / 2^(s2_(X) + 1) by lem:rules(core weigh)[K := s_(X), l := s2_(X) + 1]; cases[s2_(X) = B_(X); V; with[1 / 2^(s2_(X) + 1) < y_(X) by logic; V]]]; cases[s_(X) + 1 <= s2_(X); with[1 / 2^(s2_(X)) <= 1 / 2^(s_(X) + 1) by lem:rules(core weigh)[K := s2_(X), l := s_(X) + 1]; V]; V]]]]
  "core classbelow" with[1 / 2^Lp <= 1 / 2^L by lem:rules(core weigh)[K := Lp, l := L]; with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Point(n) : F(u) = y, (forall X : 0 < y_(X)) => forall s in Exponent(n) : S(u) = s, (forall kappa : Lp + Te.A_(kappa) + H <= sum X, Te.E_(kappa)_(X) * s_(X)) => G(u) <= 1 / 2^L by lem:compare(below)[n := n, r := n, k := k, L := Lp, h := H, b := b, B := B, G := G, Y := F, S := S, Te := Te, e := 1 / 2^L]; logic[with[forall j : exists p in NN : N = s_(j) + 1 + p by logic[take[p := max(N - (s_(j) + 1), 0); V[0]]]; with[exists P in Exponent(n) : forall j : N = s_(j) + 1 + P_(j) by choice; logic[with[forall j : exists w in NN : w + 1 = 2^(P_(j)) by logic[with[1 <= 2^(P_(j)) by V; take[w := max(2^(P_(j)) - 1, 0); V[0]]]]; with[exists W in Exponent(n) : forall j : W_(j) + 1 = 2^(P_(j)) by choice; logic[with[forall j : 2^N = 2 * 2^(s_(j)) * (W_(j) + 1) by logic[with[N = s_(j) + 1 + P_(j) by logic; with[W_(j) + 1 = 2^(P_(j)) by logic; lem:rules(core scale)[N := N, s := s_(j), p := P_(j), W := W_(j)]]]]; with[forall j : 1 / 2 * 2^N <= (W_(j) + 1) * 2^(s_(j)) by logic[with[2^N = 2 * 2^(s_(j)) * (W_(j) + 1) by logic; thm:pivots(core half)[N := N, s := s_(j), W := W_(j)]]]; with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : lam_(i) < lam_(j) => y_(i) + (W_(i) + 2) <= u_(i), u_(i) <= y_(i) + (W_(i) + 2) + W_(i)) => y_(j) + (W_(j) + 2) + W_(j) <= b_(j) by logic[with[forall i : lam_(i) < lam_(j) => y_(i) * 2^(s_(i) + 1) + 2^N < u_(i) * 2^(s_(i) + 1), u_(i) * 2^(s_(i)) <= y_(i) * 2^(s_(i)) + 2^N by with[y_(i) + (W_(i) + 2) <= u_(i) by logic; with[u_(i) <= y_(i) + (W_(i) + 2) + W_(i) by logic; with[2^N = 2 * 2^(s_(i)) * (W_(i) + 1) by logic; (thm:pivots(core winlow)[N := N, s := s_(i), W := W_(i), y := y_(i), x := u_(i)], thm:pivots(core winup)[N := N, s := s_(i), W := W_(i), y := y_(i), x := u_(i)])]]]; with[y_(j) * 2^(s_(j)) + 2^N <= b_(j) * 2^(s_(j)) by logic; with[2^N = 2 * 2^(s_(j)) * (W_(j) + 1) by logic; thm:pivots(core winend)[N := N, s := s_(j), W := W_(j), y := y_(j), b := b_(j)]]]]]; with[(sum X, s_(X)) <= sum X, c_(X) * s_(X) by sum[with[1 <= c_(X) by logic; with[1 * s_(X) <= c_(X) * s_(X) by mono; V[1 * hw22]]]]; with[forall u, v in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : v_(i) <= W_(i)) => forall y in Exponent(n) : M(u) = y, (forall j : u_(j) = y_(j) + (W_(j) + 2) + v_(j)) => G(u) <= 1 / 2^L, S(u) = s by with[S(u) = s by with[exists f in Point(n) : F(u) = f by take[f := F(u); V]; logic[with[exists s2 in Exponent(n) : S(u) = s2 by take[s2 := S(u); V]; logic[with[(f #sized s2 #cap B) by logic; with[forall X : 2^N * f_(X) = W_(X) + 2 + v_(X) by logic[with[u_(X) = y_(X) + (W_(X) + 2) + v_(X) by logic; with[y_(X) <= u_(X) by V; with[2^N * f_(X) + y_(X) = u_(X) by logic; V]]]]; with[forall X : 1 / 2^(s_(X) + 1) < f_(X), f_(X) <= 1 / 2^(s_(X)) by with[2^N = 2 * 2^(s_(X)) * (W_(X) + 1) by logic; with[2^N * f_(X) = W_(X) + 2 + v_(X) by logic; with[v_(X) <= W_(X) by logic; with[(1 / 2^(s_(X) + 1) < f_(X), f_(X) <= 1 / 2^(s_(X))) by lem:rules(window)[N := N, s := s_(X), W := W_(X), v := v_(X), f := f_(X)]; (V, V)]]]]; with[forall X : s2_(X) = s_(X) by thm:pivots(core unique)[r := n, y := f, s := s, s2 := s2, B := B]; V]]]]]]]]; with[G(u) <= 1 / 2^L by with[exists f in Point(n) : F(u) = f by take[f := F(u); V]; logic[with[forall X : 2^N * f_(X) = W_(X) + 2 + v_(X) by logic[with[u_(X) = y_(X) + (W_(X) + 2) + v_(X) by logic; with[y_(X) <= u_(X) by V; with[2^N * f_(X) + y_(X) = u_(X) by logic; V]]]]; with[forall X : 1 / 2^(s_(X) + 1) < f_(X), f_(X) <= 1 / 2^(s_(X)) by with[2^N = 2 * 2^(s_(X)) * (W_(X) + 1) by logic; with[2^N * f_(X) = W_(X) + 2 + v_(X) by logic; with[v_(X) <= W_(X) by logic; with[(1 / 2^(s_(X) + 1) < f_(X), f_(X) <= 1 / 2^(s_(X))) by lem:rules(window)[N := N, s := s_(X), W := W_(X), v := v_(X), f := f_(X)]; (V, V)]]]]; with[forall X : 0 < f_(X) by logic[with[1 / 2^(s_(X) + 1) < f_(X) by logic; V]]; logic]]]]]; (logic, logic)]]; with[((forall X : s_(X) <= B_(X)), (sum X, s_(X)) <= sum X, c_(X) * s_(X), (forall u, v in Exponent(n) : (forall i : u_(i) <= b_(i)), (forall i : v_(i) <= W_(i)) => forall y in Exponent(n) : M(u) = y, (forall j : u_(j) = y_(j) + (W_(j) + 2) + v_(j)) => G(u) <= 1 / 2^L, S(u) = s)) => (1 / 2)^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) <= sum u <= b, iverson(G(u) <= 1 / 2^L, S(u) = s) by lem:chart(below)[n := n, r := n, N := N, lam := lam, b := b, t := s, o_(j) := W_(j) + 2, W := W, B := B, c := c, M := M, G := G, S := S, e := 1 / 2^L, K := 1 / 2]; logic]]]]]]]]]]]]]]]
  "core classfeasible" with[forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (forall kappa : Lp + Te.A_(kappa) + H <= sum X, Te.E_(kappa)_(X) * s_(X)), (forall j : s_(j) + 1 <= N), (forall u in Exponent(n) : (forall i : u_(i) <= b_(i)) => forall y in Exponent(n) : M(u) = y => forall j : (forall i : lam_(i) < lam_(j) => y_(i) * 2^(s_(i) + 1) + 2^N < u_(i) * 2^(s_(i) + 1), u_(i) * 2^(s_(i)) <= y_(i) * 2^(s_(i)) + 2^N) => y_(j) * 2^(s_(j)) + 2^N <= b_(j) * 2^(s_(j))) => (1 / 2)^n * 2^(n * N) / 2^(sum X, c_(X) * s_(X)) <= sum u <= b, iverson(G(u) <= 1 / 2^L, S(u) = s) by thm:pivots(core classbelow)[n := n, k := k, N := N, L := L, Lp := Lp, H := H, b := b, B := B, c := c, lam := lam, G := G, F := F, S := S, M := M, Te := Te]; logic]
  (above) with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L => forall s in Exponent(r) : S(u) = s => forall kappa : L + 1 <= (sum X, Te.E_(kappa)_(X) * (s_(X) + 1)) + Te.A_(kappa) by lem:compare(above)[n := n, r := r, k := k, L := L, b := b, B := B, G := G, Y := Y, S := S, Te := Te, e := 1 / 2^L]; with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L => forall s in Exponent(r) : S(u) = s => (forall X : s_(X) <= B_(X)), (s #feasible Pr #level L) by (logic[with[exists y in Point(r) : Y(u) = y by take[y := Y(u); V]; logic[thm:pivots(core capped)[r := r, y := y, s := s, B := B]]]], with[forall kappa : L + 1 <= (sum X, Te.E_(kappa)_(X) * (s_(X) + 1)) + Te.A_(kappa) by logic; logic]); with[forall s in Exponent(r) : (forall X : s_(X) <= B_(X)) => (sum u <= b, iverson(G(u) <= 1 / 2^L, S(u) = s)) <= 3^n * 2^(n * Ch.N) / 2^(sum X, c_(X) * s_(X)) by thm:pivots(core classabove)[n := n, r := r, N := Ch.N, L := L, b := b, lam := Ch.lam, B := B, c := c, T := T, G := G, F := Ch.F, S := S]; thm:pivots(core out)[n := n, r := r, k := m, L := L, N := Ch.N, b := b, B := B, c := c, G := G, S := S, e := 1 / 2^L, C := 3^n, Pr := Pr]]]]
  (below) with[forall s in Exponent(n) : (forall X : s_(X) <= B_(X)), (s #feasible Pr #level Lp) => (1 / 2)^n * 2^(n * Ch.N) / 2^(sum X, c_(X) * s_(X)) <= sum u <= b, iverson(G(u) <= 1 / 2^L, S(u) = s) by thm:pivots(core classfeasible)[n := n, k := k, m := m, N := Ch.N, L := L, Lp := Lp, H := H, b := b, B := B, c := c, lam := Ch.lam, G := G, F := Ch.F, S := S, M := M, Te := Te, Pr := Pr]; with[forall u in Exponent(n) : (forall i : u_(i) <= b_(i)), G(u) <= 1 / 2^L => forall s in Exponent(n) : S(u) = s => forall X : s_(X) <= B_(X) by logic[with[exists y in Point(n) : Ch.F(u) = y by take[y := Ch.F(u); V]; logic[thm:pivots(core capped)[r := n, y := y, s := s, B := B]]]]; thm:pivots(core in)[n := n, r := n, k := m, L := Lp, N := Ch.N, b := b, B := B, c := c, G := G, S := S, e := 1 / 2^L, C := (1 / 2)^n, Pr := Pr]]]

-- The words of the pair on points of \cref{def:pair}: a potential has the pair \((\lambda,m)\) on a box when the number of
-- points of depth \(N\) where \(K\le2^{-L}\) is \(2^{nN}L^{m-1}2^{-\lfloor\lambda L\rfloor}\) up to constants, from below,
-- from above, or both.
type Potential(n) := Point(n) -> QQ>=0
relation (u #sublevel K #depth N #level L) := n, N, L in NN, u in Exponent(n), K in Potential(n), (exists w in Point(n) : (forall i : 2^N * w_(i) = u_(i)), K(w) <= 1 / 2^L)
relation (K #inner lambda #multiplicity m #box rho #at c #from Lz #depth a #plus h) := n in NN, lambda in QQ>=0, m in NN>=1, K in Potential(n), rho in Weight(n), c in QQ>0, Lz, a, h in NN, (forall L, N, kappa in NN, b in Exponent(n) : L >= Lz, N >= a * L + h, kappa <= lambda * L, lambda * L < kappa + 1, (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1) => c * L^m * 2^(n * N) <= L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L))))
relation (K #outer lambda #multiplicity m #box rho #at C #from Lz #depth a #plus h) := n in NN, lambda in QQ>=0, m in NN>=1, K in Potential(n), rho in Weight(n), C in QQ>0, Lz, a, h in NN, (forall L, N, kappa in NN, b in Exponent(n) : L >= Lz, N >= a * L + h, kappa <= lambda * L, lambda * L < kappa + 1, (forall i : b_(i) <= 2^N * rho_(i), 2^N * rho_(i) < b_(i) + 1) => L * 2^kappa * (sum u <= b, iverson((u #sublevel K #depth N #level L))) <= C * L^m * 2^(n * N))
relation (K #points lambda #multiplicity m #box rho #between c #and C #from Lz #depth a #plus h) := n in NN, lambda in QQ>=0, m in NN>=1, K in Potential(n), rho in Weight(n), c, C in QQ>0, Lz, a, h in NN, (K #inner lambda #multiplicity m #box rho #at c #from Lz #depth a #plus h), (K #outer lambda #multiplicity m #box rho #at C #from Lz #depth a #plus h)
