-- Q++ 0.2
module mean
uses root

subsection sec:mean Cells that meet by a table

-- Cells meet by a symmetric table \(P\) of masses, and a positive string \(x\) has \(\sum_jP_{ij}x_j=b_ix_i\) at every cell. Rescaled by the string, \(q_i=y_i/x_i\) and \(w_{ij}=P_{ij}x_ix_j\), the mean tie says that each \(q_i\) is the mean of the \(q_j\) of the cells it meets; added over the cells it ties two energies that are dominated term by term, so every term ties, as in the termwise core of \cref{lem:selfdual}, and every meeting ties (tie). A second string is a multiple of the first on every meeting (one); the rows add up to the sum rule (sum); weights on one side of the degrees are the degrees (flat), (flatdown), and then the string is even (even); the form of the weights is at least the cross terms of the table (form), with the tie only at the multiples of the string (null).
lemma lem:mean [cells that meet by a symmetric table: the mean tie]
  core double: A, B in QQ>=0 : A * B + A * B <= A^2 + B^2
  core square: A, B in QQ>=0, A^2 + B^2 = A * B + A * B : A = B
  core below: n in NN>=1, w in Forms(n, n), q in Point(n), (forall i : forall j : w_(i)_(j) = w_(j)_(i)) : (sum i, sum j, w_(i)_(j) * q_(i) * q_(j)) <= (sum i, sum j, w_(i)_(j) * q_(i)^2)
  core energy: n in NN>=1, w in Forms(n, n), q in Point(n), (forall i : forall j : w_(i)_(j) = w_(j)_(i)), (sum i, sum j, w_(i)_(j) * q_(i) * q_(j)) = (sum i, sum j, w_(i)_(j) * q_(i)^2) : forall i : forall j : w_(i)_(j) * q_(i) = w_(i)_(j) * q_(j)
  core mean: n in NN>=1, w in Forms(n, n), q in Point(n), (forall i : forall j : w_(i)_(j) = w_(j)_(i)), (forall i : (sum j, w_(i)_(j) * q_(j)) = q_(i) * (sum j, w_(i)_(j))) : forall i : forall j : w_(i)_(j) * q_(i) = w_(i)_(j) * q_(j)
  (tie): n in NN>=1, P in Forms(n, n), x in Weight(n), y in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : x_(i) * (sum j, P_(i)_(j) * y_(j)) = y_(i) * (sum j, P_(i)_(j) * x_(j))) : forall i : forall j : P_(i)_(j) * x_(i) * y_(j) = P_(i)_(j) * y_(i) * x_(j)
  fix (tie) mean.tie
  neqfix (tie) mean.tie.nosym
  (one): n in NN>=1, P in Forms(n, n), b, x in Weight(n), y in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (forall i : (sum j, P_(i)_(j) * y_(j)) = b_(i) * y_(i)) : forall i : forall j : P_(i)_(j) * x_(i) * y_(j) = P_(i)_(j) * y_(i) * x_(j)
  fix (one) mean.one
  neqfix (one) mean.one.nostring
  (sum): n in NN>=1, P in Forms(n, n), b, x in Weight(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)) : (sum i, b_(i) * x_(i)) = sum i, (sum j, P_(i)_(j)) * x_(i)
  fix (sum) mean.sum
  neqfix (sum) mean.sum.nosym
  (flat): n in NN>=1, P in Forms(n, n), b, x in Weight(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (forall i : (sum j, P_(i)_(j)) <= b_(i)) : forall i : b_(i) = (sum j, P_(i)_(j))
  fix (flat) mean.flat
  neqfix (flat) mean.flat.nostring
  (flatdown): n in NN>=1, P in Forms(n, n), b, x in Weight(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (forall i : b_(i) <= (sum j, P_(i)_(j))) : forall i : b_(i) = (sum j, P_(i)_(j))
  fix (flatdown) mean.flatdown
  neqfix (flatdown) mean.flatdown.nostring
  (even): n in NN>=1, P in Forms(n, n), b, x in Weight(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (forall i : b_(i) = (sum j, P_(i)_(j))) : forall i : forall j : P_(i)_(j) * x_(i) = P_(i)_(j) * x_(j)
  fix (even) mean.even
  neqfix (even) mean.even.nodegree
  (form): n in NN>=1, P in Forms(n, n), b, x in Weight(n), u in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)) : (sum i, sum j, P_(i)_(j) * u_(i) * u_(j)) <= (sum i, b_(i) * u_(i)^2)
  fix (form) mean.form
  neqfix (form) mean.form.nostring
  (null): n in NN>=1, P in Forms(n, n), b, x in Weight(n), u in Point(n), (forall i : forall j : P_(i)_(j) = P_(j)_(i)), (forall i : (sum j, P_(i)_(j) * x_(j)) = b_(i) * x_(i)), (sum i, sum j, P_(i)_(j) * u_(i) * u_(j)) = (sum i, b_(i) * u_(i)^2) : forall i : forall j : P_(i)_(j) * x_(j) * u_(i) = P_(i)_(j) * x_(i) * u_(j)
  fix (null) mean.null
  neqfix (null) mean.null.notie
  origin: ?{\text{form proved: rescaled by the string, the mean tie is a tie of two energies dominated term by term, so every term ties; the statements are classical: the case of equality in the proof of \cite[Lemma~6.8]{Ciliberto2019}, a statement over the rationals, with Zariski's lemma as its case at a fibre \cite[Theorem~6.7]{Ciliberto2019}, and \cite[Lemma~I.2.10]{BarthPetersVandeVen1984}, read through \cite[Proposition~B.7]{KeilenTyomkin2002}}}

proof lem:mean
  "core double" cases[A <= B; V[hc1 * hc1]; V[hn1 * hn1]]
  "core square" cases[A < B; with[A * B + A * B < A^2 + B^2 by V[hc1 * hc1]; with[A^2 + B^2 <= A * B + A * B by V[h_3]; logic]]; cases[B < A; with[A * B + A * B < A^2 + B^2 by V[hc2 * hc2]; with[A^2 + B^2 <= A * B + A * B by V[h_3]; logic]]; V[hn2], V[hn1]]]
  "core below" with[(sum k, sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l))) <= (sum k, sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2)) by sum[sum[with[q_(k) * q_(l) + q_(k) * q_(l) <= q_(k)^2 + q_(l)^2 by lem:mean(core double)[A := q_(k), B := q_(l)]; mono]]]; with[(sum k, sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l))) = (sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) + (sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) by sum[sum[V[0]]]; with[(sum k, sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2)) = (sum k, sum l, w_(k)_(l) * q_(k)^2) + (sum k, sum l, w_(k)_(l) * q_(l)^2) by sum[sum[V[0]]]; with[(sum k, sum l, w_(k)_(l) * q_(l)^2) = (sum l, sum k, w_(l)_(k) * q_(l)^2) by sum[sum[V[q_(l)^2 * h_1(k, l)]]]; with[(sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) + (sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) = (sum k, sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l))) by V[1 * hw3]; V[(1/2) * hw1, (1/2) * hw6, (1/2) * hw4, (1/2) * hw5]]]]]]
  "core energy" with[exists A in Point(n) : forall k : A_(k) = sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2) by take[A_(k) := (sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2)); V]; with[exists C in Point(n) : forall k : C_(k) = sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l)) by take[C_(k) := (sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l))); V]; logic[with[forall k : C_(k) <= A_(k) by logic[with[(sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l))) <= sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2) by sum[with[q_(k) * q_(l) + q_(k) * q_(l) <= q_(k)^2 + q_(l)^2 by lem:mean(core double)[A := q_(k), B := q_(l)]; mono]]; with[C_(k) = sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l)) by V; with[A_(k) = sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2) by V; with[(sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2)) = A_(k) by V[1 * hw7]; V[1 * hw4, 1 * hw6, 1 * hw8]]]]]]; with[(sum k, A_(k)) = (sum k, sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2)) by sum[V]; with[(sum k, C_(k)) = (sum k, sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l))) by sum[V]; with[(sum k, sum l, w_(k)_(l) * (q_(k) * q_(l) + q_(k) * q_(l))) = (sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) + (sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) by sum[sum[V[0]]]; with[(sum k, sum l, w_(k)_(l) * (q_(k)^2 + q_(l)^2)) = (sum k, sum l, w_(k)_(l) * q_(k)^2) + (sum k, sum l, w_(k)_(l) * q_(l)^2) by sum[sum[V[0]]]; with[(sum k, sum l, w_(k)_(l) * q_(l)^2) = (sum l, sum k, w_(l)_(k) * q_(l)^2) by sum[sum[V[q_(l)^2 * h_1(k, l)]]]; with[(sum k, A_(k)) = (sum k, sum l, w_(k)_(l) * q_(k)^2) + (sum k, sum l, w_(k)_(l) * q_(k)^2) by V[1 * hw9, 1 * hw12, 1 * hw13]; with[(sum k, C_(k)) = (sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) + (sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) by V[1 * hw10, 1 * hw11]; with[(sum k, A_(k)) = sum k, C_(k) by V[1 * hw14, 1 * hw15, 2 * h_2]; with[forall k : A_(k) = C_(k) by lem:selfdual(core termwise)[n := n, a := A, b := C]; with[A_(i) = C_(i) by V; with[exists R in Point(n) : forall l : R_(l) = w_(i)_(l) * (q_(i)^2 + q_(l)^2) by take[R_(l) := w_(i)_(l) * (q_(i)^2 + q_(l)^2); V]; with[exists S in Point(n) : forall l : S_(l) = w_(i)_(l) * (q_(i) * q_(l) + q_(i) * q_(l)) by take[S_(l) := w_(i)_(l) * (q_(i) * q_(l) + q_(i) * q_(l)); V]; logic[with[forall l : S_(l) <= R_(l) by logic[with[q_(i) * q_(l) + q_(i) * q_(l) <= q_(i)^2 + q_(l)^2 by lem:mean(core double)[A := q_(i), B := q_(l)]; with[w_(i)_(l) * (q_(i) * q_(l) + q_(i) * q_(l)) <= w_(i)_(l) * (q_(i)^2 + q_(l)^2) by mono; with[S_(l) = w_(i)_(l) * (q_(i) * q_(l) + q_(i) * q_(l)) by V; with[R_(l) = w_(i)_(l) * (q_(i)^2 + q_(l)^2) by V; with[w_(i)_(l) * (q_(i)^2 + q_(l)^2) = R_(l) by V[1 * hw25]; V[1 * hw23, 1 * hw24, 1 * hw26]]]]]]]; with[(sum l, R_(l)) = sum l, w_(i)_(l) * (q_(i)^2 + q_(l)^2) by sum[V]; with[A_(i) = sum l, w_(i)_(l) * (q_(i)^2 + q_(l)^2) by V; with[(sum l, S_(l)) = sum l, w_(i)_(l) * (q_(i) * q_(l) + q_(i) * q_(l)) by sum[V]; with[C_(i) = sum l, w_(i)_(l) * (q_(i) * q_(l) + q_(i) * q_(l)) by V; with[(sum l, R_(l)) = A_(i) by V[1 * hw27, 1 * hw28]; with[(sum l, S_(l)) = C_(i) by V[1 * hw29, 1 * hw30]; with[(sum l, R_(l)) = sum l, S_(l) by V[1 * hw31, 1 * hw18, 1 * hw32]; with[forall l : R_(l) = S_(l) by lem:selfdual(core termwise)[n := n, a := R, b := S]; with[R_(j) = S_(j) by V; with[R_(j) = w_(i)_(j) * (q_(i)^2 + q_(j)^2) by V; with[S_(j) = w_(i)_(j) * (q_(i) * q_(j) + q_(i) * q_(j)) by V; with[(w_(i)_(j) * q_(i))^2 + (w_(i)_(j) * q_(j))^2 = w_(i)_(j) * q_(i) * (w_(i)_(j) * q_(j)) + w_(i)_(j) * q_(i) * (w_(i)_(j) * q_(j)) by V[w_(i)_(j) * hw35, w_(i)_(j) * hw36, w_(i)_(j) * hw37]; lem:mean(core square)[A := w_(i)_(j) * q_(i), B := w_(i)_(j) * q_(j)]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
  "core mean" with[forall k : (sum l, w_(k)_(l) * q_(k) * q_(l)) = sum l, w_(k)_(l) * q_(k)^2 by logic[with[(sum l, w_(k)_(l) * q_(k) * q_(l)) = q_(k) * (sum l, w_(k)_(l) * q_(l)) by sum[V]; with[(sum l, w_(k)_(l) * q_(k)^2) = q_(k)^2 * (sum l, w_(k)_(l)) by sum[V]; V[1 * hw2, 1 * hw3, q_(k) * h_2(k)]]]]; with[(sum k, sum l, w_(k)_(l) * q_(k) * q_(l)) = (sum k, sum l, w_(k)_(l) * q_(k)^2) by sum[V]; lem:mean(core energy)[n := n, w := w, q := q]]]
  (tie) with[exists w in Forms(n, n) : forall k : forall l : w_(k)_(l) = P_(k)_(l) * x_(k) * x_(l) by take[w_(k)_(l) := P_(k)_(l) * x_(k) * x_(l); V]; with[exists q in Point(n) : forall k : q_(k) * x_(k) = y_(k) by take[q_(k) := y_(k) / x_(k); V]; logic[with[forall k : forall l : w_(k)_(l) = P_(k)_(l) * x_(k) * x_(l) by V; with[forall k : q_(k) * x_(k) = y_(k) by V; with[forall k : forall l : w_(k)_(l) = w_(l)_(k) by logic[with[P_(k)_(l) = P_(l)_(k) by V[1 * h_1(k, l)]; V[1 * hw3(k, l), 1 * hw3(l, k), (x_(k) * x_(l)) * hw6]]]; with[forall k : (sum l, w_(k)_(l) * q_(l)) = q_(k) * (sum l, w_(k)_(l)) by logic[with[(sum l, w_(k)_(l) * q_(l)) = sum l, P_(k)_(l) * x_(k) * (q_(l) * x_(l)) by sum[V[q_(l) * hw3(k, l)]]; with[(sum l, P_(k)_(l) * x_(k) * (q_(l) * x_(l))) = x_(k) * (sum l, P_(k)_(l) * y_(l)) by sum[V[(P_(k)_(l) * x_(k)) * hw4(l)]]; with[(sum l, w_(k)_(l)) = x_(k) * (sum l, P_(k)_(l) * x_(l)) by sum[V[1 * hw3(k, l)]]; with[q_(k) * (sum l, w_(k)_(l)) = y_(k) * (sum l, P_(k)_(l) * x_(l)) by V[q_(k) * hw10, (sum l, P_(k)_(l) * x_(l)) * hw4(k)]; V[1 * hw8, 1 * hw9, 1 * h_2(k), 1 * hw11]]]]]]; with[forall k : forall l : w_(k)_(l) * q_(k) = w_(k)_(l) * q_(l) by lem:mean(core mean)[n := n, w := w, q := q]; with[P_(i)_(j) * x_(i) * x_(j) * q_(i) = P_(i)_(j) * x_(i) * x_(j) * q_(j) by V[1 * hw12(i, j), q_(i) * hw3(i, j), q_(j) * hw3(i, j)]; V[1 * hw13, (P_(i)_(j) * x_(i)) * hw4(j), (P_(i)_(j) * x_(j)) * hw4(i)]]]]]]]]]]
  (one) with[forall k : x_(k) * (sum l, P_(k)_(l) * y_(l)) = y_(k) * (sum l, P_(k)_(l) * x_(l)) by logic[V[x_(k) * h_3(k), y_(k) * h_2(k)]]; lem:mean(tie)[n := n, P := P, x := x, y := y]]
  (sum) with[(sum i, b_(i) * x_(i)) = sum i, sum j, P_(i)_(j) * x_(j) by sum[V[1 * h_2(i)]]; with[(sum i, sum j, P_(i)_(j) * x_(j)) = (sum j, sum i, P_(j)_(i) * x_(j)) by sum[sum[V[x_(j) * h_1(i, j)]]]; with[(sum j, sum i, P_(j)_(i) * x_(j)) = sum j, (sum i, P_(j)_(i)) * x_(j) by sum[sum[V]]; V[1 * hw1, 1 * hw2, 1 * hw3]]]]
  (flat) with[(sum i, b_(i) * x_(i)) = sum i, (sum j, P_(i)_(j)) * x_(i) by lem:mean(sum)[n := n, P := P, b := b, x := x]; with[exists a in Point(n) : forall k : a_(k) = b_(k) * x_(k) by take[a_(k) := b_(k) * x_(k); V]; with[exists c in Point(n) : forall k : c_(k) = (sum l, P_(k)_(l)) * x_(k) by take[c_(k) := (sum l, P_(k)_(l)) * x_(k); V]; logic[with[forall k : a_(k) = b_(k) * x_(k) by V; with[forall k : c_(k) = (sum l, P_(k)_(l)) * x_(k) by V; with[(sum k, a_(k)) = sum k, b_(k) * x_(k) by sum[V[1 * hw4(k)]]; with[(sum k, c_(k)) = sum k, (sum l, P_(k)_(l)) * x_(k) by sum[V[1 * hw5(k)]]; with[(sum k, a_(k)) = sum k, c_(k) by V[1 * hw6, 1 * hw1, 1 * hw7]; with[forall m : c_(m) <= a_(m) by logic[with[(sum j, P_(m)_(j)) <= b_(m) by V[1 * h_3(m)]; with[a_(m) = b_(m) * x_(m) by V; with[c_(m) = (sum l, P_(m)_(l)) * x_(m) by V; with[b_(m) * x_(m) = a_(m) by V[1 * hw11]; V[x_(m) * hw10, 1 * hw13, 1 * hw12]]]]]]; with[forall k : a_(k) = c_(k) by lem:selfdual(core termwise)[n := n, a := a, b := c]; with[b_(i) * x_(i) = (sum j, P_(i)_(j)) * x_(i) by V[1 * hw14(i), 1 * hw4(i), 1 * hw5(i)]; with[(sum j, P_(i)_(j)) * x_(i) = b_(i) * x_(i) by V[1 * hw15]; cases[b_(i) < (sum j, P_(i)_(j)); with[b_(i) * x_(i) < (sum j, P_(i)_(j)) * x_(i) by V[x_(i) * hc1]; with[(sum j, P_(i)_(j)) * x_(i) <= b_(i) * x_(i) by V[1 * hw16]; logic]]; cases[(sum j, P_(i)_(j)) < b_(i); with[(sum j, P_(i)_(j)) * x_(i) < b_(i) * x_(i) by V[x_(i) * hc2]; with[b_(i) * x_(i) <= (sum j, P_(i)_(j)) * x_(i) by V[1 * hw15]; logic]]; V[hn2], V[hn1]]]]]]]]]]]]]]]]
  (flatdown) with[(sum i, b_(i) * x_(i)) = sum i, (sum j, P_(i)_(j)) * x_(i) by lem:mean(sum)[n := n, P := P, b := b, x := x]; with[exists a in Point(n) : forall k : a_(k) = b_(k) * x_(k) by take[a_(k) := b_(k) * x_(k); V]; with[exists c in Point(n) : forall k : c_(k) = (sum l, P_(k)_(l)) * x_(k) by take[c_(k) := (sum l, P_(k)_(l)) * x_(k); V]; logic[with[forall k : a_(k) = b_(k) * x_(k) by V; with[forall k : c_(k) = (sum l, P_(k)_(l)) * x_(k) by V; with[(sum k, a_(k)) = sum k, b_(k) * x_(k) by sum[V[1 * hw4(k)]]; with[(sum k, c_(k)) = sum k, (sum l, P_(k)_(l)) * x_(k) by sum[V[1 * hw5(k)]]; with[(sum k, c_(k)) = sum k, a_(k) by V[1 * hw7, 1 * hw1, 1 * hw6]; with[forall m : a_(m) <= c_(m) by logic[with[b_(m) <= (sum j, P_(m)_(j)) by V[1 * h_3(m)]; with[a_(m) = b_(m) * x_(m) by V; with[c_(m) = (sum l, P_(m)_(l)) * x_(m) by V; with[(sum l, P_(m)_(l)) * x_(m) = c_(m) by V[1 * hw12]; V[x_(m) * hw10, 1 * hw11, 1 * hw13]]]]]]; with[forall k : c_(k) = a_(k) by lem:selfdual(core termwise)[n := n, a := c, b := a]; with[b_(i) * x_(i) = (sum j, P_(i)_(j)) * x_(i) by V[1 * hw14(i), 1 * hw4(i), 1 * hw5(i)]; with[(sum j, P_(i)_(j)) * x_(i) = b_(i) * x_(i) by V[1 * hw15]; cases[b_(i) < (sum j, P_(i)_(j)); with[b_(i) * x_(i) < (sum j, P_(i)_(j)) * x_(i) by V[x_(i) * hc1]; with[(sum j, P_(i)_(j)) * x_(i) <= b_(i) * x_(i) by V[1 * hw16]; logic]]; cases[(sum j, P_(i)_(j)) < b_(i); with[(sum j, P_(i)_(j)) * x_(i) < b_(i) * x_(i) by V[x_(i) * hc2]; with[b_(i) * x_(i) <= (sum j, P_(i)_(j)) * x_(i) by V[1 * hw15]; logic]]; V[hn2], V[hn1]]]]]]]]]]]]]]]]
  (even) with[exists y in Point(n) : forall k : y_(k) = 1 by take[y_(k) := 1; V]; logic[with[forall k : y_(k) = 1 by V; with[forall k : (sum l, P_(k)_(l) * y_(l)) = b_(k) * y_(k) by logic[with[(sum l, P_(k)_(l) * y_(l)) = sum l, P_(k)_(l) by sum[V[P_(k)_(l) * hw2(l)]]; V[1 * hw4, 1 * h_3(k), b_(k) * hw2(k)]]]; with[forall k : forall l : P_(k)_(l) * x_(k) * y_(l) = P_(k)_(l) * y_(k) * x_(l) by lem:mean(one)[n := n, P := P, b := b, x := x, y := y]; V[1 * hw5(i, j), (P_(i)_(j) * x_(i)) * hw2(j), (P_(i)_(j) * x_(j)) * hw2(i)]]]]]]
