/-- (x - 1)^2 (x - 3/2)^2 + 1/64 > 0 on 1/2 < x < 2: 3 splits, 4 boxes with positive Bernstein coefficients. -/
theorem box_bernstein (x : Mass) (h1 : (1 / 2) < x) (h2 : x < 2) :
    (15 / 2) * x + 5 * x ^ 3 < (145 / 64) + (37 / 4) * x ^ 2 + x ^ 4 := by
  rcases Mass.split (5 / 4) h1 h2 with ⟨h1, h2⟩ | rfl | ⟨h1, h2⟩
  · rcases Mass.split (7 / 8) h1 h2 with ⟨h1, h2⟩ | rfl | ⟨h1, h2⟩
    · obtain ⟨c, c', rfl⟩ := Mass.box h1 h2
      farkas
    · farkas
    · obtain ⟨c, c', rfl⟩ := Mass.box h1 h2
      farkas
  · farkas
  · rcases Mass.split (13 / 8) h1 h2 with ⟨h1, h2⟩ | rfl | ⟨h1, h2⟩
    · obtain ⟨c, c', rfl⟩ := Mass.box h1 h2
      farkas
    · farkas
    · obtain ⟨c, c', rfl⟩ := Mass.box h1 h2
      farkas

