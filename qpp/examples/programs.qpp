-- Q++ 0.2
paper programs
bib references.bib
-- Linear programs in scales, read by their LP certificates: one price per row of the given, a farkas line over the
-- rows, and the points (feasible, attaining the value). The programs: one of type I, a triangle, both vertices of a
-- two-node tree program, and the silent program of a ladder step.

section sec:programs Programs

-- The program of type I.
lemma lem:typeone [the program of type I]
  given: v_s, v_a, v_b, v_k in QQ>=0, 4 * v_s + 2 * v_a >= 1, 4 * v_s + 2 * v_b >= 1, 4 * v_s + 4 * v_k >= 1, 6 * v_s >= 1
  (1): 6 * v_s + v_a + v_b + v_k >= 17 / 12
  at: v_s := 1 / 6, v_a := 1 / 6, v_b := 1 / 6, v_k := 1 / 12
  (2): 6 * v_s + v_a + v_b + v_k = 17 / 12 => v_s = 1 / 6, v_a = 1 / 6, v_b = 1 / 6, v_k = 1 / 12

-- Weak duality; the optimum is unique.
proof lem:typeone
  (1) LP[1 / 2, 1 / 2, 1 / 4, 1 / 6]
  (2) V, V, V, V

-- A tie: the optimal face is a triangle, so m = 3.
lemma lem:triangle [a triangle of optima]
  given: v_s, v_x, v_t, v_y in QQ>=0, v_s + v_y >= 1 / 2, v_x + v_t >= 1 / 2, v_x + v_y >= 1 / 2
  (1): v_s + v_x + v_t + v_y >= 1
  at: v_s := 1 / 2, v_x := 1 / 2, v_t := 0, v_y := 0; v_s := 0, v_x := 0, v_t := 1 / 2, v_y := 1 / 2; v_s := 0, v_x := 1 / 2, v_t := 0, v_y := 1 / 2
  (2): v_s + v_x + v_t + v_y = 1 => v_s + v_y = 1 / 2, v_x + v_t = 1 / 2

-- The two priced rows are tight on the optimal face.
proof lem:triangle
  (1) LP[1, 1, 0]
  (2) V, V

-- The two-node tree program, k = K + 2: the site vertex, where eta K >= 3.
lemma lem:twonodeA [two nodes, the site vertex]
  given: K, eta in QQ>0, eta * K >= 3, y, v_r, v_B, z in QQ>=0, 2 * y >= 1, v_B >= v_r, 2 * z + 2 * v_B >= 1, 3 * v_B + eta * v_r >= 1
  (1): y + v_r + (K + 1) * v_B + z >= 1 + (K + 1) / (3 + eta)
  at: y := 1 / 2, v_r := 1 / (3 + eta), v_B := 1 / (3 + eta), z := (1 + eta) / (2 * (3 + eta))

-- The order row is priced (eta K - 3)/(3 + eta), the hypothesis times 1/(3 + eta).
proof lem:twonodeA
  (1) LP[1 / 2, 1 / (3 + eta) * h_1, 1 / 2, (K + 1) / (3 + eta)]

-- The free vertex, where eta K <= 3.
lemma lem:twonodeB [two nodes, the free vertex]
  given: K, eta in QQ>0, eta * K <= 3, y, v_r, v_B, z in QQ>=0, 2 * y >= 1, v_B >= v_r, 2 * z + 2 * v_B >= 1, 3 * v_B + eta * v_r >= 1
  (1): y + v_r + (K + 1) * v_B + z >= 1 + K / 3
  at: y := 1 / 2, v_r := 0, v_B := 1 / 3, z := 1 / 6

-- The reduced cost of v_r is 1 - eta K/3, the hypothesis times v_r/3.
proof lem:twonodeB
  (1) LP[1 / 2, 0, 1 / 2, K / 3; 1 / 3 * h_1 * h_3]

-- The silent program of a ladder step at D = 2 + E > 2: the value 1/D at (0, 1/D), alone.
lemma lem:silentprog [a silent minimum]
  given: E in QQ>0, v_S, v_e in QQ>=0, 2 * v_S + (2 + E) * v_e >= 1
  (1): v_S + v_e >= 1 / (2 + E)
  at: v_S := 0, v_e := 1 / (2 + E)
  (2): v_S + v_e = 1 / (2 + E) => v_S <= 0

-- The reduced cost of v_S is E/(2 + E); on the optimal face E v_S <= 0.
proof lem:silentprog
  (1) LP[1 / (2 + E); E / (2 + E) * h_1]
  (2) div[E; V[(2 + E) * hi1, h_3]]
