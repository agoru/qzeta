/-- type Pair := pair (qpp/examples/refused/programs.qpp:10) -/
abbrev Pair : Type := WithTop (Lex (Prod NNRat (OrderDual Nat)))

/-- the pair (l, m) as (l, ord) with ord = m - 1: the product of pairs is + -/
def Pair.mk (l : NNRat) (o : ℕ) : Pair := ((toLex (l, OrderDual.toDual o) : Lex (Prod NNRat (OrderDual ℕ))) : Pair)

theorem Pair.mk_le {l l' : NNRat} {o o' : ℕ} : Pair.mk l o ≤ Pair.mk l' o' ↔ l < l' ∨ (l = l' ∧ o' ≤ o) := by
  simp [Pair.mk, Prod.Lex.le_iff]

theorem Pair.mk_add (l l' : NNRat) (o o' : ℕ) : Pair.mk l o + Pair.mk l' o' = Pair.mk (l + l') (o + o') := rfl

theorem Pair.mk_lt {l l' : NNRat} {o o' : ℕ} : Pair.mk l o < Pair.mk l' o' ↔ l < l' ∨ (l = l' ∧ o' < o) := by
  simp [Pair.mk, Prod.Lex.lt_iff]

/-- the order of literal pairs read in Rat, with no choice of a branch: the first coordinates compare, and where they are equal the orders compare -/
theorem Pair.mk_le_rat {l l' : NNRat} {o o' : ℕ} : Pair.mk l o ≤ Pair.mk l' o' ↔ (l : ℚ) ≤ l' ∧ ((l : ℚ) = l' → o' ≤ o) := by
  rw [Pair.mk_le]; norm_cast0
  constructor
  · rintro (h | ⟨h, h'⟩)
    · exact ⟨h.le, fun e => absurd e h.ne⟩
    · exact ⟨h.le, fun _ => h'⟩
  · rintro ⟨h, h'⟩
    rcases h.lt_or_eq with h | h
    · exact Or.inl h
    · exact Or.inr ⟨h, h' h⟩

/-- a literal pair with the smaller first coordinate is the smaller pair, whatever the orders -/
theorem Pair.mk_le_of_lt {l l' : NNRat} (o o' : ℕ) (h : (l : ℚ) < l') : Pair.mk l o ≤ Pair.mk l' o' :=
  Pair.mk_le.2 (Or.inl (by exact_mod_cast h))

/-- the order of literal pairs read in Rat, with no choice of a branch: the first coordinates compare, and where they are equal the orders compare -/
theorem Pair.mk_lt_rat {l l' : NNRat} {o o' : ℕ} : Pair.mk l o < Pair.mk l' o' ↔ (l : ℚ) ≤ l' ∧ ((l : ℚ) = l' → o' < o) := by
  rw [Pair.mk_lt]; norm_cast0
  constructor
  · rintro (h | ⟨h, h'⟩)
    · exact ⟨h.le, fun e => absurd e h.ne⟩
    · exact ⟨h.le, fun _ => h'⟩
  · rintro ⟨h, h'⟩
    rcases h.lt_or_eq with h | h
    · exact Or.inl h
    · exact Or.inr ⟨h, h' h⟩

/-- a literal pair with the smaller first coordinate is the smaller pair, whatever the orders -/
theorem Pair.mk_lt_of_lt {l l' : NNRat} (o o' : ℕ) (h : (l : ℚ) < l') : Pair.mk l o < Pair.mk l' o' :=
  Pair.mk_lt.2 (Or.inl (by exact_mod_cast h))

theorem Pair.mk_eq_rat {l l' : NNRat} {o o' : ℕ} : Pair.mk l o = Pair.mk l' o' ↔ (l : ℚ) = l' ∧ o = o' := by
  simp [Pair.mk]

@[simp] theorem Pair.mk_lt_top (l : NNRat) (o : ℕ) : Pair.mk l o < ⊤ := WithTop.coe_lt_top _

@[simp] theorem Pair.mk_ne_top (l : NNRat) (o : ℕ) : Pair.mk l o ≠ ⊤ := WithTop.coe_ne_top

/-- prog(S : c) = p: p is top and no point of S is feasible, or p stores the least value L of the cost c over S (an NNRat: a least value below zero gives no pair) and the dimension of the set of points of S of cost L -/
def Pair.IsProg {k : ℕ} (S : Set (Fin k → ℚ)) (c : (Fin k → ℚ) → ℚ) (p : Pair) : Prop :=
  (p = ⊤ ∧ S = ∅) ∨
    ∃ L : NNRat, IsLeast (c '' S) (L : ℚ) ∧
      p = Pair.mk L (Module.finrank ℚ (vectorSpan ℚ {x | x ∈ S ∧ c x = L}))

theorem Pair.isProg_mk {k d : ℕ} {S : Set (Fin k → ℚ)} {c : (Fin k → ℚ) → ℚ} {L : NNRat}
    (hL : IsLeast (c '' S) (L : ℚ))
    (hd : Module.finrank ℚ (vectorSpan ℚ {x | x ∈ S ∧ c x = L}) = d) : Pair.IsProg S c (Pair.mk L d) :=
  Or.inr ⟨L, hL, by rw [hd]⟩

theorem Pair.isProg_top {k : ℕ} {S : Set (Fin k → ℚ)} {c : (Fin k → ℚ) → ℚ} (hS : S = ∅) :
    Pair.IsProg S c ⊤ :=
  Or.inl ⟨rfl, hS⟩

/-- the relation is functional: a program has at most one pair -/
theorem Pair.isProg_unique {k : ℕ} {S : Set (Fin k → ℚ)} {c : (Fin k → ℚ) → ℚ} {p q : Pair}
    (hp : Pair.IsProg S c p) (hq : Pair.IsProg S c q) : p = q := by
  rcases hp with ⟨rfl, hS⟩ | ⟨L, hL, rfl⟩ <;> rcases hq with ⟨rfl, hS'⟩ | ⟨L', hL', rfl⟩
  · rfl
  · obtain ⟨x, hx, -⟩ := hL'.1; simp [hS] at hx
  · obtain ⟨x, hx, -⟩ := hL.1; simp [hS'] at hx
  · rw [NNRat.coe_inj.1 (hL.unique hL')]

/-- the reading of a program at a point: its least value is at most the cost at every feasible point -/
theorem Pair.IsProg.le {k d : ℕ} {S : Set (Fin k → ℚ)} {c : (Fin k → ℚ) → ℚ} {L : NNRat}
    (h : Pair.IsProg S c (Pair.mk L d)) {x : Fin k → ℚ} (hx : x ∈ S) : (L : ℚ) ≤ c x := by
  rcases h with ⟨h1, -⟩ | ⟨L', hL, hp⟩
  · exact absurd h1 (Pair.mk_ne_top _ _)
  · rw [(Pair.mk_eq_rat.1 hp).1]
    exact hL.2 ⟨x, hx, rfl⟩

/-- the dimension of a face from below: d + 1 of its points and a matrix M inverse to their differences at the coordinates r -/
theorem Pair.le_faceDim {k d : ℕ} {F : Set (Fin k → ℚ)} (p : Fin (d + 1) → Fin k → ℚ)
    (hF : ∀ j, p j ∈ F) (r : Fin d → Fin k) (M : Fin d → Fin d → ℚ)
    (hM : ∀ j j', ∑ t, M j t * (p j'.succ (r t) - p 0 (r t)) = if j = j' then 1 else 0) :
    d ≤ Module.finrank ℚ (vectorSpan ℚ F) := by
  let L : (Fin k → ℚ) →ₗ[ℚ] (Fin d → ℚ) :=
    { toFun := fun u j => ∑ t, M j t * u (r t)
      map_add' := fun u u' => by
        funext j; simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
      map_smul' := fun a u => by
        funext j; simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
        exact Finset.sum_congr rfl fun t _ => by ring }
  have hmem : ∀ j : Fin d, p j.succ - p 0 ∈ vectorSpan ℚ F :=
    fun j => vsub_mem_vectorSpan ℚ (hF j.succ) (hF 0)
  have hs : Function.Surjective (L.comp (vectorSpan ℚ F).subtype) := by
    intro y
    refine ⟨∑ j', y j' • ⟨p j'.succ - p 0, hmem j'⟩, ?_⟩
    funext j
    simp only [map_sum, map_smul, LinearMap.comp_apply, Submodule.subtype_apply, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul]
    have e : ∀ j', L (p j'.succ - p 0) j = if j = j' then 1 else 0 := fun j' => by
      rw [← hM j j']; rfl
    simp only [e, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  have h := LinearMap.finrank_le_finrank_of_surjective hs
  rw [Module.finrank_fin_fun] at h
  exact h

/-- the dimension of a face from above: functionals a with the constant values c on it, and coordinates r that vanish only at 0 on their common kernel -/
theorem Pair.faceDim_le {k e d : ℕ} {F : Set (Fin k → ℚ)} (a : Fin e → Fin k → ℚ)
    (c : Fin e → ℚ) (hF : ∀ x ∈ F, ∀ j, ∑ i, a j i * x i = c j) (r : Fin d → Fin k)
    (hR : ∀ u : Fin k → ℚ, (∀ j, ∑ i, a j i * u i = 0) → (∀ t, u (r t) = 0) → u = 0) :
    Module.finrank ℚ (vectorSpan ℚ F) ≤ d := by
  let W : Submodule ℚ (Fin k → ℚ) :=
    { carrier := {u | ∀ j, ∑ i, a j i * u i = 0}
      add_mem' := fun {u u'} hu hu' j => by
        simp only [Set.mem_ofPred_eq, Pi.add_apply, mul_add, Finset.sum_add_distrib] at hu hu' ⊢
        rw [hu j, hu' j, add_zero]
      zero_mem' := fun j => by simp
      smul_mem' := fun c u hu j => by
        simp only [Set.mem_ofPred_eq, Pi.smul_apply, smul_eq_mul] at hu ⊢
        have e : ∑ i, a j i * (c * u i) = c * ∑ i, a j i * u i := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun i _ => by ring
        rw [e, hu j, mul_zero] }
  have hle : vectorSpan ℚ F ≤ W := by
    rw [vectorSpan_def]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨x, hx, y, hy, rfl⟩ j
    have e : ∑ i, a j i * (x -ᵥ y) i = ∑ i, a j i * x i - ∑ i, a j i * y i := by
      simp [mul_sub, Finset.sum_sub_distrib]
    show ∑ i, a j i * (x -ᵥ y) i = 0
    rw [e, hF x hx j, hF y hy j, sub_self]
  let R : (Fin k → ℚ) →ₗ[ℚ] (Fin d → ℚ) := LinearMap.pi fun t => LinearMap.proj (r t)
  have hinj : Function.Injective (R.comp W.subtype) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    rintro ⟨u, hu⟩ h
    exact Subtype.ext (hR u hu fun t => congrFun h t)
  have h1 := Submodule.finrank_mono hle
  have h2 := LinearMap.finrank_le_finrank_of_injective hinj
  rw [Module.finrank_fin_fun] at h2
  exact h1.trans h2

/-- the scale j (from 1) of the block at the offset o of a point of a program: its coordinate o + j - 1, and 0 at
j = 0 and beyond the point -/
def Pair.blk {k : ℕ} (X : Fin k → ℚ) (o : ℕ) : ℕ → ℚ
  | 0 => 0
  | j + 1 => if h : o + j < k then X ⟨o + j, h⟩ else 0

theorem Pair.blk_succ {k : ℕ} (X : Fin k → ℚ) (o j : ℕ) :
    Pair.blk X o (j + 1) = if h : o + j < k then X ⟨o + j, h⟩ else 0 := rfl

theorem Pair.blk_one {k : ℕ} (X : Fin k → ℚ) (o : ℕ) (h : o < k) : Pair.blk X o 1 = X ⟨o, h⟩ :=
  dite_eq_left h

theorem Pair.blk_nonneg {k : ℕ} {X : Fin k → ℚ} (hX : ∀ i, 0 ≤ X i) (o : ℕ) : ∀ j, 0 ≤ Pair.blk X o j
  | 0 => le_refl 0
  | j + 1 => by
    rw [Pair.blk_succ]
    by_cases h : o + j < k
    · rw [dite_eq_left h]; exact hX _
    · rw [dite_eq_right h]

theorem Pair.blk_add {k : ℕ} (X Y : Fin k → ℚ) (o : ℕ) :
    ∀ j, Pair.blk (X + Y) o j = Pair.blk X o j + Pair.blk Y o j
  | 0 => (add_zero 0).symm
  | j + 1 => by
    simp only [Pair.blk_succ]
    by_cases h : o + j < k
    · rw [dite_eq_left h, dite_eq_left h, dite_eq_left h, Pi.add_apply]
    · rw [dite_eq_right h, dite_eq_right h, dite_eq_right h, add_zero]

theorem Pair.blk_sub {k : ℕ} (X Y : Fin k → ℚ) (o : ℕ) :
    ∀ j, Pair.blk (X - Y) o j = Pair.blk X o j - Pair.blk Y o j
  | 0 => (sub_zero 0).symm
  | j + 1 => by
    simp only [Pair.blk_succ]
    by_cases h : o + j < k
    · rw [dite_eq_left h, dite_eq_left h, dite_eq_left h, Pi.sub_apply]
    · rw [dite_eq_right h, dite_eq_right h, dite_eq_right h, sub_zero]

theorem Pair.blk_smul {k : ℕ} (a : ℚ) (X : Fin k → ℚ) (o : ℕ) :
    ∀ j, Pair.blk (a • X) o j = a * Pair.blk X o j
  | 0 => (mul_zero a).symm
  | j + 1 => by
    simp only [Pair.blk_succ]
    by_cases h : o + j < k
    · rw [dite_eq_left h, dite_eq_left h, Pi.smul_apply, smul_eq_mul]
    · rw [dite_eq_right h, dite_eq_right h, mul_zero]

theorem Pair.blk_zero {k : ℕ} (o : ℕ) : ∀ j, Pair.blk (0 : Fin k → ℚ) o j = 0
  | 0 => rfl
  | j + 1 => by
    rw [Pair.blk_succ]
    by_cases h : o + j < k
    · rw [dite_eq_left h, Pi.zero_apply]
    · rw [dite_eq_right h]

/-- the point that is f on the block at the offset o of size s (its scale j the coordinate o + j - 1), 0 elsewhere -/
def Pair.emb (k o s : ℕ) (f : ℕ → ℚ) : Fin k → ℚ :=
  fun i => if o ≤ i.val ∧ i.val < o + s then f (i.val - o + 1) else 0

theorem Pair.blk_emb_self {k o s : ℕ} (f : ℕ → ℚ) (hk : o + s ≤ k) {j : ℕ} (h1 : 1 ≤ j) (h2 : j ≤ s) :
    Pair.blk (Pair.emb k o s f) o j = f j := by
  cases j with
  | zero => exact absurd h1 (Nat.not_succ_le_zero 0)
  | succ j =>
    have hs : o + j < o + s := Nat.add_lt_add_left (Nat.lt_of_succ_le h2) o
    rw [Pair.blk_succ, dite_eq_left (Nat.lt_of_lt_of_le hs hk)]
    show (if o ≤ o + j ∧ o + j < o + s then f (o + j - o + 1) else 0) = f (j + 1)
    rw [ite_eq_left ⟨Nat.le_add_right o j, hs⟩, Nat.add_sub_cancel_left]

theorem Pair.blk_emb_before {k o s o' s' : ℕ} (f : ℕ → ℚ) (h : o' + s' ≤ o) {j : ℕ} (h2 : j ≤ s') :
    Pair.blk (Pair.emb k o s f) o' j = 0 := by
  cases j with
  | zero => rfl
  | succ j =>
    rw [Pair.blk_succ]
    by_cases hk : o' + j < k
    · rw [dite_eq_left hk]
      show (if o ≤ o' + j ∧ o' + j < o + s then f (o' + j - o + 1) else 0) = 0
      exact ite_eq_right (fun hc => absurd (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_of_succ_le h2) o') h)
        (Nat.not_lt.2 hc.1))
    · rw [dite_eq_right hk]

theorem Pair.blk_emb_after {k o s o' : ℕ} (f : ℕ → ℚ) (h : o + s ≤ o') (j : ℕ) :
    Pair.blk (Pair.emb k o s f) o' j = 0 := by
  cases j with
  | zero => rfl
  | succ j =>
    rw [Pair.blk_succ]
    by_cases hk : o' + j < k
    · rw [dite_eq_left hk]
      show (if o ≤ o' + j ∧ o' + j < o + s then f (o' + j - o + 1) else 0) = 0
      exact ite_eq_right (fun hc => absurd (Nat.le_trans h (Nat.le_add_right o' j)) (Nat.not_le.2 hc.2))
    · rw [dite_eq_right hk]

theorem Pair.emb_nonneg {k o s : ℕ} {f : ℕ → ℚ} (hf : ∀ j, 1 ≤ j → j ≤ s → 0 ≤ f j) (i : Fin k) :
    0 ≤ Pair.emb k o s f i := by
  show 0 ≤ (if o ≤ i.val ∧ i.val < o + s then f (i.val - o + 1) else 0)
  by_cases hc : o ≤ i.val ∧ i.val < o + s
  · rw [ite_eq_left hc]
    exact hf _ (Nat.succ_le_succ (Nat.zero_le _)) (Nat.succ_le_of_lt (Nat.sub_lt_left_of_lt_add hc.1 hc.2))
  · rw [ite_eq_right hc]

/-- a block of size one is its scale 1 -/
theorem Pair.blk_le_one {k : ℕ} {u : Fin k → ℚ} {o : ℕ} (h : Pair.blk u o 1 = 0) :
    ∀ j, 1 ≤ j → j ≤ 1 → Pair.blk u o j = 0 :=
  fun j h1 h2 => (Nat.le_antisymm h2 h1) ▸ h

/-- the coordinates from the end of the point on vanish (none) -/
theorem Pair.van_end {k : ℕ} (u : Fin k → ℚ) : ∀ i : Fin k, k ≤ i.val → u i = 0 :=
  fun i h => absurd i.isLt (Nat.not_lt.2 h)

/-- the coordinates from o on vanish when they vanish from o + s on and the block at o of size s vanishes -/
theorem Pair.van_step {k o s : ℕ} {u : Fin k → ℚ} (hv : ∀ i : Fin k, o + s ≤ i.val → u i = 0)
    (hb : ∀ j, 1 ≤ j → j ≤ s → Pair.blk u o j = 0) : ∀ i : Fin k, o ≤ i.val → u i = 0 := by
  intro i hi
  by_cases hs : i.val < o + s
  · have e := hb (i.val - o + 1) (Nat.succ_le_succ (Nat.zero_le _))
      (Nat.succ_le_of_lt (Nat.sub_lt_left_of_lt_add hi hs))
    rw [Pair.blk_succ, dite_eq_left ((Nat.add_sub_cancel' hi).trans_lt i.isLt)] at e
    have ei : (⟨o + (i.val - o), (Nat.add_sub_cancel' hi).trans_lt i.isLt⟩ : Fin k) = i :=
      Fin.ext (Nat.add_sub_cancel' hi)
    rw [ei] at e
    exact e
  · exact hv i (Nat.not_lt.1 hs)

/-- the point vanishes when it vanishes from s on and its first block, of size s, vanishes -/
theorem Pair.van_first {k s : ℕ} {u : Fin k → ℚ} (hv : ∀ i : Fin k, s ≤ i.val → u i = 0)
    (hb : ∀ j, 1 ≤ j → j ≤ s → Pair.blk u 0 j = 0) : u = 0 :=
  funext fun i => Pair.van_step (o := 0) (s := s) (fun i h => hv i ((Nat.zero_add s).symm ▸ h)) hb i (Nat.zero_le _)

theorem Pair.isProg_cast {k k' : ℕ} (e : k = k') (Φ : (ℕ → ℕ → ℚ) → Prop) (Ψ : (ℕ → ℕ → ℚ) → ℚ) (P : Pair) :
    Pair.IsProg {X : Fin k → ℚ | (∀ i, 0 ≤ X i) ∧ Φ (Pair.blk X)} (fun X => Ψ (Pair.blk X)) P ↔
      Pair.IsProg {X : Fin k' → ℚ | (∀ i, 0 ≤ X i) ∧ Φ (Pair.blk X)} (fun X => Ψ (Pair.blk X)) P := by
  subst e; exact Iff.rfl

/-- the dimension of a face from above, by ties: a predicate T closed under sums and multiples, true at the
difference of two points of the face, whose points vanish where they vanish at the coordinates r -/
theorem Pair.faceDim_le_ties {k d : ℕ} {F : Set (Fin k → ℚ)} (r : Fin d → Fin k) (T : (Fin k → ℚ) → Prop)
    (h0 : T 0) (hadd : ∀ u v, T u → T v → T (u + v)) (hsmul : ∀ (a : ℚ) u, T u → T (a • u))
    (hT : ∀ x ∈ F, ∀ y ∈ F, T (x - y)) (hR : ∀ u, T u → (∀ t, u (r t) = 0) → u = 0) :
    Module.finrank ℚ (vectorSpan ℚ F) ≤ d := by
  let W : Submodule ℚ (Fin k → ℚ) :=
    { carrier := {u | T u}
      add_mem' := fun {u v} hu hv => hadd u v hu hv
      zero_mem' := h0
      smul_mem' := fun a u hu => hsmul a u hu }
  have hle : vectorSpan ℚ F ≤ W := by
    rw [vectorSpan_def]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨x, hx, y, hy, rfl⟩
    exact hT x hx y hy
  let φ : W →ₗ[ℚ] (Fin d → ℚ) :=
    { toFun := fun u t => (u : Fin k → ℚ) (r t)
      map_add' := fun u v => by funext t; rfl
      map_smul' := fun a u => by funext t; rfl }
  have hinj : Function.Injective φ := by
    intro u v huv
    have hd : T ((u : Fin k → ℚ) - v) := by
      rw [sub_eq_add_neg, ← neg_one_smul ℚ (v : Fin k → ℚ)]
      exact hadd _ _ u.2 (hsmul (-1) _ v.2)
    have h0' := hR _ hd (fun t => by
      rw [Pi.sub_apply, sub_eq_zero]
      exact congrFun huv t)
    exact Subtype.ext (sub_eq_zero.1 h0')
  calc Module.finrank ℚ (vectorSpan ℚ F) ≤ Module.finrank ℚ W := Submodule.finrank_mono hle
    _ ≤ Module.finrank ℚ (Fin d → ℚ) := LinearMap.finrank_le_finrank_of_injective hinj
    _ = d := Module.finrank_fin_fun ℚ

/-- the dimension of a face from below, by two of its points that differ at the scale of a block of size one -/
theorem Pair.one_le_faceDim {k : ℕ} {F : Set (Fin k → ℚ)} {P Q : Fin k → ℚ} (hP : P ∈ F) (hQ : Q ∈ F) (o : ℕ)
    (h : o < k) (hne : Pair.blk P o 1 ≠ Pair.blk Q o 1) : 1 ≤ Module.finrank ℚ (vectorSpan ℚ F) := by
  rw [Pair.blk_one P o h, Pair.blk_one Q o h] at hne
  refine Pair.le_faceDim ![P, Q] (Fin.forall_fin_two.2 ⟨hP, hQ⟩) ![⟨o, h⟩] ![![1 / (Q ⟨o, h⟩ - P ⟨o, h⟩)]]
    (Fin.forall_fin_one.2 (Fin.forall_fin_one.2 ?_))
  rw [Fin.sum_univ_one, ite_eq_left rfl]
  exact one_div_mul_cancel (sub_ne_zero.2 hne.symm)



